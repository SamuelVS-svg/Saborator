@model List<ControlClientesRestaurante.Models.Producto>
@{
    ViewData["Title"] = "Inventario";
    bool esAdmin = (bool)(ViewBag.EsAdministrador ?? false);
    var stockBajo = Model?.Where(p => p.Activo && p.Stock <= 5).ToList() ?? new();
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-0">
    <div class="pg-header">
        <div class="pg-icon">
            <svg viewBox="0 0 24 24" fill="none"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
        </div>
        <div>
            <div class="pg-title">Inventario</div>
            <div class="pg-sub">Control de productos y stock del restaurante</div>
        </div>
    </div>
    @if (esAdmin)
    {
        <a asp-action="Create" class="btn-gold" style="gap:.4rem;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Nuevo producto
        </a>
    }
</div>
<hr class="div-gold" />

@* Banner de alertas de stock bajo *@
@if (stockBajo.Any())
{
    <div style="background:var(--color-danger-bg);border:1px solid var(--color-danger);border-left:5px solid var(--color-danger);border-radius:10px;padding:1rem 1.25rem;margin-bottom:1.25rem;">
        <div style="display:flex;align-items:center;gap:.6rem;margin-bottom:.6rem;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-danger)" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            <strong style="color:var(--color-text);font-size:.9rem;">
                @stockBajo.Count producto@(stockBajo.Count > 1 ? "s" : "") con stock bajo
            </strong>
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:.5rem;">
            @foreach (var p in stockBajo)
            {
                var borde = p.Stock == 0 ? "var(--color-danger)" : "var(--color-accent)";
                var label = p.Stock == 0 ? "Sin stock" : $"{p.Stock} ud.";
                <span style="background:var(--color-bg);border:1px solid @borde;border-radius:20px;padding:.25em .75em;font-size:.78rem;color:var(--color-text);font-weight:600;">
                    @p.Nombre — @label
                </span>
            }
        </div>
    </div>
}

@if (Model == null || !Model.Any())
{
    <div class="card-pro text-center py-5" style="color:var(--c-muted);">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" style="margin-bottom:.75rem;opacity:.3;"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
        <p style="font-weight:600;font-size:1rem;margin-bottom:.25rem;">No hay productos registrados.</p>
    </div>
}
else
{
    <div class="tbl-wrap">
        <table id="tablaProductos">
            <thead>
                <tr>
                    <th>Nombre &amp; Categoría</th>
                    <th>Alérgenos &amp; Ficha Dietaria</th>
                    <th>Precio</th>
                    <th>Stock</th>
                    @if (esAdmin){ <th style="width:90px;text-align:right;">Acciones</th> }
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>
                            <div>
                                <strong style="font-size:0.92rem;">@p.Nombre</strong>
                                @if (p.Stock == 0)
                                {
                                    <span style="font-size:.7rem;background:var(--color-danger-bg);color:var(--color-text);border:1px solid var(--color-danger);border-radius:4px;padding:.1em .45em;margin-left:.35rem;font-weight:700;">Sin stock</span>
                                }
                                else if (p.Stock <= 5)
                                {
                                    <span style="font-size:.7rem;background:var(--color-accent-bg);color:var(--color-text);border:1px solid var(--color-accent);border-radius:4px;padding:.1em .45em;margin-left:.35rem;font-weight:700;">Stock bajo</span>
                                }
                            </div>
                            <div style="font-size:0.75rem;color:var(--c-muted);margin-top:2px;">
                                <span class="badge" style="background:rgba(200,151,58,0.12);color:var(--color-brand,#7A1C28);border-radius:4px;padding:2px 6px;">
                                    @p.Categoria
                                </span>
                                @if (p.TiempoCoccionMinutos > 0)
                                {
                                    <span style="margin-left:4px;">⏱️ @p.TiempoCoccionMinutos min</span>
                                }
                            </div>
                        </td>
                        <td>
                            <div class="d-flex flex-wrap gap-1 align-items-center">
                                @if (p.EsVegetariano)
                                {
                                    <span style="font-size:0.7rem;background:#ECFDF5;color:#065F46;border:1px solid #A7F3D0;border-radius:4px;padding:1px 6px;font-weight:700;">🌱 Vegetariano</span>
                                }
                                @if (p.EsLibreGluten)
                                {
                                    <span style="font-size:0.7rem;background:#EFF6FF;color:#1E40AF;border:1px solid #BFDBFE;border-radius:4px;padding:1px 6px;font-weight:700;">🌾 Sin TACC</span>
                                }
                            </div>
                            <div style="font-size:0.78rem;color:var(--c-muted);margin-top:3px;">
                                @if (!string.IsNullOrWhiteSpace(p.Alergenos))
                                {
                                    <span style="color:#B45309;font-weight:600;">⚠️ Alérgenos: @p.Alergenos</span>
                                }
                                else
                                {
                                    <span style="color:var(--c-muted);">Sin alérgenos comunes</span>
                                }
                            </div>
                        </td>
                        <td>
                            <strong style="color:var(--color-brand,#7A1C28);">$@p.Precio.ToString("N0")</strong>
                        </td>
                        <td>
                            @if (p.Stock == 0)
                            {
                                <span class="txt-err" style="font-weight:800;color:#DC2626;">0</span>
                            }
                            else if (p.Stock <= 5)
                            {
                                <span style="font-weight:700;color:var(--color-text);background:var(--color-accent-bg);border:1px solid var(--color-accent);border-radius:6px;padding:.15em .5em;">@p.Stock</span>
                            }
                            else
                            {
                                <span style="font-weight:600;">@p.Stock</span>
                            }
                        </td>
                        @if (esAdmin)
                        {
                            <td style="text-align:right;">
                                <a asp-action="Edit" asp-route-id="@p.Id" class="btn-ghost" style="padding:.3rem .65rem;font-size:.75rem;gap:.3rem;display:inline-flex;align-items:center;">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                    Editar
                                </a>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div style="font-size:.73rem;color:var(--c-muted);margin-top:.5rem;text-align:right;">
        <span id="conteo">@Model.Count</span> producto(s)
    </div>
}
