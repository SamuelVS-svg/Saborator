@{
    ViewData["Title"] = "Rastrear Pedido — Saborator";
    bool busquedaFallida = ViewBag.BusquedaFallida as bool? ?? false;
    string codigoBuscado = ViewBag.CodigoBuscado as string ?? "";
}

<div class="rastrear-container">
    <div class="rastrear-card">
        <div class="rastrear-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            Saborator Tracker
        </div>

        <h1 class="rastrear-title">Rastrea tu Pedido en Vivo</h1>
        <p class="rastrear-sub">Ingresa el código único de tu pedido (ej. <strong>PED-00001</strong>) o tu número celular para conocer el estado de tu comida en tiempo real.</p>

        @if (busquedaFallida)
        {
            <div class="rastrear-error">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                <span>No encontramos ningún pedido activo asociado a: "<strong>@codigoBuscado</strong>". Verifica el código o tu teléfono celular.</span>
            </div>
        }

        <form asp-controller="Pedido" asp-action="Seguimiento" method="get" class="rastrear-form">
            @Html.AntiForgeryToken()
            <div class="input-wrap">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <input type="text" name="id" class="input-rastrear" placeholder="Código (PED-00001) o Celular (300...)" required autofocus />
            </div>

            <button type="submit" class="btn-rastrear">
                <span>Rastrear Orden</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
        </form>

        <div class="rastrear-footer">
            <a href="/#menu" class="link-menu">← Volver a la Carta Gastronómica</a>
        </div>
    </div>
</div>

<style>
    .rastrear-container {
        min-height: 75vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3rem 1.25rem;
    }
    .rastrear-card {
        max-width: 580px;
        width: 100%;
        background: var(--surface, #FFFDF9);
        border: 1px solid var(--line, #E2D7C8);
        border-radius: 20px;
        padding: 3rem 2.5rem;
        text-align: center;
        box-shadow: 0 12px 35px rgba(0,0,0,0.06);
    }
    .rastrear-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: rgba(200, 151, 58, 0.12);
        color: var(--gold, #C8973A);
        border: 1px solid rgba(200, 151, 58, 0.35);
        padding: 0.3rem 0.85rem;
        border-radius: 999px;
        font-size: 0.76rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-bottom: 1rem;
    }
    .rastrear-title {
        font-family: var(--font-serif, 'Instrument Serif', serif);
        font-size: 2.6rem;
        color: var(--brand, #6B1E2E);
        margin: 0 0 0.65rem;
        line-height: 1.15;
    }
    .rastrear-sub {
        font-size: 0.92rem;
        color: var(--muted, #6E5C50);
        margin: 0 0 2rem;
        line-height: 1.5;
    }
    .rastrear-error {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        padding: 0.85rem 1.15rem;
        background: #FEE2E2;
        border: 1px solid #FCA5A5;
        border-radius: 12px;
        color: #991B1B;
        font-size: 0.88rem;
        text-align: left;
        margin-bottom: 1.5rem;
    }
    .rastrear-form {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }
    .input-wrap {
        position: relative;
        display: flex;
        align-items: center;
    }
    .input-wrap svg {
        position: absolute;
        left: 1.15rem;
        color: var(--muted, #6E5C50);
    }
    .input-rastrear {
        width: 100%;
        padding: 1rem 1rem 1rem 3rem;
        font-size: 1.05rem;
        border: 2px solid var(--line, #E2D7C8);
        border-radius: 12px;
        background: #FFFDF9;
        color: #18060A;
        font-weight: 600;
        outline: none;
        box-sizing: border-box;
        transition: border-color 160ms ease;
    }
    .input-rastrear:focus {
        border-color: var(--brand, #6B1E2E);
        box-shadow: 0 0 0 3px rgba(107, 30, 46, 0.1);
    }
    .btn-rastrear {
        width: 100%;
        padding: 1rem;
        background: linear-gradient(135deg, var(--gold, #C8973A) 0%, #DFB460 100%);
        border: none;
        border-radius: 12px;
        color: #18060A;
        font-weight: 800;
        font-size: 1rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        box-shadow: 0 6px 20px rgba(200, 151, 58, 0.35);
        transition: transform 140ms ease;
    }
    .btn-rastrear:hover { transform: translateY(-2px); }
    .rastrear-footer { margin-top: 1.75rem; }
    .link-menu {
        color: var(--gold, #C8973A);
        text-decoration: none;
        font-size: 0.88rem;
        font-weight: 700;
    }
    .link-menu:hover { text-decoration: underline; }
</style>
