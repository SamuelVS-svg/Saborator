@{ 
    ViewData["Title"] = "Sistema de Gestión & Control — Saborator"; 
    Layout = "_Layout"; 
}

<link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />

<div class="landing">

    <!-- ══ NAV ══════════════════════════════════════════════════ -->
    <nav class="lnav">
        <a href="/" class="lnav-brand">
            <div class="lnav-icon">
                <partial name="_LogoBurger" />
            </div>
            <span class="lnav-name">Saborator</span>
        </a>
        <div class="lnav-actions">
            <a href="/" class="lnav-btn-o">Ver Menú Gastronómico</a>
            <a asp-controller="Reserva" asp-action="Nueva" class="lnav-btn-p">Reservar Mesa</a>
            <a asp-controller="Login" asp-action="Index" class="lnav-btn-o">Acceso Personal</a>
        </div>
    </nav>

    <!-- ══ HERO SISTEMA ═════════════════════════════════════════ -->
    <section class="hero">
        <div class="hero-inner">
            <div class="hero-tag">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                Arquitectura &amp; Gestión Restaurantera
            </div>
            <h1 class="hero-title">
                Control Operativo &amp;<br/>
                <span>Saborator</span>
            </h1>
            <p class="hero-desc">
                Plataforma integral para restaurantes gourmet: gestión de clientes, comandas en mesa, 
                facturación DIAN con propina, control de inventario en tiempo real y módulo de reservas exclusivas.
            </p>
            <div class="hero-cta">
                <a asp-controller="Home" asp-action="Dashboard" class="btn-hero-p">Abrir Dashboard V12</a>
                <a asp-controller="Login" asp-action="Index" class="btn-hero-s">Ingresar con Usuario</a>
                <a href="/" class="btn-hero-s">Ir a la Carta</a>
            </div>
        </div>
    </section>

    <!-- ══ FEATURES TÉCNICAS ════════════════════════════════════ -->
    <section class="section-pad" id="features">
        <div class="section-inner">
            <div class="section-center">
                <h2 class="section-title">Módulos del Sistema</h2>
                <p class="section-sub">Ecosistema unificado para cada área operativa de tu restaurante</p>
            </div>
            <div class="features-grid">
                <div class="feat-card">
                    <div class="feat-icon"><svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
                    <h3>Control de clientes</h3>
                    <p>Registra y gestiona los datos de tus clientes con validaciones automáticas de documento y contacto.</p>
                </div>
                <div class="feat-card">
                    <div class="feat-icon"><svg viewBox="0 0 24 24"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><line x1="9" y1="12" x2="15" y2="12"/><line x1="9" y1="16" x2="13" y2="16"/></svg></div>
                    <h3>Pedidos en mesa</h3>
                    <p>Los meseros toman comandas desde terminales táctiles que pasan directamente a cocina y caja.</p>
                </div>
                <div class="feat-card">
                    <div class="feat-icon"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="15" y2="17"/></svg></div>
                    <h3>Facturación &amp; Caja</h3>
                    <p>Genera facturas numeradas automáticamente con cálculo de impuestos, propina voluntaria y cierre diario.</p>
                </div>
                <div class="feat-card">
                    <div class="feat-icon"><svg viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg></div>
                    <h3>Inventario Atómico</h3>
                    <p>Descuento estricto de existencias con bloqueo de sobreventa por concurrencia a nivel de base de datos.</p>
                </div>
                <div class="feat-card">
                    <div class="feat-icon"><svg viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13" rx="2"/><polygon points="16 8 20 8 23 11 23 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg></div>
                    <h3>Proveedores</h3>
                    <p>Administra la cadena de suministros e insumos gastronómicos con trazabilidad completa.</p>
                </div>
                <div class="feat-card">
                    <div class="feat-icon"><svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg></div>
                    <h3>Roles y Permisos</h3>
                    <p>Administrador, Cajero, Mesero y Comensal con accesos seguros y vistas diferenciadas.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ══ CTA ══════════════════════════════════════════════════ -->
    <section class="section-pad section-center">
        <div class="section-inner">
            <h2 class="cta-title">¿Listo para <span>gestionar?</span></h2>
            <p class="cta-desc">Ingresa con tus credenciales asignadas de Administrador, Cajero o Mesero.</p>
            <a asp-controller="Login" asp-action="Index" class="btn-hero-p">Acceder al Panel de Empleados</a>
        </div>
    </section>

    <!-- ══ FOOTER ════════════════════════════════════════════════ -->
    <footer class="lfooter">
        <div>&copy; @DateTime.Now.Year <span>Saborator</span> · Sistema de Control Operativo Gastronómico</div>
    </footer>

</div>
