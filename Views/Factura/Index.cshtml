@model List<ControlClientesRestaurante.Models.Factura>
@{
    ViewData["Title"] = "Historial de Ventas & Facturación";
    decimal totalFacturado  = ViewBag.TotalFacturado  ?? 0m;
    decimal totalIva        = ViewBag.TotalIva        ?? 0m;
    decimal totalPropinas   = ViewBag.TotalPropinas   ?? 0m;
    decimal totalDomicilios = ViewBag.TotalDomicilios ?? 0m;
    decimal ticketPromedio  = ViewBag.TicketPromedio  ?? 0m;
    int totalFacturas       = ViewBag.TotalFacturas   ?? 0;

    string desde = ViewBag.Desde as string ?? "";
    string hasta = ViewBag.Hasta as string ?? "";
    string buscar = ViewBag.Buscar as string ?? "";
    string cajeroSeleccionado = ViewBag.CajeroSeleccionado as string ?? "";
    var listaCajeros = (ViewBag.ListaCajeros as List<string>) ?? new List<string>();
}

<!-- Encabezado Principal -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
    <div class="pg-header">
        <div class="pg-icon">
            <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="3" x2="9" y2="21"/></svg>
        </div>
        <div>
            <div class="pg-title">Historial de Ventas &amp; Facturación</div>
            <div class="pg-sub">Consulta de comprobantes contables, métricas y exportación financiera</div>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <a asp-action="ExportarCsv" asp-route-desde="@desde" asp-route-hasta="@hasta" asp-route-buscar="@buscar" asp-route-cajero="@cajeroSeleccionado" 
           class="btn-ghost" title="Exportar reporte consolidado a Excel / CSV" style="padding:0.45rem 0.85rem;font-size:0.82rem;gap:0.4rem;display:inline-flex;align-items:center;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            <span>Exportar Ventas (Excel)</span>
        </a>
        <a asp-action="ExportarDetalladoCsv" asp-route-desde="@desde" asp-route-hasta="@hasta" asp-route-buscar="@buscar" asp-route-cajero="@cajeroSeleccionado" 
           class="btn-ghost" title="Exportar desglose por plato vendido a Excel" style="padding:0.45rem 0.85rem;font-size:0.82rem;gap:0.4rem;display:inline-flex;align-items:center;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            <span>Detalle Platos (Excel)</span>
        </a>
        <a asp-action="Create" class="btn-gold" style="padding:0.45rem 0.95rem;font-size:0.82rem;gap:0.4rem;display:inline-flex;align-items:center;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            <span>Nueva Factura</span>
        </a>
    </div>
</div>
<hr class="div-gold" />

<!-- ══ TARJETAS DE KPIS FINANCIEROS ═══════════════════════════════════ -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card-pro p-3" style="border-left: 4px solid var(--color-brand, #7A1C28);">
            <div style="font-size:0.75rem;color:var(--c-muted);text-transform:uppercase;font-weight:700;">Total Facturado</div>
            <div style="font-size:1.35rem;font-weight:800;color:var(--c-dark);margin-top:0.2rem;">$@totalFacturado.ToString("N0") COP</div>
            <div style="font-size:0.72rem;color:var(--c-muted);">En @totalFacturas factura(s)</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card-pro p-3" style="border-left: 4px solid #10B981;">
            <div style="font-size:0.75rem;color:var(--c-muted);text-transform:uppercase;font-weight:700;">Ticket Promedio</div>
            <div style="font-size:1.35rem;font-weight:800;color:#059669;margin-top:0.2rem;">$@ticketPromedio.ToString("N0") COP</div>
            <div style="font-size:0.72rem;color:var(--c-muted);">Por comprobante emitido</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card-pro p-3" style="border-left: 4px solid #C8973A;">
            <div style="font-size:0.75rem;color:var(--c-muted);text-transform:uppercase;font-weight:700;">IVA Recaudado</div>
            <div style="font-size:1.35rem;font-weight:800;color:#B45309;margin-top:0.2rem;">$@totalIva.ToString("N0") COP</div>
            <div style="font-size:0.72rem;color:var(--c-muted);">Impuesto discriminado</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card-pro p-3" style="border-left: 4px solid #3B82F6;">
            <div style="font-size:0.75rem;color:var(--c-muted);text-transform:uppercase;font-weight:700;">Propinas &amp; Domicilios</div>
            <div style="font-size:1.35rem;font-weight:800;color:#2563EB;margin-top:0.2rem;">$@((totalPropinas + totalDomicilios).ToString("N0")) COP</div>
            <div style="font-size:0.72rem;color:var(--c-muted);">$@totalPropinas.ToString("N0") prop / $@totalDomicilios.ToString("N0") dom</div>
        </div>
    </div>
</div>

<!-- ══ FILTROS DE RANGO Y BÚSQUEDA ═══════════════════════════════════ -->
<div class="card-pro p-3 mb-4" style="background:var(--color-bg-card, #FFFDF9);">
    <form method="get" asp-action="Index" id="filtroForm" class="row g-2 align-items-end">
        <div class="col-12 col-md-3">
            <label style="font-size:0.75rem;font-weight:700;color:var(--c-muted);margin-bottom:0.25rem;">Buscar por N°, Cliente o Cédula</label>
            <input type="text" name="buscar" value="@buscar" class="form-control form-control-sm" placeholder="Ej: FAC-0001, Carlos, 1042..." />
        </div>
        <div class="col-6 col-md-2">
            <label style="font-size:0.75rem;font-weight:700;color:var(--c-muted);margin-bottom:0.25rem;">Desde</label>
            <input type="date" name="desde" id="inputDesde" value="@desde" class="form-control form-control-sm" />
        </div>
        <div class="col-6 col-md-2">
            <label style="font-size:0.75rem;font-weight:700;color:var(--c-muted);margin-bottom:0.25rem;">Hasta</label>
            <input type="date" name="hasta" id="inputHasta" value="@hasta" class="form-control form-control-sm" />
        </div>
        <div class="col-6 col-md-2">
            <label style="font-size:0.75rem;font-weight:700;color:var(--c-muted);margin-bottom:0.25rem;">Cajero</label>
            <select name="cajero" class="form-select form-select-sm">
                <option value="">Todos los cajeros</option>
                @foreach (var c in listaCajeros)
                {
                    <option value="@c" selected="@(c == cajeroSeleccionado)">@c</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-3 d-flex gap-2">
            <button type="submit" class="btn-brand flex-fill" style="padding:0.38rem 0.75rem;font-size:0.8rem;border-radius:8px;">
                Filtrar
            </button>
            <a asp-action="Index" class="btn-ghost" style="padding:0.38rem 0.75rem;font-size:0.8rem;border-radius:8px;">
                Limpiar
            </a>
        </div>
    </form>

    <!-- Botones de Acceso Rápido de Fecha -->
    <div class="d-flex flex-wrap gap-2 mt-3 pt-2 border-top">
        <span style="font-size:0.75rem;color:var(--c-muted);align-self:center;margin-right:0.25rem;">Rango rápido:</span>
        <button type="button" class="btn-ghost" onclick="setRango('hoy')" style="padding:0.2rem 0.6rem;font-size:0.73rem;">Hoy</button>
        <button type="button" class="btn-ghost" onclick="setRango('semana')" style="padding:0.2rem 0.6rem;font-size:0.73rem;">Últimos 7 días</button>
        <button type="button" class="btn-ghost" onclick="setRango('mes')" style="padding:0.2rem 0.6rem;font-size:0.73rem;">Este mes</button>
    </div>
</div>

@if (Model == null || !Model.Any())
{
    <div class="card-pro text-center py-5" style="color:var(--c-muted);">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" style="margin-bottom:.75rem;opacity:.35;"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="3" x2="9" y2="21"/></svg>
        <p style="font-weight:600;font-size:1rem;margin-bottom:.25rem;">No se encontraron facturas para los filtros seleccionados.</p>
        <p style="font-size:.875rem;">Intenta ampliar el rango de fechas o limpiar los filtros.</p>
    </div>
}
else
{
    <div class="tbl-wrap">
        <table id="tablaFacturas">
            <thead>
                <tr>
                    <th>N° Factura</th>
                    <th>Fecha &amp; Hora</th>
                    <th>Cliente</th>
                    <th>Subtotal</th>
                    <th>IVA</th>
                    <th>Propina</th>
                    <th>Total</th>
                    <th>Estado</th>
                    <th>Cajero</th>
                    <th style="width:120px;text-align:right;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in Model)
                {
                    decimal ivaFactura = f.Subtotal * f.ImpuestoPorcentaje / 100m;
                    <tr>
                        <td>
                            <strong style="font-family:monospace;font-size:.85rem;color:var(--color-brand, #7A1C28);">@f.Numero</strong>
                        </td>
                        <td style="color:var(--c-muted);font-size:.82rem;">@f.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            @if (f.Cliente != null)
                            {
                                <div style="font-weight:600;">@f.Cliente.Nombre</div>
                                <div style="font-size:0.75rem;color:var(--c-muted);">Doc: @(f.Cliente.Documento ?? "N/A")</div>
                            }
                            else if (!string.IsNullOrEmpty(f.NombreClienteLibre))
                            {
                                <div style="font-weight:600;">@f.NombreClienteLibre</div>
                                <div style="font-size:0.75rem;color:var(--c-muted);">Cliente libre</div>
                            }
                            else
                            {
                                <span style="color:var(--c-muted);">Consumidor final</span>
                            }
                        </td>
                        <td style="font-size:0.85rem;">$@f.Subtotal.ToString("N0")</td>
                        <td style="font-size:0.85rem;color:var(--c-muted);">$@ivaFactura.ToString("N0")</td>
                        <td style="font-size:0.85rem;color:var(--c-muted);">$@f.Propina.ToString("N0")</td>
                        <td>
                            <strong style="font-size:0.92rem;color:var(--c-dark);">$@f.Total.ToString("N0")</strong>
                        </td>
                        <td>
                            @if (f.Estado == "Emitida")
                            { <span class="badge-emit">Emitida</span> }
                            else
                            { <span class="badge-anul">Anulada</span> }
                        </td>
                        <td style="color:var(--c-muted);font-size:.82rem;">@f.UsuarioCajero</td>
                        <td style="text-align:right;">
                            <a asp-action="Detalle" asp-route-id="@f.Id" class="btn-ghost"
                               style="padding:.28rem .65rem;font-size:.76rem;gap:.3rem;display:inline-flex;align-items:center;">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                Ver / PDF
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="d-flex justify-content-between align-items-center mt-3" style="font-size:.78rem;color:var(--c-muted);">
        <div>Mostrando <strong>@Model.Count</strong> factura(s)</div>
        <div>Total consolidado en vista: <strong style="color:var(--c-dark);font-size:0.85rem;">$@totalFacturado.ToString("N0") COP</strong></div>
    </div>
}

<script>
    function setRango(tipo) {
        const hoy = new Date();
        const formatDate = (d) => d.toISOString().split('T')[0];
        const inputDesde = document.getElementById('inputDesde');
        const inputHasta = document.getElementById('inputHasta');

        inputHasta.value = formatDate(hoy);

        if (tipo === 'hoy') {
            inputDesde.value = formatDate(hoy);
        } else if (tipo === 'semana') {
            const semanaAtras = new Date();
            semanaAtras.setDate(hoy.getDate() - 7);
            inputDesde.value = formatDate(semanaAtras);
        } else if (tipo === 'mes') {
            const inicioMes = new Date(hoy.getFullYear(), hoy.getMonth(), 1);
            inputDesde.value = formatDate(inicioMes);
        }
        document.getElementById('filtroForm').submit();
    }
</script>
