@model ControlClientesRestaurante.Models.Cupon
@{
    ViewData["Title"] = "Crear Nuevo Cupón Promocional";
}

<div style="max-width:680px;margin:2rem auto;padding:0 1.25rem;">
    <div style="margin-bottom:1.5rem;">
        <a asp-action="Index" style="display:inline-flex;align-items:center;gap:5px;color:#3C2A20;text-decoration:none;font-weight:700;font-size:0.85rem;margin-bottom:0.75rem;">
            ← Volver a Cupones
        </a>
        <h1 style="font-size:1.65rem;font-weight:800;color:var(--brand,#6B1E2E);margin:0;">Crear Nuevo Cupón</h1>
        <p style="font-size:0.88rem;color:#666;margin:4px 0 0;">Configura las reglas comerciales, límite de canjes y porcentaje o monto del descuento.</p>
    </div>

    <div style="background:#FFFDF9;border:1px solid var(--line,#E2D7C8);border-radius:14px;padding:2rem;box-shadow:0 4px 16px rgba(0,0,0,0.04);">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" style="color:#DC2626;font-size:0.85rem;margin-bottom:1rem;"></div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;margin-bottom:1.25rem;">
                <div>
                    <label asp-for="Codigo" style="display:block;font-size:0.8rem;font-weight:700;color:#3C2A20;text-transform:uppercase;margin-bottom:0.35rem;">Código Promocional *</label>
                    <input asp-for="Codigo" class="input-field" placeholder="EJ: BURGER20" style="width:100%;padding:0.75rem;border:1.5px solid var(--line,#E2D7C8);border-radius:10px;text-transform:uppercase;font-weight:800;letter-spacing:1px;font-family:monospace;" required />
                    <span asp-validation-for="Codigo" style="color:#DC2626;font-size:0.78rem;"></span>
                </div>
                <div>
                    <label asp-for="TipoDescuento" style="display:block;font-size:0.8rem;font-weight:700;color:#3C2A20;text-transform:uppercase;margin-bottom:0.35rem;">Tipo de Descuento *</label>
                    <select asp-for="TipoDescuento" id="selTipoDescuento" class="input-field" style="width:100%;padding:0.75rem;border:1.5px solid var(--line,#E2D7C8);border-radius:10px;" onchange="ajustarCamposTipo()">
                        <option value="Porcentaje">Porcentaje (% sobre subtotal)</option>
                        <option value="Fijo">Monto Fijo ($ COP de descuento)</option>
                    </select>
                </div>
            </div>

            <div style="margin-bottom:1.25rem;">
                <label asp-for="Descripcion" style="display:block;font-size:0.8rem;font-weight:700;color:#3C2A20;text-transform:uppercase;margin-bottom:0.35rem;">Descripción de la Promoción *</label>
                <input asp-for="Descripcion" class="input-field" placeholder="Ej: 15% de descuento en pedidos mayores a $30.000 COP" style="width:100%;padding:0.75rem;border:1.5px solid var(--line,#E2D7C8);border-radius:10px;" required />
                <span asp-validation-for="Descripcion" style="color:#DC2626;font-size:0.78rem;"></span>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;margin-bottom:1.25rem;">
                <div>
                    <label asp-for="Valor" id="lblValor" style="display:block;font-size:0.8rem;font-weight:700;color:#3C2A20;text-transform:uppercase;margin-bottom:0.35rem;">Porcentaje (%) *</label>
                    <input asp-for="Valor" type="number" step="0.01" class="input-field" placeholder="15" style="width:100%;padding:0.75rem;border:1.5px solid var(--line,#E2D7C8);border-radius:10px;" required />
                    <span asp-validation-for="Valor" style="color:#DC2626;font-size:0.78rem;"></span>
                </div>
                <div id="colTopeMaximo">
                    <label asp-for="TopeMaximoDescuento" style="display:block;font-size:0.8rem;font-weight:700;color:#3C2A20;text-transform:uppercase;margin-bottom:0.35rem;">Tope Máximo Descuento ($ COP)</label>
                    <input asp-for="TopeMaximoDescuento" type="number" class="input-field" placeholder="Ej: 15000 (Opcional)" style="width:100%;padding:0.75rem;border:1.5px solid var(--line,#E2D7C8);border-radius:10px;" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;margin-bottom:1.25rem;">
                <div>
                    <label asp-for="MontoMinimo" style="display:block;font-size:0.8rem;font-weight:700;color:#3C2A20;text-transform:uppercase;margin-bottom:0.35rem;">Consumo Mínimo de Pedido ($ COP)</label>
                    <input asp-for="MontoMinimo" type="number" class="input-field" placeholder="Ej: 30000" style="width:100%;padding:0.75rem;border:1.5px solid var(--line,#E2D7C8);border-radius:10px;" />
                </div>
                <div>
                    <label asp-for="UsosMaximos" style="display:block;font-size:0.8rem;font-weight:700;color:#3C2A20;text-transform:uppercase;margin-bottom:0.35rem;">Límite Máximo de Canjes *</label>
                    <input asp-for="UsosMaximos" type="number" class="input-field" placeholder="100" style="width:100%;padding:0.75rem;border:1.5px solid var(--line,#E2D7C8);border-radius:10px;" required />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;margin-bottom:1.5rem;">
                <div>
                    <label asp-for="FechaVencimiento" style="display:block;font-size:0.8rem;font-weight:700;color:#3C2A20;text-transform:uppercase;margin-bottom:0.35rem;">Fecha de Vencimiento</label>
                    <input asp-for="FechaVencimiento" type="date" class="input-field" style="width:100%;padding:0.75rem;border:1.5px solid var(--line,#E2D7C8);border-radius:10px;" />
                </div>
                <div style="display:flex;align-items:center;gap:10px;padding-top:1.5rem;">
                    <input asp-for="Activo" type="checkbox" id="chkActivo" style="width:18px;height:18px;accent-color:var(--brand,#6B1E2E);" />
                    <label for="chkActivo" style="font-weight:700;color:#3C2A20;font-size:0.9rem;cursor:pointer;">Cupón Activo Inmediatamente</label>
                </div>
            </div>

            <div style="display:flex;justify-content:flex-end;gap:1rem;border-top:1px solid var(--line,#E2D7C8);padding-top:1.25rem;">
                <a asp-action="Index" style="padding:0.75rem 1.25rem;border:1px solid var(--line,#E2D7C8);border-radius:10px;color:#3C2A20;text-decoration:none;font-weight:700;font-size:0.88rem;">
                    Cancelar
                </a>
                <button type="submit" style="background:var(--brand,#6B1E2E);color:#FFFDF9;border:none;padding:0.75rem 1.5rem;border-radius:10px;font-weight:800;font-size:0.88rem;cursor:pointer;box-shadow:0 3px 10px rgba(107,30,46,0.25);">
                    Guardar Cupón
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function ajustarCamposTipo() {
        const tipo = document.getElementById('selTipoDescuento').value;
        const lbl = document.getElementById('lblValor');
        const colTope = document.getElementById('colTopeMaximo');
        if (tipo === 'Porcentaje') {
            lbl.textContent = 'Porcentaje (%) *';
            colTope.style.display = 'block';
        } else {
            lbl.textContent = 'Valor Fijo ($ COP) *';
            colTope.style.display = 'none';
        }
    }
    document.addEventListener('DOMContentLoaded', ajustarCamposTipo);
</script>
