@model ErrorViewModel
@{
    ViewData["Title"] = "Incidencia en el Servicio — Saborator";
}

<div style="min-height:80vh;display:flex;align-items:center;justify-content:center;padding:3rem 1.5rem;background:radial-gradient(circle at 50% 30%, rgba(107,30,46,0.5) 0%, rgba(24,6,10,0.98) 75%);color:#FFFDF9;text-align:center;">
    <div style="max-width:580px;background:rgba(30,10,16,0.85);backdrop-filter:blur(16px);border:1px solid rgba(200,151,58,0.3);border-radius:20px;padding:3rem 2.5rem;box-shadow:0 25px 60px rgba(0,0,0,0.65);">
        <div style="width:72px;height:72px;margin:0 auto 1.5rem;border-radius:50%;background:rgba(107,30,46,0.6);border:1px solid rgba(200,151,58,0.4);display:flex;align-items:center;justify-content:center;color:#C8973A;">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                <line x1="12" y1="9" x2="12" y2="13"/>
                <line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
        </div>

        <div style="display:inline-block;padding:0.3rem 0.9rem;border-radius:999px;background:rgba(200,151,58,0.15);border:1px solid rgba(200,151,58,0.3);color:#F0E2D2;font-size:0.8rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;margin-bottom:1.25rem;">
            Aviso de Sistema
        </div>

        <h1 style="font-family:'Instrument Serif', Georgia, serif;font-size:2.6rem;font-weight:400;margin:0 0 1rem;color:#FFFDF9;">
            Interrupción en el <span style="color:#C8973A;font-style:italic;">Servicio</span>
        </h1>

        <p style="color:rgba(255,253,249,0.8);font-size:1.02rem;line-height:1.6;margin:0 auto 2rem;">
            Ha ocurrido un inconveniente inesperado al procesar tu solicitud. El equipo técnico ha registrado la traza para solventarlo a la brevedad.
        </p>

        @if (Model?.ShowRequestId == true)
        {
            <div style="background:rgba(0,0,0,0.35);padding:0.75rem 1rem;border-radius:10px;border:1px solid rgba(255,253,249,0.1);font-family:'Geist Mono',monospace;font-size:0.82rem;color:#C8973A;margin-bottom:2rem;word-break:break-all;">
                <strong>ID de Traza:</strong> @Model.RequestId
            </div>
        }

        <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
            <a href="/" style="display:inline-flex;align-items:center;gap:0.5rem;padding:0.8rem 1.6rem;background:linear-gradient(135deg,#C8973A,#A67520);color:#18060A;font-weight:700;border-radius:12px;text-decoration:none;font-size:0.92rem;">
                Regresar al Inicio
            </a>
            <a href="javascript:history.back()" style="display:inline-flex;align-items:center;gap:0.5rem;padding:0.8rem 1.5rem;background:transparent;color:#FFFDF9;border:1px solid rgba(255,253,249,0.3);border-radius:12px;text-decoration:none;font-size:0.92rem;">
                Volver Atrás
            </a>
        </div>
    </div>
</div>
