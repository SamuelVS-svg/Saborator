@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    var _session = HttpContextAccessor.HttpContext?.Session;
    var _usuario = _session?.GetString("Usuario");
    var _rol = _session?.GetString("Rol") ?? "Cliente";
    if (string.IsNullOrWhiteSpace(_rol)) _rol = "Cliente";
    var _esAdmin = _rol == "Administrador";
}

<!-- ══════════════════════════════════════════════════════════════════════════
     ASISTENTE DE INTELIGENCIA ARTIFICIAL MULTI-ROL CON CARAS INTERACTIVAS
     BURBUJA FLOTANTE Y ARRASTRABLE (DRAGGABLE) CON MIRADA QUE SIGUE EL CURSOR
     CONTROL POR VOZ Y DESPERTAR POR NOMBRE ("WAKE ON NAME")
     ══════════════════════════════════════════════════════════════════════════ -->

<div id="saboratorAiWidget" class="ai-widget-container" data-rol="@_rol">

    <!-- BURBUJA FLOTANTE Y ARRASTRABLE -->
    <div id="aiFloatingBubble" class="ai-floating-bubble" title="Arrastra para mover · Haz clic para chatear · Di su nombre para hablar" role="button" tabindex="0" aria-label="Asistente de IA Saborator">
        <div class="ai-bubble-glow"></div>
        <div class="ai-drag-handle" title="Arrastrar">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="5" r="2"/><circle cx="12" cy="5" r="2"/><circle cx="19" cy="5" r="2"/><circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/><circle cx="5" cy="19" r="2"/><circle cx="12" cy="19" r="2"/><circle cx="19" cy="19" r="2"/></svg>
        </div>

        <!-- AVATAR SVG CON CARA INTERACTIVA Y OJOS QUE PERSIGUEN EL CURSOR -->
        <div class="ai-avatar-face-wrapper" id="aiAvatarFaceWrap">
            <!-- Inyectado dinámicamente según el rol por JS para máxima nitidez y rendimiento -->
        </div>

        <span class="ai-badge-status" id="aiBadgeStatus">
            <span class="ai-badge-dot"></span>
        </span>

        <!-- INDICADOR VISUAL DE MICRÓFONO EN LA BURBUJA -->
        <button type="button" id="aiBubbleMicBtn" class="ai-bubble-mic-btn" onclick="activarOAlternarVoz(event)" title="Activar control por voz (Di su nombre)">
            <svg id="aiBubbleMicIcon" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>
            <span class="ai-voice-wave" id="aiVoiceWave"></span>
        </button>

        <span class="ai-bubble-tooltip" id="aiBubbleTooltip">
            <strong id="aiTooltipName">Asistente IA</strong>
            <small id="aiTooltipRole">Especializado en tu rol</small>
            <span id="aiTooltipVoiceHint" class="ai-tooltip-voice-hint">🎤 Di su nombre para despertar</span>
        </span>
    </div>

    <!-- PANEL FLOTANTE DE CONVERSACIÓN -->
    <div id="aiChatPanel" class="ai-chat-panel" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="aiHeaderName">
        
        <!-- HEADER DEL CHAT -->
        <div class="ai-panel-header" id="aiPanelHeader">
            <div class="ai-header-info">
                <div class="ai-header-avatar" id="aiHeaderAvatarFace">
                    <!-- Mini cara interactiva con ojos que también siguen el cursor -->
                </div>
                <div class="ai-header-text">
                    <div class="ai-header-name-row">
                        <h4 id="aiHeaderName">Sabori</h4>
                        <span class="ai-role-pill" id="aiHeaderRolePill">Sommelier</span>
                    </div>
                    <div class="ai-header-status">
                        <span class="ai-pulse-green"></span>
                        <span id="aiHeaderStatusText">IA Especializada en Vivo</span>
                    </div>
                </div>
            </div>

            <div class="ai-header-actions">
                @if (_esAdmin)
                {
                    <!-- Selector de rol exclusivo para Administrador para probar cualquier asistente -->
                    <select id="aiSelectRolAdmin" class="ai-role-switcher" onchange="cambiarRolAsistente(this.value)" title="Modo de prueba de roles (Admin)">
                        <option value="Administrador">👔 Hermes (Admin)</option>
                        <option value="Cliente">🍽️ Sabori (Cliente)</option>
                        <option value="Mesero">🤵 Gastón (Mesero)</option>
                        <option value="Cocinero">👨‍🍳 Gusteau (Cocinero)</option>
                        <option value="Cajero">💰 Aurelio (Cajero)</option>
                    </select>
                }

                <!-- Botón de Silenciar / Escuchar Voz -->
                <button type="button" class="ai-btn-icon" id="aiBtnSpeaker" onclick="toggleVozRespuesta()" title="Silenciar / Activar voz del asistente">
                    <svg id="aiIconSpeakerOn" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>
                    <svg id="aiIconSpeakerOff" style="display:none;" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>
                </button>

                <!-- Botón Reiniciar Conversación -->
                <button type="button" class="ai-btn-icon" onclick="limpiarConversacionAi()" title="Reiniciar chat">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/></svg>
                </button>

                <!-- Botón Minimizar -->
                <button type="button" class="ai-btn-icon" onclick="cerrarChatAi()" title="Minimizar">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>
        </div>

        <!-- BANNER DE PERMISO Y ESTADO DE VOZ (WAKE-ON-NAME) -->
        <div id="aiVoiceStatusBanner" class="ai-voice-status-banner">
            <div class="ai-voice-banner-content">
                <div class="ai-voice-banner-icon" id="aiVoiceBannerIcon">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>
                </div>
                <div class="ai-voice-banner-text">
                    <strong id="aiVoiceBannerTitle">Control por voz disponible</strong>
                    <span id="aiVoiceBannerSub">Activa el micrófono para llamar al asistente por su nombre</span>
                </div>
                <button type="button" id="aiVoiceBannerBtnAction" class="ai-voice-banner-btn" onclick="activarOAlternarVoz(event)">
                    Activar
                </button>
            </div>
        </div>

        <!-- CUERPO DE MENSAJES -->
        <div class="ai-panel-body" id="aiChatMessages">
            <!-- Mensajes dinámicos generados por JS -->
        </div>

        <!-- BANNER DE SUGERENCIAS RÁPIDAS -->
        <div class="ai-suggestions-bar" id="aiSuggestionsBar">
            <!-- Chips inyectados por JS según el rol -->
        </div>

        <!-- FOOTER: INPUT DE CONSULTA CON MICRÓFONO -->
        <form class="ai-panel-footer" id="aiFormConsulta" onsubmit="enviarMensajeAi(event)">
            @Html.AntiForgeryToken()
            <button type="button" id="aiBtnMicFooter" class="ai-btn-mic" onclick="activarOAlternarVoz(event)" title="Hablar con tu voz o dictar pregunta" aria-label="Hablar por micrófono">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>
            </button>
            <input type="text" id="aiInputPregunta" class="ai-input" placeholder="Escribe o di su nombre en voz alta..." autocomplete="off" maxlength="300" />
            <button type="submit" id="aiBtnEnviar" class="ai-btn-send" aria-label="Enviar pregunta">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
            </button>
        </form>

        <div class="ai-footer-note">
            <span id="aiFooterNoteText">Parámetros delimitados y calibrados según rol asignado.</span>
        </div>

    </div>

    <!-- MODAL DE PERMISO PARA ACCESO AL MICRÓFONO -->
    <div class="ai-mic-permission-modal" id="aiMicPermModal" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="aiPermTitle">
        <div class="ai-perm-card">
            <div class="ai-perm-icon">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>
            </div>
            <h3 id="aiPermTitle">¿Deseas activar el control por voz?</h3>
            <p>
                Al permitir el acceso a tu micrófono podrás hablar directamente con tu asistente. Cuando digas en voz alta su nombre (ejemplo: <strong id="aiPermAssocName">"¡Sabori!"</strong> o <strong id="aiPermAssocExample">"Sabori, ¿qué recomiendas?"</strong>), responderá de inmediato.
            </p>
            <div class="ai-perm-security-box">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                <span>Tu voz se procesa de forma segura en tu navegador. No grabamos ni almacenamos archivos de audio.</span>
            </div>
            <div class="ai-perm-actions">
                <button type="button" id="btnPermisoAceptar" class="btn-perm-accept" onclick="confirmarPermisoMicrofono(event)">Permitir Micrófono</button>
                <button type="button" id="btnPermisoCancelar" class="btn-perm-cancel" onclick="cerrarPermisoMicrofono(event)">Cancelar</button>
            </div>
        </div>
    </div>

</div>

<!-- ════ ESTILOS AVANZADOS DEL WIDGET DE IA ════ -->
<style>
    .ai-widget-container {
        font-family: var(--font-sans, 'Geist', -apple-system, sans-serif);
        user-select: none;
        z-index: 9995;
    }

    /* BURBUJA FLOTANTE */
    .ai-floating-bubble {
        position: fixed;
        bottom: 92px;
        right: 24px;
        width: 62px;
        height: 62px;
        border-radius: 50%;
        background: #18060A;
        border: 2px solid #C8973A;
        box-shadow: 0 10px 28px rgba(0,0,0,0.4), 0 0 0 1px rgba(200,151,58,0.25);
        cursor: grab;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9998;
        touch-action: none;
        transition: transform 180ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 180ms ease, border-color 180ms ease;
    }
    .ai-floating-bubble:active {
        cursor: grabbing;
        transform: scale(0.96);
    }
    .ai-floating-bubble.is-dragging {
        cursor: grabbing;
        transform: scale(1.08);
        box-shadow: 0 16px 36px rgba(0,0,0,0.6), 0 0 20px rgba(200,151,58,0.5);
    }
    .ai-floating-bubble:hover {
        border-color: #E6B55C;
        box-shadow: 0 14px 34px rgba(0,0,0,0.5), 0 0 16px rgba(200,151,58,0.4);
    }

    /* Estado cuando está escuchando la voz */
    .ai-floating-bubble.is-listening {
        border-color: #10B981;
        box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.25), 0 14px 36px rgba(0,0,0,0.6);
        animation: aiVoicePulseRing 1.6s infinite ease-in-out;
    }
    @@keyframes aiVoicePulseRing {
        0%, 100% { box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.25), 0 14px 36px rgba(0,0,0,0.6); }
        50% { box-shadow: 0 0 0 10px rgba(16, 185, 129, 0.5), 0 18px 42px rgba(16, 185, 129, 0.4); }
    }

    .ai-bubble-glow {
        position: absolute;
        inset: -3px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(200,151,58,0.35) 0%, transparent 70%);
        animation: aiHaloPulse 3s infinite ease-in-out;
        pointer-events: none;
    }
    @@keyframes aiHaloPulse {
        0%, 100% { transform: scale(1); opacity: 0.5; }
        50% { transform: scale(1.18); opacity: 0.9; }
    }

    .ai-drag-handle {
        position: absolute;
        top: -6px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(24, 6, 10, 0.9);
        color: #C8973A;
        border: 1px solid rgba(200, 151, 58, 0.5);
        border-radius: 6px;
        padding: 1px 4px;
        opacity: 0;
        transition: opacity 160ms ease;
        pointer-events: none;
    }
    .ai-floating-bubble:hover .ai-drag-handle {
        opacity: 0.85;
    }

    .ai-avatar-face-wrapper {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        overflow: hidden;
    }
    .ai-avatar-face-wrapper svg {
        width: 54px;
        height: 54px;
        display: block;
    }

    /* BADGE STATUS */
    .ai-badge-status {
        position: absolute;
        bottom: 2px;
        right: 2px;
        width: 15px;
        height: 15px;
        border-radius: 50%;
        background: #18060A;
        border: 2px solid #18060A;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .ai-badge-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: #10B981;
        box-shadow: 0 0 6px #10B981;
        animation: aiBlinkDot 2s infinite ease-in-out;
    }
    @@keyframes aiBlinkDot {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.4; }
    }

    /* BOTÓN MICRÓFONO EN BURBUJA FLOTANTE */
    .ai-bubble-mic-btn {
        position: absolute;
        top: -2px;
        right: -2px;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: #1E070B;
        border: 1.5px solid #C8973A;
        color: #C8973A;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        padding: 0;
        transition: transform 140ms ease, background 140ms ease;
        z-index: 2;
    }
    .ai-bubble-mic-btn:hover {
        transform: scale(1.15);
        background: #C8973A;
        color: #18060A;
    }
    .ai-floating-bubble.is-listening .ai-bubble-mic-btn {
        background: #10B981;
        border-color: #10B981;
        color: #18060A;
        animation: micPulse 1.2s infinite ease-in-out;
    }
    @@keyframes micPulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.18); }
    }

    /* TOOLTIP EN HOVER */
    .ai-bubble-tooltip {
        position: absolute;
        right: 74px;
        background: rgba(24, 6, 10, 0.95);
        border: 1px solid rgba(200, 151, 58, 0.4);
        color: #FFFDF9;
        padding: 6px 12px;
        border-radius: 10px;
        font-size: 0.78rem;
        white-space: nowrap;
        pointer-events: none;
        opacity: 0;
        transform: translateX(8px);
        transition: opacity 0.2s ease, transform 0.2s ease;
        box-shadow: 0 8px 24px rgba(0,0,0,0.5);
        display: flex;
        flex-direction: column;
        line-height: 1.3;
    }
    .ai-bubble-tooltip small {
        color: #C8973A;
        font-size: 0.7rem;
    }
    .ai-tooltip-voice-hint {
        color: #10B981;
        font-size: 0.68rem;
        font-weight: 700;
        margin-top: 2px;
    }
    .ai-floating-bubble:hover .ai-bubble-tooltip {
        opacity: 1;
        transform: translateX(0);
    }

    /* OJOS INTERACTIVOS (MIRADA QUE SIGUE EL CURSOR) */
    .ai-pupil-group {
        transition: transform 60ms linear;
        transform-origin: center;
    }
    .ai-eye-blink {
        transform-origin: center;
        animation: aiAutoBlink 4.5s infinite ease-in-out;
    }
    @@keyframes aiAutoBlink {
        0%, 94%, 98%, 100% { transform: scaleY(1); }
        96% { transform: scaleY(0.08); }
    }

    /* ANIMACIÓN DE HABLAR (BOCA DEL AVATAR) */
    .ai-speaking .ai-mouth {
        animation: aiMouthTalk 0.24s infinite alternate ease-in-out;
        transform-origin: center;
    }
    @@keyframes aiMouthTalk {
        0% { transform: scaleY(0.8) scaleX(0.9); }
        100% { transform: scaleY(1.4) scaleX(1.1); }
    }

    /* PANEL FLOTANTE DE CHAT */
    .ai-chat-panel {
        position: fixed;
        bottom: 165px;
        right: 24px;
        width: 380px;
        max-width: calc(100vw - 32px);
        height: 540px;
        max-height: calc(100vh - 190px);
        background: #18060A;
        border: 1.5px solid rgba(200, 151, 58, 0.45);
        border-radius: 20px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.7), 0 0 1px rgba(255,255,255,0.2);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        z-index: 9997;
        backdrop-filter: blur(12px);
        animation: aiPanelOpen 240ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @@keyframes aiPanelOpen {
        0% { opacity: 0; transform: translateY(16px) scale(0.96); }
        100% { opacity: 1; transform: translateY(0) scale(1); }
    }

    /* HEADER */
    .ai-panel-header {
        background: rgba(32, 11, 16, 0.95);
        border-bottom: 1px solid rgba(200, 151, 58, 0.25);
        padding: 0.9rem 1.1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
    }
    .ai-header-info {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }
    .ai-header-avatar {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: #120406;
        border: 1.5px solid #C8973A;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 10px rgba(0,0,0,0.4);
    }
    .ai-header-avatar svg {
        width: 40px;
        height: 40px;
    }
    .ai-header-text h4 {
        margin: 0;
        font-size: 1rem;
        font-weight: 700;
        color: #FFFDF9;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }
    .ai-header-name-row {
        display: flex;
        align-items: center;
        gap: 0.45rem;
    }
    .ai-role-pill {
        font-size: 0.68rem;
        font-weight: 700;
        padding: 2px 7px;
        border-radius: 999px;
        background: rgba(200, 151, 58, 0.18);
        color: #C8973A;
        border: 1px solid rgba(200, 151, 58, 0.4);
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }
    .ai-header-status {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 0.73rem;
        color: rgba(255, 253, 249, 0.65);
        margin-top: 1px;
    }
    .ai-pulse-green {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #10B981;
        box-shadow: 0 0 5px #10B981;
    }
    .ai-header-actions {
        display: flex;
        align-items: center;
        gap: 0.35rem;
    }
    .ai-btn-icon {
        background: rgba(255, 253, 249, 0.06);
        border: 1px solid rgba(255, 253, 249, 0.12);
        color: rgba(255, 253, 249, 0.8);
        border-radius: 8px;
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 140ms ease;
    }
    .ai-btn-icon:hover {
        background: rgba(200, 151, 58, 0.2);
        color: #FFFDF9;
        border-color: #C8973A;
    }
    .ai-role-switcher {
        background: rgba(24, 6, 10, 0.9);
        border: 1px solid rgba(200, 151, 58, 0.4);
        color: #E6B55C;
        font-size: 0.72rem;
        font-weight: 600;
        border-radius: 8px;
        padding: 4px 6px;
        outline: none;
        cursor: pointer;
    }

    /* CUERPO MENSAJES */
    .ai-panel-body {
        flex: 1;
        overflow-y: auto;
        padding: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
        background: #18060A;
        scrollbar-width: thin;
        scrollbar-color: rgba(200, 151, 58, 0.3) transparent;
    }
    .ai-panel-body::-webkit-scrollbar { width: 5px; }
    .ai-panel-body::-webkit-scrollbar-thumb { background: rgba(200, 151, 58, 0.3); border-radius: 4px; }

    /* BURBUJAS DE MENSAJE */
    .ai-msg {
        display: flex;
        flex-direction: column;
        max-width: 86%;
        animation: aiMsgIn 180ms ease forwards;
    }
    @@keyframes aiMsgIn {
        0% { opacity: 0; transform: translateY(6px); }
        100% { opacity: 1; transform: translateY(0); }
    }
    .ai-msg.user {
        align-self: flex-end;
    }
    .ai-msg.assistant {
        align-self: flex-start;
    }
    .ai-msg-bubble {
        padding: 0.75rem 0.95rem;
        border-radius: 14px;
        font-size: 0.86rem;
        line-height: 1.45;
        color: #FFFDF9;
        word-break: break-word;
    }
    .ai-msg.user .ai-msg-bubble {
