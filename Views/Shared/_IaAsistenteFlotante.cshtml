    // ─────────────────────────────────────────────────────────────────────────
    // FÍSICA Y TRIGONOMETRÍA: LA MIRADA PERSIGUE EL CURSOR
    // ─────────────────────────────────────────────────────────────────────────
    function actualizarMiradaOjos(e) {
        const clientX = e.clientX;
        const clientY = e.clientY;
        const ojos = document.querySelectorAll('.ai-interactive-eye');

        ojos.forEach(ojo => {
            const rect = ojo.getBoundingClientRect();
            const centroX = rect.left + rect.width / 2;
            const centroY = rect.top + rect.height / 2;

            const dx = clientX - centroX;
            const dy = clientY - centroY;
            const angulo = Math.atan2(dy, dx);
            const distancia = Math.hypot(dx, dy);

            const maxRadio = parseFloat(ojo.getAttribute('data-max-r') || '4.2');
            const radioCalculado = Math.min(maxRadio, distancia / 28);

            const pupilGroup = ojo.querySelector('.ai-pupil-group');
            if (pupilGroup) {
                const posX = Math.cos(angulo) * radioCalculado;
                const posY = Math.sin(angulo) * radioCalculado;
                pupilGroup.style.transform = `translate(${posX.toFixed(1)}px, ${posY.toFixed(1)}px)`;
            }
        });
    }

    window.addEventListener('mousemove', actualizarMiradaOjos, { passive: true });

    document.addEventListener('mouseleave', () => {
        document.querySelectorAll('.ai-pupil-group').forEach(p => {
            p.style.transform = 'translate(0px, 0px)';
        });
    });

    // ─────────────────────────────────────────────────────────────────────────
    // ARRASTRE LIBRE (DRAGGING) DE LA BURBUJA FLOTANTE
    // ─────────────────────────────────────────────────────────────────────────
    const bubble = document.getElementById('aiFloatingBubble');

    function inicializarPosicionBurbuja() {
        const guardadaX = localStorage.getItem('saborator_ai_pos_x');
        const guardadaY = localStorage.getItem('saborator_ai_pos_y');

        if (guardadaX !== null && guardadaY !== null) {
            const x = Math.min(Math.max(10, parseInt(guardadaX)), window.innerWidth - 72);
            const y = Math.min(Math.max(10, parseInt(guardadaY)), window.innerHeight - 72);
            bubble.style.left = x + 'px';
            bubble.style.top = y + 'px';
            bubble.style.right = 'auto';
            bubble.style.bottom = 'auto';
        }
    }

    function onPointerDown(e) {
        if (e.button !== undefined && e.button !== 0) return;
        // Evitar arrastre si hace clic sobre el botón de micrófono pequeño
        if (e.target.closest('#aiBubbleMicBtn')) return;

        isDragging = false;
        dragStartTime = Date.now();

        const clientX = e.touches ? e.touches[0].clientX : e.clientX;
        const clientY = e.touches ? e.touches[0].clientY : e.clientY;

        startX = clientX;
        startY = clientY;

        const rect = bubble.getBoundingClientRect();
        initialLeft = rect.left;
        initialTop = rect.top;

        window.addEventListener('mousemove', onPointerMove, { passive: false });
        window.addEventListener('mouseup', onPointerUp);
        window.addEventListener('touchmove', onPointerMove, { passive: false });
        window.addEventListener('touchend', onPointerUp);
    }

    function onPointerMove(e) {
        const clientX = e.touches ? e.touches[0].clientX : e.clientX;
        const clientY = e.touches ? e.touches[0].clientY : e.clientY;

        const deltaX = clientX - startX;
        const deltaY = clientY - startY;

        if (Math.hypot(deltaX, deltaY) > 5) {
            isDragging = true;
            bubble.classList.add('is-dragging');
            if (e.cancelable) e.preventDefault();

            let nuevoX = initialLeft + deltaX;
            let nuevoY = initialTop + deltaY;

            const pad = 8;
            nuevoX = Math.max(pad, Math.min(window.innerWidth - bubble.offsetWidth - pad, nuevoX));
            nuevoY = Math.max(pad, Math.min(window.innerHeight - bubble.offsetHeight - pad, nuevoY));

            bubble.style.left = nuevoX + 'px';
            bubble.style.top = nuevoY + 'px';
            bubble.style.right = 'auto';
            bubble.style.bottom = 'auto';
        }
    }

    function onPointerUp(e) {
        window.removeEventListener('mousemove', onPointerMove);
        window.removeEventListener('mouseup', onPointerUp);
        window.removeEventListener('touchmove', onPointerMove);
        window.removeEventListener('touchend', onPointerUp);

        bubble.classList.remove('is-dragging');

        if (isDragging) {
            const rect = bubble.getBoundingClientRect();
            localStorage.setItem('saborator_ai_pos_x', Math.round(rect.left));
            localStorage.setItem('saborator_ai_pos_y', Math.round(rect.top));
        } else {
            toggleChatAi();
        }
    }

    bubble.addEventListener('mousedown', onPointerDown);
    bubble.addEventListener('touchstart', onPointerDown, { passive: true });

    // ─────────────────────────────────────────────────────────────────────────
    // SISTEMA DE CONTROL POR VOZ: PERMISOS, RECONOCIMIENTO & WAKE ON NAME
    // ─────────────────────────────────────────────────────────────────────────
    const SpeechRec = window.SpeechRecognition || window.webkitSpeechRecognition;

    function desbloquearAudio() {
        try {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
        } catch(e) {}
    }

    function reproducirChimeWake() {
        try {
            desbloquearAudio();
            if (!audioCtx) return;
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(587.33, audioCtx.currentTime); // D5
            osc.frequency.exponentialRampToValueAtTime(880, audioCtx.currentTime + 0.12); // A5
            gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.35);
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            osc.start();
            osc.stop(audioCtx.currentTime + 0.35);
        } catch(e) {}
    }

    window.solicitarPermisoVoz = function(e) {
        activarOAlternarVoz(e);
    };

    window.cerrarPermisoMicrofono = function() {
        const modal = document.getElementById('aiMicPermModal');
        if (modal) modal.style.display = 'none';
    };

    window.confirmarPermisoMicrofono = function(e) {
        cerrarPermisoMicrofono();
        activarOAlternarVoz(e, true);
    };

    window.activarOAlternarVoz = async function(e, forzarInicio = false) {
        if (e) {
            e.stopPropagation();
            e.preventDefault();
        }

        desbloquearAudio();

        // Si ya está activo y no se fuerza inicio, pausar
        if (reconocimientoActivo && !forzarInicio) {
            detenerEscuchaVoz();
            if (window.showToast) showToast('ok', 'Escucha por voz en pausa.');
            return;
        }

        if (!SpeechRec) {
            alert('Tu navegador no tiene activado el reconocimiento de voz Web Speech. Recomendamos usar Google Chrome, Microsoft Edge, Opera o Safari.');
            actualizarEstadoVisualMic(false);
            return;
        }

        // Feedback inmediato en el botón para responder al clic sin demoras
        const bannerBtn = document.getElementById('aiVoiceBannerBtnAction');
        if (bannerBtn) {
            bannerBtn.textContent = 'Activando...';
            bannerBtn.style.opacity = '0.7';
        }

        try {
            // Solicitar acceso al micrófono si el navegador lo requiere
            if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
                try {
                    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                    // No detener agresivamente para no trabar el dispositivo en Windows
                    setTimeout(() => {
                        try { stream.getTracks().forEach(t => t.stop()); } catch(e) {}
                    }, 600);
                } catch(mediaErr) {
                    console.warn('getUserMedia denegado o no disponible:', mediaErr);
                    if (mediaErr.name === 'NotAllowedError' || mediaErr.name === 'PermissionDeniedError') {
                        localStorage.removeItem('saborator_mic_enabled');
                        actualizarEstadoVisualMic(false);
                        if (window.showToast) {
                            showToast('err', 'Acceso al micrófono denegado. Permite el micrófono en el candado 🔒 de la barra de direcciones.');
                        }
                        return;
                    }
                }
            }

            localStorage.setItem('saborator_mic_enabled', 'true');
            iniciarEscuchaVoz(true);
        } catch(err) {
            console.error('Error al activar el micrófono:', err);
            actualizarEstadoVisualMic(false);
        }
    };

    window.toggleReconocimientoVoz = function(e) {
        activarOAlternarVoz(e);
    };

    function iniciarEscuchaVoz(showFeedback = false) {
        if (!SpeechRec) {
            actualizarEstadoVisualMic(false);
            return;
        }

        try {
            if (recognitionInstance) {
                recognitionInstance.onstart = null;
                recognitionInstance.onerror = null;
                recognitionInstance.onend = null;
                recognitionInstance.onresult = null;
                try { recognitionInstance.abort(); } catch(e) {}
                recognitionInstance = null;
            }

            const rec = new SpeechRec();
            recognitionInstance = rec;
            rec.continuous = true;
            rec.interimResults = true;
            rec.lang = (navigator.language && navigator.language.startsWith('es')) ? navigator.language : 'es-CO';
            rec.maxAlternatives = 3;

            rec.onstart = () => {
                reconocimientoActivo = true;
                actualizarEstadoVisualMic(true);
                reproducirChimeWake();
                const nom = infoPersonaActual ? infoPersonaActual.nombre : 'Sabori';
                if (showFeedback && window.showToast) {
                    showToast('ok', `🎤 Asistente escuchando en vivo. Di "${nom}" en voz alta.`);
                }
            };

            rec.onresult = (event) => {
                if (esAssistantHablando) return; // Evitar que el asistente se auto-escuche

                const results = event.results;
                if (!results || results.length === 0) return;

                let textoDetectado = '';
                for (let i = event.resultIndex; i < results.length; i++) {
                    if (results[i] && results[i][0] && results[i][0].transcript) {
                        textoDetectado += ' ' + results[i][0].transcript;
                    }
                }
                textoDetectado = textoDetectado.trim();
                if (!textoDetectado) return;

                // Feedback visual en tiempo real de lo que el micrófono escucha
                actualizarFeedbackEnVivoVoz(textoDetectado);

                // Evaluar si contiene la palabra clave para despertar
                procesarTranscripcionVoz(textoDetectado);
            };

            rec.onerror = (event) => {
                console.warn('SpeechRecognition error:', event.error);
                if (event.error === 'not-allowed' || event.error === 'service-not-allowed') {
                    reconocimientoActivo = false;
                    localStorage.removeItem('saborator_mic_enabled');
                    actualizarEstadoVisualMic(false);
                    if (window.showToast) {
                        showToast('err', 'El navegador bloqueó el micrófono. Permítelo en el icono del candado 🔒.');
                    }
                } else if (event.error === 'audio-capture') {
                    reconocimientoActivo = false;
                    actualizarEstadoVisualMic(false);
                    if (window.showToast) {
                        showToast('err', 'No se detectó dispositivo de micrófono conectado.');
                    }
                }
            };

            rec.onend = () => {
                // Si el permiso sigue activo y no se detuvo intencionalmente, reiniciar
                const activoDeseado = localStorage.getItem('saborator_mic_enabled') === 'true';
                if (activoDeseado && reconocimientoActivo) {
                    setTimeout(() => {
                        if (localStorage.getItem('saborator_mic_enabled') === 'true' && reconocimientoActivo) {
                            try {
                                rec.start();
                            } catch(e) {
                                iniciarEscuchaVoz(false);
                            }
                        }
                    }, 350);
                } else {
                    actualizarEstadoVisualMic(false);
                }
            };

            rec.start();
        } catch(e) {
            console.error('Error iniciando SpeechRecognition:', e);
            actualizarEstadoVisualMic(false);
        }
    }

    function detenerEscuchaVoz() {
        reconocimientoActivo = false;
        localStorage.removeItem('saborator_mic_enabled');
        if (recognitionInstance) {
            recognitionInstance.onstart = null;
            recognitionInstance.onerror = null;
            recognitionInstance.onend = null;
            recognitionInstance.onresult = null;
            try { recognitionInstance.abort(); } catch(e) {}
            recognitionInstance = null;
        }
        actualizarEstadoVisualMic(false);
    }

    function actualizarFeedbackEnVivoVoz(texto) {
        if (!texto) return;
        const bannerSub = document.getElementById('aiVoiceBannerSub');
        const hint = document.getElementById('aiTooltipVoiceHint');
        const resumen = texto.length > 32 ? texto.substring(0, 30) + '...' : texto;

        if (bannerSub) {
            bannerSub.textContent = `👂 Escuchando: "${resumen}"`;
        }
        if (hint) {
            hint.textContent = `🟢 "${resumen}"`;
        }
    }

    function actualizarEstadoVisualMic(activo) {
        const bubble = document.getElementById('aiFloatingBubble');
        const btnMicFooter = document.getElementById('aiBtnMicFooter');
        const hint = document.getElementById('aiTooltipVoiceHint');
        const banner = document.getElementById('aiVoiceStatusBanner');
        const bannerTitle = document.getElementById('aiVoiceBannerTitle');
        const bannerSub = document.getElementById('aiVoiceBannerSub');
        const bannerBtn = document.getElementById('aiVoiceBannerBtnAction');
        const nombre = infoPersonaActual ? infoPersonaActual.nombre : 'Sabori';

        if (activo) {
            if (bubble) bubble.classList.add('is-listening');
            if (btnMicFooter) btnMicFooter.classList.add('is-active');
            if (hint) hint.textContent = `🟢 Escuchando... Di "${nombre}"`;

            if (banner) {
                banner.style.display = 'block';
                banner.classList.add('is-active');
                if (bannerTitle) bannerTitle.textContent = `Escuchando en vivo · Di "${nombre}"`;
                if (bannerSub) bannerSub.textContent = `Pronuncia su nombre en cualquier momento para hablar`;
                if (bannerBtn) {
                    bannerBtn.textContent = 'Pausar';
                    bannerBtn.style.opacity = '1';
                }
            }
        } else {
            if (bubble) bubble.classList.remove('is-listening');
            if (btnMicFooter) btnMicFooter.classList.remove('is-active');
            if (hint) hint.textContent = `🎤 Di "${nombre}" para despertar`;

            if (banner) {
                banner.style.display = 'block';
                banner.classList.remove('is-active');
                if (bannerTitle) bannerTitle.textContent = `Activar respuesta por voz (${nombre})`;
                if (bannerSub) bannerSub.textContent = `Haz clic en Activar para que responda cuando lo llames`;
                if (bannerBtn) {
                    bannerBtn.textContent = 'Activar';
                    bannerBtn.style.opacity = '1';
                }
            }
        }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // DETECCIÓN DE PALABRA CLAVE (WAKE WORD) Y PREGUNTAS
    // ─────────────────────────────────────────────────────────────────────────
    let ultimoWakeTime = 0;
    let esAssistantHablando = false;

    function normalizarTexto(txt) {
        return (txt || '')
            .toLowerCase()
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '') // Quitar tildes
            .replace(/[¿?¡!.,;:_()\-]/g, ' ')
            .trim();
    }

    function procesarTranscripcionVoz(frase) {
        if (!frase || esAssistantHablando) return false;
        const ahora = Date.now();
        // Cooldown de 3.2s para evitar múltiples disparos sobre la misma locución
        if (ahora - ultimoWakeTime < 3200) return false;

        const norm = normalizarTexto(frase);
        const actualNom = infoPersonaActual ? infoPersonaActual.nombre : 'Sabori';

        // Comprobación de todas las palabras clave y nombres de asistentes
        let nombreDetectado = null;

        // Cliente: Sabori (y variantes comunes de transcripción en español)
        if (norm.includes('sabori') || norm.includes('sabor y') || norm.includes('sabory') || norm.includes('saborator') || norm.includes('sabor')) {
            nombreDetectado = 'Sabori';
        }
        // Administrador: Hermes
        else if (norm.includes('hermes') || norm.includes('ermes')) {
            nombreDetectado = 'Hermes';
        }
        // Mesero: Gastón
        else if (norm.includes('gaston')) {
            nombreDetectado = 'Gastón';
        }
        // Cocinero: Gusteau
        else if (norm.includes('gusteau') || norm.includes('gusto') || norm.includes('gusteo') || norm.includes('chef')) {
            nombreDetectado = 'Gusteau';
        }
        // Cajero: Aurelio
        else if (norm.includes('aurelio')) {
            nombreDetectado = 'Aurelio';
        }
        // Universal: Asistente / Oye / Hola
        else if (norm.includes('asistente') || norm.includes('asistenta') || norm.includes('oye') || norm.includes('hola')) {
            nombreDetectado = actualNom;
        }

        if (!nombreDetectado) return false;

        ultimoWakeTime = ahora;

        // Feedback inmediato: timbre de despertar y apertura del chat
        reproducirChimeWake();
        if (!chatAbierto) abrirChatAi();

        const bannerTitle = document.getElementById('aiVoiceBannerTitle');
        const bannerSub = document.getElementById('aiVoiceBannerSub');
        if (bannerTitle) bannerTitle.textContent = `¡Hola! Despertaste a ${nombreDetectado}`;
        if (bannerSub) bannerSub.textContent = `Asistente listo y respondiendo en vivo`;

        if (window.showToast) {
            showToast('ok', `✨ ¡${nombreDetectado} activado por tu voz!`);
        }

        // Limpiar las palabras de activación para detectar si el usuario formuló una pregunta
        const regexLimpiar = /\b(sabori|sabor y|sabory|saborator|sabor|hermes|ermes|gaston|gusteau|gusto|gusteo|chef|aurelio|asistente|asistenta|oye|hola|por favor|dime)\b/gi;
        const consultaLimpia = norm.replace(regexLimpiar, '').replace(/\s+/g, ' ').trim();

        if (consultaLimpia.length >= 3) {
            // El usuario hizo una pregunta directa junto con el nombre (ej. "Sabori, ¿cuál es el precio de la hamburguesa?")
            const input = document.getElementById('aiInputPregunta');
            if (input) {
                input.value = frase;
                document.getElementById('aiFormConsulta').dispatchEvent(new Event('submit'));
            }
        } else {
            // El usuario solo llamó al asistente por su nombre
            const respuestasSaludo = [
                `¡Hola! Soy ${nombreDetectado}. Te escucho con atención, ¿en qué te colaboro hoy?`,
                `¡A la orden! Aquí estoy para ayudarte. ¿Qué deseas saber o pedir?`,
                `¡Hola! Dime qué necesitas y con gusto te colaboro.`
            ];
            const saludoElegido = respuestasSaludo[Math.floor(Math.random() * respuestasSaludo.length)];
            agregarMensajeChat('assistant', saludoElegido);
            hablarTextoConSintesis(saludoElegido);
        }

        return true;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // SÍNTESIS DE VOZ (TEXT-TO-SPEECH)
    // ─────────────────────────────────────────────────────────────────────────
    function hablarTextoConSintesis(texto) {
        if (!vozHabilitada || !synth) return;

        try {
            synth.cancel();
            if (synth.resume) synth.resume();

            // Limpiar texto de etiquetas y markdown
            const textoLimpio = texto
                .replace(/\*\*(.*?)\*\*/g, '$1')
                .replace(/\*(.*?)\*/g, '$1')
                .replace(/\[(.*?)\]\(.*?\)/g, '$1')
                .replace(/[•#\-*]+/g, ' ')
                .replace(/https?:\/\/\S+/g, '')
                .trim();

            const utterance = new SpeechSynthesisUtterance(textoLimpio);
            utterance.lang = 'es-CO';
            utterance.rate = 1.05;
            utterance.pitch = 1.0;

            const voces = synth.getVoices();
            if (voces && voces.length > 0) {
                const vozEs = voces.find(v => v.lang.startsWith('es-CO')) ||
                              voces.find(v => v.lang.startsWith('es-MX')) ||
                              voces.find(v => v.lang.startsWith('es'));
                if (vozEs) utterance.voice = vozEs;
            }

            const wrap = document.getElementById('aiAvatarFaceWrap');
            esAssistantHablando = true;

            utterance.onstart = () => {
                if (wrap) wrap.classList.add('ai-speaking');
            };
            utterance.onend = utterance.onerror = () => {
                if (wrap) wrap.classList.remove('ai-speaking');
                setTimeout(() => { esAssistantHablando = false; }, 500);
            };

            synth.speak(utterance);
        } catch(e) {
            esAssistantHablando = false;
            console.error('Error en síntesis de voz:', e);
        }
    }

    window.toggleVozRespuesta = function() {
        vozHabilitada = !vozHabilitada;
        const iconOn = document.getElementById('aiIconSpeakerOn');
        const iconOff = document.getElementById('aiIconSpeakerOff');

        if (vozHabilitada) {
            if (iconOn) iconOn.style.display = 'block';
            if (iconOff) iconOff.style.display = 'none';
            if (window.showToast) showToast('ok', 'Voz del asistente activada.');
        } else {
            if (iconOn) iconOn.style.display = 'none';
            if (iconOff) iconOff.style.display = 'block';
            if (synth) synth.cancel();
            if (window.showToast) showToast('ok', 'Voz del asistente silenciada.');
        }
    };

    // ─────────────────────────────────────────────────────────────────────────
    // CHAT: CARGA DE PERSONA Y METADATOS
    // ─────────────────────────────────────────────────────────────────────────
    async function cargarInformacionPersona(rol) {
        try {
            const res = await fetch(`/api/ia/info?rolOverride=${encodeURIComponent(rol)}`);
            const json = await res.json();
            if (json.ok && json.data) {
                infoPersonaActual = json.data;
                actualizarVisualesPersona(infoPersonaActual);
            }
        } catch (err) {
            console.error('Error cargando info de IA:', err);
        }
    }

    function actualizarVisualesPersona(info) {
        const faceSvgBig = generarSvgCara(info.codigoRol, 54);
        const faceSvgHeader = generarSvgCara(info.codigoRol, 40);

        document.getElementById('aiAvatarFaceWrap').innerHTML = faceSvgBig;
        document.getElementById('aiHeaderAvatarFace').innerHTML = faceSvgHeader;

        document.getElementById('aiHeaderName').textContent = info.nombre;
        document.getElementById('aiHeaderRolePill').textContent = info.titulo;
        document.getElementById('aiTooltipName').textContent = info.nombre;
        document.getElementById('aiTooltipRole').textContent = info.titulo;

        renderSugerencias(info.sugerenciasIniciales || []);

        if (historialChat.length === 0) {
            agregarMensajeChat('assistant', `${info.saludo} ${info.descripcion}`);
        }
    }

    function renderSugerencias(sugerencias) {
        const bar = document.getElementById('aiSuggestionsBar');
        bar.innerHTML = '';
        sugerencias.forEach(sug => {
            const chip = document.createElement('button');
            chip.type = 'button';
            chip.className = 'ai-chip-sugerencia';
            chip.textContent = sug;
            chip.onclick = () => {
                document.getElementById('aiInputPregunta').value = sug.replace(/^[^\w\s¿?]+/, '').trim();
                document.getElementById('aiFormConsulta').dispatchEvent(new Event('submit'));
            };
            bar.appendChild(chip);
        });
    }

    // ─────────────────────────────────────────────────────────────────────────
    // ABRIR / CERRAR PANEL DE CHAT Y POSICIONAMIENTO
    // ─────────────────────────────────────────────────────────────────────────
    function toggleChatAi() {
        if (chatAbierto) cerrarChatAi();
        else abrirChatAi();
    }

    function abrirChatAi() {
        const panel = document.getElementById('aiChatPanel');
        panel.style.display = 'flex';
        chatAbierto = true;

        const bRect = bubble.getBoundingClientRect();
        const pWidth = 380;
        const pHeight = 540;

        let left = bRect.left - pWidth + 60;
        let top = bRect.top - pHeight - 14;

        if (left < 10) left = 10;
        if (left + pWidth > window.innerWidth - 10) left = window.innerWidth - pWidth - 10;
        if (top < 10) top = bRect.bottom + 14;

        panel.style.left = left + 'px';
        panel.style.top = top + 'px';
        panel.style.right = 'auto';
        panel.style.bottom = 'auto';

        document.getElementById('aiInputPregunta').focus();
    }

    function cerrarChatAi() {
        const panel = document.getElementById('aiChatPanel');
        panel.style.display = 'none';
        chatAbierto = false;
        if (synth) synth.cancel();
    }

    window.cerrarChatAi = cerrarChatAi;
    window.toggleChatAi = toggleChatAi;

    // ─────────────────────────────────────────────────────────────────────────
    // ENVÍO DE MENSAJES Y RESPUESTA DEL BACKEND
    // ─────────────────────────────────────────────────────────────────────────
    async function enviarMensajeAi(e) {
        e.preventDefault();
        const input = document.getElementById('aiInputPregunta');
        const texto = input.value.trim();
        if (!texto) return;

        input.value = '';
        agregarMensajeChat('user', texto);

        const typingEl = mostrarTypingIndicator();

        try {
            const payload = {
                mensaje: texto,
                rol: rolActual,
                historial: historialChat.slice(-6)
            };

            const res = await fetch('/api/ia/consultar', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            const data = await res.json();
            removerTypingIndicator(typingEl);

            if (data.ok) {
                agregarMensajeChat('assistant', data.respuesta, data.enlaceAccion, data.textoAccion, data.pasosRazonamiento, data.intencionDetectada);
                hablarTextoConSintesis(data.respuesta);
                if (data.sugerencias && data.sugerencias.length > 0) {
                    renderSugerencias(data.sugerencias);
                }
            } else {
                agregarMensajeChat('assistant', 'Lo siento, hubo un inconveniente al procesar tu consulta. Intenta nuevamente.');
            }
        } catch (err) {
            removerTypingIndicator(typingEl);
            agregarMensajeChat('assistant', 'Hubo un error de conexión con el motor de IA. Por favor verifica tu red.');
        }
    }

    window.enviarMensajeAi = enviarMensajeAi;

    function agregarMensajeChat(remitente, texto, enlaceAccion = null, textoAccion = null, pasosRazonamiento = null, intencionDetectada = null) {
        historialChat.push({ remitente, contenido: texto, timestamp: new Date() });
        const box = document.getElementById('aiChatMessages');

        const msgDiv = document.createElement('div');
        msgDiv.className = `ai-msg ${remitente}`;

        const bubbleDiv = document.createElement('div');
        bubbleDiv.className = 'ai-msg-bubble';

        // Si es respuesta del Asistente y cuenta con Pasos de Razonamiento Cognitivo (Chain of Thought)
        if (remitente === 'assistant' && pasosRazonamiento && pasosRazonamiento.length > 0) {
            const reasoningBox = document.createElement('div');
            reasoningBox.className = 'ai-reasoning-wrap';

            const toggleBtn = document.createElement('div');
            toggleBtn.className = 'ai-reasoning-toggle';
            const escapar = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
            toggleBtn.innerHTML = `
                <span style="display:flex;align-items:center;gap:5px;">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                    <span>Razonamiento: ${escapar(intencionDetectada || 'Análisis Cognitivo')}</span>
                </span>
                <span class="ai-reasoning-chevron">▼</span>
            `;

            const stepsContainer = document.createElement('div');
            stepsContainer.className = 'ai-reasoning-steps';
            stepsContainer.style.display = 'block'; // Abierto para transparencia analítica

            pasosRazonamiento.forEach((p, i) => {
                const stepRow = document.createElement('div');
                stepRow.className = 'ai-reasoning-step-item';
                stepRow.style.opacity = '0';
                stepRow.style.transform = 'translateY(4px)';
                stepRow.style.transition = 'opacity 260ms ease, transform 260ms ease';
                const dot = document.createElement('span');
                dot.className = 'ai-reasoning-step-dot';
                dot.textContent = '›';
                const txt = document.createElement('span');
                txt.textContent = p;   // textContent: el mensaje del usuario nunca se interpreta como HTML
                stepRow.appendChild(dot);
                stepRow.appendChild(txt);
                stepsContainer.appendChild(stepRow);
                setTimeout(() => { stepRow.style.opacity = '1'; stepRow.style.transform = 'none'; }, 120 + i * 220);
            });

            toggleBtn.onclick = () => {
                const isOpen = stepsContainer.style.display !== 'none';
                stepsContainer.style.display = isOpen ? 'none' : 'block';
                const chevron = toggleBtn.querySelector('.ai-reasoning-chevron');
                if (chevron) chevron.textContent = isOpen ? '▶' : '▼';
            };

            reasoningBox.appendChild(toggleBtn);
            reasoningBox.appendChild(stepsContainer);
            bubbleDiv.appendChild(reasoningBox);
        }

        let htmlParsed = texto
            .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
            .replace(/\*(.*?)\*/g, '<em>$1</em>')
            .replace(/\n/g, '<br/>');

        const textContentDiv = document.createElement('div');
        textContentDiv.className = 'ai-msg-text-content';
        textContentDiv.innerHTML = htmlParsed;
        bubbleDiv.appendChild(textContentDiv);

        if (enlaceAccion && textoAccion) {
            const btn = document.createElement('a');
            btn.className = 'ai-action-btn';
            btn.href = enlaceAccion;
            btn.innerHTML = `<span>${textoAccion}</span> <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>`;
            bubbleDiv.appendChild(btn);
        }

        const timeSpan = document.createElement('span');
        timeSpan.className = 'ai-msg-time';
        const d = new Date();
        timeSpan.textContent = d.getHours().toString().padStart(2, '0') + ':' + d.getMinutes().toString().padStart(2, '0');

        msgDiv.appendChild(bubbleDiv);
        msgDiv.appendChild(timeSpan);
        box.appendChild(msgDiv);

        box.scrollTop = box.scrollHeight;
    }

    function mostrarTypingIndicator() {
        const box = document.getElementById('aiChatMessages');
        const el = document.createElement('div');
        el.className = 'ai-typing-indicator';
        el.id = 'aiTypingInd';
        el.innerHTML = '<span class="ai-typing-dot"></span><span class="ai-typing-dot"></span><span class="ai-typing-dot"></span>';
        box.appendChild(el);
        box.scrollTop = box.scrollHeight;
        return el;
    }

    function removerTypingIndicator(el) {
        if (el && el.parentNode) {
            el.parentNode.removeChild(el);
        }
    }

    window.limpiarConversacionAi = function() {
        historialChat = [];
        if (synth) synth.cancel();
        document.getElementById('aiChatMessages').innerHTML = '';
        if (infoPersonaActual) {
            agregarMensajeChat('assistant', `${infoPersonaActual.saludo} ${infoPersonaActual.descripcion}`);
            renderSugerencias(infoPersonaActual.sugerenciasIniciales || []);
        }
    };

    window.cambiarRolAsistente = function(nuevoRol) {
        rolActual = nuevoRol;
        limpiarConversacionAi();
        cargarInformacionPersona(nuevoRol);
    };

    // Inicialización al cargar el DOM
    document.addEventListener('DOMContentLoaded', () => {
        inicializarPosicionBurbuja();
        cargarInformacionPersona(rolActual);

        actualizarEstadoVisualMic(false);

        // Si ya tenía el permiso habilitado, reanudar al primer gesto/clic del usuario
        if (localStorage.getItem('saborator_mic_enabled') === 'true') {
            const reanudarAlInteractuar = () => {
                document.removeEventListener('click', reanudarAlInteractuar);
                document.removeEventListener('keydown', reanudarAlInteractuar);
                if (localStorage.getItem('saborator_mic_enabled') === 'true' && !reconocimientoActivo) {
                    desbloquearAudio();
                    iniciarEscuchaVoz(false);
                }
            };
            document.addEventListener('click', reanudarAlInteractuar, { once: true });
            document.addEventListener('keydown', reanudarAlInteractuar, { once: true });
        }
    });

})();
</script>
