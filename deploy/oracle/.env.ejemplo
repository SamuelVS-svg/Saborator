# Copia este archivo como ".env" en la misma carpeta y complétalo. NUNCA subas el .env a GitHub.

# Dominio gratuito que apunta a la IP pública de tu VM (por ejemplo, tu-restaurante.duckdns.org)
DOMINIO=tu-restaurante.duckdns.org

# ── Wompi (llaves de PRUEBAS para la exposición: pub_test_ / prv_test_ / test_events_ / test_integrity_) ──
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
# Solo para demostraciones en sandbox. Déjalo en false si usas llaves de producción.
WOMPI_PERMITIR_SIMULACION=true

# ── Correo (SMTP) y mensajes (Twilio): opcionales; sin ellos no se envían códigos ni comprobantes ──
Smtp__Servidor=smtp.gmail.com
Smtp__Puerto=587
Smtp__Usuario=
Smtp__Remitente=
Smtp__Contrasena=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
