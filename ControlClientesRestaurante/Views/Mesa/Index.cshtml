@model List<ControlClientesRestaurante.Services.MesaDetalleDto>
@{
    ViewData["Title"] = "Control de Mesas";
    Layout = "_Layout";
    var filtro = ViewBag.FiltroActual as string ?? "Todas";
    var total = (int)(ViewBag.Total ?? 30);
    var libres = (int)(ViewBag.Libres ?? 0);
    var ocupadas = (int)(ViewBag.Ocupadas ?? 0);
    var reservadas = (int)(ViewBag.Reservadas ?? 0);
    var enLimpieza = (int)(ViewBag.EnLimpieza ?? 0);
}

<style>
    /* ── PALETA & ESTILOS GESTIÓN DE MESAS ── */
    .mesas-dashboard {
        max-width: 1400px;
        margin: 0 auto;
        padding: 1.5rem 1rem 3rem;
    }

    /* Encabezado */
    .md-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 1.25rem;
        margin-bottom: 2rem;
        background: linear-gradient(135deg, var(--brand, #6B1E2E) 0%, #4A121E 100%);
        color: #FFFDF9;
        padding: 2rem 2.25rem;
        border-radius: var(--r-card, 16px);
        box-shadow: 0 10px 30px rgba(107, 30, 46, 0.15);
        position: relative;
        overflow: hidden;
    }
    .md-header::after {
        content: '';
        position: absolute;
        top: -60px;
        right: -60px;
        width: 220px;
        height: 220px;
        background: radial-gradient(circle, rgba(200, 151, 58, 0.2) 0%, transparent 70%);
        border-radius: 50%;
        pointer-events: none;
    }
    .md-header-title {
        font-family: var(--font-serif, 'Instrument Serif', Georgia, serif);
        font-size: clamp(2rem, 3.2vw, 2.7rem);
        font-weight: 400;
        margin: 0 0 .35rem 0;
        line-height: 1.1;
    }
    .md-header-subtitle {
        color: rgba(255, 253, 249, 0.82);
        font-size: .92rem;
        max-width: 650px;
        margin: 0;
    }
    .md-header-actions {
        display: flex;
        gap: .75rem;
        align-items: center;
        flex-wrap: wrap;
        position: relative;
        z-index: 2;
    }
    .btn-header-action {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        padding: .65rem 1.25rem;
        border-radius: 9999px;
        font-size: .85rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 180ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .btn-header-primary {
        background: var(--gold, #C8973A);
        color: #FFFDF9;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.2);
    }
    .btn-header-primary:hover {
        background: #D4A346;
        color: #FFFDF9;
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(200, 151, 58, 0.35);
    }

    /* KPI Summary Cards */
    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
    }
    .kpi-card {
        background: var(--surface, #FFFDF9);
        border: 1px solid var(--line, #E5DCB8);
        border-radius: var(--r-control, 12px);
        padding: 1.1rem 1.25rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        box-shadow: var(--shadow-sm, 0 1px 3px rgba(0, 0, 0, 0.05));
        transition: transform 160ms ease, box-shadow 160ms ease;
    }
    .kpi-card:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-md, 0 4px 12px rgba(0, 0, 0, 0.08));
    }
    .kpi-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .kpi-val {
        font-size: 1.65rem;
        font-weight: 700;
        line-height: 1;
        color: var(--ink, #1C1416);
    }
    .kpi-lbl {
        font-size: .75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .05em;
        color: var(--c-muted, #7A6355);
        margin-top: .25rem;
    }

    /* Colores por estado */
    .st-libre       { color: #059669; background: #ECFDF5; border-color: #A7F3D0; }
    .st-ocupada     { color: #BE123C; background: #FFF1F2; border-color: #FECDD3; }
    .st-reservada   { color: #B45309; background: #FFFBEB; border-color: #FDE68A; }
    .st-limpieza    { color: #0369A1; background: #F0F9FF; border-color: #BAE6FD; }
    .st-manten      { color: #475569; background: #F8FAFC; border-color: #E2E8F0; }

    /* Barra de filtros */
    .filter-bar {
        display: flex;
        gap: .5rem;
        margin-bottom: 1.75rem;
        flex-wrap: wrap;
        align-items: center;
    }
    .filter-pill {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .5rem 1rem;
        border-radius: 9999px;
        font-size: .82rem;
        font-weight: 600;
        text-decoration: none;
        border: 1px solid var(--line, #E5DCB8);
        background: var(--surface, #FFFDF9);
        color: var(--c-muted, #7A6355);
        transition: all 140ms ease;
    }
    .filter-pill:hover {
        border-color: var(--brand, #6B1E2E);
        color: var(--brand, #6B1E2E);
    }
    .filter-pill.active {
        background: var(--brand, #6B1E2E);
        border-color: var(--brand, #6B1E2E);
        color: #FFFDF9;
        box-shadow: 0 2px 8px rgba(107, 30, 46, 0.25);
    }
    .filter-pill .count {
        background: rgba(0, 0, 0, 0.08);
        padding: .15rem .45rem;
        border-radius: 9999px;
        font-size: .72rem;
    }
    .filter-pill.active .count {
        background: rgba(255, 253, 249, 0.25);
        color: #FFFDF9;
    }

    /* Grilla de Mesas */
    .mesas-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.25rem;
    }

    /* Tarjeta de Mesa */
    .mesa-card {
        background: var(--surface, #FFFDF9);
        border: 1.5px solid var(--line, #E5DCB8);
        border-radius: var(--r-card, 16px);
        padding: 1.25rem;
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 1rem;
        transition: all 180ms cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow: var(--shadow-sm, 0 1px 3px rgba(0, 0, 0, 0.05));
    }
    .mesa-card:hover {
        transform: translateY(-3px);
        border-color: var(--gold, #C8973A);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    }

    /* Bordes sutiles según estado */
    .mesa-card[data-estado="Libre"]       { border-top: 4px solid #10B981; }
    .mesa-card[data-estado="Ocupada"]     { border-top: 4px solid #E11D48; }
    .mesa-card[data-estado="Reservada"]   { border-top: 4px solid #F59E0B; }
    .mesa-card[data-estado="En Limpieza"] { border-top: 4px solid #0EA5E9; }
    .mesa-card[data-estado="Mantenimiento"] { border-top: 4px solid #94A3B8; }

    .mc-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .mc-num-wrap {
        display: flex;
        align-items: center;
        gap: .55rem;
    }
    .mc-table-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: var(--surface-2, #EFE8DA);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--brand, #6B1E2E);
    }
    .mc-num {
        font-family: var(--font-serif, 'Instrument Serif', Georgia, serif);
        font-size: 1.6rem;
        font-weight: 600;
        color: var(--ink, #1C1416);
        line-height: 1;
    }
    .mc-badge {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        font-size: .72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .06em;
        padding: .28rem .7rem;
        border-radius: 9999px;
        border: 1px solid currentColor;
    }
    .mc-badge .dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
    }
    .mc-badge.pulse .dot {
        animation: pulse-dot 1.8s infinite;
    }
    @@keyframes pulse-dot {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: .4; transform: scale(1.3); }
    }

    /* Contenido de la tarjeta */
    .mc-body {
        font-size: .85rem;
        color: var(--c-muted, #7A6355);
        background: var(--surface-2, #FAF6F0);
        border: 1px solid var(--line-2, #EFE8DA);
        padding: .85rem .95rem;
        border-radius: 10px;
        min-height: 70px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }
    .mc-info-title {
        font-size: .7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .05em;
        color: var(--c-muted, #7A6355);
        margin-bottom: .25rem;
    }
    .mc-info-main {
        font-weight: 600;
        color: var(--ink, #1C1416);
        font-size: .9rem;
    }
    .mc-info-sub {
        font-size: .78rem;
        color: var(--c-muted, #7A6355);
        margin-top: .15rem;
    }

    /* Selector de Estado Operativo */
    .mc-changer {
        display: flex;
        flex-direction: column;
        gap: .5rem;
    }
    .mc-changer-label {
        font-size: .72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: var(--c-muted, #7A6355);
    }
    .mc-select {
        width: 100%;
        padding: .5rem .75rem;
        border-radius: 8px;
        border: 1.5px solid var(--line, #E5DCB8);
        background: var(--surface, #FFFDF9);
        color: var(--ink, #1C1416);
        font-size: .84rem;
        font-weight: 600;
        outline: none;
        cursor: pointer;
        transition: border-color 140ms ease, box-shadow 140ms ease;
    }
    .mc-select:focus {
        border-color: var(--brand, #6B1E2E);
        box-shadow: 0 0 0 3px rgba(107, 30, 46, 0.12);
    }

    /* Botones de acción rápida */
    .mc-quick-btns {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: .35rem;
    }
    .mc-q-btn {
        background: var(--surface, #FFFDF9);
        border: 1px solid var(--line, #E5DCB8);
        border-radius: 6px;
        padding: .35rem .25rem;
        font-size: .68rem;
        font-weight: 700;
        color: var(--ink, #1C1416);
        cursor: pointer;
        text-align: center;
        transition: all 120ms ease;
        user-select: none;
    }
    .mc-q-btn:hover {
        border-color: var(--brand, #6B1E2E);
        color: var(--brand, #6B1E2E);
        transform: translateY(-1px);
    }
    .mc-q-btn.active {
        background: var(--brand, #6B1E2E);
        color: #FFFDF9;
        border-color: var(--brand, #6B1E2E);
    }

    /* Pie de tarjeta */
    .mc-footer {
        display: flex;
        gap: .5rem;
        margin-top: .25rem;
    }
    .mc-action-btn {
        flex: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .4rem;
        padding: .55rem .75rem;
        border-radius: 8px;
        font-size: .8rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 140ms ease;
    }
    .mc-action-order {
        background: var(--brand, #6B1E2E);
        color: #FFFDF9;
    }
    .mc-action-order:hover {
        background: #842539;
        color: #FFFDF9;
        transform: translateY(-1px);
    }
    .mc-action-view {
        background: var(--surface-2, #EFE8DA);
        color: var(--ink, #1C1416);
        border: 1px solid var(--line-2, #DDD4A8);
    }
    .mc-action-view:hover {
        background: var(--line-2, #DDD4A8);
        color: var(--ink, #1C1416);
    }

    /* Toast Flotante */
    .mesa-toast {
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        background: #18060A;
        color: #FFFDF9;
        border-left: 4px solid var(--gold, #C8973A);
        padding: .85rem 1.4rem;
        border-radius: 10px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
        font-size: .88rem;
        font-weight: 600;
        z-index: 9999;
        display: flex;
        align-items: center;
        gap: .75rem;
        opacity: 0;
        transform: translateY(20px);
        pointer-events: none;
        transition: all 260ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .mesa-toast.show {
        opacity: 1;
        transform: translateY(0);
    }
</style>

<div class="mesas-dashboard">

    <!-- Notificaciones TempData -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert" style="border-radius:12px;background:#ECFDF5;border:1px solid #A7F3D0;color:#065F46;display:flex;align-items:center;gap:8px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <div><strong>Éxito:</strong> @TempData["Mensaje"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert" style="border-radius:12px;background:#FFF1F2;border:1px solid #FECDD3;color:#9F1239;display:flex;align-items:center;gap:8px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <div><strong>Atención:</strong> @TempData["Error"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <!-- Encabezado de la Tarea del Mesero -->
    <div class="md-header">
        <div>
            <h1 class="md-header-title">Control Operativo de Mesas</h1>
            <p class="md-header-subtitle">
                Supervisa el salón y actualiza el estado de las 30 mesas en tiempo real. 
                Los comensales y el sistema de pedidos se sincronizan inmediatamente con tus cambios.
            </p>
        </div>
        <div class="md-header-actions">
            <a asp-controller="Pedido" asp-action="Menu" class="btn-header-action btn-header-primary">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><line x1="9" y1="12" x2="15" y2="12"/><line x1="9" y1="16" x2="13" y2="16"/></svg>
                <span>Tomar Nuevo Pedido</span>
            </a>
            <a asp-controller="Reserva" asp-action="Admin" class="btn-header-action" style="background:rgba(255,253,249,0.15);border:1px solid rgba(255,253,249,0.3);color:#FFFDF9;">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                <span>Ver Reservas</span>
            </a>
        </div>
    </div>

    <!-- Tarjetas de Resumen KPI -->
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-icon" style="background:rgba(107,30,46,0.1);color:var(--brand,#6B1E2E);">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
            </div>
            <div>
                <div class="kpi-val">@total</div>
                <div class="kpi-lbl">Total Mesas</div>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon st-libre">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </div>
            <div>
                <div class="kpi-val" style="color:#059669;">@libres</div>
                <div class="kpi-lbl">Mesas Libres</div>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon st-ocupada">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/></svg>
            </div>
            <div>
                <div class="kpi-val" style="color:#BE123C;">@ocupadas</div>
                <div class="kpi-lbl">Ocupadas</div>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon st-reservada">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <div>
                <div class="kpi-val" style="color:#B45309;">@reservadas</div>
                <div class="kpi-lbl">Reservadas</div>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon st-limpieza">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12h20"/><path d="M20 12v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-6"/><path d="M12 2v10"/></svg>
            </div>
            <div>
                <div class="kpi-val" style="color:#0369A1;">@enLimpieza</div>
                <div class="kpi-lbl">En Limpieza</div>
            </div>
        </div>
    </div>

    <!-- Pestañas de Filtrado -->
    <div class="filter-bar">
        <a asp-action="Index" asp-route-filtro="Todas" class="filter-pill @(filtro == "Todas" ? "active" : "")">
            <span>Todas</span>
            <span class="count">@total</span>
        </a>
        <a asp-action="Index" asp-route-filtro="Libre" class="filter-pill @(filtro == "Libre" ? "active" : "")">
            <span>Libres</span>
            <span class="count">@libres</span>
        </a>
        <a asp-action="Index" asp-route-filtro="Ocupada" class="filter-pill @(filtro == "Ocupada" ? "active" : "")">
            <span>Ocupadas</span>
            <span class="count">@ocupadas</span>
        </a>
        <a asp-action="Index" asp-route-filtro="Reservada" class="filter-pill @(filtro == "Reservada" ? "active" : "")">
            <span>Reservadas</span>
            <span class="count">@reservadas</span>
        </a>
        <a asp-action="Index" asp-route-filtro="En Limpieza" class="filter-pill @(filtro == "En Limpieza" ? "active" : "")">
            <span>En Limpieza</span>
            <span class="count">@enLimpieza</span>
        </a>
    </div>

    <!-- Cuadrícula de 30 Mesas -->
    <div class="mesas-grid">
        @foreach (var item in Model)
        {
            var m = item.Mesa;
            var estado = m.Estado ?? "Libre";
            var estadoClass = estado switch {
                "Libre" => "st-libre",
                "Ocupada" => "st-ocupada",
                "Reservada" => "st-reservada",
                "En Limpieza" => "st-limpieza",
                _ => "st-manten"
            };

            <div class="mesa-card" id="card-mesa-@m.Numero" data-mesa="@m.Numero" data-estado="@estado">
                <div>
                    <!-- Encabezado de la mesa -->
                    <div class="mc-header mb-3">
                        <div class="mc-num-wrap">
                            <div class="mc-table-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="7" width="18" height="10" rx="2"/><line x1="7" y1="17" x2="7" y2="21"/><line x1="17" y1="17" x2="17" y2="21"/><line x1="3" y1="12" x2="21" y2="12"/></svg>
                            </div>
                            <span class="mc-num">Mesa @(m.Numero < 10 ? $"0{m.Numero}" : m.Numero.ToString())</span>
                        </div>
                        <span class="mc-badge @estadoClass @(estado == "Ocupada" ? "pulse" : "")" id="badge-mesa-@m.Numero">
                            <span class="dot"></span>
                            <span class="badge-text">@estado</span>
                        </span>
                    </div>

                    <!-- Cuerpo informativo con datos reales -->
                    <div class="mc-body mb-3" id="body-mesa-@m.Numero">
                        @if (estado == "Ocupada" && item.PedidoActivo != null)
                        {
                            <div class="mc-info-title">Pedido Activo en Mesa</div>
                            <div class="mc-info-main">@item.PedidoActivo.NombreCliente</div>
                            <div class="mc-info-sub">
                                Total: <strong>$@item.PedidoActivo.Total.ToString("N0")</strong> • @item.PedidoActivo.Lineas.Count productos
                            </div>
                        }
                        else if (estado == "Reservada" && item.ReservaActiva != null)
                        {
                            <div class="mc-info-title">Reserva Programada</div>
                            <div class="mc-info-main">@item.ReservaActiva.NombreCliente</div>
                            <div class="mc-info-sub">
                                Hora: <strong>@item.ReservaActiva.Hora</strong> • @item.ReservaActiva.NumeroPersonas comensales
                            </div>
                        }
                        else if (estado == "En Limpieza")
                        {
                            <div class="mc-info-title">Estado de Mesa</div>
                            <div class="mc-info-main" style="color:#0369A1;">En Proceso de Limpieza</div>
                            <div class="mc-info-sub">Mesa desocupada. Requiere desinfección para volver a estar libre.</div>
                        }
                        else if (estado == "Libre")
                        {
                            <div class="mc-info-title">Disponibilidad</div>
                            <div class="mc-info-main" style="color:#059669;">Mesa Libre y Limpia</div>
                            <div class="mc-info-sub">Capacidad: 2-4 personas. Lista para asignar pedidos.</div>
                        }
                        else
                        {
                            <div class="mc-info-title">Estado</div>
                            <div class="mc-info-main">@estado</div>
                            <div class="mc-info-sub">Configuración manual de mesa.</div>
                        }
                    </div>

                    <!-- Cambiador Rápido de Estado para el Mesero -->
                    <div class="mc-changer">
                        <div class="mc-changer-label">Cambiar Estado Rápido:</div>
                        <div class="mc-quick-btns">
                            <button type="button" class="mc-q-btn @(estado=="Libre"?"active":"")" onclick="cambiarEstadoAjax(@m.Numero, 'Libre')">Libre</button>
                            <button type="button" class="mc-q-btn @(estado=="Ocupada"?"active":"")" onclick="cambiarEstadoAjax(@m.Numero, 'Ocupada')">Ocupar</button>
                            <button type="button" class="mc-q-btn @(estado=="Reservada"?"active":"")" onclick="cambiarEstadoAjax(@m.Numero, 'Reservada')">Reserva</button>
                            <button type="button" class="mc-q-btn @(estado=="En Limpieza"?"active":"")" onclick="cambiarEstadoAjax(@m.Numero, 'En Limpieza')">Limpiar</button>
                        </div>

                        <!-- Formulario de respaldo accesible -->
                        <form asp-action="CambiarEstado" method="post" class="d-none" id="form-mesa-@m.Numero">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="numeroMesa" value="@m.Numero" />
                            <input type="hidden" name="nuevoEstado" id="input-estado-@m.Numero" value="@estado" />
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                        </form>
                    </div>
                </div>

                <!-- Botones de Acción Operativa -->
                <div class="mc-footer">
                    <a asp-controller="Pedido" asp-action="Menu" asp-route-mesa="@m.Numero" class="mc-action-btn mc-action-order">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 5v14M5 12h14"/></svg>
                        <span>Tomar Pedido</span>
                    </a>
                    @if (item.PedidoActivo != null)
                    {
                        <a asp-controller="Pedido" asp-action="Detalle" asp-route-id="@item.PedidoActivo.Id" class="mc-action-btn mc-action-view" title="Ver pedido actual">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                            <span>Pedido</span>
                        </a>
                    }
                </div>
            </div>
        }
    </div>
</div>

<!-- Toast flotante de notificación rápida -->
<div id="mesaToast" class="mesa-toast">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--gold,#C8973A)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
    <span id="mesaToastMsg">Mesa actualizada</span>
</div>

@section Scripts {
<script>
    // Microinteracción para actualizar el estado de la mesa mediante AJAX sin recarga
    async function cambiarEstadoAjax(numeroMesa, nuevoEstado) {
        const card = document.getElementById(`card-mesa-${numeroMesa}`);
        const badge = document.getElementById(`badge-mesa-${numeroMesa}`);
        const badgeText = badge ? badge.querySelector('.badge-text') : null;

        try {
            // Animación suave de espera
            if (card) card.style.opacity = '0.65';

            const response = await fetch('/Mesa/CambiarEstadoRapido', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({
                    numeroMesa: numeroMesa,
                    nuevoEstado: nuevoEstado
                })
            });

            const data = await response.json();

            if (data && data.success) {
                // Actualizar dataset del card
                if (card) {
                    card.setAttribute('data-estado', nuevoEstado);
                    card.style.opacity = '1';

                    // Actualizar botones rápidos activos
                    const btns = card.querySelectorAll('.mc-q-btn');
                    btns.forEach(btn => {
                        const txt = btn.textContent.trim().toLowerCase();
                        let target = nuevoEstado.toLowerCase();
                        if (target === 'ocupada') target = 'ocupar';
                        if (target === 'reservada') target = 'reserva';
                        if (target === 'en limpieza') target = 'limpiar';

                        if (txt === target) {
                            btn.classList.add('active');
                        } else {
                            btn.classList.remove('active');
                        }
                    });
                }

                // Actualizar badge visual
                if (badge && badgeText) {
                    badgeText.textContent = nuevoEstado;
                    badge.className = 'mc-badge';

                    if (nuevoEstado === 'Libre') {
                        badge.classList.add('st-libre');
                    } else if (nuevoEstado === 'Ocupada') {
                        badge.classList.add('st-ocupada', 'pulse');
                    } else if (nuevoEstado === 'Reservada') {
                        badge.classList.add('st-reservada');
                    } else if (nuevoEstado === 'En Limpieza') {
                        badge.classList.add('st-limpieza');
                    } else {
                        badge.classList.add('st-manten');
                    }
                }

                // Mostrar toast de éxito
                showToast(`Mesa #${numeroMesa} actualizada a "${nuevoEstado}"`);
            } else {
                if (card) card.style.opacity = '1';
                showToast(`Error: ${data.message || 'No se pudo cambiar el estado'}`);
            }
        } catch (err) {
            console.error('Error al actualizar mesa:', err);
            if (card) card.style.opacity = '1';
            // Respaldo de envío clásico si fetch falla
            const input = document.getElementById(`input-estado-${numeroMesa}`);
            const form = document.getElementById(`form-mesa-${numeroMesa}`);
            if (input && form) {
                input.value = nuevoEstado;
                form.submit();
            }
        }
    }

    function showToast(msg) {
        const toast = document.getElementById('mesaToast');
        const toastMsg = document.getElementById('mesaToastMsg');
        if (!toast || !toastMsg) return;

        toastMsg.textContent = msg;
        toast.classList.add('show');

        clearTimeout(window._toastTimeout);
        window._toastTimeout = setTimeout(() => {
            toast.classList.remove('show');
        }, 3000);
    }
</script>
}
