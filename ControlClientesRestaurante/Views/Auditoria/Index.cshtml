@model List<ControlClientesRestaurante.Models.AuditoriaLog>
@{
    ViewData["Title"] = "Bitácora de Auditoría y Seguridad";
    int totalHoy = ViewBag.TotalHoy ?? 0;
    int anulacionesHoy = ViewBag.AnulacionesHoy ?? 0;
    int cajaHoy = ViewBag.CajaHoy ?? 0;
    int usuariosHoy = ViewBag.UsuariosHoy ?? 0;

    string moduloSel = ViewBag.Modulo as string ?? "Todos";
    string desdeSel = ViewBag.Desde as string ?? "";
    string hastaSel = ViewBag.Hasta as string ?? "";
    string usuarioFiltro = ViewBag.UsuarioFiltro as string ?? "";
}

<div class="auditoria-container" style="max-width:1240px;margin:1.5rem auto;padding:0 1.25rem;">

    <!-- ══ ENCABEZADO ═══════════════════════════════════════════════════ -->
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem;margin-bottom:1.5rem;">
        <div>
            <div style="display:inline-flex;align-items:center;gap:6px;background:rgba(107,30,46,0.1);border:1px solid rgba(107,30,46,0.25);padding:3px 10px;border-radius:20px;font-size:0.75rem;font-weight:700;color:var(--brand,#6B1E2E);margin-bottom:6px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                Seguridad Operativa &amp; Cumplimiento Fiscal
            </div>
            <h1 style="margin:0;font-size:1.75rem;font-weight:800;color:var(--brand,#6B1E2E);letter-spacing:-0.02em;">Bitácora de Auditoría del Sistema</h1>
            <p style="margin:4px 0 0;font-size:0.88rem;color:#555;">Registro inmutable de todas las operaciones sensibles, anulaciones, movimientos de caja y cambios de catálogo.</p>
        </div>

        <div style="display:flex;gap:0.75rem;">
            <a asp-action="ExportarCsv" asp-route-desde="@desdeSel" asp-route-hasta="@hastaSel" asp-route-modulo="@moduloSel" asp-route-usuario="@usuarioFiltro"
               style="display:inline-flex;align-items:center;gap:6px;background:#FFFDF9;border:1.5px solid var(--gold,#C8973A);color:#3C2A20;padding:0.6rem 1.15rem;border-radius:10px;text-decoration:none;font-weight:700;font-size:0.85rem;box-shadow:0 2px 6px rgba(0,0,0,0.04);transition:all 120ms ease;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C8973A" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                <span>Exportar Bitácora (Excel / CSV)</span>
            </a>
        </div>
    </div>

    <!-- ══ KPIS EN TIEMPO REAL ═══════════════════════════════════════════ -->
    <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));gap:1rem;margin-bottom:1.5rem;">
        <div style="background:#FFFDF9;border:1px solid var(--line,#E2D7C8);border-radius:12px;padding:1.15rem 1.25rem;display:flex;align-items:center;gap:1rem;">
            <div style="width:44px;height:44px;border-radius:10px;background:rgba(107,30,46,0.08);color:var(--brand,#6B1E2E);display:flex;align-items:center;justify-content:center;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <div>
                <span style="font-size:0.75rem;font-weight:700;color:#6B7280;text-transform:uppercase;">Eventos Hoy</span>
                <div style="font-size:1.5rem;font-weight:800;color:#18060A;line-height:1.2;">@totalHoy</div>
            </div>
        </div>

        <div style="background:#FFFDF9;border:1px solid var(--line,#E2D7C8);border-radius:12px;padding:1.15rem 1.25rem;display:flex;align-items:center;gap:1rem;">
            <div style="width:44px;height:44px;border-radius:10px;background:@(anulacionesHoy > 0 ? "rgba(220,38,38,0.12)" : "rgba(16,185,129,0.12)");color:@(anulacionesHoy > 0 ? "#DC2626" : "#059669");display:flex;align-items:center;justify-content:center;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
            </div>
            <div>
                <span style="font-size:0.75rem;font-weight:700;color:#6B7280;text-transform:uppercase;">Anulaciones / Cancelaciones</span>
                <div style="font-size:1.5rem;font-weight:800;color:@(anulacionesHoy > 0 ? "#DC2626" : "#059669");line-height:1.2;">@anulacionesHoy</div>
            </div>
        </div>

        <div style="background:#FFFDF9;border:1px solid var(--line,#E2D7C8);border-radius:12px;padding:1.15rem 1.25rem;display:flex;align-items:center;gap:1rem;">
            <div style="width:44px;height:44px;border-radius:10px;background:rgba(200,151,58,0.15);color:#C8973A;display:flex;align-items:center;justify-content:center;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            </div>
            <div>
                <span style="font-size:0.75rem;font-weight:700;color:#6B7280;text-transform:uppercase;">Operaciones de Caja</span>
                <div style="font-size:1.5rem;font-weight:800;color:#B45309;line-height:1.2;">@cajaHoy</div>
            </div>
        </div>

        <div style="background:#FFFDF9;border:1px solid var(--line,#E2D7C8);border-radius:12px;padding:1.15rem 1.25rem;display:flex;align-items:center;gap:1rem;">
            <div style="width:44px;height:44px;border-radius:10px;background:rgba(59,130,246,0.12);color:#2563EB;display:flex;align-items:center;justify-content:center;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
            </div>
            <div>
                <span style="font-size:0.75rem;font-weight:700;color:#6B7280;text-transform:uppercase;">Usuarios Activos</span>
                <div style="font-size:1.5rem;font-weight:800;color:#2563EB;line-height:1.2;">@usuariosHoy</div>
            </div>
        </div>
    </div>

    <!-- ══ BARRA DE FILTROS ═══════════════════════════════════════════════ -->
    <div style="background:#FFFDF9;border:1px solid var(--line,#E2D7C8);border-radius:14px;padding:1rem 1.25rem;margin-bottom:1.5rem;">
        <form method="get" asp-action="Index" style="display:flex;align-items:flex-end;gap:1rem;flex-wrap:wrap;">
            <div style="flex:1;min-width:140px;">
                <label style="display:block;font-size:0.75rem;font-weight:700;color:#3C2A20;text-transform:uppercase;margin-bottom:0.3rem;">Módulo</label>
                <select name="modulo" class="input-field" style="width:100%;padding:0.55rem 0.75rem;border:1.5px solid var(--line,#E2D7C8);border-radius:8px;font-size:0.85rem;background:#FAF6F0;">
                    <option value="Todos" selected="@(moduloSel == "Todos")">Todos los módulos</option>
                    <option value="Pedidos" selected="@(moduloSel == "Pedidos")">Pedidos</option>
                    <option value="Facturas" selected="@(moduloSel == "Facturas")">Facturación</option>
                    <option value="Caja" selected="@(moduloSel == "Caja")">Caja &amp; Arqueos</option>
                    <option value="Inventario" selected="@(moduloSel == "Inventario")">Inventario</option>
                    <option value="Seguridad" selected="@(moduloSel == "Seguridad")">Seguridad &amp; Accesos</option>
                    <option value="Reservas" selected="@(moduloSel == "Reservas")">Reservas</option>
                </select>
            </div>

            <div style="width:160px;">
                <label style="display:block;font-size:0.75rem;font-weight:700;color:#3C2A20;text-transform:uppercase;margin-bottom:0.3rem;">Desde</label>
                <input type="date" name="desde" value="@desdeSel" class="input-field" style="width:100%;padding:0.55rem 0.75rem;border:1.5px solid var(--line,#E2D7C8);border-radius:8px;font-size:0.85rem;" />
            </div>

            <div style="width:160px;">
                <label style="display:block;font-size:0.75rem;font-weight:700;color:#3C2A20;text-transform:uppercase;margin-bottom:0.3rem;">Hasta</label>
                <input type="date" name="hasta" value="@hastaSel" class="input-field" style="width:100%;padding:0.55rem 0.75rem;border:1.5px solid var(--line,#E2D7C8);border-radius:8px;font-size:0.85rem;" />
            </div>

            <div style="flex:1;min-width:150px;">
                <label style="display:block;font-size:0.75rem;font-weight:700;color:#3C2A20;text-transform:uppercase;margin-bottom:0.3rem;">Usuario</label>
                <input type="text" name="usuario" value="@usuarioFiltro" placeholder="Ej: cajero o admin" class="input-field" style="width:100%;padding:0.55rem 0.75rem;border:1.5px solid var(--line,#E2D7C8);border-radius:8px;font-size:0.85rem;" />
            </div>

            <div style="display:flex;gap:0.5rem;">
                <button type="submit" style="background:var(--brand,#6B1E2E);color:#FFFDF9;border:none;padding:0.58rem 1.15rem;border-radius:8px;font-weight:700;font-size:0.85rem;cursor:pointer;">
                    Filtrar
                </button>
                <a asp-action="Index" style="background:#F3F4F6;color:#4B5563;border:1px solid #D1D5DB;padding:0.58rem 0.9rem;border-radius:8px;font-weight:600;font-size:0.85rem;text-decoration:none;">
                    Limpiar
                </a>
            </div>
        </form>
    </div>

    <!-- ══ TABLA DE EVENTOS DE AUDITORÍA ═════════════════════════════════ -->
    <div style="background:#FFFDF9;border:1px solid var(--line,#E2D7C8);border-radius:14px;overflow:hidden;box-shadow:0 4px 16px rgba(0,0,0,0.03);">
        <table style="width:100%;border-collapse:collapse;text-align:left;font-size:0.88rem;">
            <thead>
                <tr style="background:#FAF6F0;border-bottom:1px solid var(--line,#E2D7C8);color:#3C2A20;font-size:0.75rem;text-transform:uppercase;letter-spacing:0.04em;">
                    <th style="padding:0.85rem 1rem;width:150px;">Fecha &amp; Hora</th>
                    <th style="padding:0.85rem 1rem;width:160px;">Usuario / Rol</th>
                    <th style="padding:0.85rem 1rem;width:110px;">Módulo</th>
                    <th style="padding:0.85rem 1rem;width:170px;">Acción Crítica</th>
                    <th style="padding:0.85rem 1rem;">Detalle del Evento</th>
                    <th style="padding:0.85rem 1rem;text-align:right;width:120px;">Dirección IP</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || Model.Count == 0)
                {
                    <tr>
                        <td colspan="6" style="padding:3rem 1rem;text-align:center;color:#6B7280;">
                            No se encontraron registros de auditoría para los criterios seleccionados.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var l in Model)
                    {
                        bool esCritico = l.Accion.Contains("ANULACION") || l.Accion.Contains("CANCELACION") || l.Accion.Contains("ELIMINACION");
                        bool esCaja = l.Modulo == "Caja";
                        bool esExito = l.Accion.Contains("EXITOSO") || l.Accion.Contains("APERTURA") || l.Accion.Contains("FACTURACION");

                        <tr style="border-bottom:1px solid rgba(226,215,200,0.5);transition:background 120ms ease;">
                            <td style="padding:0.85rem 1rem;font-size:0.82rem;color:#3C2A20;">
                                <div style="font-weight:700;">@l.FechaCreacion.ToString("dd/MM/yyyy")</div>
                                <div style="font-family:monospace;color:#6B7280;font-size:0.78rem;">@l.FechaCreacion.ToString("HH:mm:ss")</div>
                            </td>
                            <td style="padding:0.85rem 1rem;">
                                <div style="font-weight:700;color:#18060A;">@l.Usuario</div>
                                <span style="font-size:0.72rem;background:#F3F4F6;color:#4B5563;padding:2px 6px;border-radius:4px;font-weight:600;">@l.Rol</span>
                            </td>
                            <td style="padding:0.85rem 1rem;">
                                <span style="background:rgba(200,151,58,0.12);color:#92400E;font-size:0.75rem;font-weight:700;padding:2px 7px;border-radius:6px;border:1px solid rgba(200,151,58,0.25);">
                                    @l.Modulo
                                </span>
                            </td>
                            <td style="padding:0.85rem 1rem;">
                                @if (esCritico)
                                {
                                    <span style="background:#FEE2E2;color:#991B1B;border:1px solid #FCA5A5;font-size:0.72rem;font-weight:800;padding:3px 8px;border-radius:6px;display:inline-flex;align-items:center;gap:4px;">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                                        @l.Accion
                                    </span>
                                }
                                else if (esCaja)
                                {
                                    <span style="background:#FEF3C7;color:#92400E;border:1px solid #FCD34D;font-size:0.72rem;font-weight:800;padding:3px 8px;border-radius:6px;display:inline-flex;align-items:center;gap:4px;">
                                        @l.Accion
                                    </span>
                                }
                                else if (esExito)
                                {
                                    <span style="background:#ECFDF5;color:#065F46;border:1px solid #A7F3D0;font-size:0.72rem;font-weight:800;padding:3px 8px;border-radius:6px;display:inline-flex;align-items:center;gap:4px;">
                                        @l.Accion
                                    </span>
                                }
                                else
                                {
                                    <span style="background:#EFF6FF;color:#1E40AF;border:1px solid #BFDBFE;font-size:0.72rem;font-weight:800;padding:3px 8px;border-radius:6px;display:inline-flex;align-items:center;gap:4px;">
                                        @l.Accion
                                    </span>
                                }
                            </td>
                            <td style="padding:0.85rem 1rem;font-size:0.85rem;color:#374151;line-height:1.4;">
                                @l.Detalle
                                @if (!string.IsNullOrEmpty(l.EntidadAfectada) && l.EntidadId.HasValue)
                                {
                                    <span style="color:#6B7280;font-size:0.75rem;margin-left:4px;">(@l.EntidadAfectada ID: #@l.EntidadId)</span>
                                }
                            </td>
                            <td style="padding:0.85rem 1rem;text-align:right;font-family:monospace;font-size:0.78rem;color:#6B7280;">
                                @l.IpAddress
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</div>
