@model List<ControlClientesRestaurante.Models.AuditoriaLog>
@{
    ViewData["Title"] = "Bitácora de Auditoría y Seguridad";
    int totalHoy = ViewBag.TotalHoy ?? 0;
    int anulacionesHoy = ViewBag.AnulacionesHoy ?? 0;
    int cajaHoy = ViewBag.CajaHoy ?? 0;
    int usuariosHoy = ViewBag.UsuariosHoy ?? 0;

    string moduloSel = ViewBag.Modulo as string ?? "Todos";
    string desdeSel = ViewBag.Desde as string ?? "";
    string hastaSel = ViewBag.Hasta as string ?? "";
    string usuarioFiltro = ViewBag.UsuarioFiltro as string ?? "";
}

<style>
    .audit-kpi-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
    }
    .audit-kpi-card {
        background: var(--surface, #FFFDF9);
        border: 1px solid var(--line, #E2D7C8);
        border-radius: 14px;
        padding: 1.15rem 1.25rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        box-shadow: var(--shadow-sm);
    }
    .audit-kpi-icon {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .audit-kpi-label {
        font-size: 0.72rem;
        font-weight: 700;
        color: var(--muted, #5E5357);
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }
    .audit-kpi-val {
        font-size: 1.55rem;
        font-weight: 800;
        color: var(--text, #1C1416);
        line-height: 1.2;
    }
    .audit-role-badge {
        font-size: 0.72rem;
        background: var(--surface-2, #EFE6D8);
        color: var(--muted, #5E5357);
        border: 1px solid var(--line, #E2D7C8);
        padding: 2px 7px;
        border-radius: 6px;
        font-weight: 700;
    }
    .audit-mod-badge {
        background: rgba(200, 151, 58, 0.14);
        color: #92400E;
        font-size: 0.75rem;
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 6px;
        border: 1px solid rgba(200, 151, 58, 0.35);
    }
    html[data-theme="dark"] .audit-mod-badge {
        color: var(--gold, #E5C687);
        background: rgba(229, 198, 135, 0.16);
    }
</style>

<!-- ══ ENCABEZADO ═══════════════════════════════════════════════════ -->
<div class="pg-header">
    <div>
        <div class="pg-title">
            <span class="pg-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </span>
            Bitácora de Auditoría del Sistema
        </div>
        <div class="pg-sub">Registro inmutable de operaciones sensibles, anulaciones, movimientos de caja y cambios de catálogo</div>
    </div>

    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="ExportarCsv" asp-route-desde="@desdeSel" asp-route-hasta="@hastaSel" asp-route-modulo="@moduloSel" asp-route-usuario="@usuarioFiltro"
           class="btn-ghost" style="border-color: var(--gold, #C8973A); font-weight: 700;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--gold, #C8973A)" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            <span>Exportar Bitácora (Excel / CSV)</span>
        </a>
    </div>
</div>

<hr class="div-gold" />

<!-- ══ KPIS EN TIEMPO REAL ═══════════════════════════════════════════ -->
<div class="audit-kpi-grid">
    <div class="audit-kpi-card">
        <div class="audit-kpi-icon" style="background: var(--brand-soft, rgba(107,30,46,0.12)); color: var(--ink, #6B1E2E);">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <div>
            <span class="audit-kpi-label">Eventos Hoy</span>
            <div class="audit-kpi-val">@totalHoy</div>
        </div>
    </div>

    <div class="audit-kpi-card">
        <div class="audit-kpi-icon" style="background: @(anulacionesHoy > 0 ? "var(--danger-bg)" : "var(--success-bg)"); color: @(anulacionesHoy > 0 ? "var(--danger)" : "var(--success)");">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        </div>
        <div>
            <span class="audit-kpi-label">Anulaciones / Cancelaciones</span>
            <div class="audit-kpi-val" style="color: @(anulacionesHoy > 0 ? "var(--danger)" : "var(--success)");">@anulacionesHoy</div>
        </div>
    </div>

    <div class="audit-kpi-card">
        <div class="audit-kpi-icon" style="background: rgba(200,151,58,0.16); color: var(--amber, #C8973A);">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </div>
        <div>
            <span class="audit-kpi-label">Operaciones de Caja</span>
            <div class="audit-kpi-val" style="color: var(--amber, #B45309);">@cajaHoy</div>
        </div>
    </div>

    <div class="audit-kpi-card">
        <div class="audit-kpi-icon" style="background: rgba(59,130,246,0.14); color: var(--info, #2563EB);">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
        </div>
        <div>
            <span class="audit-kpi-label">Usuarios Activos</span>
            <div class="audit-kpi-val" style="color: var(--info, #2563EB);">@usuariosHoy</div>
        </div>
    </div>
</div>

<!-- ══ BARRA DE FILTROS ═══════════════════════════════════════════════ -->
<div class="card-pro" style="padding: 1.15rem 1.35rem; margin-bottom: 1.5rem;">
    <form method="get" asp-action="Index" style="display:flex;align-items:flex-end;gap:1rem;flex-wrap:wrap;">
        <div style="flex:1;min-width:150px;">
            <label class="form-lbl" style="display:block;margin-bottom:0.35rem;">Módulo</label>
            <select name="modulo" class="form-select">
                <option value="Todos" selected="@(moduloSel == "Todos")">Todos los módulos</option>
                <option value="Pedidos" selected="@(moduloSel == "Pedidos")">Pedidos</option>
                <option value="Facturas" selected="@(moduloSel == "Facturas")">Facturación</option>
                <option value="Caja" selected="@(moduloSel == "Caja")">Caja &amp; Arqueos</option>
                <option value="Inventario" selected="@(moduloSel == "Inventario")">Inventario</option>
                <option value="Seguridad" selected="@(moduloSel == "Seguridad")">Seguridad &amp; Accesos</option>
                <option value="Reservas" selected="@(moduloSel == "Reservas")">Reservas</option>
            </select>
        </div>

        <div style="width:165px;">
            <label class="form-lbl" style="display:block;margin-bottom:0.35rem;">Desde</label>
            <input type="date" name="desde" value="@desdeSel" class="form-control" />
        </div>

        <div style="width:165px;">
            <label class="form-lbl" style="display:block;margin-bottom:0.35rem;">Hasta</label>
            <input type="date" name="hasta" value="@hastaSel" class="form-control" />
        </div>

        <div style="flex:1;min-width:160px;">
            <label class="form-lbl" style="display:block;margin-bottom:0.35rem;">Usuario</label>
            <input type="text" name="usuario" value="@usuarioFiltro" placeholder="Ej: cajero o admin" class="form-control" />
        </div>

        <div style="display:flex;gap:0.5rem;">
            <button type="submit" class="btn-brand">
                Filtrar
            </button>
            <a asp-action="Index" class="btn-ghost">
                Limpiar
            </a>
        </div>
    </form>
</div>

<!-- ══ TABLA DE EVENTOS DE AUDITORÍA ═════════════════════════════════ -->
<div class="tbl-wrap">
    <table class="tbl">
        <thead>
            <tr>
                <th style="width:150px;">Fecha &amp; Hora</th>
                <th style="width:160px;">Usuario / Rol</th>
                <th style="width:120px;">Módulo</th>
                <th style="width:180px;">Acción Crítica</th>
                <th>Detalle del Evento</th>
                <th style="text-align:right;width:130px;">Dirección IP</th>
            </tr>
        </thead>
        <tbody>
            @if (Model == null || Model.Count == 0)
            {
                <tr>
                    <td colspan="6" style="padding:3rem 1rem;text-align:center;color:var(--muted);">
                        No se encontraron registros de auditoría para los criterios seleccionados.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var l in Model)
                {
                    bool esCritico = l.Accion.Contains("ANULACION") || l.Accion.Contains("CANCELACION") || l.Accion.Contains("ELIMINACION");
                    bool esCaja = l.Modulo == "Caja";
                    bool esExito = l.Accion.Contains("EXITOSO") || l.Accion.Contains("APERTURA") || l.Accion.Contains("FACTURACION");

                    <tr>
                        <td>
                            <div style="font-weight:700;color:var(--text);">@l.FechaCreacion.ToString("dd/MM/yyyy")</div>
                            <div style="font-family:var(--font-mono);color:var(--muted);font-size:0.78rem;">@l.FechaCreacion.ToString("HH:mm:ss")</div>
                        </td>
                        <td>
                            <div style="font-weight:700;color:var(--text);margin-bottom:3px;">@l.Usuario</div>
                            <span class="audit-role-badge">@l.Rol</span>
                        </td>
                        <td>
                            <span class="audit-mod-badge">
                                @l.Modulo
                            </span>
                        </td>
                        <td>
                            @if (esCritico)
                            {
                                <span class="badge-pill bp-danger">
                                    <span class="dot"></span>
                                    @l.Accion
                                </span>
                            }
                            else if (esCaja)
                            {
                                <span class="badge-pill bp-warn">
                                    <span class="dot"></span>
                                    @l.Accion
                                </span>
                            }
                            else if (esExito)
                            {
                                <span class="badge-pill bp-ok">
                                    <span class="dot"></span>
                                    @l.Accion
                                </span>
                            }
                            else
                            {
                                <span class="badge-pill bp-gold">
                                    <span class="dot"></span>
                                    @l.Accion
                                </span>
                            }
                        </td>
                        <td style="font-size:0.86rem;color:var(--text);line-height:1.45;">
                            @l.Detalle
                            @if (!string.IsNullOrEmpty(l.EntidadAfectada) && l.EntidadId.HasValue)
                            {
                                <span style="color:var(--muted);font-size:0.76rem;margin-left:4px;font-weight:600;">(@l.EntidadAfectada ID: #@l.EntidadId)</span>
                            }
                        </td>
                        <td style="text-align:right;font-family:var(--font-mono);font-size:0.78rem;color:var(--muted);">
                            @l.IpAddress
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
