@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    // Barra superior única del cliente: la usan el inicio y el resto de páginas para que no cambie al navegar.
    var _session = HttpContextAccessor.HttpContext?.Session;
    var _usuario = (User.Identity?.IsAuthenticated == true && !string.IsNullOrWhiteSpace(User.Identity.Name))
        ? User.Identity.Name
        : _session?.GetString("Usuario");
    var _rol     = (User.Identity?.IsAuthenticated == true && !string.IsNullOrWhiteSpace(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value))
        ? User.FindFirst(System.Security.Claims.ClaimTypes.Role)!.Value
        : (_session?.GetString("Rol") ?? "");
    var _autenticado = (User.Identity?.IsAuthenticated == true) || !string.IsNullOrEmpty(_usuario);
    var _esPersonal = Roles.EsPersonal(_rol);
    // Fuera del inicio, los enlaces a secciones de la página apuntan a "/#seccion"
    var _esInicio = ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index";
    var _ancla = _esInicio ? "" : "/";
    var _ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var _act = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string Actual(string c, string a) => _ctrl == c && _act == a ? "page" : null;
}

<link rel="stylesheet" href="~/css/nav-inicio.css" asp-append-version="true" />

    <nav class="lnav">
        <a href="/" class="lnav-brand">
            <div class="lnav-icon">
                <partial name="_LogoBurger" />
            </div>
            <span class="lnav-name">Saborator</span>
        </a>

        <div class="lnav-menu-links">
            <a href="@_ancla#menu" class="lnav-item"><span>La Carta</span></a>
            <a href="@_ancla#ubicacion" class="lnav-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="2.2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                <span>Sede &amp; Mapa</span>
            </a>
            <a href="@_ancla#resenas" class="lnav-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="2.2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <span>Reseñas</span>
            </a>
            <a href="@(_esInicio ? "javascript:void(0)" : "/#menu")" onclick="@(_esInicio ? "abrirModalModalidad()" : "")" class="lnav-item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="2.2"><circle cx="18.5" cy="17.5" r="3.5"/><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="15" cy="5" r="1"/><path d="M12 17.5V14l-3-3 4-3 2 3h2"/></svg>
                <span id="navModalityText">Domicilio</span>
            </a>
            <a asp-controller="Pedido" asp-action="Rastrear" class="lnav-item" aria-current="@Actual("Pedido", "Rastrear")">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                <span>Rastrear Pedido</span>
            </a>
            <a asp-controller="Pago" asp-action="Checkout" class="lnav-item" aria-current="@Actual("Pago", "Checkout")">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="2.5"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                <span>Pagar Cuenta</span>
            </a>
            <a asp-controller="Reserva" asp-action="Nueva" class="lnav-item lnav-item-reserva-mobile">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="2.5"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                <span>Reservar Mesa</span>
            </a>
            @if (_autenticado)
            {
                <a asp-controller="Reserva" asp-action="MisReservas" class="lnav-item" aria-current="@Actual("Reserva", "MisReservas")">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="2.3"><polyline points="20 6 9 17 4 12"/></svg>
                    <span>Mis Reservas</span>
                </a>
                <a asp-controller="Pedido" asp-action="MisPedidos" class="lnav-item" aria-current="@Actual("Pedido", "MisPedidos")">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="2.3"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/></svg>
                    <span>Mis Pedidos</span>
                </a>
            }
            @if (_esPersonal)
            {
                <a href="@Roles.PaginaInicio(_rol)" class="lnav-item lnav-item-admin" style="background:rgba(200,151,58,0.18);border:1px solid rgba(200,151,58,0.55);border-radius:999px;padding:0.28rem 0.72rem;color:var(--gold, #C8973A) !important;font-weight:700 !important;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" style="display:inline-block !important;flex-shrink:0;"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>
                    <span>Mi Panel</span>
                </a>
            }
        </div>

        <div class="lnav-actions">
            <!-- Botón de Modo Oscuro / Claro -->
            <button type="button" class="theme-toggle-btn" onclick="toggleModoOscuro()" title="Cambiar modo de luz u oscuro" aria-label="Cambiar modo de luz u oscuro">
                <svg class="theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                <svg class="theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
            </button>

            <!-- Botón de Carrito Flotante/Nav estilo KFC -->
            <button type="button" onclick="@(_esInicio ? "abrirDrawerCarrito()" : "location.href='/#menu'")" class="lnav-cart-btn" id="navCartBtn" aria-label="Ver Carrito">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                <span class="nav-cart-badge" id="navCartCount" style="display:none;">0</span>
            </button>

            <a asp-controller="Reserva" asp-action="Nueva" class="lnav-btn-p lnav-btn-reserva-desk">Reservar Mesa</a>
            @if (_autenticado)
            {
                @if (_esPersonal)
                {
                    <a href="@Roles.PaginaInicio(_rol)" class="lnav-user-tag staff" title="Ir a mi panel">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" style="display:inline-block !important;flex-shrink:0;"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>
                        <span>@_usuario</span>
                    </a>
                }
                else
                {
                    <a asp-controller="Perfil" asp-action="Index" class="lnav-user-tag" title="Mi perfil">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" style="display:inline-block !important;flex-shrink:0;"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        <span>@_usuario</span>
                    </a>
                }
                <a asp-controller="Login" asp-action="Logout" class="lnav-btn-o" title="Cerrar sesión">Salir</a>
            }
            else
            {
                <button type="button" onclick="abrirModalIngreso()" class="lnav-btn-o lnav-btn-login" id="btnNavIngresarHome">Ingresar</button>
            }

            <!-- Botón Menú Hamburguesa Móvil -->
            <button type="button" class="lnav-toggle" id="lnavMobileToggle" onclick="document.getElementById('lnavMobileMenu').classList.toggle('open')" aria-label="Abrir menú de opciones">
                <span></span><span></span><span></span>
            </button>
        </div>
    </nav>

    <!-- Menú Desplegable Móvil Completo -->
    <div class="lnav-mobile" id="lnavMobileMenu">
        <a href="@_ancla#menu" onclick="document.getElementById('lnavMobileMenu').classList.remove('open')"><svg class="ico" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-.15em;margin-right:.35em;flex:none"><path d="M4 11a8 8 0 0 1 16 0Z"/><path d="M3 14.5h18"/><path d="M4 18h16v1a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z"/></svg>La Carta Gourmet</a>
        <a href="@_ancla#ubicacion" onclick="document.getElementById('lnavMobileMenu').classList.remove('open')"><svg class="ico" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-.15em;margin-right:.35em;flex:none"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>Sede &amp; Mapa</a>
        <a href="@_ancla#resenas" onclick="document.getElementById('lnavMobileMenu').classList.remove('open')"><svg class="ico" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-.15em;margin-right:.35em;flex:none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" fill="currentColor"/></svg>Reseñas de Clientes</a>
        <a href="@(_esInicio ? "javascript:void(0)" : "/#menu")" onclick="document.getElementById('lnavMobileMenu').classList.remove('open'); @(_esInicio ? "abrirModalModalidad();" : "")"><svg class="ico" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-.15em;margin-right:.35em;flex:none"><circle cx="18.5" cy="17.5" r="3.5"/><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="15" cy="5" r="1"/><path d="M12 17.5V14l-3-3 4-3 2 3h2"/></svg>Modalidad / Domicilio</a>
        <a asp-controller="Pedido" asp-action="Rastrear"><svg class="ico" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-.15em;margin-right:.35em;flex:none"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>Rastrear Pedido</a>
        <a asp-controller="Pago" asp-action="Checkout"><svg class="ico" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-.15em;margin-right:.35em;flex:none"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>Pagar Cuenta</a>
        <a asp-controller="Reserva" asp-action="Nueva" style="color:var(--gold, #C8973A);font-weight:700;"><svg class="ico" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-.15em;margin-right:.35em;flex:none"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>Reservar Mesa</a>
        @if (_esPersonal)
        {
            <a href="@Roles.PaginaInicio(_rol)" style="color:var(--gold, #C8973A);font-weight:700;"><svg class="ico" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-.15em;margin-right:.35em;flex:none"><line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6" y1="20" x2="6" y2="16"/></svg>Mi Panel</a>
        }
        @if (_autenticado)
        {
            <a asp-controller="Reserva" asp-action="MisReservas"><svg class="ico" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-.15em;margin-right:.35em;flex:none"><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/></svg>Mis Reservas</a>
            <a asp-controller="Pedido" asp-action="MisPedidos"><svg class="ico" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-.15em;margin-right:.35em;flex:none"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>Mis Pedidos</a>
            <a asp-controller="Perfil" asp-action="Index"><svg class="ico" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-.15em;margin-right:.35em;flex:none"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>Mi Perfil (@_usuario)</a>
            <a asp-controller="Login" asp-action="Logout" style="color:#DC2626;font-weight:700;"><svg class="ico" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-.15em;margin-right:.35em;flex:none"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>Cerrar Sesión</a>
        }
        else
        {
            <a href="javascript:void(0)" onclick="document.getElementById('lnavMobileMenu').classList.remove('open'); abrirModalIngreso();"><svg class="ico" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-.15em;margin-right:.35em;flex:none"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>Ingresar</a>
        }
    </div>

@if (!_esInicio)
{
    <div class="lnav-spacer" aria-hidden="true"></div>
}
