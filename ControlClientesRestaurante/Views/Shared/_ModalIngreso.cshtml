@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var googleClientId = Configuration["Authentication:Google:ClientId"]
                       ?? Configuration["Google:ClientId"]
                       ?? Environment.GetEnvironmentVariable("GOOGLE_CLIENT_ID")
                       ?? "";
}

<!-- SDK Oficial de Google Identity Services (GSI) -->
<script src="https://accounts.google.com/gsi/client" async defer></script>

<!-- ══ CLUB SABORATOR: MODAL DE AUTENTICACIÓN ESTILO KFC FAST-FOOD ════════════ -->
<div class="modal-ingreso-overlay" id="modalIngresoOverlay" aria-modal="true" role="dialog" aria-labelledby="modalClubTitle">
    <div class="modal-ingreso-box" id="modalIngresoBox">
        <button type="button" class="modal-ingreso-close" onclick="cerrarModalIngreso()" aria-label="Cerrar modal">&times;</button>

        <!-- ── VISTA PRINCIPAL: FAST-FOOD CLUB SABORATOR ─────────────────────── -->
        <div id="viewClubSaboratorMain">
            <div class="kfc-auth-header">
                <div class="kfc-club-badge">🍔 Club Saborator</div>
                <h3 class="kfc-auth-title" id="modalClubTitle">¡Bienvenido al Club Saborator!</h3>
                <p class="kfc-auth-sub">Inicia sesión o regístrate en segundos para pedir, guardar tus direcciones y rastrear tu orden en vivo.</p>
            </div>

            <!-- Feedback general -->
            <div id="kfcFeedbackBox" class="kfc-feedback-box"></div>

            <!-- Pestañas de Acceso Rápido (Estilo KFC Colombia) -->
            <div class="kfc-tab-selector" role="tablist">
                <button type="button" class="kfc-tab-btn active" id="tabKfcOtp" onclick="cambiarPestanaKfc('otp')">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/></svg>
                    <span>WhatsApp OTP</span>
                </button>
                <button type="button" class="kfc-tab-btn" id="tabKfcClave" onclick="cambiarPestanaKfc('clave')">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    <span>Correo / Clave</span>
                </button>
            </div>

            <!-- PANEL 1: ACCESO DIRECTO CON CÓDIGO OTP POR WHATSAPP (SIN CONTRASEÑA) -->
            <div class="kfc-tab-panel active" id="panelKfcOtp">
                <!-- Paso 1: Digitar Celular -->
                <form id="formKfcPedirOtp" onsubmit="ejecutarPedirOtpWhatsApp(event)">
                    <div class="kfc-field-wrap">
                        <label for="kfcPhoneInput">Número de Celular *</label>
                        <div class="kfc-phone-group">
                            <div class="kfc-prefix-pill">🇨🇴 +57</div>
                            <input type="tel" id="kfcPhoneInput" class="kfc-input" placeholder="300 123 4567" maxlength="12" required />
                        </div>
                    </div>
                    <button type="submit" class="btn-kfc-cta whatsapp" id="btnPedirOtpSubmit">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.196 8.196 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.25-.75-.67-1.26-1.5-1.41-1.75-.15-.25-.02-.39.11-.51.11-.11.25-.29.38-.44.12-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.13.17 1.77 2.7 4.29 3.79.6.26 1.07.41 1.44.53.6.19 1.15.16 1.58.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.07-.12-.23-.19-.48-.31z"/>
                        </svg>
                        <span>Pedir código por WhatsApp</span>
                    </button>
                </form>

                <!-- Paso 2: Confirmar Código OTP (Aparece tras enviar) -->
                <form id="formKfcVerificarOtp" style="display:none;" onsubmit="ejecutarVerificarOtpWhatsApp(event)">
                    <div style="background:rgba(37,211,102,0.12);border:1px solid rgba(37,211,102,0.3);border-radius:10px;padding:0.65rem 0.85rem;margin-bottom:0.85rem;font-size:0.82rem;color:#15803D;">
                        📲 Enviamos tu código de 6 dígitos al WhatsApp <strong>+57 <span id="kfcNumeroEnviado"></span></strong>.
                    </div>
                    <div class="kfc-field-wrap">
                        <label for="kfcOtpInput">Digita los 6 dígitos del código *</label>
                        <input type="text" id="kfcOtpInput" class="kfc-input otp-digits" placeholder="••••••" maxlength="6" inputmode="numeric" required />
                    </div>
                    <div class="kfc-field-wrap" id="kfcWrapNombreNuevo">
                        <label for="kfcNombreCliente">Tu nombre (para tus pedidos) *</label>
                        <input type="text" id="kfcNombreCliente" class="kfc-input" placeholder="Ej: Juan Pérez" />
                    </div>
                    <button type="submit" class="btn-kfc-cta red" id="btnVerificarOtpSubmit">
                        <span>Confirmar e Ingresar</span>
                    </button>
                    <div style="text-align:center;margin-top:0.65rem;">
                        <a href="javascript:void(0)" onclick="reiniciarFlujoOtpKfc()" class="btn-auth-back" style="font-size:0.8rem;color:#E4002B;font-weight:700;">
                            ← Cambiar número o reenviar código
                        </a>
                    </div>
                </form>
            </div>

            <!-- PANEL 2: INGRESO CON CORREO / CELULAR + CONTRASEÑA -->
            <div class="kfc-tab-panel" id="panelKfcClave">
                <form id="formKfcLoginClave" onsubmit="ejecutarLoginClaveKfc(event)">
                    <div class="kfc-field-wrap">
                        <label for="kfcEmailInput">Correo o Celular *</label>
                        <input type="text" id="kfcEmailInput" class="kfc-input" placeholder="ejemplo@gmail.com o 3001234567" required />
                    </div>
                    <div class="kfc-field-wrap">
                        <label for="kfcPassInput">Contraseña *</label>
                        <input type="password" id="kfcPassInput" class="kfc-input" placeholder="••••••••" required />
                    </div>
                    <button type="submit" class="btn-kfc-cta red" id="btnLoginClaveSubmit">
                        <span>Ingresar a mi cuenta</span>
                    </button>
                    <div style="text-align:center;margin-top:0.65rem;">
                        <a href="javascript:void(0)" onclick="cambiarPestanaKfc('otp')" style="font-size:0.8rem;color:#4B5563;font-weight:600;">
                            ¿Sin contraseña? <strong style="color:#E4002B;">Entra con WhatsApp OTP en segundos</strong>
                        </a>
                    </div>
                </form>
            </div>

            <!-- Separador Oficial -->
            <div class="kfc-divider">
                <span>O continúa con</span>
            </div>

            <!-- ── INTEGRACIÓN OFICIAL GOOGLE IDENTITY SERVICES (GSI & ONE TAP) ──── -->
            <div id="g_id_onload"
                 data-client_id="@googleClientId"
                 data-context="signin"
                 data-callback="handleGoogleCredentialResponse"
                 data-auto_prompt="true"
                 data-auto_select="false"
                 data-itp_support="true">
            </div>

            <!-- Contenedor donde Google SDK renderiza el botón oficial nativo -->
            <div id="googleOfficialBtnContainer" class="google-official-btn-wrap"></div>

            <!-- Botón Oficial "Continuar con Google" de respaldo con disparo interactivo -->
            <button type="button" class="btn-google-official" id="btnGoogleOfficial" onclick="iniciarGoogleAuthOficial()" title="Acceder con tu cuenta de Google">
                <svg viewBox="0 0 24 24">
                    <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                    <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                    <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                    <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                </svg>
                <span>Continuar con Google</span>
            </button>

            <p style="font-size:0.73rem;color:#6B7280;text-align:center;margin-top:1.15rem;line-height:1.45;">
                Al continuar confirmas que aceptas nuestros
                <a asp-controller="Home" asp-action="Terminos" target="_blank" style="color:#E4002B;text-decoration:underline;font-weight:700;">Términos y condiciones</a> y las
                <a asp-controller="Home" asp-action="Terminos" asp-fragment="datos" target="_blank" style="color:#E4002B;text-decoration:underline;font-weight:700;">Políticas de privacidad</a>.
            </p>
        </div>
    </div>
</div>

<!-- ══ SCRIPT DE CONTROLADOR FAST-FOOD & GOOGLE GSI OFICIAL ═══════════════════ -->
<script>
    let kfcCelularActual = '';
    const googleClientIdConfig = '@googleClientId';

    function abrirModalIngreso() {
        const overlay = document.getElementById('modalIngresoOverlay');
        if (overlay) {
            overlay.classList.add('active');
            document.body.style.overflow = 'hidden';
            setTimeout(() => document.getElementById('kfcPhoneInput')?.focus(), 120);
            // Activar / refrescar selector oficial de cuentas de Google en el dispositivo
            inicializarGoogleIdentityServices();
        }
    }

    function cerrarModalIngreso() {
        const overlay = document.getElementById('modalIngresoOverlay');
        if (overlay) {
            overlay.classList.remove('active');
            document.body.style.overflow = '';
            limpiarKfcFeedbacks();
        }
    }

    function cambiarPestanaKfc(tab) {
        document.querySelectorAll('.kfc-tab-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.kfc-tab-panel').forEach(p => p.classList.remove('active'));
        limpiarKfcFeedbacks();

        if (tab === 'otp') {
            document.getElementById('tabKfcOtp')?.classList.add('active');
            document.getElementById('panelKfcOtp')?.classList.add('active');
            setTimeout(() => document.getElementById('kfcPhoneInput')?.focus(), 60);
        } else {
            document.getElementById('tabKfcClave')?.classList.add('active');
            document.getElementById('panelKfcClave')?.classList.add('active');
            setTimeout(() => document.getElementById('kfcEmailInput')?.focus(), 60);
        }
    }

    // ── 1. Flujo WhatsApp OTP (Estilo KFC) ──
    async function ejecutarPedirOtpWhatsApp(e) {
        e.preventDefault();
        const rawPhone = document.getElementById('kfcPhoneInput')?.value || '';
        const phone = rawPhone.replace(/\D/g, '');

        if (phone.length !== 10) {
            mostrarKfcFeedback('Por favor ingresa los 10 dígitos de tu celular (ej. 3001234567).', false);
            return;
        }

        const btn = document.getElementById('btnPedirOtpSubmit');
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<span>Enviando código a WhatsApp...</span>';
        }

        try {
            const resp = await fetch('/Login/EnviarOtpWhatsApp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ Telefono: phone })
            });
            const data = await resp.json();

            if (!resp.ok || !data.ok) {
                mostrarKfcFeedback(data.mensaje || 'No se pudo enviar el código por WhatsApp.', false);
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<span>Pedir código por WhatsApp</span>';
                }
                return;
            }

            kfcCelularActual = phone;
            document.getElementById('kfcNumeroEnviado').textContent = phone;
            document.getElementById('formKfcPedirOtp').style.display = 'none';
            document.getElementById('formKfcVerificarOtp').style.display = 'block';
            mostrarKfcFeedback(data.mensaje, true);

            if (data.demoCode) {
                document.getElementById('kfcOtpInput').value = data.demoCode;
            }
            document.getElementById('kfcOtpInput')?.focus();
        } catch (err) {
            console.error(err);
            mostrarKfcFeedback('Error de conexión al solicitar el código OTP.', false);
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = '<span>Pedir código por WhatsApp</span>';
            }
        }
    }

    async function ejecutarVerificarOtpWhatsApp(e) {
        e.preventDefault();
        const code = (document.getElementById('kfcOtpInput')?.value || '').trim();
        const nombre = (document.getElementById('kfcNombreCliente')?.value || '').trim();
        const btn = document.getElementById('btnVerificarOtpSubmit');

        if (code.length !== 6) {
            mostrarKfcFeedback('Por favor digita los 6 dígitos del código recibido.', false);
            return;
        }

        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<span>Verificando tu acceso...</span>';
        }

        try {
            const resp = await fetch('/Login/VerificarOtpWhatsApp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    Telefono: kfcCelularActual,
                    Codigo: code,
                    Nombre: nombre,
                    ReturnUrl: window.location.pathname
                })
            });
            const data = await resp.json();

            if (!resp.ok || !data.ok) {
                mostrarKfcFeedback(data.mensaje || 'Código incorrecto o expirado.', false);
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<span>Confirmar e Ingresar</span>';
                }
                return;
            }

            mostrarKfcFeedback(data.mensaje || '¡Acceso concedido! Bienvenido al Club Saborator.', true);
            setTimeout(() => {
                window.location.href = data.redirectUrl || '/';
            }, 600);
        } catch (err) {
            console.error(err);
            mostrarKfcFeedback('Error de conexión al verificar el código.', false);
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = '<span>Confirmar e Ingresar</span>';
            }
        }
    }

    function reiniciarFlujoOtpKfc() {
        document.getElementById('formKfcPedirOtp').style.display = 'block';
        document.getElementById('formKfcVerificarOtp').style.display = 'none';
        document.getElementById('kfcOtpInput').value = '';
        const btn = document.getElementById('btnPedirOtpSubmit');
        if (btn) {
            btn.disabled = false;
            btn.innerHTML = '<span>Pedir código por WhatsApp</span>';
        }
        limpiarKfcFeedbacks();
    }

    // ── 2. Flujo Correo / Contraseña ──
    async function ejecutarLoginClaveKfc(e) {
        e.preventDefault();
        const usuario = document.getElementById('kfcEmailInput')?.value.trim();
        const pass = document.getElementById('kfcPassInput')?.value;
        const btn = document.getElementById('btnLoginClaveSubmit');

        if (!usuario || !pass) {
            mostrarKfcFeedback('Por favor digita tu usuario o correo y tu contraseña.', false);
            return;
        }

        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<span>Ingresando...</span>';
        }

        try {
            const resp = await fetch('/Login/LoginAjax', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ usuario, password: pass, returnUrl: window.location.pathname })
            });
            const data = await resp.json();

            if (!resp.ok || !data.ok) {
                mostrarKfcFeedback(data.mensaje || 'Credenciales inválidas.', false);
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<span>Ingresar a mi cuenta</span>';
                }
                return;
            }

            mostrarKfcFeedback('¡Ingreso exitoso al Club Saborator! Redirigiendo...', true);
            setTimeout(() => {
                window.location.href = data.redirectUrl || '/';
            }, 600);
        } catch (err) {
            console.error(err);
            mostrarKfcFeedback('Error de conexión al ingresar.', false);
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = '<span>Ingresar a mi cuenta</span>';
            }
        }
    }

    // ── 3. Flujo Oficial Google Identity Services (GSI SDK) ──
    function inicializarGoogleIdentityServices() {
        const cId = googleClientIdConfig || '';
        if (!cId) {
            console.info('Club Saborator: Google ClientId no está configurado aún en Authentication:Google:ClientId.');
            return;
        }

        if (typeof google !== 'undefined' && google.accounts && google.accounts.id) {
            try {
                google.accounts.id.initialize({
                    client_id: cId,
                    callback: handleGoogleCredentialResponse,
                    auto_select: false,
                    cancel_on_tap_outside: true
                });

                // Renderizar botón oficial de Google dentro del contenedor
                const container = document.getElementById('googleOfficialBtnContainer');
                if (container && !container.hasChildNodes()) {
                    google.accounts.id.renderButton(container, {
                        type: 'standard',
                        shape: 'rectangular',
                        theme: 'outline',
                        text: 'continue_with',
                        size: 'large',
                        logo_alignment: 'left',
                        width: Math.min(340, window.innerWidth - 60)
                    });
                    // Ocultar botón estático si el botón oficial nativo de Google ya se renderizó
                    const btnStatic = document.getElementById('btnGoogleOfficial');
                    if (btnStatic) btnStatic.style.display = 'none';
                }

                // Activar Google One Tap (abre selector nativo con cuentas reales de Google del dispositivo)
                google.accounts.id.prompt((notification) => {
                    if (notification.isNotDisplayed()) {
                        console.info('Google One Tap no visible:', notification.getNotDisplayedReason());
                    }
                });
            } catch (err) {
                console.warn('Google GSI init notice:', err);
            }
        } else {
            // Reintentar si el script oficial de Google aún se está descargando
            setTimeout(inicializarGoogleIdentityServices, 200);
        }
    }

    // Clic en "Continuar con Google" abre el selector OFICIAL de cuentas de Google (accounts.google.com)
    function iniciarGoogleAuthOficial() {
        limpiarKfcFeedbacks();

        if (typeof google !== 'undefined' && google.accounts && google.accounts.id) {
            // Forzar prompt nativo de cuentas reales de Google del dispositivo
            google.accounts.id.prompt((notification) => {
                if (notification.isNotDisplayed()) {
                    mostrarKfcFeedback('Por favor selecciona tu cuenta en la ventana emergente de Google.', true);
                }
            });
        } else {
            mostrarKfcFeedback('Cargando el selector oficial de Google... Intenta de nuevo en unos segundos.', false);
        }
    }

    // Callback oficial que recibe el Token JWT emitido por Google accounts.google.com
    async function handleGoogleCredentialResponse(response) {
        if (!response || !response.credential) return;

        mostrarKfcFeedback('Autenticando con cuenta de Google...', true);
        try {
            const resp = await fetch('/Login/GoogleCallback', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({
                    credential: response.credential,
                    returnUrl: window.location.pathname
                })
            });
            const data = await resp.json();

            if (data && data.ok) {
                mostrarKfcFeedback(data.mensaje || '¡Acceso concedido con Google!', true);
                setTimeout(() => {
                    window.location.href = data.redirectUrl || '/#menu';
                }, 600);
            } else {
                mostrarKfcFeedback(data.mensaje || 'Error al autenticar tu cuenta de Google.', false);
            }
        } catch (err) {
            console.error('Error GoogleCallback:', err);
            mostrarKfcFeedback('Error de comunicación al autenticar con Google.', false);
        }
    }

    function mostrarKfcFeedback(msg, esExito) {
        const box = document.getElementById('kfcFeedbackBox');
        if (box) {
            box.textContent = msg;
            box.className = 'kfc-feedback-box ' + (esExito ? 'success' : 'error');
            box.style.display = 'block';
        }
    }

    function limpiarKfcFeedbacks() {
        document.querySelectorAll('.kfc-feedback-box').forEach(b => {
            b.style.display = 'none';
            b.textContent = '';
        });
    }

    // Cerrar modal al presionar Escape o clic fuera
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
            const overlay = document.getElementById('modalIngresoOverlay');
            if (overlay && overlay.classList.contains('active')) {
                cerrarModalIngreso();
            }
        }
    });

    document.getElementById('modalIngresoOverlay')?.addEventListener('click', function (e) {
        if (e.target === this) {
            cerrarModalIngreso();
        }
    });

    // Auto-inicializar Google GSI cuando el DOM y el SDK estén listos
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', inicializarGoogleIdentityServices);
    } else {
        inicializarGoogleIdentityServices();
    }
</script>
