@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    // Valores vacíos cuentan como "no configurado": sin un ClientId real el botón de Google se oculta
    var googleClientId = new[]
    {
        Configuration["Authentication:Google:ClientId"],
        Configuration["Google:ClientId"],
        Environment.GetEnvironmentVariable("GOOGLE_CLIENT_ID")
    }.FirstOrDefault(v => !string.IsNullOrWhiteSpace(v))?.Trim() ?? "";
    var googleHabilitado = !string.IsNullOrEmpty(googleClientId);
    // Facebook: el botón siempre se ve; si falta el AppId, al pulsarlo se avisa que aún no está activado
    var facebookAppId = new[]
    {
        Configuration["Authentication:Facebook:AppId"],
        Configuration["Facebook:AppId"],
        Environment.GetEnvironmentVariable("FACEBOOK_APP_ID")
    }.FirstOrDefault(v => !string.IsNullOrWhiteSpace(v))?.Trim() ?? "";
}

@if (googleHabilitado)
{
    <!-- SDK Oficial de Google Identity Services (GSI) -->
    <script src="https://accounts.google.com/gsi/client" async defer></script>
}

<!-- ══ CLUB SABORATOR: MODAL DE AUTENTICACIÓN ESTILO KFC FAST-FOOD ════════════ -->
<div class="modal-ingreso-overlay" id="modalIngresoOverlay" aria-modal="true" role="dialog" aria-labelledby="modalClubTitle">
    <div class="modal-ingreso-box" id="modalIngresoBox">
        <button type="button" class="modal-ingreso-close" onclick="cerrarModalIngreso()" aria-label="Cerrar modal">&times;</button>

        <!-- ── VISTA PRINCIPAL: elegir cómo ingresar (Google, Facebook o correo) ───────────────── -->
        <div id="viewClubSaboratorMain">
            <div class="kfc-auth-header">
                <h3 class="kfc-auth-title kfc-auth-title-grande" id="modalClubTitle">Ingresa a tu cuenta</h3>
            </div>

            <!-- Feedback general -->
            <div id="kfcFeedbackBox" class="kfc-feedback-box"></div>

            <div class="kfc-social-stack">
                @if (googleHabilitado)
                {
                <div id="g_id_onload"
                     data-client_id="@googleClientId"
                     data-context="signin"
                     data-callback="handleGoogleCredentialResponse"
                     data-auto_prompt="false"
                     data-auto_select="false"
                     data-itp_support="true">
                </div>
                <!-- Pastilla visible igual a las demás; el botón oficial de Google (que dibuja su SDK) va encima, invisible, para que el clic sea el oficial -->
                <div class="btn-social-google-wrap" id="googleWrap">
                    <button type="button" class="btn-social btn-social-google" id="btnGoogleOfficial" onclick="iniciarGoogleAuthOficial()">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/></svg><span>Continuar con Google</span>
                    </button>
                    <div id="googleOfficialBtnContainer" class="google-official-btn-wrap"><div id="googleOfficialBtnInner"></div></div>
                </div>
                }
                <button type="button" class="btn-social btn-social-facebook" id="btnFacebookAuth" onclick="iniciarFacebookAuth()">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#fff" d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.5 0-1.96.93-1.96 1.88v2.27h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07z"/></svg><span>Continuar con Facebook</span>
                </button>
                <button type="button" class="btn-social btn-social-correo" id="btnCorreoAuth" onclick="mostrarVista('correo')">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg><span>Continuar con correo electrónico</span>
                </button>
            </div>

            <p class="kfc-legal">
                Al continuar confirmas que aceptas nuestros
                <a asp-controller="Home" asp-action="Terminos" target="_blank">Términos y condiciones</a> y las
                <a asp-controller="Home" asp-action="Terminos" asp-fragment="datos" target="_blank">Políticas de privacidad</a>.
            </p>
        </div>

        <!-- ── VISTA: INGRESAR CON CORREO (usuario o correo + contraseña); desde aquí se puede crear la cuenta ─── -->
        <div id="viewClubSaboratorCorreo" hidden>
            <button type="button" class="kfc-back-btn" onclick="mostrarVista('main')" aria-label="Volver a las opciones de ingreso">
                <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <div class="kfc-auth-header">
                <h3 class="kfc-auth-title kfc-auth-title-grande" id="modalCorreoTitle">Ingresa con tu correo</h3>
            </div>

            <div id="kfcFeedbackBoxCorreo" class="kfc-feedback-box"></div>

            <form id="formKfcLoginClave" onsubmit="ejecutarLoginClaveKfc(event)">
                <div class="kfc-field-wrap">
                    <label for="kfcUsuarioInput">Usuario o correo</label>
                    <input type="text" id="kfcUsuarioInput" class="kfc-input" placeholder="Tu usuario o correo electrónico" autocomplete="username" autocapitalize="none" spellcheck="false" />
                </div>
                <div class="kfc-field-wrap">
                    <label for="kfcPassInput">Contraseña *</label>
                    <input type="password" id="kfcPassInput" class="kfc-input" placeholder="••••••••" autocomplete="current-password" required />
                </div>
                <button type="submit" class="btn-kfc-cta red" id="btnLoginClaveSubmit">
                    <span>Ingresar a mi cuenta</span>
                </button>
            </form>

            <div class="kfc-switch-view">
                ¿Aún no tienes cuenta?
                <button type="button" class="kfc-link-btn" onclick="mostrarVista('registro')">Crea una aquí</button>
            </div>
        </div>

        <!-- ── VISTA: CREAR CUENTA (nombre, apellido, usuario, correo y contraseña) ─── -->
        <div id="viewClubSaboratorRegistro" hidden>
            <div class="kfc-auth-header">
                <h3 class="kfc-auth-title" id="modalRegistroTitle">Crea tu cuenta</h3>
                <p class="kfc-auth-sub">Completa tus datos y empieza a pedir, guardar tus direcciones y rastrear tu orden en vivo.</p>
            </div>

            <div id="kfcFeedbackBoxReg" class="kfc-feedback-box"></div>

            <form id="formKfcRegistro" onsubmit="ejecutarRegistroKfc(event)" novalidate>
                @Html.AntiForgeryToken()
                <div class="kfc-row-2">
                    <div class="kfc-field-wrap">
                        <label for="kfcRegNombre">Nombre *</label>
                        <input type="text" id="kfcRegNombre" class="kfc-input" placeholder="Ej: Carlos" maxlength="50" autocomplete="given-name" required />
                    </div>
                    <div class="kfc-field-wrap">
                        <label for="kfcRegApellido">Apellido *</label>
                        <input type="text" id="kfcRegApellido" class="kfc-input" placeholder="Ej: Ramírez" maxlength="50" autocomplete="family-name" required />
                    </div>
                </div>
                <div class="kfc-field-wrap">
                    <label for="kfcRegUsuario">Usuario *</label>
                    <input type="text" id="kfcRegUsuario" class="kfc-input" placeholder="Ej: carlosr" maxlength="30" autocomplete="username" autocapitalize="none" spellcheck="false" required />
                </div>
                <div class="kfc-field-wrap">
                    <label for="kfcRegCorreo">Correo electrónico *</label>
                    <input type="email" id="kfcRegCorreo" class="kfc-input" placeholder="ejemplo@gmail.com" maxlength="100" autocomplete="email" autocapitalize="none" spellcheck="false" required />
                </div>
                <div class="kfc-row-2">
                    <div class="kfc-field-wrap">
                        <label for="kfcRegPass">Contraseña *</label>
                        <input type="password" id="kfcRegPass" class="kfc-input" placeholder="Mín. 8 caracteres" autocomplete="new-password" required />
                    </div>
                    <div class="kfc-field-wrap">
                        <label for="kfcRegPassConf">Confirmar *</label>
                        <input type="password" id="kfcRegPassConf" class="kfc-input" placeholder="Repite la contraseña" autocomplete="new-password" required />
                    </div>
                </div>
                <button type="submit" class="btn-kfc-cta red" id="btnRegistroSubmit">
                    <span>Crear mi cuenta</span>
                </button>
            </form>

            <div class="kfc-switch-view">
                ¿Ya tienes una cuenta?
                <button type="button" class="kfc-link-btn" onclick="mostrarVista('correo')">Inicia sesión</button>
            </div>
        </div>
    </div>
</div>

<!-- ══ SCRIPT DE CONTROLADOR FAST-FOOD & GOOGLE GSI OFICIAL ═══════════════════ --><script>
        const googleClientIdConfig = '@googleClientId';
        const facebookAppIdConfig = '@facebookAppId';

    function abrirModalIngreso() {
        const overlay = document.getElementById('modalIngresoOverlay');
        if (overlay) {
            overlay.classList.add('active');
            document.body.style.overflow = 'hidden';
            mostrarVista('main');
            setTimeout(ofrecerSelectorAlAbrir, 1500);
            // Activar / refrescar selector oficial de cuentas de Google en el dispositivo
            inicializarGoogleIdentityServices();
        }
    }

    function cerrarModalIngreso() {
        const overlay = document.getElementById('modalIngresoOverlay');
        if (overlay) {
            overlay.classList.remove('active');
            document.body.style.overflow = '';
            limpiarKfcFeedbacks();
            mostrarVista('main');
        }
    }

    // ── 2. Flujo Correo / Contraseña ──
    async function ejecutarLoginClaveKfc(e) {
        e.preventDefault();
        const usuario = document.getElementById('kfcUsuarioInput')?.value.trim()
            || document.getElementById('kfcEmailInput')?.value.trim();
        const pass = document.getElementById('kfcPassInput')?.value;
        const btn = document.getElementById('btnLoginClaveSubmit');

        if (!usuario || !pass) {
            mostrarKfcFeedback('Por favor digita tu correo o nombre de usuario y tu contraseña.', false);
            return;
        }

        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<span>Ingresando...</span>';
        }

        try {
            const resp = await fetch('/Login/LoginAjax', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ usuario, password: pass, returnUrl: window.location.pathname })
            });
            const data = await resp.json();

            if (!resp.ok || !data.ok) {
                mostrarKfcFeedback(data.mensaje || 'Credenciales inválidas.', false);
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<span>Ingresar a mi cuenta</span>';
                }
                return;
            }

            mostrarKfcFeedback('¡Ingreso exitoso al Club Saborator! Redirigiendo...', true);
            setTimeout(() => {
                window.location.href = data.redirectUrl || '/';
            }, 600);
        } catch (err) {
            console.error(err);
            mostrarKfcFeedback('Error de conexión al ingresar.', false);
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = '<span>Ingresar a mi cuenta</span>';
            }
        }
    }

    // ── 3. Flujo Oficial Google Identity Services (GSI SDK) ──
    // Dos caminos oficiales de Google, que conviven:
    //  · el botón oficial de Google (invisible, encima de nuestra pastilla), si Google lo dibuja;
    //  · el selector de cuentas "One Tap", que se muestra al abrir el modal y al pulsar la pastilla si el botón no está.
    // Se inicializa UNA sola vez y nunca hay dos solicitudes de One Tap a la vez.
    let gsiIniciado = false, gsiIntentos = 0, gsiBotonVisible = false, gsiSelectorPendiente = false;
    const esEntornoLocal = ['localhost', '127.0.0.1'].includes(location.hostname);

    function actualizarEstadoGoogle() {
        const contenedor = document.getElementById('googleOfficialBtnContainer');
        const marco = contenedor ? contenedor.querySelector('iframe') : null;
        gsiBotonVisible = !!marco && marco.getBoundingClientRect().width > 0;
        if (contenedor) contenedor.classList.toggle('listo', gsiBotonVisible);
        return gsiBotonVisible;
    }

    // Motivo por el que Google no mostró su selector, en palabras para la persona
    function motivoGoogle(razon) {
        switch (razon) {
            case 'unregistered_origin':
                return esEntornoLocal
                    ? 'Google no tiene registrada esta dirección (' + location.origin + '). Agrégala en "Orígenes autorizados de JavaScript" del ID de cliente en Google Cloud.'
                    : 'El ingreso con Google no está disponible en este momento. Usa tu correo electrónico.';
            case 'opt_out_or_no_session':
                return 'No hay una sesión de Google abierta en este navegador. Inicia sesión en Google (accounts.google.com) e intenta de nuevo, o usa tu correo.';
            case 'suppressed_by_user':
                return 'Google ocultó el selector porque lo cerraste hace poco. Espera unos minutos, o usa tu correo.';
            case 'browser_not_supported':
                return 'Este navegador no es compatible con el acceso con Google. Usa tu correo electrónico.';
            default:
                return 'Google no pudo mostrar el selector de cuentas. Intenta de nuevo, o usa tu correo.';
        }
    }

    // Muestra el selector de cuentas de Google. Con avisar=true explica el motivo si no aparece.
    function mostrarSelectorGoogle(avisar) {
        if (!gsiIniciado || gsiSelectorPendiente) return;
        gsiSelectorPendiente = true;
        try {
            google.accounts.id.prompt(function (notificacion) {
                if (notificacion.isNotDisplayed && notificacion.isNotDisplayed()) {
                    gsiSelectorPendiente = false;
                    const razon = notificacion.getNotDisplayedReason ? notificacion.getNotDisplayedReason() : '';
                    console.info('Google One Tap no visible:', razon);
                    if (avisar) mostrarKfcFeedback(motivoGoogle(razon), false);
                } else if ((notificacion.isSkippedMoment && notificacion.isSkippedMoment()) || (notificacion.isDismissedMoment && notificacion.isDismissedMoment())) {
                    gsiSelectorPendiente = false;
                }
            });
        } catch (err) {
            gsiSelectorPendiente = false;
            console.warn('Google One Tap:', err);
        }
    }

    function inicializarGoogleIdentityServices() {
        const cId = googleClientIdConfig || '';
        if (!cId || gsiIniciado) return;

        if (typeof google !== 'undefined' && google.accounts && google.accounts.id) {
            gsiIniciado = true;
            try {
                google.accounts.id.initialize({
                    client_id: cId,
                    callback: handleGoogleCredentialResponse,
                    auto_select: false,
                    cancel_on_tap_outside: true
                });
                const interior = document.getElementById('googleOfficialBtnInner');
                if (interior && !interior.hasChildNodes()) {
                    const ancho = Math.min(400, Math.round((document.getElementById('googleWrap') || {}).clientWidth || 340));
                    google.accounts.id.renderButton(interior, {
                        type: 'standard', shape: 'pill', theme: 'outline', text: 'continue_with', size: 'large', logo_alignment: 'left', width: ancho
                    });
                }
                // Cuando Google dibuja su botón oficial, pasa a recibir el clic (se revisa durante unos segundos)
                let revisiones = 0;
                const revisar = setInterval(function () { if (actualizarEstadoGoogle() || ++revisiones > 24) clearInterval(revisar); }, 500);
                // Si el modal ya está abierto, se ofrece el selector de cuentas
                if (document.getElementById('modalIngresoOverlay')?.classList.contains('active')) setTimeout(ofrecerSelectorAlAbrir, 1500);
            } catch (err) {
                console.warn('Google GSI init notice:', err);
            }
        } else if (gsiIntentos++ < 50) {
            // El SDK de Google aún se está descargando: se reintenta durante unos 10 segundos
            setTimeout(inicializarGoogleIdentityServices, 200);
        }
    }

    // Al abrir el modal: si Google dibujó su botón oficial no hace falta más; si no, se abre el selector de cuentas
    function ofrecerSelectorAlAbrir() {
        if (!gsiIniciado) return;
        if (!actualizarEstadoGoogle()) mostrarSelectorGoogle(false);
    }

    // Clic en la pastilla: normalmente lo recibe el botón oficial que la cubre; si no está, se abre el selector de cuentas
    function iniciarGoogleAuthOficial() {
        limpiarKfcFeedbacks();
        if (typeof google === 'undefined' || !google.accounts || !google.accounts.id || !gsiIniciado) {
            mostrarKfcFeedback('Cargando el selector oficial de Google... Intenta de nuevo en unos segundos.', false);
            inicializarGoogleIdentityServices();
            return;
        }
        gsiSelectorPendiente = false;   // un clic explícito siempre pide el selector de nuevo
        mostrarSelectorGoogle(true);
    }

    // Callback oficial que recibe el Token JWT emitido por Google accounts.google.com
    async function handleGoogleCredentialResponse(response) {
        if (!response || !response.credential) return;

        mostrarKfcFeedback('Autenticando con cuenta de Google...', true);
        try {
            const resp = await fetch('/Login/GoogleCallback', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({
                    credential: response.credential,
                    returnUrl: window.location.pathname
                })
            });
            const data = await resp.json();

            if (data && data.ok) {
                mostrarKfcFeedback(data.mensaje || '¡Acceso concedido con Google!', true);
                setTimeout(() => {
                    window.location.href = data.redirectUrl || '/Carta';
                }, 600);
            } else {
                mostrarKfcFeedback(data.mensaje || 'Error al autenticar tu cuenta de Google.', false);
            }
        } catch (err) {
            console.error('Error GoogleCallback:', err);
            mostrarKfcFeedback('Error de comunicación al autenticar con Google.', false);
        }
    }

    // ── Facebook Login (SDK oficial de Facebook; el servidor valida el token en /Login/FacebookAuth) ──
    let facebookSdkListo = null;
    function cargarFacebookSdk() {
        if (facebookSdkListo) return facebookSdkListo;
        facebookSdkListo = new Promise((resolver, rechazar) => {
            window.fbAsyncInit = function () {
                FB.init({ appId: facebookAppIdConfig, cookie: false, xfbml: false, version: 'v19.0' });
                resolver();
            };
            const s = document.createElement('script');
            s.src = 'https://connect.facebook.net/es_LA/sdk.js';
            s.async = true;
            s.onerror = () => { facebookSdkListo = null; rechazar(new Error('sdk')); };
            document.head.appendChild(s);
        });
        return facebookSdkListo;
    }

    async function iniciarFacebookAuth() {
        limpiarKfcFeedbacks();
        if (!facebookAppIdConfig) {
            mostrarKfcFeedback('El acceso con Facebook aún no está activado. Por ahora ingresa con Google o con tu correo.', false);
            return;
        }
        try {
            await cargarFacebookSdk();
        } catch (e) {
            mostrarKfcFeedback('No se pudo cargar Facebook. Revisa tu conexión e intenta de nuevo.', false);
            return;
        }
        FB.login(function (r) {
            if (!r || !r.authResponse) {
                mostrarKfcFeedback('No se completó el inicio de sesión con Facebook.', false);
                return;
            }
            enviarTokenFacebook(r.authResponse.accessToken);
        }, { scope: 'public_profile,email' });
    }

    async function enviarTokenFacebook(accessToken) {
        mostrarKfcFeedback('Autenticando con Facebook...', true);
        try {
            const resp = await fetch('/Login/FacebookAuth', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                body: JSON.stringify({ accessToken, returnUrl: window.location.pathname })
            });
            const data = await resp.json();
            if (data && data.ok) {
                mostrarKfcFeedback(data.mensaje || '¡Acceso concedido con Facebook!', true);
                setTimeout(() => { window.location.href = data.redirectUrl || '/Carta'; }, 600);
            } else {
                mostrarKfcFeedback((data && data.mensaje) || 'No se pudo ingresar con Facebook.', false);
            }
        } catch (err) {
            console.error('Error FacebookAuth:', err);
            mostrarKfcFeedback('Error de comunicación al autenticar con Facebook.', false);
        }
    }

    // ── Vistas del modal: 'main' (Google / Facebook / correo), 'correo' (usuario + contraseña) y 'registro' (crear cuenta) ──
    function mostrarVista(nombre) {
        const vistas = { main: 'viewClubSaboratorMain', correo: 'viewClubSaboratorCorreo', registro: 'viewClubSaboratorRegistro' };
        limpiarKfcFeedbacks();
        Object.entries(vistas).forEach(([clave, id]) => { const el = document.getElementById(id); if (el) el.hidden = clave !== nombre; });
        const foco = { correo: 'kfcUsuarioInput', registro: 'kfcRegNombre' }[nombre];
        if (foco) setTimeout(() => document.getElementById(foco)?.focus(), 80);
    }
    // (se conserva por compatibilidad con enlaces anteriores)
    function mostrarVistaRegistro(mostrar) { mostrarVista(mostrar ? 'registro' : 'correo'); }

    // ── Crear cuenta con nombre, apellido, usuario, correo y contraseña ──
    async function ejecutarRegistroKfc(e) {
        e.preventDefault();
        const v = id => (document.getElementById(id)?.value || '');
        const nombre = v('kfcRegNombre').trim(), apellido = v('kfcRegApellido').trim();
        const usuario = v('kfcRegUsuario').trim(), correo = v('kfcRegCorreo').trim();
        const pass = v('kfcRegPass'), conf = v('kfcRegPassConf');
        const btn = document.getElementById('btnRegistroSubmit');

        let error = '';
        if (nombre.length < 2) error = 'Escribe tu nombre.';
        else if (apellido.length < 2) error = 'Escribe tu apellido.';
        else if (!/^[A-Za-z0-9._-]{3,30}$/.test(usuario)) error = 'El usuario debe tener entre 3 y 30 caracteres: letras, números, punto, guion o guion bajo.';
        else if (!/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(correo)) error = 'Escribe un correo electrónico válido.';
        else if (pass.length < 8) error = 'La contraseña debe tener al menos 8 caracteres.';
        else if (pass !== conf) error = 'Las contraseñas no coinciden.';
        if (error) { mostrarKfcFeedback(error, false); return; }

        const reabrir = () => { if (btn) { btn.disabled = false; btn.innerHTML = '<span>Crear mi cuenta</span>'; } };
        if (btn) { btn.disabled = true; btn.innerHTML = '<span>Creando cuenta...</span>'; }

        try {
            const token = document.querySelector('#formKfcRegistro input[name="__RequestVerificationToken"]')?.value || '';
            const resp = await fetch('/Login/RegistroRapidoAjax', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify({ nombre, apellido, usuario, correo, contrasena: pass, confirmar: conf, returnUrl: window.location.pathname })
            });
            const data = await resp.json();
            if (!resp.ok || !data.ok) {
                mostrarKfcFeedback(data.mensaje || 'No se pudo crear la cuenta.', false);
                reabrir();
                return;
            }
            mostrarKfcFeedback('¡Cuenta creada! Bienvenido al Club Saborator. Redirigiendo...', true);
            setTimeout(() => { window.location.href = data.redirectUrl || '/'; }, 700);
        } catch (err) {
            console.error(err);
            mostrarKfcFeedback('Error de conexión al crear la cuenta.', false);
            reabrir();
        }
    }

    function mostrarKfcFeedback(msg, esExito) {
        // El mensaje se muestra en la vista que está abierta (opciones, correo o registro)
        const abierta = (id) => { const el = document.getElementById(id); return el && !el.hidden; };
        const box = document.getElementById(abierta('viewClubSaboratorRegistro') ? 'kfcFeedbackBoxReg'
            : abierta('viewClubSaboratorCorreo') ? 'kfcFeedbackBoxCorreo' : 'kfcFeedbackBox');
        if (box) {
            box.textContent = msg;
            box.className = 'kfc-feedback-box ' + (esExito ? 'success' : 'error');
            box.style.display = 'block';
        }
    }

    function limpiarKfcFeedbacks() {
        document.querySelectorAll('.kfc-feedback-box').forEach(b => {
            b.style.display = 'none';
            b.textContent = '';
        });
    }

    // Cerrar modal al presionar Escape o clic fuera
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
            const overlay = document.getElementById('modalIngresoOverlay');
            if (overlay && overlay.classList.contains('active')) {
                cerrarModalIngreso();
            }
        }
    });

    document.getElementById('modalIngresoOverlay')?.addEventListener('click', function (e) {
        if (e.target === this) {
            cerrarModalIngreso();
        }
    });

    // "Iniciar sesión con otra cuenta": el inicio se abre con ?ingresar=1 y muestra este modal
    (function () {
        var params = new URLSearchParams(location.search);
        if (!params.has('ingresar')) return;
        params.delete('ingresar');
        var query = params.toString();
        history.replaceState(null, '', location.pathname + (query ? '?' + query : '') + location.hash);
        document.addEventListener('DOMContentLoaded', abrirModalIngreso);
    })();

    // Auto-inicializar Google GSI cuando el DOM y el SDK estén listos
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', inicializarGoogleIdentityServices);
    } else {
        inicializarGoogleIdentityServices();
    }
</script>
