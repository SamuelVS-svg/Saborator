@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    // Valores vacíos cuentan como "no configurado": sin un ClientId real el botón de Google se oculta
    var googleClientId = new[]
    {
        Configuration["Authentication:Google:ClientId"],
        Configuration["Google:ClientId"],
        Environment.GetEnvironmentVariable("GOOGLE_CLIENT_ID")
    }.FirstOrDefault(v => !string.IsNullOrWhiteSpace(v))?.Trim() ?? "";
    var googleHabilitado = !string.IsNullOrEmpty(googleClientId);
}

@if (googleHabilitado)
{
    <!-- SDK Oficial de Google Identity Services (GSI) -->
    <script src="https://accounts.google.com/gsi/client" async defer></script>
}

<!-- ══ CLUB SABORATOR: MODAL DE AUTENTICACIÓN ESTILO KFC FAST-FOOD ════════════ -->
<div class="modal-ingreso-overlay" id="modalIngresoOverlay" aria-modal="true" role="dialog" aria-labelledby="modalClubTitle">
    <div class="modal-ingreso-box" id="modalIngresoBox">
        <button type="button" class="modal-ingreso-close" onclick="cerrarModalIngreso()" aria-label="Cerrar modal">&times;</button>

        <!-- ── VISTA PRINCIPAL: usuario o correo + contraseña, o Google; desde aquí se crea la cuenta ───────────────── -->
        <div id="viewClubSaboratorMain">
            <div class="kfc-auth-header">
                <h3 class="kfc-auth-title kfc-auth-title-grande" id="modalClubTitle">Ingresa a tu cuenta</h3>
            </div>

            <!-- Feedback general -->
            <div id="kfcFeedbackBox" class="kfc-feedback-box"></div>

            <form id="formKfcLoginClave" onsubmit="ejecutarLoginClaveKfc(event)">
                <div class="kfc-field-wrap">
                    <label for="kfcUsuarioInput">Usuario o correo</label>
                    <input type="text" id="kfcUsuarioInput" class="kfc-input" placeholder="Tu usuario o correo electrónico" autocomplete="username" autocapitalize="none" spellcheck="false" />
                </div>
                <div class="kfc-field-wrap">
                    <label for="kfcPassInput">Contraseña *</label>
                    <input type="password" id="kfcPassInput" class="kfc-input" placeholder="••••••••" autocomplete="current-password" required />
                </div>
                <button type="submit" class="btn-kfc-cta red" id="btnLoginClaveSubmit">
                    <span>Ingresar a mi cuenta</span>
                </button>
            </form>

            <div class="kfc-divider"><span>o continúa con</span></div>

            <div class="kfc-social-stack">
                @if (googleHabilitado)
                {
                <div id="g_id_onload"
                     data-client_id="@googleClientId"
                     data-context="signin"
                     data-callback="handleGoogleCredentialResponse"
                     data-auto_prompt="false"
                     data-auto_select="false"
                     data-itp_support="true">
                </div>
                <!-- Pastilla visible igual a las demás; el botón oficial de Google (que dibuja su SDK) va encima, invisible, para que el clic sea el oficial -->
                <div class="btn-social-google-wrap" id="googleWrap">
                    <button type="button" class="btn-social btn-social-google" id="btnGoogleOfficial" onclick="iniciarGoogleAuthOficial()">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/></svg><span>Continuar con Google</span>
                    </button>
                    <div id="googleOfficialBtnContainer" class="google-official-btn-wrap"><div id="googleOfficialBtnInner"></div></div>
                </div>
                }
            </div>

            <div class="kfc-switch-view">
                ¿Aún no tienes cuenta?
                <button type="button" class="kfc-link-btn" onclick="mostrarVista('registro')">Crea una aquí</button>
            </div>

            <p class="kfc-legal">
                Al continuar confirmas que aceptas nuestros
                <a asp-controller="Home" asp-action="Terminos" target="_blank">Términos y condiciones</a> y las
                <a asp-controller="Home" asp-action="Terminos" asp-fragment="datos" target="_blank">Políticas de privacidad</a>.
            </p>
        </div>

        <!-- ── VISTA: CREAR CUENTA (nombre, apellido, usuario, correo y contraseña) ─── -->
        <div id="viewClubSaboratorRegistro" hidden>
            <div class="kfc-auth-header">
                <h3 class="kfc-auth-title" id="modalRegistroTitle">Crea tu cuenta</h3>
            </div>

            <div id="kfcFeedbackBoxReg" class="kfc-feedback-box"></div>

            <form id="formKfcRegistro" onsubmit="ejecutarRegistroKfc(event)" novalidate>
                @Html.AntiForgeryToken()
                <div class="kfc-row-2">
                    <div class="kfc-field-wrap">
                        <label for="kfcRegNombre">Nombre *</label>
                        <input type="text" id="kfcRegNombre" class="kfc-input" placeholder="Ej: Carlos" maxlength="50" autocomplete="given-name" required />
                    </div>
                    <div class="kfc-field-wrap">
                        <label for="kfcRegApellido">Apellido *</label>
                        <input type="text" id="kfcRegApellido" class="kfc-input" placeholder="Ej: Ramírez" maxlength="50" autocomplete="family-name" required />
                    </div>
                </div>
                <div class="kfc-field-wrap">
                    <label for="kfcRegUsuario">Usuario *</label>
                    <input type="text" id="kfcRegUsuario" class="kfc-input" placeholder="Ej: carlosr" maxlength="30" autocomplete="username" autocapitalize="none" spellcheck="false" required />
                </div>
                <div class="kfc-field-wrap">
                    <label for="kfcRegCorreo">Correo electrónico *</label>
                    <input type="email" id="kfcRegCorreo" class="kfc-input" placeholder="ejemplo@gmail.com" maxlength="100" autocomplete="email" autocapitalize="none" spellcheck="false" required />
                </div>
                <div class="kfc-row-2">
                    <div class="kfc-field-wrap">
                        <label for="kfcRegPass">Contraseña *</label>
                        <input type="password" id="kfcRegPass" class="kfc-input" placeholder="Mín. 8 caracteres" autocomplete="new-password" required />
                    </div>
                    <div class="kfc-field-wrap">
                        <label for="kfcRegPassConf">Confirmar *</label>
                        <input type="password" id="kfcRegPassConf" class="kfc-input" placeholder="Repite la contraseña" autocomplete="new-password" required />
                    </div>
                </div>
                <button type="submit" class="btn-kfc-cta red" id="btnRegistroSubmit">
                    <span>Crear mi cuenta</span>
                </button>
            </form>

            <div class="kfc-switch-view">
                ¿Ya tienes una cuenta?
                <button type="button" class="kfc-link-btn" onclick="mostrarVista('correo')">Inicia sesión</button>
            </div>
        </div>
    </div>
</div>

<!-- ══ SCRIPT DE CONTROLADOR FAST-FOOD & GOOGLE GSI OFICIAL ═══════════════════ --><div id="ingreso-config" hidden data-google-client-id="@googleClientId"></div>
<script src="~/js/ingreso-modal.js" asp-append-version="true"></script>
