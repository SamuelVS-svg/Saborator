@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject ControlClientesRestaurante.Services.ProductoService _productoSvc
@{
    var _session = HttpContextAccessor.HttpContext?.Session;
    var _usuario = (User.Identity?.IsAuthenticated == true) ? User.Identity.Name : _session?.GetString("Usuario");
    var _rol     = (User.Identity?.IsAuthenticated == true) 
        ? (User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? _session?.GetString("Rol") ?? "")
        : (_session?.GetString("Rol") ?? "");
    var _esAdmin  = User.IsInRole("Administrador") || _rol == "Administrador";
    var _esCajero = User.IsInRole("Cajero") || _rol == "Cajero";
    var _esMesero = User.IsInRole("Mesero") || _rol == "Mesero";
    var _esCocinero = User.IsInRole("Cocinero") || _rol == "Cocinero";
    var _esCliente = User.IsInRole("Cliente") || _rol == "Cliente";
    var _esDomiciliario = User.IsInRole("Domiciliario") || _rol == "Domiciliario";
    // El panel interno solo se muestra con una cookie de autenticación válida
    var _logado   = User.Identity?.IsAuthenticated == true;

    var _fotoPerfil = (User.Identity?.IsAuthenticated == true)
        ? (User.FindFirst("FotoPerfil")?.Value ?? _session?.GetString("FotoPerfil"))
        : _session?.GetString("FotoPerfil");
    var _tema = (User.Identity?.IsAuthenticated == true)
        ? (User.FindFirst("Tema")?.Value ?? _session?.GetString("Tema") ?? "clasico")
        : (_session?.GetString("Tema") ?? "clasico");
    if (string.IsNullOrEmpty(_tema)) _tema = "clasico";

    // Productos con stock bajo (≤ 5) — solo relevante para admin
    var _stockBajo = _esAdmin
        ? _productoSvc.ObtenerTodos().Where(p => p.Activo && p.Stock <= 5).ToList()
        : new List<ControlClientesRestaurante.Models.Producto>();

    var _esLogin = ViewContext.RouteData.Values["controller"]?.ToString() == "Login";
}
<!DOCTYPE html>
<html lang="es" data-tema-perfil="@_tema" data-theme="@(_tema != "clasico" ? _tema : null)">
<head>
    @* Styles section for page-specific CSS *@
    @RenderSection("Styles", required: false)

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} — Saborator" : "Saborator — Hamburguesas, salchipapas y perros")</title>
    <meta name="description" content="Restaurante Saborator en Barranquilla: hamburguesas, salchipapas y perros calientes. Pide a domicilio con seguimiento en vivo, recoge en sede o reserva tu mesa en línea." />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#1F120C" />
    <link rel="canonical" href="@(Context.Request.Scheme)://@(Context.Request.Host)@(Context.Request.Path)" />

    <!-- Open Graph / Redes Sociales -->
    <meta property="og:type" content="restaurant" />
    <meta property="og:title" content="@(ViewData["Title"] != null ? $"{ViewData["Title"]} — Saborator" : "Saborator — Pide ya")" />
    <meta property="og:description" content="Mira la carta de Saborator, pide a domicilio y reserva tu mesa en línea." />
    <meta property="og:url" content="@(Context.Request.Scheme)://@(Context.Request.Host)@(Context.Request.Path)" />
    <meta property="og:image" content="@(Context.Request.Scheme)://@(Context.Request.Host)/img/logo-burger-gold.png" />
    <meta property="og:site_name" content="Saborator Restaurante" />
    <meta property="og:locale" content="es_CO" />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@(ViewData["Title"] != null ? $"{ViewData["Title"]} — Saborator" : "Saborator — Pide ya")" />
    <meta name="twitter:description" content="Pide a domicilio y reserva tu mesa en Saborator." />
    <meta name="twitter:image" content="@(Context.Request.Scheme)://@(Context.Request.Host)/img/logo-burger-gold.png" />

    <!-- Favicon & PWA Icons -->
    <link rel="icon" type="image/svg+xml" href="~/img/logo-burger.svg" />
    <link rel="alternate icon" href="~/favicon.ico" />
    <link rel="apple-touch-icon" href="~/img/icon-192.png" />
    <link rel="manifest" href="~/site.webmanifest" />

    <!-- Preconexiones y Tipografías -->
    <link rel="preload" href="~/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/bebas-neue-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />

    <!-- Hojas de Estilo Base -->
    <link rel="stylesheet" href="~/css/material.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <script src="~/js/dialogos.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/dashboard-v12.css" asp-append-version="true" />
    <!-- Capa responsive global (se carga al final para sobrescribir ajustes fijos) -->
    <link rel="stylesheet" href="~/css/responsive.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth-modal.css" asp-append-version="true" />
    <!-- Piel Material Design 3 (va al final para quedar encima del CSS propio) -->
    <link rel="stylesheet" href="~/css/material-skin.css" asp-append-version="true" />
    <!-- Plantilla E (crema y mostaza): va al final para quedar por encima del resto -->
    <link rel="stylesheet" href="~/css/plantilla-e.css" asp-append-version="true" />


    <!-- Tema: se decide antes de pintar para evitar parpadeos.
         Prioridad: elección guardada del visitante > tema de su perfil > preferencia del sistema operativo -->
    <script src="~/js/tema-inicial.js" asp-append-version="true"></script>

    <!-- Structured Data: Schema.org JSON-LD -->
    @Html.Raw("<script type=\"application/ld+json\">")
    {
      "@@context": "https://schema.org",
      "@@type": "Restaurant",
      "name": "Saborator",
      "image": "@(Context.Request.Scheme)://@(Context.Request.Host)/img/logo-burger-gold.png",
      "description": "Hamburguesas, salchipapas y perros calientes con domicilio y reserva de mesas.",
      "servesCuisine": "Hamburguesas, Salchipapas, Comida rápida",
      "priceRange": "$$",
      "currenciesAccepted": "COP",
      "paymentAccepted": "Cash, Credit Card, Debit Card, Nequi, Daviplata",
      "acceptsReservations": "True",
      "telephone": "+57-322-525-4289",
      "address": {
        "@@type": "PostalAddress",
        "streetAddress": "Cra 4 Sur # 50D-107",
        "addressLocality": "Barranquilla",
        "addressRegion": "Atlántico",
        "addressCountry": "CO"
      },
      "openingHoursSpecification": [
        {
          "@@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
          "opens": "12:00",
          "closes": "23:00"
        }
      ]
    }
    @Html.Raw("</script>")
</head>
<body>
<a href="#mainContent" class="skip-link">Saltar al contenido principal</a>

@if (_esLogin)
{
    @RenderBody()
}
else if (_logado && !_esCliente)
{
<aside class="sidebar" id="sidebar">
    <!-- Botón flecha toggle -->
    <button class="sb-arrow" id="sbArrow" onclick="toggleSidebar()" aria-label="Expandir menú">
        <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
    </button>

    <a href="@ControlClientesRestaurante.Models.Roles.PaginaInicio(_rol)" class="sb-logo">
        <div class="sb-logo-icon">
            <partial name="_LogoBurger" />
        </div>
        <div class="sb-logo-text">
            <span class="name">Saborator</span>
            <span class="sub">@_rol</span>
        </div>
    </a>

    <nav class="sb-nav">
        <div class="sb-section">Navegación</div>

        @* ── DASHBOARD V12 EJECUTIVO: solo Admin ── *@
        @if (_esAdmin)
        {
            <a asp-controller="Home" asp-action="Dashboard"
               class="sb-item @(ViewContext.RouteData.Values["controller"]?.ToString()=="Home"&&ViewContext.RouteData.Values["action"]?.ToString()=="Dashboard"?"active":"")">
