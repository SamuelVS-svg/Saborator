@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject ControlClientesRestaurante.Services.ProductoService _productoSvc
@{
    var _session = HttpContextAccessor.HttpContext?.Session;
    var _usuario = (User.Identity?.IsAuthenticated == true) ? User.Identity.Name : _session?.GetString("Usuario");
    var _rol     = (User.Identity?.IsAuthenticated == true) 
        ? (User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? _session?.GetString("Rol") ?? "")
        : (_session?.GetString("Rol") ?? "");
    var _esAdmin  = User.IsInRole("Administrador") || _rol == "Administrador";
    var _esCajero = User.IsInRole("Cajero") || _rol == "Cajero";
    var _esMesero = User.IsInRole("Mesero") || _rol == "Mesero";
    var _esCocinero = User.IsInRole("Cocinero") || _rol == "Cocinero";
    var _esCliente = User.IsInRole("Cliente") || _rol == "Cliente";
    var _logado   = (User.Identity?.IsAuthenticated == true) || !string.IsNullOrEmpty(_usuario);

    var _fotoPerfil = (User.Identity?.IsAuthenticated == true)
        ? (User.FindFirst("FotoPerfil")?.Value ?? _session?.GetString("FotoPerfil"))
        : _session?.GetString("FotoPerfil");
    var _tema = (User.Identity?.IsAuthenticated == true)
        ? (User.FindFirst("Tema")?.Value ?? _session?.GetString("Tema") ?? "clasico")
        : (_session?.GetString("Tema") ?? "clasico");
    if (string.IsNullOrEmpty(_tema)) _tema = "clasico";

    // Productos con stock bajo (≤ 5) — solo relevante para admin
    var _stockBajo = _esAdmin
        ? _productoSvc.ObtenerTodos().Where(p => p.Activo && p.Stock <= 5).ToList()
        : new List<ControlClientesRestaurante.Models.Producto>();

    var _esLogin = ViewContext.RouteData.Values["controller"]?.ToString() == "Login";
}
<!DOCTYPE html>
<html lang="es" data-theme="@(_tema != "clasico" ? _tema : null)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} — Saborator" : "Saborator — Alta Cocina & Gestión")</title>
    <meta name="description" content="Restaurante Saborator — Experiencia gastronómica de alta cocina, carta de autor de hamburguesas gourmet y reservas de mesa exclusivas en línea con plano interactivo." />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#6B1E2E" />
    <link rel="canonical" href="@(Context.Request.Scheme)://@(Context.Request.Host)@(Context.Request.Path)" />

    <!-- Open Graph / Redes Sociales -->
    <meta property="og:type" content="restaurant" />
    <meta property="og:title" content="@(ViewData["Title"] != null ? $"{ViewData["Title"]} — Saborator" : "Saborator — Alta Cocina & Experiencia")" />
    <meta property="og:description" content="Descubre la carta de autor de Saborator y reserva tu turno en nuestro salón exclusivo en tiempo real." />
    <meta property="og:url" content="@(Context.Request.Scheme)://@(Context.Request.Host)@(Context.Request.Path)" />
    <meta property="og:image" content="@(Context.Request.Scheme)://@(Context.Request.Host)/img/logo-burger-gold.png" />
    <meta property="og:site_name" content="Saborator Restaurante" />
    <meta property="og:locale" content="es_CO" />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@(ViewData["Title"] != null ? $"{ViewData["Title"]} — Saborator" : "Saborator — Alta Cocina")" />
    <meta name="twitter:description" content="Experiencia culinaria de autor y reservas en línea en Saborator." />
    <meta name="twitter:image" content="@(Context.Request.Scheme)://@(Context.Request.Host)/img/logo-burger-gold.png" />

    <!-- Favicon & PWA Icons -->
    <link rel="icon" type="image/svg+xml" href="~/img/logo-burger.svg" />
    <link rel="alternate icon" href="~/favicon.ico" />
    <link rel="apple-touch-icon" href="~/img/logo-burger.png" />
    <link rel="manifest" href="~/site.webmanifest" />

    <!-- Preconexiones y Tipografías -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500;600&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />

    <!-- Hojas de Estilo Base -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard-v12.css" asp-append-version="true" />
    <!-- Capa responsive global (se carga al final para sobrescribir ajustes fijos) -->
    <link rel="stylesheet" href="~/css/responsive.css" asp-append-version="true" />

    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>

    <!-- Script Anti-FOUC para Temas de Usuario -->
    <script>
        (function() {
            try {
                var userTheme = '@_tema';
                var local = localStorage.getItem('saborator_theme');
                var t = (userTheme && userTheme !== 'clasico') ? userTheme : (local || 'clasico');
                if (t === 'dark' || t === 'noche' || t === 'dorado' || t === 'esmeralda' || t === 'sunset') {
                    document.documentElement.setAttribute('data-theme', t);
                } else {
                    document.documentElement.removeAttribute('data-theme');
                }
            } catch(e) {}
        })();
    </script>

    <!-- Structured Data: Schema.org JSON-LD -->
    @Html.Raw("<script type=\"application/ld+json\">")
    {
      "@@context": "https://schema.org",
      "@@type": "Restaurant",
      "name": "Saborator",
      "image": "@(Context.Request.Scheme)://@(Context.Request.Host)/img/logo-burger-gold.png",
      "description": "Alta cocina, hamburguesas y creaciones gastronómicas de autor con reserva de mesas.",
      "servesCuisine": "Gourmet, Hamburguesas de Autor, Cocina Contemporánea",
      "priceRange": "$$",
      "currenciesAccepted": "COP",
      "paymentAccepted": "Cash, Credit Card, Debit Card, Nequi, Daviplata",
      "acceptsReservations": "True",
      "telephone": "+57-322-525-4289",
      "address": {
        "@@type": "PostalAddress",
        "addressLocality": "Bogotá",
        "addressCountry": "CO"
      },
      "openingHoursSpecification": [
        {
          "@@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
          "opens": "12:00",
          "closes": "23:00"
        }
      ]
    }
    @Html.Raw("</script>")
</head>
<body>
<a href="#mainContent" class="skip-link">Saltar al contenido principal</a>

@if (_esLogin)
{
    @RenderBody()
}
else if (_logado && !_esCliente)
{
<aside class="sidebar" id="sidebar">
    <!-- Botón flecha toggle -->
    <button class="sb-arrow" id="sbArrow" onclick="toggleSidebar()" aria-label="Expandir menú">
        <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
    </button>

    <a asp-controller="@(_esCocinero ? "Pedido" : (_esMesero ? "Pedido" : "Cliente"))"
       asp-action="@(_esCocinero ? "Cocina" : (_esMesero ? "Menu" : "Index"))" class="sb-logo">
        <div class="sb-logo-icon">
            <partial name="_LogoBurger" />
        </div>
        <div class="sb-logo-text">
            <span class="name">Saborator</span>
            <span class="sub">@_rol</span>
        </div>
    </a>

    <nav class="sb-nav">
        <div class="sb-section">Navegación</div>

        @* ── PÁGINA PRINCIPAL PÚBLICA ── *@
        <a asp-controller="Home" asp-action="Index"
           class="sb-item @(ViewContext.RouteData.Values["controller"]?.ToString()=="Home"&&ViewContext.RouteData.Values["action"]?.ToString()=="Index"?"active":"")">
            <span class="ico"><svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></span>
            <span class="sb-lbl">Página principal</span>
        </a>

        @* ── DASHBOARD V12 EJECUTIVO ── *@
        <a asp-controller="Home" asp-action="Dashboard"
           class="sb-item @(ViewContext.RouteData.Values["controller"]?.ToString()=="Home"&&ViewContext.RouteData.Values["action"]?.ToString()=="Dashboard"?"active":"")">
            <span class="ico"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg></span>
            <span class="sb-lbl">Dashboard V12</span>
        </a>

        @* ── PANTALLA DE COCINA & KDS: Cocinero, Admin y Mesero ── *@
        @if (_esCocinero || _esAdmin || _esMesero)
        {
            <a asp-controller="Pedido" asp-action="Cocina"
               class="sb-item @(ViewContext.RouteData.Values["controller"]?.ToString()=="Pedido"&&ViewContext.RouteData.Values["action"]?.ToString()=="Cocina"?"active":"")">
                <span class="ico"><svg viewBox="0 0 24 24"><path d="M6 13.87A4 4 0 0 1 7.41 6a5.11 5.11 0 0 1 1.05-1.54 5 5 0 0 1 7.08 0A5.11 5.11 0 0 1 16.59 6 4 4 0 0 1 18 13.87V21H6Z"/><line x1="6" y1="17" x2="18" y2="17"/></svg></span>
                <span class="sb-lbl">Comandas Cocina</span>
            </a>
            <a asp-controller="Pedido" asp-action="Recetario"
               class="sb-item @(ViewContext.RouteData.Values["controller"]?.ToString()=="Pedido"&&ViewContext.RouteData.Values["action"]?.ToString()=="Recetario"?"active":"")">
                <span class="ico"><svg viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg></span>
                <span class="sb-lbl">Recetario Carta</span>
            </a>
        }

        @* ── RESERVAS DE MESAS: Admin, Mesero y Cajero ── *@
        <a asp-controller="Reserva" asp-action="Admin"
           class="sb-item @(ViewContext.RouteData.Values["controller"]?.ToString()=="Reserva"?"active":"")">
            <span class="ico"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg></span>
            <span class="sb-lbl">Reservas</span>
        </a>

        @* ── ESTADO DE MESAS: Mesero, Admin y Cajero ── *@
        @if (_esMesero || _esAdmin || _esCajero)
        {
            <a asp-controller="Mesa" asp-action="Index"
               class="sb-item @(ViewContext.RouteData.Values["controller"]?.ToString()=="Mesa"?"active":"")">
                <span class="ico"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/></svg></span>
                <span class="sb-lbl">Estado de Mesas</span>
            </a>

            <a asp-controller="Pedido" asp-action="Domicilios"
               class="sb-item @(ViewContext.RouteData.Values["controller"]?.ToString()=="Pedido"&&ViewContext.RouteData.Values["action"]?.ToString()=="Domicilios"?"active":"")">
                <span class="ico"><svg viewBox="0 0 24 24"><circle cx="18.5" cy="17.5" r="3.5"/><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="15" cy="5" r="1"/><path d="M12 17.5V14l-3-3 4-3 2 3h2"/></svg></span>
                <span class="sb-lbl">Despacho Domicilios</span>
            </a>
        }

        @* ── CLIENTES: Admin y Cajero ── *@
        @if (_esAdmin || _esCajero)
        {
            <a asp-controller="Cliente" asp-action="Index"
               class="sb-item @(ViewContext.RouteData.Values["controller"]?.ToString()=="Cliente"?"active":"")">
                <span class="ico"><svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
                <span class="sb-lbl">Clientes</span>
            </a>
        }

        @* ── TOMAR PEDIDO / HACER PEDIDO: Mesero, Admin y Cliente ── *@
        @if (_esMesero || _esAdmin || _esCliente)
        {
            if (_esCliente)
            {
                <a asp-controller="Pedido" asp-action="Checkout" asp-route-tipo="Domicilio"
                   class="sb-item @(ViewContext.RouteData.Values["controller"]?.ToString()=="Pedido"&&ViewContext.RouteData.Values["action"]?.ToString()=="Checkout"?"active":"")">
                    <span class="ico"><svg viewBox="0 0 24 24"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><line x1="9" y1="12" x2="15" y2="12"/><line x1="9" y1="16" x2="13" y2="16"/></svg></span>
                    <span class="sb-lbl">Hacer pedido</span>
                </a>
            }
            else
            {
            <a asp-controller="Pedido" asp-action="Menu"
               class="sb-item @(ViewContext.RouteData.Values["controller"]?.ToString()=="Pedido"&&ViewContext.RouteData.Values["action"]?.ToString()=="Menu"?"active":"")">
                <span class="ico"><svg viewBox="0 0 24 24"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><line x1="9" y1="12" x2="15" y2="12"/><line x1="9" y1="16" x2="13" y2="16"/></svg></span>
                <span class="sb-lbl">Tomar pedido</span>
            </a>
            }
        }

        @* ── MIS PEDIDOS: Mesero y Cliente ── *@
        @if (_esMesero || _esCliente)
        {
            <a asp-controller="Pedido" asp-action="MisPedidos"
               class="sb-item @(ViewContext.RouteData.Values["controller"]?.ToString()=="Pedido"&&ViewContext.RouteData.Values["action"]?.ToString()=="MisPedidos"?"active":"")">
                <span class="ico"><svg viewBox="0 0 24 24"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/></svg></span>
                <span class="sb-lbl">Mis pedidos</span>
            </a>
        }

        @* ── PEDIDOS ACTIVOS + FACTURACIÓN: Cajero y Admin ── *@
        @if (_esCajero || _esAdmin)
        {
            <a asp-controller="Pedido" asp-action="Index"
               class="sb-item @(ViewContext.RouteData.Values["controller"]?.ToString()=="Pedido"&&ViewContext.RouteData.Values["action"]?.ToString()=="Index"?"active":"")">
                <span class="ico"><svg viewBox="0 0 24 24"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><polyline points="9 11 11 13 15 9"/></svg></span>
                <span class="sb-lbl">Pedidos activos</span>
            </a>
            <a asp-controller="Factura" asp-action="Create"
               class="sb-item @(ViewContext.RouteData.Values["controller"]?.ToString()=="Factura"&&ViewContext.RouteData.Values["action"]?.ToString()=="Create"?"active":"")">
                <span class="ico"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/></svg></span>
                <span class="sb-lbl">Nueva Factura</span>
            </a>
            <a asp-controller="Caja" asp-action="Index"
               class="sb-item @(ViewContext.RouteData.Values["controller"]?.ToString()=="Caja"?"active":"")">
                <span class="ico"><svg viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span>
                <span class="sb-lbl">Control de Caja</span>
            </a>
            <a asp-controller="Factura" asp-action="Index"
               class="sb-item @(ViewContext.RouteData.Values["controller"]?.ToString()=="Factura"&&ViewContext.RouteData.Values["action"]?.ToString()=="Index"?"active":"")">
                <span class="ico"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="3" x2="9" y2="21"/></svg></span>
                <span class="sb-lbl">Historial</span>
            </a>
            <a asp-controller="Resena" asp-action="Index"
               class="sb-item @(ViewContext.RouteData.Values["controller"]?.ToString()=="Resena"?"active":"")">
                <span class="ico"><svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></span>
                <span class="sb-lbl">Reseñas</span>
            </a>
            <a asp-controller="Cupon" asp-action="Index"
               class="sb-item @(ViewContext.RouteData.Values["controller"]?.ToString()=="Cupon"?"active":"")">
                <span class="ico"><svg viewBox="0 0 24 24"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg></span>
                <span class="sb-lbl">Cupones Promocionales</span>
            </a>
        }

        @* ── INVENTARIO + PROVEEDORES: solo Admin ── *@
        @if (_esAdmin)
        {
            <div class="sb-section">Admin</div>
            <a asp-controller="Producto" asp-action="Index"
               class="sb-item @(ViewContext.RouteData.Values["controller"]?.ToString()=="Producto"?"active":"")">
                <span class="ico"><svg viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg></span>
                <span class="sb-lbl">Inventario</span>
            </a>
            <a asp-controller="Proveedor" asp-action="Index"
               class="sb-item @(ViewContext.RouteData.Values["controller"]?.ToString()=="Proveedor"?"active":"")">
                <span class="ico"><svg viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13" rx="2"/><polygon points="16 8 20 8 23 11 23 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg></span>
                <span class="sb-lbl">Proveedores</span>
            </a>
            <a asp-controller="Auditoria" asp-action="Index"
               class="sb-item @(ViewContext.RouteData.Values["controller"]?.ToString()=="Auditoria"?"active":"")">
                <span class="ico"><svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></span>
                <span class="sb-lbl">Bitácora Auditoría</span>
            </a>
        }
    </nav>

    <div class="sb-bottom">
        <a asp-controller="Perfil" asp-action="Index" class="sb-item @(ViewContext.RouteData.Values["controller"]?.ToString()=="Perfil"?"active":"")">
            <span class="ico"><svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></span>
            <span class="sb-lbl">Mi Perfil</span>
        </a>
        <button class="sb-item" onclick="document.getElementById('modalLogout').classList.add('show')">
            <span class="ico"><svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></span>
            <span class="sb-lbl">Cerrar sesión</span>
        </button>
    </div>
</aside>

<header class="topbar" id="topbar">
    <button class="sb-toggle" id="sbToggle" onclick="toggleSidebar()" aria-label="Abrir menú" title="Abrir menú">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
    </button>
    <span class="top-page-title">@(ViewData["Title"]?.ToString() ?? "Saborator")</span>
    <div class="top-spacer"></div>
    <div class="top-search">
        <span class="search-icon"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></span>
        <input type="text" id="globalSearch" placeholder="Buscar…" autocomplete="off" />
    </div>

    <!-- Acceso Rápido a Dashboard Admin (especialmente útil en móvil) -->
    <a asp-controller="Home" asp-action="Dashboard" class="top-bell" title="Ir al Dashboard Ejecutivo" style="position:relative;display:flex;align-items:center;justify-content:center;width:38px;height:38px;border-radius:10px;background:var(--surface-2);color:var(--gold, #C8973A);border:1px solid rgba(200,151,58,0.35);text-decoration:none;margin-right:0.35rem;transition:transform 140ms ease;flex-shrink:0;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>
    </a>

    <!-- Campana de Avisos de Reservas para Staff -->
    <a asp-controller="Reserva" asp-action="Admin" class="top-bell" title="Ver Reservas de Comensales" style="position:relative;display:flex;align-items:center;justify-content:center;width:38px;height:38px;border-radius:10px;background:var(--surface-2);color:var(--text);text-decoration:none;margin-right:0.5rem;transition:transform 140ms ease;flex-shrink:0;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
        <span style="position:absolute;top:7px;right:7px;width:7px;height:7px;border-radius:50%;background:var(--gold);box-shadow:0 0 6px var(--gold);"></span>
    </a>

    <!-- Selector de Modo Oscuro / Modo Claro -->
    <button type="button" class="theme-toggle-btn" onclick="toggleModoOscuro()" title="Cambiar modo de luz u oscuro" aria-label="Cambiar modo de luz u oscuro" style="margin-right:0.65rem;">
        <svg class="theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <svg class="theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
    </button>

    <div class="top-profile" id="profileWrap">
        <div class="top-avatar" onclick="toggleDropdown()" title="Mi cuenta & Apariencia" style="cursor:pointer;">
            @if (!string.IsNullOrEmpty(_fotoPerfil))
            {
                <img src="@_fotoPerfil" alt="Avatar de @_usuario" class="top-avatar-img" />
            }
            else if (_esAdmin)
            {
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            }
            else
            {
                @(_usuario?.Length > 0 ? _usuario[0].ToString().ToUpper() : "U")
            }
        </div>
        <div class="profile-dropdown" id="profileDropdown">
            <div class="pd-header">
                <div class="pd-name">@_usuario</div>
                <span class="pd-role @(_esAdmin ? "admin" : _esMesero ? "mesero" : _esCajero ? "cajero" : "cliente")">@_rol</span>
            </div>
            <a asp-controller="Perfil" asp-action="Index" class="pd-item" style="text-decoration:none;color:inherit;">
                <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                Mi perfil & temas
            </a>
            <button class="pd-item" onclick="abrirModalContrasena()">
                <svg viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                Cambiar contraseña
            </button>
            @if (_usuario == "admin")
            {
                @* Admin puede cambiar a cualquiera de los otros 2 roles *@
                foreach (var rol in new[] { "Administrador", "Cajero", "Mesero" })
                {
                    if (rol != _rol)
                    {
                        <form asp-controller="Login" asp-action="CambiarRol" method="post" style="margin:0;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="nuevoRol" value="@rol" />
                            <button type="submit" class="pd-item">
                                <svg viewBox="0 0 24 24" fill="none"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
                                Cambiar a @rol
                            </button>
                        </form>
                    }
                }
                <div class="pd-divider"></div>
            }
            <button class="pd-item danger" onclick="document.getElementById('modalLogout').classList.add('show');document.getElementById('profileDropdown').classList.remove('show')">
                <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                Cerrar sesión
            </button>
        </div>
    </div>
</header>

<main class="main-content" id="mainContent">
    <div class="page-body">
        @RenderBody()
    </div>
</main>

<!-- ══ TOASTS ═══════════════════════════════════════════════ -->
<div class="toast-wrap" id="toastWrap"></div>

@if (TempData["Mensaje"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            showToast('ok', @Json.Serialize(TempData["Mensaje"]?.ToString()));
        });
    </script>
}
@if (TempData["Error"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            showToast('err', @Json.Serialize(TempData["Error"]?.ToString()));
        });
    </script>
}
@if (TempData["ErrorContrasena"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            showToast('err', @Json.Serialize(TempData["ErrorContrasena"]?.ToString()));
        });
    </script>
}

@* Alertas de stock bajo — aparecen automáticamente para el admin si hay productos con ≤ 5 unidades *@
@if (_esAdmin && _stockBajo.Any())
{
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            @foreach (var p in _stockBajo)
            {
                var msg = p.Stock == 0
                    ? $"Sin stock: {p.Nombre} (0 unidades)"
                    : $"Stock bajo: {p.Nombre} — {p.Stock} unidad{(p.Stock == 1 ? "" : "es")} restante{(p.Stock == 1 ? "" : "s")}";
                <text>showToastStock('warn', @Json.Serialize(msg)); </text>
            }
        });
    </script>
}

<!-- Modal Logout -->
<div class="modal-overlay" id="modalLogout">
    <div class="modal-box">
        <div class="modal-icon err">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </div>
        <h2 style="font-family:'Playfair Display',serif;font-size:1.2rem;margin-bottom:.4rem;">¿Cerrar sesión?</h2>
        <p style="color:var(--color-text-secondary);font-size:.85rem;margin-bottom:1.4rem;">Tu sesión se cerrará y tendrás que volver a iniciar.</p>
        <div style="display:flex;gap:.65rem;justify-content:center;">
            <a asp-controller="Login" asp-action="Logout" class="btn-brand">Sí, salir</a>
            <button onclick="document.getElementById('modalLogout').classList.remove('show')" class="btn-ghost">Cancelar</button>
        </div>
    </div>
</div>

<!-- Modal Cambiar Contraseña -->
<div class="modal-overlay" id="modalContrasena">
    <div class="modal-box left-align" style="max-width:420px;">
        <div style="display:flex;align-items:center;gap:.65rem;margin-bottom:1.25rem;">
            <div style="width:40px;height:40px;background:var(--color-brand);border:1px solid rgba(255,253,249,0.2);border-radius:9px;display:flex;align-items:center;justify-content:center;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--on-brand)" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            </div>
            <div>
                <div style="font-family:'Playfair Display',serif;font-size:1.1rem;font-weight:700;">Cambiar contraseña</div>
                <div style="font-size:.75rem;color:var(--color-text-secondary);">Actualiza tu contraseña de acceso</div>
            </div>
        </div>
        <form asp-controller="Login" asp-action="CambiarContrasena" method="post" id="formContrasena">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="lbl">Contraseña actual</label>
                <input type="password" name="contrasenaActual" class="form-control" required placeholder="••••••••" />
            </div>
            <div class="mb-3">
                <label class="lbl">Nueva contraseña</label>
                <input type="password" name="nuevaContrasena" id="nuevaPass" class="form-control" required placeholder="Mínimo 6 caracteres" />
            </div>
            <div class="mb-4">
                <label class="lbl">Confirmar nueva contraseña</label>
                <input type="password" name="confirmar" id="confirmarPass" class="form-control" required placeholder="Repite la nueva contraseña" />
                <div id="errConfirmar" class="txt-err" style="font-size:.76rem;display:none;margin-top:.25rem;">Las contraseñas no coinciden.</div>
            </div>
            <div style="display:flex;gap:.65rem;">
                <button type="submit" class="btn-brand" style="flex:1;justify-content:center;">Guardar</button>
                <button type="button" onclick="cerrarModalContrasena()" class="btn-ghost" style="flex:1;justify-content:center;">Cancelar</button>
            </div>
        </form>
    </div>
</div>
}
else
{
    var _esInicio = ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index";

    if (!_esInicio)
    {
        <partial name="_NavbarGourmet" />
        <main id="mainContent" class="gourmet-client-main">
            @RenderBody()
        </main>
        <partial name="_FooterGourmet" />
    }
    else
    {
        <main id="mainContent">
            @RenderBody()
        </main>
    }
}

@if (!_esLogin)
{
    <partial name="_IaAsistenteFlotante" />
    <partial name="_WhatsAppConcierge" />
    <partial name="_CookieBanner" />
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script>
    if (typeof lucide !== 'undefined') lucide.createIcons();

    // ── Toggle de Modo Oscuro / Claro ──────────────────────────
    function toggleModoOscuro() {
        var esOscuro = document.documentElement.getAttribute('data-theme') === 'dark';
        if (esOscuro) {
            document.documentElement.removeAttribute('data-theme');
            try { localStorage.setItem('saborator_theme', 'light'); } catch(e) {}
        } else {
            document.documentElement.setAttribute('data-theme', 'dark');
            try { localStorage.setItem('saborator_theme', 'dark'); } catch(e) {}
        }
    }

    // ── Toast ─────────────────────────────────────────────────
    function showToast(tipo, msg) {
        var wrap = document.getElementById('toastWrap');
        if (!wrap || !msg) return;
        var iconOk   = '<svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>';
        var iconErr  = '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>';
        var t = document.createElement('div');
        t.className = 'toast ' + tipo;
        t.innerHTML = (tipo === 'ok' ? iconOk : iconErr) + '<span>' + msg + '</span>';
        wrap.appendChild(t);
        setTimeout(function() { t.remove(); }, 3400);
    }

    // Toast de stock bajo — dura más tiempo y tiene ícono de advertencia
    function showToastStock(tipo, msg) {
        var wrap = document.getElementById('toastWrap');
        if (!wrap || !msg) return;
        var icon = '<svg viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>';
        var t = document.createElement('div');
        t.className = 'toast warn';
        t.innerHTML = icon + '<span>' + msg + '</span>';
        wrap.appendChild(t);
        setTimeout(function() { t.remove(); }, 6000);   // 6 segundos para leer bien
    }

    function toggleSidebar() { document.getElementById('sidebar')?.classList.toggle('open'); }
    function toggleGourmetMobileNav() { document.getElementById('gourmetMobileMenu')?.classList.toggle('open'); }
    document.addEventListener('click', function(e) {
        var sb = document.getElementById('sidebar'), tog = document.getElementById('sbToggle');
        if (sb && tog && !sb.contains(e.target) && !tog.contains(e.target)) sb.classList.remove('open');
        var gNav = document.getElementById('gourmetNavbar'), gMenu = document.getElementById('gourmetMobileMenu'), gBtn = document.getElementById('gourmetMobileToggle');
        if (gMenu && gBtn && !gMenu.contains(e.target) && !gBtn.contains(e.target)) gMenu.classList.remove('open');
        var lMenu = document.getElementById('lnavMobileMenu'), lBtn = document.getElementById('lnavMobileToggle');
        if (lMenu && lBtn && !lMenu.contains(e.target) && !lBtn.contains(e.target)) lMenu.classList.remove('open');
    });

    function toggleDropdown() { document.getElementById('profileDropdown').classList.toggle('show'); }
    document.addEventListener('click', function(e) {
        var w = document.getElementById('profileWrap');
        if (w && !w.contains(e.target)) { var d = document.getElementById('profileDropdown'); if(d) d.classList.remove('show'); }
    });

    function abrirModalContrasena() {
        document.getElementById('profileDropdown').classList.remove('show');
        document.getElementById('modalContrasena').classList.add('show');
    }
    function cerrarModalContrasena() {
        document.getElementById('modalContrasena').classList.remove('show');
        document.getElementById('formContrasena').reset();
        document.getElementById('errConfirmar').style.display = 'none';
    }
    var cfm = document.getElementById('confirmarPass');
    if (cfm) cfm.addEventListener('input', function() {
        var np = document.getElementById('nuevaPass').value;
        document.getElementById('errConfirmar').style.display = (this.value && this.value !== np) ? 'block' : 'none';
    });
    var fc = document.getElementById('formContrasena');
    if (fc) fc.addEventListener('submit', function(e) {
        if (document.getElementById('nuevaPass').value !== document.getElementById('confirmarPass').value) {
            e.preventDefault(); document.getElementById('errConfirmar').style.display = 'block';
        }
    });

    var gs = document.getElementById('globalSearch');
    if (gs) gs.addEventListener('input', function() {
        var q = this.value.toLowerCase().trim();
        var rows = document.querySelectorAll('table tbody tr'), vis = 0;
        rows.forEach(function(tr) { var m = tr.innerText.toLowerCase().includes(q); tr.style.display = m ? '' : 'none'; if(m) vis++; });
        var cnt = document.getElementById('conteo'); if (cnt) cnt.textContent = vis;
    });

    // ── Registro de Service Worker PWA para Tablets de Meseros y Cocina ──
    if ('serviceWorker' in navigator) {
        window.addEventListener('load', function() {
            navigator.serviceWorker.register('/sw.js').catch(function(err) {
                console.log('SW registration note:', err);
            });
        });
    }
</script>

@* ── Google Analytics 4 / Tag Manager (Hook Pluggable Seguro) ── *@
@if (!string.IsNullOrEmpty(Environment.GetEnvironmentVariable("GA_TRACKING_ID")))
{
    var gaId = Environment.GetEnvironmentVariable("GA_TRACKING_ID");
    <script async src="https://www.googletagmanager.com/gtag/js?id=@gaId"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '@gaId');
    </script>
}

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
