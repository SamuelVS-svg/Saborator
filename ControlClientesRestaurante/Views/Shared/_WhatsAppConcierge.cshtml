<style>
    .luxury-whatsapp-wrap {
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 9990;
        cursor: grab;
        user-select: none;
        touch-action: none;
        transition: transform 180ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .luxury-whatsapp-wrap:active {
        cursor: grabbing;
        transform: scale(0.96);
    }
    .luxury-whatsapp-wrap.is-dragging {
        cursor: grabbing;
        transform: scale(1.08);
        box-shadow: 0 16px 36px rgba(18, 140, 126, 0.6);
    }
    .wa-drag-handle {
        position: absolute;
        top: -6px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(18, 140, 126, 0.9);
        color: #FFFFFF;
        border: 1px solid rgba(255, 255, 255, 0.4);
        border-radius: 6px;
        padding: 1px 3px;
        opacity: 0;
        transition: opacity 160ms ease;
        pointer-events: none;
    }
    .luxury-whatsapp-wrap:hover .wa-drag-handle {
        opacity: 0.9;
    }
    .luxury-wa-btn {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: linear-gradient(135deg, #25D366, #128C7E);
        color: #FFFFFF;
        box-shadow: 0 8px 24px rgba(18, 140, 126, 0.45), 0 2px 6px rgba(0, 0, 0, 0.3);
        border: 1px solid rgba(255, 255, 255, 0.3);
        text-decoration: none;
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease;
    }
    .luxury-wa-btn:hover {
        transform: scale(1.06) translateY(-2px);
        box-shadow: 0 12px 30px rgba(18, 140, 126, 0.6), 0 4px 10px rgba(0, 0, 0, 0.4);
        color: #FFFFFF;
    }
    .wa-ping-ring {
        position: absolute;
        inset: -4px;
        border-radius: 50%;
        border: 2px solid rgba(37, 211, 102, 0.5);
        animation: waPulse 2.8s infinite cubic-bezier(0.24, 0, 0.38, 1);
        pointer-events: none;
    }
    @@keyframes waPulse {
        0% { transform: scale(0.95); opacity: 0.8; }
        50% { transform: scale(1.25); opacity: 0; }
        100% { transform: scale(0.95); opacity: 0; }
    }
    .wa-tooltip {
        position: absolute;
        right: 64px;
        background: rgba(24, 6, 10, 0.94);
        border: 1px solid rgba(200, 151, 58, 0.4);
        color: #FFFDF9;
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 0.78rem;
        white-space: nowrap;
        pointer-events: none;
        opacity: 0;
        transform: translateX(6px);
        transition: opacity 0.2s ease, transform 0.2s ease;
        box-shadow: 0 6px 16px rgba(0,0,0,0.5);
        display: flex;
        flex-direction: column;
        line-height: 1.3;
    }
    .wa-tooltip small {
        color: #C8973A;
        font-size: 0.7rem;
    }
    .luxury-whatsapp-wrap:hover .wa-tooltip {
        opacity: 1;
        transform: translateX(0);
    }
    @@media (max-width: 768px) {
        .luxury-wa-btn { width: 48px; height: 48px; }
        .wa-tooltip { display: none; }
    }
    @@media (prefers-reduced-motion: reduce) {
        .wa-ping-ring { animation: none; }
        .luxury-wa-btn { transition: none; }
    }
</style>

<script>
(function() {
    const waWrap = document.getElementById('whatsappConcierge');
    const waLink = document.getElementById('waConciergeLink');
    if (!waWrap || !waLink) return;

    let isDragging = false;
    let startX = 0, startY = 0;
    let initialLeft = 0, initialTop = 0;

    function inicializarPosicionWa() {
        const guardadaX = localStorage.getItem('saborator_wa_pos_x');
        const guardadaY = localStorage.getItem('saborator_wa_pos_y');

        if (guardadaX !== null && guardadaY !== null) {
            const x = Math.min(Math.max(10, parseInt(guardadaX)), window.innerWidth - 64);
            const y = Math.min(Math.max(10, parseInt(guardadaY)), window.innerHeight - 64);
            waWrap.style.left = x + 'px';
            waWrap.style.top = y + 'px';
            waWrap.style.right = 'auto';
            waWrap.style.bottom = 'auto';
        }
    }

    function onPointerDown(e) {
        if (e.button !== undefined && e.button !== 0) return;
        isDragging = false;

        const clientX = e.touches ? e.touches[0].clientX : e.clientX;
        const clientY = e.touches ? e.touches[0].clientY : e.clientY;

        startX = clientX;
        startY = clientY;

        const rect = waWrap.getBoundingClientRect();
        initialLeft = rect.left;
        initialTop = rect.top;

        window.addEventListener('mousemove', onPointerMove, { passive: false });
        window.addEventListener('mouseup', onPointerUp);
        window.addEventListener('touchmove', onPointerMove, { passive: false });
        window.addEventListener('touchend', onPointerUp);
    }

    function onPointerMove(e) {
        const clientX = e.touches ? e.touches[0].clientX : e.clientX;
        const clientY = e.touches ? e.touches[0].clientY : e.clientY;

        const deltaX = clientX - startX;
        const deltaY = clientY - startY;

        if (Math.hypot(deltaX, deltaY) > 5) {
            isDragging = true;
            waWrap.classList.add('is-dragging');
            if (e.cancelable) e.preventDefault();

            let nuevoX = initialLeft + deltaX;
            let nuevoY = initialTop + deltaY;

            const pad = 8;
            nuevoX = Math.max(pad, Math.min(window.innerWidth - waWrap.offsetWidth - pad, nuevoX));
            nuevoY = Math.max(pad, Math.min(window.innerHeight - waWrap.offsetHeight - pad, nuevoY));

            waWrap.style.left = nuevoX + 'px';
            waWrap.style.top = nuevoY + 'px';
            waWrap.style.right = 'auto';
            waWrap.style.bottom = 'auto';
        }
    }

    function onPointerUp() {
        window.removeEventListener('mousemove', onPointerMove);
        window.removeEventListener('mouseup', onPointerUp);
        window.removeEventListener('touchmove', onPointerMove);
        window.removeEventListener('touchend', onPointerUp);

        waWrap.classList.remove('is-dragging');

        if (isDragging) {
            const rect = waWrap.getBoundingClientRect();
            localStorage.setItem('saborator_wa_pos_x', Math.round(rect.left));
            localStorage.setItem('saborator_wa_pos_y', Math.round(rect.top));
        }
    }

    waWrap.addEventListener('mousedown', onPointerDown);
    waWrap.addEventListener('touchstart', onPointerDown, { passive: true });

    // Prevenir apertura de enlace si fue un arrastre
    waLink.addEventListener('click', (e) => {
        if (isDragging) {
            e.preventDefault();
            e.stopPropagation();
            return false;
        }
        window.open(waLink.href, '_blank', 'noopener,noreferrer');
        e.preventDefault();
    });

    document.addEventListener('DOMContentLoaded', inicializarPosicionWa);
})();
</script>
