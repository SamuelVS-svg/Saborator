@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    var _session = HttpContextAccessor.HttpContext?.Session;
    var _user = User.Identity?.IsAuthenticated == true ? User.Identity.Name : _session?.GetString("Usuario");
    var _rol = User.Identity?.IsAuthenticated == true
        ? (User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? _session?.GetString("Rol") ?? "")
        : (_session?.GetString("Rol") ?? "");
    var _autenticado = (User.Identity?.IsAuthenticated == true) || !string.IsNullOrEmpty(_user);
    var _esPersonal = Roles.EsPersonal(_rol);
    var _fotoPerfil = User.Identity?.IsAuthenticated == true
        ? (User.FindFirst("FotoPerfil")?.Value ?? _session?.GetString("FotoPerfil"))
        : _session?.GetString("FotoPerfil");
    var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAct = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

<!-- ══ NAVBAR DE ALTA COCINA (PLANTILLA BORGOÑA Y CREMA) ════════════════════ -->
<header class="gourmet-navbar" id="gourmetNavbar">
    <div class="gourmet-nav-container">
        <!-- Brand / Logotipo -->
        <a href="/" class="gourmet-brand">
            <div class="gourmet-brand-icon">
                <partial name="_LogoBurger" />
            </div>
            <div class="gourmet-brand-text">
                <span class="gourmet-brand-title">Saborator</span>
                <span class="gourmet-brand-sub">Alta Cocina</span>
            </div>
        </a>

        <!-- Enlaces Principales de Navegación -->
        <nav class="gourmet-links" id="gourmetLinks">
            <a href="/" class="gourmet-link @(currentCtrl == "Home" && currentAct == "Index" ? "active" : "")">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                <span>La Carta</span>
            </a>
            <a asp-controller="Reserva" asp-action="Nueva" class="gourmet-link @(currentCtrl == "Reserva" && currentAct == "Nueva" ? "active" : "")">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                <span>Reservar Mesa</span>
            </a>
            <a asp-controller="Pedido" asp-action="Checkout" asp-route-tipo="Domicilio" class="gourmet-link @(currentCtrl == "Pedido" && currentAct == "Checkout" ? "active" : "")">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><line x1="9" y1="12" x2="15" y2="12"/><line x1="9" y1="16" x2="13" y2="16"/></svg>
                <span>Hacer Pedido</span>
            </a>
            <a asp-controller="Pago" asp-action="Checkout" class="gourmet-link @(currentCtrl == "Pago" && currentAct == "Checkout" ? "active" : "")">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                <span>Pagar Cuenta</span>
            </a>

            @if (_autenticado)
            {
                <a asp-controller="Pedido" asp-action="MisPedidos" class="gourmet-link @(currentCtrl == "Pedido" && currentAct == "MisPedidos" ? "active" : "")">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/></svg>
                    <span>Mis Pedidos</span>
                </a>
                <a asp-controller="Reserva" asp-action="MisReservas" class="gourmet-link @(currentCtrl == "Reserva" && currentAct == "MisReservas" ? "active" : "")">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                    <span>Mis Reservas</span>
                </a>
                <a asp-controller="Perfil" asp-action="Index" class="gourmet-link @(currentCtrl == "Perfil" ? "active" : "")">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    <span>Mi Perfil</span>
                </a>
            }

            @if (_esPersonal)
            {
                <a href="@Roles.PaginaInicio(_rol)" class="gourmet-link staff-link">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="display:inline-block !important;flex-shrink:0;"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>
                    <span>Mi Panel</span>
                </a>
            }
        </nav>

        <!-- Acciones Derecha (Tema, Usuario, Carrito, Botón) -->
        <div class="gourmet-actions">
            <!-- Toggle Modo Oscuro / Claro -->
            <button type="button" class="theme-toggle-btn" onclick="toggleModoOscuro()" title="Cambiar modo de luz u oscuro" aria-label="Cambiar modo de luz u oscuro">
                <svg class="theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                <svg class="theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
            </button>

            @if (_autenticado)
            {
                <div class="gourmet-user-pill">
                    <a href="@(_esPersonal ? Roles.PaginaInicio(_rol) : Url.Action("Index", "Perfil"))" class="gourmet-user-avatar" title="@(_esPersonal ? "Ir a mi panel" : "Mi perfil & apariencia")" style="text-decoration:none;">
                        @if (!string.IsNullOrEmpty(_fotoPerfil))
                        {
                            <img src="@_fotoPerfil" alt="Avatar de @_user" class="gourmet-user-avatar-img" />
                        }
                        else if (_esPersonal)
                        {
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#18060A" stroke-width="2.4"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>
                        }
                        else
                        {
                            @(_user?.Length > 0 ? _user[0].ToString().ToUpper() : "U")
                        }
                    </a>
                    <a href="@(_esPersonal ? Roles.PaginaInicio(_rol) : Url.Action("Index", "Perfil"))" class="gourmet-user-name" title="Gestionar mi perfil" style="text-decoration:none;color:inherit;">@_user</a>
                    <a asp-controller="Login" asp-action="Logout" class="gourmet-btn-logout" title="Cerrar sesión">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                    </a>
                </div>
            }
            else
            {
                <button type="button" onclick="abrirModalIngreso()" class="gourmet-btn-login" id="btnNavIngresarGourmet">
                    Ingresar
                </button>
            }

            <!-- Botón Hamburguesa Responsive -->
            <button type="button" class="gourmet-mobile-toggle" id="gourmetMobileToggle" onclick="toggleGourmetMobileNav()" aria-label="Abrir menú">
                <span></span><span></span><span></span>
            </button>
        </div>
    </div>

    <!-- Menú Desplegable Móvil -->
    <div class="gourmet-mobile-menu" id="gourmetMobileMenu">
        <a href="/" class="gourmet-mobile-item"><svg class="ico" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-.15em;margin-right:.35em;flex:none"><path d="M4 11a8 8 0 0 1 16 0Z"/><path d="M3 14.5h18"/><path d="M4 18h16v1a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z"/></svg>La Carta de Autor</a>
        <a asp-controller="Reserva" asp-action="Nueva" class="gourmet-mobile-item"><svg class="ico" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-.15em;margin-right:.35em;flex:none"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>Reservar Mesa</a>
        <a asp-controller="Pedido" asp-action="Checkout" asp-route-tipo="Domicilio" class="gourmet-mobile-item"><svg class="ico" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-.15em;margin-right:.35em;flex:none"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>Hacer Pedido</a>
        <a asp-controller="Pago" asp-action="Checkout" class="gourmet-mobile-item"><svg class="ico" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-.15em;margin-right:.35em;flex:none"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>Pagar Cuenta</a>
        @if (_esPersonal)
        {
            <a href="@Roles.PaginaInicio(_rol)" class="gourmet-mobile-item" style="color:var(--gold);font-weight:800;"><svg class="ico" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-.15em;margin-right:.35em;flex:none"><line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6" y1="20" x2="6" y2="16"/></svg>Mi Panel</a>
        }
        @if (_autenticado)
        {
            <a asp-controller="Pedido" asp-action="MisPedidos" class="gourmet-mobile-item"><svg class="ico" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-.15em;margin-right:.35em;flex:none"><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/></svg>Mis Pedidos</a>
            <a asp-controller="Reserva" asp-action="MisReservas" class="gourmet-mobile-item"><svg class="ico" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-.15em;margin-right:.35em;flex:none"><path d="M19 9V6a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v3"/><path d="M3 16a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-5a2 2 0 0 0-4 0v1.5a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5V11a2 2 0 0 0-4 0z"/><path d="M5 18v2"/><path d="M19 18v2"/></svg>Mis Reservas</a>
            <a asp-controller="Perfil" asp-action="Index" class="gourmet-mobile-item"><svg class="ico" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-.15em;margin-right:.35em;flex:none"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>Mi Perfil (@_user)</a>
            <a asp-controller="Login" asp-action="Logout" class="gourmet-mobile-item" style="color:#F87171;font-weight:700;"><svg class="ico" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-.15em;margin-right:.35em;flex:none"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>Cerrar Sesión</a>
        }
        else
        {
            <button type="button" onclick="abrirModalIngreso(); toggleGourmetMobileNav();" class="gourmet-mobile-item" style="background:none;border:none;text-align:left;width:100%;cursor:pointer;font-size:inherit;font-family:inherit;color:inherit;"><svg class="ico" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-.15em;margin-right:.35em;flex:none"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>Ingresar</button>
        }
    </div>
</header>
