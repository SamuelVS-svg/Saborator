@inject ControlClientesRestaurante.Services.ComboService _comboSvc
@* Carrito de compras: panel lateral, ventana de modalidad de entrega y su motor.
   Lo incluye _NavbarInicio, así que está disponible en todas las páginas con la barra pública. *@
<link rel="stylesheet" href="~/css/carrito.css" asp-append-version="true" />
<script type="application/json" data-combos>@Html.Raw(_comboSvc.DisponiblesJson())</script>
<script src="~/js/combos.js" asp-append-version="true"></script>
<script src="~/js/carrito.js" asp-append-version="true"></script>

<!-- Modal Selector de Modalidad (KFC) -->
<div class="modality-modal-overlay" id="modalityModalOverlay" onclick="if(event.target===this) cerrarModalModalidad();">
    <div class="modality-modal">
        <button type="button" class="modality-modal-close" onclick="cerrarModalModalidad()">&times;</button>
        <h2 class="modality-modal-title">¿Cómo deseas tu orden?</h2>
        <p class="modality-modal-sub">Elige tu forma de entrega preferida para Saborator:</p>

        <div class="modality-modal-options">
            <div class="mod-option-btn active" id="optDomicilio" onclick="seleccionarModalidad('Domicilio')">
                <span class="mod-opt-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18.5" cy="17.5" r="3.5"/><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="15" cy="5" r="1"/><path d="M12 17.5V14l-3-3 4-3 2 3h2"/></svg>
                </span>
                <div>
                    <div class="mod-opt-title">Domicilio Express</div>
                    <div class="mod-opt-desc">Te lo llevamos caliente y sellado a tu puerta desde Cra 4 Sur # 50D-107</div>
                </div>
            </div>

            <div id="quickAddressBox" style="display:none;background:#FBF7EE;padding:1.15rem;border-radius:14px;border:1.5px solid #E8DFD0;margin-top:-0.35rem;">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.75rem;padding-bottom:0.6rem;border-bottom:1px dashed #E8DFD0;">
                    <span style="font-size:0.78rem;color:#6E5C50;display:inline-flex;align-items:center;gap:4px;">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                        Despacho: <strong>Cra 4 Sur # 50D-107, Barranquilla</strong>
                    </span>
                    <a href="https://www.google.com/maps/search/?api=1&query=Cra+4+Sur+%2350D-107,+Barranquilla,+Atlantico" target="_blank" rel="noopener noreferrer" style="font-size:0.75rem;color:#9A6700;font-weight:700;text-decoration:none;">
                        Ver Maps ↗
                    </a>
                </div>

                <label style="display:block;font-size:0.75rem;font-weight:800;color:#3C2A20;margin-bottom:0.35rem;text-transform:uppercase;">Sector / Barrio en Barranquilla *</label>
                <select id="quickBarrioSelect" onchange="cambiarBarrioModalKfc()" style="width:100%;padding:0.65rem 0.85rem;border:1.5px solid #E8DFD0;border-radius:8px;font-size:0.88rem;background:#FFFFFF;color:#3C2A20;font-weight:600;margin-bottom:0.65rem;">
                    <option value="4000|Ciudadela 20 de Julio">Ciudadela 20 de Julio ($4.000 COP)</option>
                    <option value="4000|La Magdalena">La Magdalena ($4.000 COP)</option>
                    <option value="4000|Las Cayenas">Las Cayenas ($4.000 COP)</option>
                    <option value="4000|Simón Bolívar">Simón Bolívar ($4.000 COP)</option>
                    <option value="4000|Santa María">Santa María ($4.000 COP)</option>
                    <option value="4000|Carrizal">Carrizal ($4.000 COP)</option>
                    <option value="4000|Buenos Aires">Buenos Aires ($4.000 COP)</option>
                    <option value="4000|Las Palmas">Las Palmas ($4.000 COP)</option>
                    <option value="4000|Los Robles">Los Robles ($4.000 COP)</option>
                    <option value="6000|San Roque">San Roque ($6.000 COP)</option>
                    <option value="6000|Rebolo">Rebolo ($6.000 COP)</option>
                    <option value="6000|Chiquinquirá">Chiquinquirá ($6.000 COP)</option>
                    <option value="6000|San Felipe">San Felipe ($6.000 COP)</option>
                    <option value="6000|Bostón">Bostón ($6.000 COP)</option>
                    <option value="6000|Lucero">Lucero ($6.000 COP)</option>
                    <option value="6000|Los Pinos">Los Pinos ($6.000 COP)</option>
                    <option value="6000|El Valle">El Valle ($6.000 COP)</option>
                    <option value="6000|Soledad Centro">Soledad Centro / Hipódromo ($6.000 COP)</option>
                    <option value="9000|El Prado">El Prado ($9.000 COP)</option>
                    <option value="9000|Alto Prado">Alto Prado ($9.000 COP)</option>
                    <option value="9000|Riomar">Riomar ($9.000 COP)</option>
                    <option value="9000|Miramar">Miramar ($9.000 COP)</option>
                    <option value="9000|Buenavista">Buenavista ($9.000 COP)</option>
                    <option value="9000|Villa Campestre">Villa Campestre ($9.000 COP)</option>
                    <option value="9000|Villa Santos">Villa Santos ($9.000 COP)</option>
                    <option value="9000|Paraíso">Paraíso ($9.000 COP)</option>
                </select>

                <label style="display:block;font-size:0.75rem;font-weight:800;color:#3C2A20;margin-bottom:0.35rem;text-transform:uppercase;">Dirección exacta de entrega *</label>
                <input type="text" id="quickAddressInput" placeholder="Ej: Calle 47 # 3 Sur-20, Apto 201" style="width:100%;padding:0.65rem 0.85rem;border:1.5px solid #E8DFD0;border-radius:8px;font-size:0.9rem;box-sizing:border-box;margin-bottom:0.65rem;" />

                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.75rem;padding:0.5rem 0.75rem;background:rgba(244, 168, 23,0.12);border-radius:8px;font-size:0.82rem;">
                    <span>Tarifa asignada:</span>
                    <strong id="quickModalFeeDisplay" style="color:#9A6700;font-size:0.95rem;">$4.000 COP</strong>
                </div>

                <button type="button" onclick="guardarDireccionRapida()" class="btn-gold" style="width:100%;padding:0.65rem;border-radius:8px;font-weight:800;border:none;cursor:pointer;">Confirmar Dirección y Tarifa</button>
            </div>

            <div class="mod-option-btn" id="optParaLlevar" onclick="seleccionarModalidad('ParaLlevar')">
                <span class="mod-opt-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                </span>
                <div>
                    <div class="mod-opt-title">Para Llevar / Pick Up</div>
                    <div class="mod-opt-desc">Pide en línea y retira en restaurante sin hacer fila (Gratis)</div>
                </div>
            </div>

            <div class="mod-option-btn" id="optEnMesa" onclick="seleccionarModalidad('EnMesa')">
                <span class="mod-opt-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/></svg>
                </span>
                <div>
                    <div class="mod-opt-title">Consumo en Salón / Mesa</div>
                    <div class="mod-opt-desc">Disfruta tu comida servida a tu mesa en nuestro salón</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Barra Flotante de Carrito en la parte inferior (KFC) -->

<!-- Drawer Lateral de Carrito estilo KFC -->
<div class="cart-drawer-overlay" id="cartDrawerOverlay" onclick="clickOverlayDrawer(event)">
    <aside class="cart-drawer" id="cartDrawer">
        <div class="drawer-header">
            <h2 class="drawer-title">Tu Pedido</h2>
            <button type="button" class="drawer-close" onclick="cerrarDrawerCarrito()" aria-label="Cerrar">&times;</button>
        </div>

        <div class="drawer-modality-bar">
            <span class="drawer-mod-text" id="drawerModText">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18.5" cy="17.5" r="3.5"/><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="15" cy="5" r="1"/><path d="M12 17.5V14l-3-3 4-3 2 3h2"/></svg>
                <span id="drawerModLabel">Domicilio Express</span>
            </span>
            <span class="drawer-mod-change" onclick="abrirModalModalidad()">Cambiar</span>
        </div>

        <div class="drawer-items" id="drawerItemsList">
            <!-- Items del carrito -->
        </div>

        <div class="drawer-footer">
            <!-- Alerta de Pedido Mínimo de Domicilio -->
            <div id="drawerMinAlert" style="display:none;margin-bottom:0.75rem;padding:0.65rem 0.85rem;background:rgba(239,68,68,0.15);border:1px solid rgba(239,68,68,0.35);border-radius:10px;font-size:0.78rem;color:#FCA5A5;line-height:1.4;">
                <div style="font-weight:700;display:flex;align-items:center;gap:5px;margin-bottom:2px;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    <span>Límite Mínimo de Domicilio: $20.000 COP</span>
                </div>
                <span>Te faltan <strong id="drawerMinFaltante" style="color:#FFF;">$0</strong> en comida para habilitar el domicilio. Puedes agregar más platos o elegir "Para Llevar".</span>
            </div>

            <div class="drawer-totals">
                <div class="drawer-total-row">
                    <span>Subtotal</span>
                    <span id="drawerSubtotal">$0 COP</span>
                </div>
                <div class="drawer-total-row combo-ahorro" id="drawerComboRow" style="display:none;">
                    <span id="drawerComboLabel">Ahorro por combo</span>
                    <span id="drawerComboVal">-$0 COP</span>
                </div>
                <div class="drawer-total-row" id="drawerShippingRow">
                    <span>Costo de Envío</span>
                    <span id="drawerShipping">$4.000 COP</span>
                </div>
                <div class="drawer-total-row final">
                    <span>Total a Pagar</span>
                    <span id="drawerTotal">$0 COP</span>
                </div>
            </div>

            <a href="/Pedido/Checkout" class="drawer-checkout-btn" id="drawerCheckoutBtn">
                <span>Continuar al Checkout</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
            </a>
        </div>
    </aside>
</div>
