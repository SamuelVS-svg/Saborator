</style>

<script>
(function() {
    const STORAGE_KEY = 'saborator_cookie_consent';

    function obtenerConsentimiento() {
        try {
            const raw = localStorage.getItem(STORAGE_KEY);
            return raw ? JSON.parse(raw) : null;
        } catch(e) {
            return null;
        }
    }

    function guardarConsentimiento(esenciales, preferencias, analiticas) {
        const data = {
            esenciales: true,
            preferencias: !!preferencias,
            analiticas: !!analiticas,
            fecha: new Date().toISOString()
        };
        try {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
            localStorage.setItem('lamesa_cookie_accepted', 'true');
        } catch(e) {}

        const banner = document.getElementById('cookieBanner');
        if (banner) banner.style.display = 'none';

        cerrarModalPreferenciasCookies();
    }

    window.aceptarTodasCookies = function() {
        guardarConsentimiento(true, true, true);
        if (window.showToast) {
            showToast('ok', 'Preferencias de cookies guardadas: Todas habilitadas.');
        }
    };

    window.aceptarSoloNecesarias = function() {
        guardarConsentimiento(true, false, false);
        if (window.showToast) {
            showToast('ok', 'Preferencias guardadas: Solo cookies técnicas esenciales.');
        }
    };

    window.abrirModalPreferenciasCookies = function() {
        const consent = obtenerConsentimiento();
        const togglePref = document.getElementById('toggleCookiesPreferencias');
        const toggleAna = document.getElementById('toggleCookiesAnaliticas');

        if (togglePref) togglePref.checked = consent ? consent.preferencias : true;
        if (toggleAna) toggleAna.checked = consent ? consent.analiticas : false;

        const modal = document.getElementById('cookieModalOverlay');
        if (modal) modal.style.display = 'flex';
    };

    window.cerrarModalPreferenciasCookies = function() {
        const modal = document.getElementById('cookieModalOverlay');
        if (modal) modal.style.display = 'none';
    };

    window.guardarPreferenciasPersonalizadas = function() {
        const pref = document.getElementById('toggleCookiesPreferencias')?.checked ?? true;
        const ana = document.getElementById('toggleCookiesAnaliticas')?.checked ?? false;
        guardarConsentimiento(true, pref, ana);
        if (window.showToast) {
            showToast('ok', 'Preferencias de cookies personalizadas guardadas.');
        }
    };

    window.abrirConfiguracionCookies = window.abrirModalPreferenciasCookies;

    // ── MOTOR ARRASTRABLE (DRAG & DROP) EXACTO AL DE WHATSAPP CONCIERGE ──
    const cookieWrap = document.getElementById('cookieConcierge');
    const cookieBtn = document.getElementById('cookieConciergeBtn');

    let isDraggingCookie = false;
    let cookieStartX = 0, cookieStartY = 0;
    let cookieInitialLeft = 0, cookieInitialTop = 0;

    function inicializarPosicionCookie() {
        if (!cookieWrap) return;
        const guardadaX = localStorage.getItem('saborator_cookie_pos_x');
        const guardadaY = localStorage.getItem('saborator_cookie_pos_y');

        if (guardadaX !== null && guardadaY !== null) {
            const x = Math.min(Math.max(10, parseInt(guardadaX)), window.innerWidth - 64);
            const y = Math.min(Math.max(10, parseInt(guardadaY)), window.innerHeight - 64);
            cookieWrap.style.left = x + 'px';
            cookieWrap.style.top = y + 'px';
            cookieWrap.style.right = 'auto';
            cookieWrap.style.bottom = 'auto';
        }
    }

    function onCookiePointerDown(e) {
        if (e.button !== undefined && e.button !== 0) return;
        isDraggingCookie = false;

        const clientX = e.touches ? e.touches[0].clientX : e.clientX;
        const clientY = e.touches ? e.touches[0].clientY : e.clientY;

        cookieStartX = clientX;
        cookieStartY = clientY;

        const rect = cookieWrap.getBoundingClientRect();
        cookieInitialLeft = rect.left;
        cookieInitialTop = rect.top;

        window.addEventListener('mousemove', onCookiePointerMove, { passive: false });
        window.addEventListener('mouseup', onCookiePointerUp);
        window.addEventListener('touchmove', onCookiePointerMove, { passive: false });
        window.addEventListener('touchend', onCookiePointerUp);
    }

    function onCookiePointerMove(e) {
        const clientX = e.touches ? e.touches[0].clientX : e.clientX;
        const clientY = e.touches ? e.touches[0].clientY : e.clientY;

        const deltaX = clientX - cookieStartX;
        const deltaY = clientY - cookieStartY;

        if (Math.hypot(deltaX, deltaY) > 5) {
            isDraggingCookie = true;
            cookieWrap.classList.add('is-dragging');
            if (e.cancelable) e.preventDefault();

            let nuevoX = cookieInitialLeft + deltaX;
            let nuevoY = cookieInitialTop + deltaY;

            const pad = 8;
            nuevoX = Math.max(pad, Math.min(window.innerWidth - cookieWrap.offsetWidth - pad, nuevoX));
            nuevoY = Math.max(pad, Math.min(window.innerHeight - cookieWrap.offsetHeight - pad, nuevoY));

            cookieWrap.style.left = nuevoX + 'px';
            cookieWrap.style.top = nuevoY + 'px';
            cookieWrap.style.right = 'auto';
            cookieWrap.style.bottom = 'auto';
        }
    }

    function onCookiePointerUp() {
        window.removeEventListener('mousemove', onCookiePointerMove);
        window.removeEventListener('mouseup', onCookiePointerUp);
        window.removeEventListener('touchmove', onCookiePointerMove);
        window.removeEventListener('touchend', onCookiePointerUp);

        cookieWrap.classList.remove('is-dragging');

        if (isDraggingCookie) {
            const rect = cookieWrap.getBoundingClientRect();
            localStorage.setItem('saborator_cookie_pos_x', Math.round(rect.left));
            localStorage.setItem('saborator_cookie_pos_y', Math.round(rect.top));
        }
    }

    if (cookieWrap) {
        cookieWrap.addEventListener('mousedown', onCookiePointerDown);
        cookieWrap.addEventListener('touchstart', onCookiePointerDown, { passive: true });
    }

    if (cookieBtn) {
        // Prevenir modal si fue un arrastre, o abrirlo en click simple
        cookieBtn.addEventListener('click', (e) => {
            if (isDraggingCookie) {
                e.preventDefault();
                e.stopPropagation();
                return false;
            }
            abrirModalPreferenciasCookies();
            e.preventDefault();
        });
    }

    document.addEventListener('DOMContentLoaded', () => {
        const consent = obtenerConsentimiento();
        if (!consent) {
            const banner = document.getElementById('cookieBanner');
            if (banner) banner.style.display = 'block';
        }
        inicializarPosicionCookie();
    });
})();
</script>
