        color: #FFFDF9;
    }
    .cookie-text {
        font-size: 0.8rem;
        line-height: 1.45;
        color: rgba(255, 253, 249, 0.85);
        margin: 0 0 0.4rem;
    }
    .cookie-legal-link {
        font-size: 0.76rem;
        color: #C8973A;
        text-decoration: underline;
        font-weight: 600;
    }
    .cookie-legal-link:hover {
        color: #E6B55C;
    }

    .cookie-actions {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-top: 0.2rem;
    }
    .btn-cookie-accept-all {
        background: linear-gradient(135deg, #C8973A, #DFB460);
        color: #18060A;
