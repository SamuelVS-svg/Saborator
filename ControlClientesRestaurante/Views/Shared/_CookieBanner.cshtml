@* ════ COMPONENTE INTEGRAL DE PRIVACIDAD, CONSENTIMIENTO & GESTIÓN DE COOKIES ════ *@

<div class="cookie-banner-wrap" id="cookieBanner" style="display: none;" role="region" aria-label="Aviso de cookies y privacidad">
    <div class="cookie-content">
        <div class="cookie-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <path d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5"/>
                <circle cx="8.5" cy="8.5" r="1" fill="currentColor"/>
                <circle cx="15.5" cy="15.5" r="1" fill="currentColor"/>
                <circle cx="12" cy="12" r="1" fill="currentColor"/>
                <circle cx="8" cy="14" r="0.75" fill="currentColor"/>
                <circle cx="14" cy="9" r="0.75" fill="currentColor"/>
            </svg>
        </div>
        <div class="cookie-text-box">
            <h4 class="cookie-heading">Tu privacidad y tus cookies</h4>
            <p class="cookie-text">
                En Saborator utilizamos cookies técnicas esenciales para procesar tus pedidos y reservas, así como cookies de personalización para recordar tu modo de visualización (claro/oscuro) y sector de entrega en Barranquilla conforme a la Ley 1581 de 2012.
            </p>
            <div class="cookie-links">
                <a asp-controller="Home" asp-action="Terminos" target="_blank" class="cookie-legal-link">Ver Política de Cookies &amp; Términos</a>
            </div>
        </div>
        <div class="cookie-actions">
            <button type="button" class="btn-cookie-accept-all" onclick="aceptarTodasCookies()">Aceptar todas</button>
            <button type="button" class="btn-cookie-necessary" onclick="aceptarSoloNecesarias()">Solo necesarias</button>
            <button type="button" class="btn-cookie-config" onclick="abrirModalPreferenciasCookies()">Personalizar</button>
        </div>
    </div>
</div>

<!-- MODAL DE PREFERENCIAS GRANULARES DE COOKIES -->
<div class="cookie-modal-overlay" id="cookieModalOverlay" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="cookieModalTitle">
    <div class="cookie-modal-card">
        <div class="cookie-modal-header">
            <div style="display:flex;align-items:center;gap:0.6rem;">
                <div class="cookie-icon-gold">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5"/><circle cx="8.5" cy="8.5" r="1"/><circle cx="15.5" cy="15.5" r="1"/><circle cx="12" cy="12" r="1"/></svg>
                </div>
                <div>
                    <h3 id="cookieModalTitle" class="cookie-modal-title">Centro de Preferencias de Cookies</h3>
                    <p class="cookie-modal-subtitle">Controla qué información permites que Saborator almacene en tu dispositivo</p>
                </div>
            </div>
            <button type="button" class="cookie-modal-close" onclick="cerrarModalPreferenciasCookies()" aria-label="Cerrar modal">&times;</button>
        </div>

        <div class="cookie-modal-body">
            
            <!-- 1. Esenciales -->
            <div class="cookie-item">
                <div class="cookie-item-info">
                    <div class="cookie-item-title-row">
                        <strong>Cookies Técnicas &amp; Esenciales</strong>
                        <span class="cookie-badge-required">Siempre Activas</span>
                    </div>
                    <p class="cookie-item-desc">
                        Requeridas para el funcionamiento seguro del sitio web, autenticación de usuarios, persistencia del carrito, antiforgery tokens y procesamiento seguro de pedidos.
                    </p>
                </div>
                <div class="cookie-toggle-wrap">
                    <input type="checkbox" checked disabled id="toggleCookiesEsenciales" class="cookie-switch-input" />
                    <label for="toggleCookiesEsenciales" class="cookie-switch-label disabled"></label>
                </div>
            </div>

            <!-- 2. Preferencias -->
            <div class="cookie-item">
                <div class="cookie-item-info">
                    <div class="cookie-item-title-row">
                        <strong>Cookies de Personalización &amp; Preferencias</strong>
                        <span class="cookie-badge-optional">Opcional</span>
                    </div>
                    <p class="cookie-item-desc">
                        Permiten recordar tus preferencias de navegación, como la activación del <strong>Modo Oscuro</strong>, la posición preferida de tus widgets flotantes y tu sector de entrega habitual en Barranquilla.
                    </p>
                </div>
                <div class="cookie-toggle-wrap">
                    <input type="checkbox" id="toggleCookiesPreferencias" class="cookie-switch-input" />
                    <label for="toggleCookiesPreferencias" class="cookie-switch-label"></label>
                </div>
            </div>

            <!-- 3. Rendimiento / Analítica -->
            <div class="cookie-item">
                <div class="cookie-item-info">
                    <div class="cookie-item-title-row">
                        <strong>Cookies de Experiencia &amp; Rendimiento</strong>
                        <span class="cookie-badge-optional">Opcional</span>
                    </div>
                    <p class="cookie-item-desc">
                        Recopilan métricas totalmente anónimas sobre tiempos de carga de la carta y navegación para ayudarnos a optimizar la velocidad del servicio online.
                    </p>
                </div>
                <div class="cookie-toggle-wrap">
                    <input type="checkbox" id="toggleCookiesAnaliticas" class="cookie-switch-input" />
                    <label for="toggleCookiesAnaliticas" class="cookie-switch-label"></label>
                </div>
            </div>

        </div>

        <div class="cookie-modal-footer">
            <button type="button" class="btn-cookie-save-prefs" onclick="guardarPreferenciasPersonalizadas()">Guardar Mis Preferencias</button>
            <button type="button" class="btn-cookie-accept-all-modal" onclick="aceptarTodasCookies()">Aceptar Todas</button>
        </div>
    </div>
</div>

<style>
    /* ── BANNER PRINCIPAL ── */
    .cookie-banner-wrap {
        position: fixed;
        bottom: 24px;
        left: 24px;
        z-index: 9980;
        max-width: 520px;
        background: #1F120C;
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1.5px solid rgba(244, 168, 23, 0.4);
        border-radius: 18px;
        padding: 1.25rem 1.4rem;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.65), 0 0 1px rgba(255, 255, 255, 0.2);
        animation: cookieSlideUp 0.35s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    @@keyframes cookieSlideUp {
        from { opacity: 0; transform: translateY(20px) scale(0.97); }
        to { opacity: 1; transform: translateY(0) scale(1); }
    }
    .cookie-content {
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
    }
    .cookie-icon {
        color: #9A6700;
        width: 38px;
        height: 38px;
        background: rgba(244, 168, 23, 0.12);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .cookie-heading {
        margin: 0 0 0.3rem;
        font-size: 0.95rem;
        font-weight: 700;
        color: #FFFFFF;
    }
    .cookie-text {
        font-size: 0.8rem;
        line-height: 1.45;
        color: rgba(255, 255, 255, 0.85);
        margin: 0 0 0.4rem;
    }
    .cookie-legal-link {
        font-size: 0.76rem;
        color: #9A6700;
        text-decoration: underline;
        font-weight: 600;
    }
    .cookie-legal-link:hover {
        color: #E6B55C;
    }

    .cookie-actions {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-top: 0.2rem;
    }
    .btn-cookie-accept-all {
        background: linear-gradient(135deg, #F4A817, #F4C95D);
        color: #1F120C;
        font-weight: 800;
        font-size: 0.8rem;
        padding: 0.55rem 1rem;
        border-radius: 10px;
        border: none;
        cursor: pointer;
        transition: transform 120ms ease, box-shadow 120ms ease;
    }
    .btn-cookie-accept-all:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 14px rgba(244, 168, 23, 0.35);
    }
    .btn-cookie-necessary {
        background: rgba(255, 255, 255, 0.08);
        color: #FFFFFF;
        font-weight: 600;
        font-size: 0.8rem;
        padding: 0.55rem 0.9rem;
        border-radius: 10px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        cursor: pointer;
        transition: background 140ms ease;
    }
    .btn-cookie-necessary:hover {
        background: rgba(255, 255, 255, 0.16);
    }
    .btn-cookie-config {
        background: none;
        color: var(--gold, #F4A817);
        font-weight: 600;
        font-size: 0.78rem;
        padding: 0.55rem 0.65rem;
        border: none;
        cursor: pointer;
        text-decoration: underline;
    }

    /* ── MODAL DE PREFERENCIAS ── */
    .cookie-modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(10, 3, 5, 0.78);
        backdrop-filter: blur(8px);
        z-index: 10000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.25rem;
        animation: fadeInModal 200ms ease;
    }
    @@keyframes fadeInModal {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    .cookie-modal-card {
        background: #1F120C;
        border: 1.5px solid rgba(244, 168, 23, 0.45);
        border-radius: 22px;
        width: 100%;
        max-width: 580px;
        box-shadow: 0 24px 64px rgba(0,0,0,0.8);
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }
    .cookie-modal-header {
        padding: 1.25rem 1.5rem;
        background: rgba(32, 11, 16, 0.95);
        border-bottom: 1px solid rgba(244, 168, 23, 0.25);
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }
    .cookie-icon-gold {
        color: #9A6700;
        background: rgba(244, 168, 23, 0.15);
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .cookie-modal-title {
        margin: 0 0 0.15rem;
        font-size: 1.15rem;
        font-weight: 700;
        color: #FFFFFF;
    }
    .cookie-modal-subtitle {
        margin: 0;
        font-size: 0.78rem;
        color: rgba(255, 255, 255, 0.65);
    }
    .cookie-modal-close {
        background: none;
        border: none;
        color: rgba(255, 255, 255, 0.6);
        font-size: 1.6rem;
        cursor: pointer;
        padding: 0 4px;
        line-height: 1;
    }
    .cookie-modal-close:hover { color: #FFF; }

    .cookie-modal-body {
        padding: 1.25rem 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1.1rem;
        max-height: 60vh;
        overflow-y: auto;
    }
    .cookie-item {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(244, 168, 23, 0.2);
        border-radius: 14px;
        padding: 1rem 1.15rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1.25rem;
    }
    .cookie-item-info { flex: 1; }
    .cookie-item-title-row {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-bottom: 0.3rem;
    }
    .cookie-item-title-row strong {
        font-size: 0.9rem;
        color: #FFFFFF;
    }
    .cookie-badge-required {
        font-size: 0.65rem;
        font-weight: 700;
        background: rgba(16, 185, 129, 0.18);
        color: #34D399;
        border: 1px solid rgba(16, 185, 129, 0.4);
        padding: 1px 7px;
        border-radius: 999px;
        text-transform: uppercase;
    }
    .cookie-badge-optional {
        font-size: 0.65rem;
        font-weight: 700;
        background: rgba(244, 168, 23, 0.15);
        color: #9A6700;
        border: 1px solid rgba(244, 168, 23, 0.35);
        padding: 1px 7px;
        border-radius: 999px;
        text-transform: uppercase;
    }
    .cookie-item-desc {
        margin: 0;
        font-size: 0.78rem;
        line-height: 1.4;
        color: rgba(255, 255, 255, 0.7);
    }

    /* Switch toggle */
    .cookie-toggle-wrap { flex-shrink: 0; }
    .cookie-switch-input { display: none; }
    .cookie-switch-label {
        position: relative;
        display: inline-block;
        width: 44px;
        height: 24px;
        background: #331A21;
        border-radius: 999px;
        cursor: pointer;
        transition: background 200ms ease;
    }
    .cookie-switch-label::after {
        content: '';
        position: absolute;
        top: 2px;
        left: 2px;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: #FFFFFF;
        transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow: 0 2px 5px rgba(0,0,0,0.3);
    }
    .cookie-switch-input:checked + .cookie-switch-label {
        background: #F4A817;
    }
    .cookie-switch-input:checked + .cookie-switch-label::after {
        transform: translateX(20px);
        background: #1F120C;
    }
    .cookie-switch-label.disabled {
        opacity: 0.6;
        cursor: not-allowed;
        background: #059669 !important;
    }
    .cookie-switch-label.disabled::after {
        transform: translateX(20px);
    }

    .cookie-modal-footer {
        padding: 1.1rem 1.5rem;
        background: rgba(32, 11, 16, 0.95);
        border-top: 1px solid rgba(244, 168, 23, 0.2);
        display: flex;
        justify-content: flex-end;
        gap: 0.75rem;
        flex-wrap: wrap;
    }
    .btn-cookie-save-prefs {
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(244, 168, 23, 0.4);
        color: #FFFFFF;
        padding: 0.6rem 1.15rem;
        border-radius: 10px;
        font-weight: 700;
        font-size: 0.82rem;
        cursor: pointer;
        transition: background 140ms ease;
    }
    .btn-cookie-save-prefs:hover {
        background: rgba(244, 168, 23, 0.2);
    }
    .btn-cookie-accept-all-modal {
        background: linear-gradient(135deg, #F4A817, #F4C95D);
        color: #1F120C;
        border: none;
        padding: 0.6rem 1.25rem;
        border-radius: 10px;
        font-weight: 800;
        font-size: 0.82rem;
        cursor: pointer;
        box-shadow: 0 4px 14px rgba(244, 168, 23, 0.35);
    }

    @@media (max-width: 600px) {
        .cookie-banner-wrap {
            left: 12px;
            right: 12px;
            bottom: 78px;
            max-width: none;
        }
        .btn-floating-cookie-reopen {
            bottom: 16px;
            left: 16px;
        }
    }
</style>

<script>
(function() {
    const STORAGE_KEY = 'saborator_cookie_consent';

    function obtenerConsentimiento() {
        try {
            const raw = localStorage.getItem(STORAGE_KEY);
            return raw ? JSON.parse(raw) : null;
        } catch(e) {
            return null;
        }
    }

    function guardarConsentimiento(esenciales, preferencias, analiticas) {
        const data = {
            esenciales: true,
            preferencias: !!preferencias,
            analiticas: !!analiticas,
            fecha: new Date().toISOString()
        };
        try {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
            localStorage.setItem('lamesa_cookie_accepted', 'true');
        } catch(e) {}

        const banner = document.getElementById('cookieBanner');
        if (banner) banner.style.display = 'none';

        cerrarModalPreferenciasCookies();
    }

    window.aceptarTodasCookies = function() {
        guardarConsentimiento(true, true, true);
        if (window.showToast) {
            showToast('ok', 'Preferencias de cookies guardadas: Todas habilitadas.');
        }
    };

    window.aceptarSoloNecesarias = function() {
        guardarConsentimiento(true, false, false);
        if (window.showToast) {
            showToast('ok', 'Preferencias guardadas: Solo cookies técnicas esenciales.');
        }
    };

    window.abrirModalPreferenciasCookies = function() {
        const consent = obtenerConsentimiento();
        const togglePref = document.getElementById('toggleCookiesPreferencias');
        const toggleAna = document.getElementById('toggleCookiesAnaliticas');

        if (togglePref) togglePref.checked = consent ? consent.preferencias : true;
        if (toggleAna) toggleAna.checked = consent ? consent.analiticas : false;

        const modal = document.getElementById('cookieModalOverlay');
        if (modal) modal.style.display = 'flex';
    };

    window.cerrarModalPreferenciasCookies = function() {
        const modal = document.getElementById('cookieModalOverlay');
        if (modal) modal.style.display = 'none';
    };

    window.guardarPreferenciasPersonalizadas = function() {
        const pref = document.getElementById('toggleCookiesPreferencias')?.checked ?? true;
        const ana = document.getElementById('toggleCookiesAnaliticas')?.checked ?? false;
        guardarConsentimiento(true, pref, ana);
        if (window.showToast) {
            showToast('ok', 'Preferencias de cookies personalizadas guardadas.');
        }
    };

    window.abrirConfiguracionCookies = window.abrirModalPreferenciasCookies;

    document.addEventListener('DOMContentLoaded', () => {
        const consent = obtenerConsentimiento();
        if (!consent) {
            const banner = document.getElementById('cookieBanner');
            if (banner) banner.style.display = 'block';
        }
    });
})();
</script>
