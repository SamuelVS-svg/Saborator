        overflow: hidden;
        display: flex;
        flex-direction: column;
    }
    .cookie-modal-header {
        padding: 1.25rem 1.5rem;
        background: rgba(32, 11, 16, 0.95);
        border-bottom: 1px solid rgba(200, 151, 58, 0.25);
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }
    .cookie-icon-gold {
        color: #C8973A;
        background: rgba(200, 151, 58, 0.15);
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .cookie-modal-title {
        margin: 0 0 0.15rem;
        font-size: 1.15rem;
        font-weight: 700;
        color: #FFFDF9;
    }
    .cookie-modal-subtitle {
        margin: 0;
        font-size: 0.78rem;
        color: rgba(255, 253, 249, 0.65);
    }
    .cookie-modal-close {
        background: none;
        border: none;
        color: rgba(255, 253, 249, 0.6);
        font-size: 1.6rem;
        cursor: pointer;
        padding: 0 4px;
