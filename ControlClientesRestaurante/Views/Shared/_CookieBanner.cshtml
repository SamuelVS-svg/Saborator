@* ════ COMPONENTE INTEGRAL DE PRIVACIDAD, CONSENTIMIENTO & GESTIÓN DE COOKIES ════ *@

<div class="cookie-banner-wrap" id="cookieBanner" style="display: none;" role="region" aria-label="Aviso de cookies y privacidad">
    <div class="cookie-content">
        <div class="cookie-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <path d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5"/>
                <circle cx="8.5" cy="8.5" r="1" fill="currentColor"/>
                <circle cx="15.5" cy="15.5" r="1" fill="currentColor"/>
                <circle cx="12" cy="12" r="1" fill="currentColor"/>
                <circle cx="8" cy="14" r="0.75" fill="currentColor"/>
                <circle cx="14" cy="9" r="0.75" fill="currentColor"/>
            </svg>
        </div>
        <div class="cookie-text-box">
            <h4 class="cookie-heading">Tu Privacidad &amp; Experiencia Gastronómica</h4>
            <p class="cookie-text">
                En Saborator utilizamos cookies técnicas esenciales para procesar tus pedidos y reservas, así como cookies de personalización para recordar tu modo de visualización (claro/oscuro) y sector de entrega en Barranquilla conforme a la Ley 1581 de 2012.
            </p>
            <div class="cookie-links">
                <a asp-controller="Home" asp-action="Terminos" target="_blank" class="cookie-legal-link">Ver Política de Cookies &amp; Términos</a>
            </div>
        </div>
        <div class="cookie-actions">
            <button type="button" class="btn-cookie-accept-all" onclick="aceptarTodasCookies()">Aceptar todas</button>
            <button type="button" class="btn-cookie-necessary" onclick="aceptarSoloNecesarias()">Solo necesarias</button>
            <button type="button" class="btn-cookie-config" onclick="abrirModalPreferenciasCookies()">Personalizar</button>
        </div>
    </div>
</div>

<!-- COMPONENTE FLOTANTE COOKIES (ESTILO WHATSAPP: CIRCULAR, CON MANIJA DE PUNTOS Y ARRASTRABLE LIBREMENTE) -->
<div class="luxury-cookie-wrap" id="cookieConcierge" role="button" tabindex="0" title="Arrastra para mover · Haz clic para configurar Cookies" aria-label="Preferencias de Cookies Saborator">
    <div class="cookie-drag-handle" title="Arrastrar">
        <svg width="8" height="8" viewBox="0 0 24 24" fill="currentColor">
            <circle cx="5" cy="5" r="2"/><circle cx="12" cy="5" r="2"/><circle cx="19" cy="5" r="2"/>
            <circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/>
            <circle cx="5" cy="19" r="2"/><circle cx="12" cy="19" r="2"/><circle cx="19" cy="19" r="2"/>
        </svg>
    </div>

    <button type="button" id="cookieConciergeBtn" class="luxury-cookie-btn" aria-label="Configuración de Cookies">
        <span class="cookie-ping-ring"></span>
        <svg class="cookie-icon-svg" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5"/>
            <circle cx="8.5" cy="8.5" r="1" fill="currentColor"/>
            <circle cx="15.5" cy="15.5" r="1" fill="currentColor"/>
            <circle cx="12" cy="12" r="1" fill="currentColor"/>
        </svg>
        <span class="cookie-tooltip">
            <strong>Cookies &amp; Privacidad</strong>
            <small>Configurar preferencias</small>
        </span>
    </button>
</div>

<!-- MODAL DE PREFERENCIAS GRANULARES DE COOKIES -->
<div class="cookie-modal-overlay" id="cookieModalOverlay" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="cookieModalTitle">
    <div class="cookie-modal-card">
        <div class="cookie-modal-header">
            <div style="display:flex;align-items:center;gap:0.6rem;">
                <div class="cookie-icon-gold">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5"/><circle cx="8.5" cy="8.5" r="1"/><circle cx="15.5" cy="15.5" r="1"/><circle cx="12" cy="12" r="1"/></svg>
                </div>
                <div>
                    <h3 id="cookieModalTitle" class="cookie-modal-title">Centro de Preferencias de Cookies</h3>
                    <p class="cookie-modal-subtitle">Controla qué información permites que Saborator almacene en tu dispositivo</p>
                </div>
            </div>
            <button type="button" class="cookie-modal-close" onclick="cerrarModalPreferenciasCookies()" aria-label="Cerrar modal">&times;</button>
        </div>

        <div class="cookie-modal-body">
            
            <!-- 1. Esenciales -->
            <div class="cookie-item">
                <div class="cookie-item-info">
                    <div class="cookie-item-title-row">
                        <strong>Cookies Técnicas &amp; Esenciales</strong>
                        <span class="cookie-badge-required">Siempre Activas</span>
                    </div>
                    <p class="cookie-item-desc">
                        Requeridas para el funcionamiento seguro del sitio web, autenticación de usuarios, persistencia del carrito gastronómico, antiforgery tokens y procesamiento seguro de pedidos.
                    </p>
                </div>
                <div class="cookie-toggle-wrap">
                    <input type="checkbox" checked disabled id="toggleCookiesEsenciales" class="cookie-switch-input" />
                    <label for="toggleCookiesEsenciales" class="cookie-switch-label disabled"></label>
                </div>
            </div>

            <!-- 2. Preferencias -->
            <div class="cookie-item">
                <div class="cookie-item-info">
                    <div class="cookie-item-title-row">
                        <strong>Cookies de Personalización &amp; Preferencias</strong>
                        <span class="cookie-badge-optional">Opcional</span>
                    </div>
                    <p class="cookie-item-desc">
                        Permiten recordar tus preferencias de navegación, como la activación del <strong>Modo Oscuro</strong>, la posición preferida de tus widgets flotantes y tu sector de entrega habitual en Barranquilla.
                    </p>
                </div>
                <div class="cookie-toggle-wrap">
                    <input type="checkbox" id="toggleCookiesPreferencias" class="cookie-switch-input" />
                    <label for="toggleCookiesPreferencias" class="cookie-switch-label"></label>
                </div>
            </div>

            <!-- 3. Rendimiento / Analítica -->
            <div class="cookie-item">
                <div class="cookie-item-info">
                    <div class="cookie-item-title-row">
                        <strong>Cookies de Experiencia &amp; Rendimiento</strong>
                        <span class="cookie-badge-optional">Opcional</span>
                    </div>
                    <p class="cookie-item-desc">
                        Recopilan métricas totalmente anónimas sobre tiempos de carga de la carta y navegación para ayudarnos a optimizar la velocidad del servicio online.
                    </p>
                </div>
                <div class="cookie-toggle-wrap">
                    <input type="checkbox" id="toggleCookiesAnaliticas" class="cookie-switch-input" />
                    <label for="toggleCookiesAnaliticas" class="cookie-switch-label"></label>
                </div>
            </div>

        </div>

        <div class="cookie-modal-footer">
            <button type="button" class="btn-cookie-save-prefs" onclick="guardarPreferenciasPersonalizadas()">Guardar Mis Preferencias</button>
            <button type="button" class="btn-cookie-accept-all-modal" onclick="aceptarTodasCookies()">Aceptar Todas</button>
        </div>
    </div>
</div>

<style>
    /* ── BANNER PRINCIPAL ── */
    .cookie-banner-wrap {
        position: fixed;
        bottom: 24px;
        left: 24px;
        z-index: 9980;
        max-width: 520px;
        background: #18060A;
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1.5px solid rgba(200, 151, 58, 0.4);
        border-radius: 18px;
        padding: 1.25rem 1.4rem;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.65), 0 0 1px rgba(255, 255, 255, 0.2);
        animation: cookieSlideUp 0.35s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    @@keyframes cookieSlideUp {
        from { opacity: 0; transform: translateY(20px) scale(0.97); }
        to { opacity: 1; transform: translateY(0) scale(1); }
    }
    .cookie-content {
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
    }
    .cookie-icon {
        color: #C8973A;
        width: 38px;
        height: 38px;
        background: rgba(200, 151, 58, 0.12);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
