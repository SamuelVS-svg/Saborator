    /* Switch toggle */
    .cookie-toggle-wrap { flex-shrink: 0; }
    .cookie-switch-input { display: none; }
    .cookie-switch-label {
        position: relative;
        display: inline-block;
        width: 44px;
        height: 24px;
        background: #331A21;
        border-radius: 999px;
        cursor: pointer;
        transition: background 200ms ease;
    }
    .cookie-switch-label::after {
        content: '';
