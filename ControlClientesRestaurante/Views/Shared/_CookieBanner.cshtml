        border: none;
        cursor: pointer;
        text-decoration: underline;
    }

    /* ── COMPONENTE FLOTANTE COOKIES (ESTILO WHATSAPP CON ANILLO DE PULSO Y MANIJA) ── */
    .luxury-cookie-wrap {
        position: fixed;
        bottom: 24px;
        left: 24px;
        z-index: 9985;
        cursor: grab;
        user-select: none;
        touch-action: none;
        transition: transform 180ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .luxury-cookie-wrap:active {
        cursor: grabbing;
        transform: scale(0.96);
    }
    .luxury-cookie-wrap.is-dragging {
        cursor: grabbing;
        transform: scale(1.08);
        box-shadow: 0 16px 36px rgba(200, 151, 58, 0.6);
    }
    .cookie-drag-handle {
        position: absolute;
        top: -6px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(200, 151, 58, 0.9);
        color: #18060A;
        border: 1px solid rgba(255, 255, 255, 0.4);
        border-radius: 6px;
        padding: 1px 3px;
        opacity: 0;
        transition: opacity 160ms ease;
        pointer-events: none;
        z-index: 3;
    }
    .luxury-cookie-wrap:hover .cookie-drag-handle {
        opacity: 0.95;
    }
    .luxury-cookie-btn {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: linear-gradient(135deg, #C8973A, #8E631A);
        color: #FFFDF9;
        box-shadow: 0 8px 24px rgba(200, 151, 58, 0.45), 0 2px 6px rgba(0, 0, 0, 0.3);
        border: 1px solid rgba(255, 255, 255, 0.35);
        cursor: pointer;
        padding: 0;
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease;
    }
    .luxury-cookie-btn:hover {
        transform: scale(1.06) translateY(-2px);
        box-shadow: 0 12px 30px rgba(200, 151, 58, 0.6), 0 4px 10px rgba(0, 0, 0, 0.4);
        color: #FFFFFF;
    }
    .cookie-ping-ring {
        position: absolute;
        inset: -4px;
        border-radius: 50%;
        border: 2px solid rgba(200, 151, 58, 0.5);
        animation: cookiePulse 3s infinite cubic-bezier(0.24, 0, 0.38, 1);
        pointer-events: none;
    }
    @@keyframes cookiePulse {
        0% { transform: scale(0.95); opacity: 0.8; }
        50% { transform: scale(1.25); opacity: 0; }
        100% { transform: scale(0.95); opacity: 0; }
    }
    .cookie-tooltip {
        position: absolute;
        left: 64px;
        background: rgba(24, 6, 10, 0.94);
        border: 1px solid rgba(200, 151, 58, 0.4);
        color: #FFFDF9;
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 0.78rem;
        white-space: nowrap;
        pointer-events: none;
        opacity: 0;
        transform: translateX(-6px);
        transition: opacity 0.2s ease, transform 0.2s ease;
        box-shadow: 0 6px 16px rgba(0,0,0,0.5);
        display: flex;
        flex-direction: column;
