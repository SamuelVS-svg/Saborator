@model ControlClientesRestaurante.Models.Cupon
@{
    ViewData["Title"] = "Crear Nuevo Cupón Promocional";
}

<div style="max-width:720px;margin:0.5rem auto;">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
        <div class="pg-header">
            <div class="pg-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
            </div>
            <div>
                <div class="pg-title">Crear Nuevo Cupón</div>
                <div class="pg-sub">Configura las reglas comerciales, límite de canjes y porcentaje o monto del descuento</div>
            </div>
        </div>
        <a asp-action="Index" class="btn-ghost">
            ← Volver a Cupones
        </a>
    </div>
    <hr class="div-gold" />

    <div class="card-pro">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="row g-3 mb-3">
                <div class="col-12 col-md-6">
                    <label asp-for="Codigo" class="form-label">Código Promocional *</label>
                    <input asp-for="Codigo" class="form-control" placeholder="EJ: BURGER20" style="text-transform:uppercase;font-weight:800;letter-spacing:1px;font-family:'Geist Mono',monospace;" required />
                    <span asp-validation-for="Codigo" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="TipoDescuento" class="form-label">Tipo de Descuento *</label>
                    <select asp-for="TipoDescuento" id="selTipoDescuento" class="form-select" onchange="ajustarCamposTipo()">
                        <option value="Porcentaje">Porcentaje (% sobre subtotal)</option>
                        <option value="Fijo">Monto Fijo ($ COP de descuento)</option>
                    </select>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Descripcion" class="form-label">Descripción de la Promoción *</label>
                <input asp-for="Descripcion" class="form-control" placeholder="Ej: 15% de descuento en pedidos mayores a $30.000 COP" required />
                <span asp-validation-for="Descripcion" class="text-danger small"></span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-12 col-md-6">
                    <label asp-for="Valor" id="lblValor" class="form-label">Porcentaje (%) *</label>
                    <input asp-for="Valor" type="number" step="0.01" class="form-control" placeholder="15" required />
                    <span asp-validation-for="Valor" class="text-danger small"></span>
                </div>
                <div class="col-12 col-md-6" id="colTopeMaximo">
                    <label asp-for="TopeMaximoDescuento" class="form-label">Tope Máximo Descuento ($ COP)</label>
                    <input asp-for="TopeMaximoDescuento" type="number" class="form-control" placeholder="Ej: 15000 (Opcional)" />
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-12 col-md-6">
                    <label asp-for="MontoMinimo" class="form-label">Consumo Mínimo de Pedido ($ COP)</label>
                    <input asp-for="MontoMinimo" type="number" class="form-control" placeholder="Ej: 30000" />
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="UsosMaximos" class="form-label">Límite Máximo de Canjes *</label>
                    <input asp-for="UsosMaximos" type="number" class="form-control" placeholder="100" required />
                </div>
            </div>

            <div class="row g-3 mb-4 align-items-center">
                <div class="col-12 col-md-6">
                    <label asp-for="FechaVencimiento" class="form-label">Fecha de Vencimiento</label>
                    <input asp-for="FechaVencimiento" type="date" class="form-control" />
                </div>
                <div class="col-12 col-md-6 pt-md-4">
                    <div class="d-flex align-items-center gap-2 p-2 rounded-3" style="background:var(--surface-2);border:1px solid var(--border);">
                        <input asp-for="Activo" type="checkbox" id="chkActivo" class="form-check-input mt-0" style="width:18px;height:18px;cursor:pointer;" />
                        <label for="chkActivo" style="font-weight:700;color:var(--ink);font-size:0.88rem;cursor:pointer;margin:0;">Cupón Activo Inmediatamente</label>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 pt-3" style="border-top:1px solid var(--border);">
                <a asp-action="Index" class="btn-ghost">
                    Cancelar
                </a>
                <button type="submit" class="btn-gold">
                    Guardar Cupón
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function ajustarCamposTipo() {
        const tipo = document.getElementById('selTipoDescuento').value;
        const lbl = document.getElementById('lblValor');
        const colTope = document.getElementById('colTopeMaximo');
        if (tipo === 'Porcentaje') {
            lbl.textContent = 'Porcentaje (%) *';
            colTope.style.display = 'block';
        } else {
            lbl.textContent = 'Valor Fijo ($ COP) *';
            colTope.style.display = 'none';
        }
    }
    document.addEventListener('DOMContentLoaded', ajustarCamposTipo);
</script>
