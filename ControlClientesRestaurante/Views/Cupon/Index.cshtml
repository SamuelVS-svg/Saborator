@model List<ControlClientesRestaurante.Models.Cupon>
@{
    ViewData["Title"] = "Gestión de Cupones y Promociones";
    int total = ViewBag.TotalCupones ?? 0;
    int activos = ViewBag.CuponesActivos ?? 0;
    int canjes = ViewBag.TotalCanjes ?? 0;
}

<!-- Encabezado Principal Saborator -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
    <div class="pg-header">
        <div class="pg-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
        </div>
        <div>
            <div class="pg-title">Cupones &amp; Promociones Comerciales</div>
            <div class="pg-sub">Crea y administra campañas de fidelización y descuentos automáticos en el checkout</div>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Create" class="btn-gold" style="padding:0.48rem 1rem;font-size:0.82rem;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            <span>Nuevo Cupón Promocional</span>
        </a>
    </div>
</div>
<hr class="div-gold" />

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success d-flex align-items-center gap-2 mb-4">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <span>@TempData["Mensaje"]</span>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger d-flex align-items-center gap-2 mb-4">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span>@TempData["Error"]</span>
    </div>
}

<!-- ══ TARJETAS DE KPIS DE MARKETING ═══════════════════════════════ -->
<div class="cupon-kpi-grid">
    <div class="cupon-kpi-card" style="border-left: 4px solid var(--gold);">
        <div class="cupon-kpi-icon" style="background: rgba(200,151,58,0.15); color: var(--gold);">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
        </div>
        <div>
            <span class="cupon-kpi-label">Total Cupones Creados</span>
            <div class="cupon-kpi-val">@total</div>
            <span class="cupon-kpi-sub">Campañas registradas</span>
        </div>
    </div>

    <div class="cupon-kpi-card" style="border-left: 4px solid #10B981;">
        <div class="cupon-kpi-icon" style="background: rgba(16,185,129,0.15); color: #10B981;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        <div>
            <span class="cupon-kpi-label">Cupones Activos</span>
            <div class="cupon-kpi-val" style="color: #10B981;">@activos</div>
            <span class="cupon-kpi-sub">Habilitados para canje hoy</span>
        </div>
    </div>

    <div class="cupon-kpi-card" style="border-left: 4px solid #3B82F6;">
        <div class="cupon-kpi-icon" style="background: rgba(59,130,246,0.15); color: #3B82F6;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <div>
            <span class="cupon-kpi-label">Total Canjes Clientes</span>
            <div class="cupon-kpi-val" style="color: var(--gold);">@canjes veces</div>
            <span class="cupon-kpi-sub">Redenciones acumuladas</span>
        </div>
    </div>
</div>

<!-- ══ TABLA DE CUPONES ════════════════════════════════════════════ -->
<div class="tbl-wrap">
    <table class="tbl-pro">
        <thead>
            <tr>
                <th>Código &amp; Promoción</th>
                <th>Beneficio / Descuento</th>
                <th>Compra Mínima</th>
                <th style="text-align:center;">Canjes / Límite</th>
                <th>Vencimiento</th>
                <th style="text-align:center;">Estado</th>
                <th style="text-align:right;width:210px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model == null || Model.Count == 0)
            {
                <tr>
                    <td colspan="7" style="padding:3rem 1rem;text-align:center;color:var(--muted);">
                        No hay cupones registrados actualmente. ¡Crea el primero para incentivar ventas!
                    </td>
                </tr>
            }
            else
            {
                @foreach (var c in Model)
                {
                    bool vencido = c.FechaVencimiento.HasValue && DateTime.Today > c.FechaVencimiento.Value.Date;
                    bool agotado = c.UsosMaximos > 0 && c.UsosActuales >= c.UsosMaximos;

                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="cupon-code-ticket">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
                                    @c.Codigo
                                </span>
                            </div>
                            <div style="font-size:0.81rem;color:var(--muted);">@c.Descripcion</div>
                        </td>
                        <td>
                            @if (c.TipoDescuento == "Porcentaje")
                            {
                                <span style="font-weight:800;color:#10B981;font-size:1rem;">@c.Valor% OFF</span>
                                @if (c.TopeMaximoDescuento.HasValue && c.TopeMaximoDescuento.Value > 0)
                                {
                                    <div style="font-size:0.74rem;color:var(--muted);">Tope máx: $@c.TopeMaximoDescuento.Value.ToString("N0", ControlClientesRestaurante.Models.Formato.Co) COP</div>
                                }
                            }
                            else
                            {
                                <span style="font-weight:800;color:#10B981;font-size:1rem;">-$@c.Valor.ToString("N0", ControlClientesRestaurante.Models.Formato.Co) COP</span>
                                <div style="font-size:0.74rem;color:var(--muted);">Monto Fijo</div>
                            }
                        </td>
                        <td style="font-variant-numeric:tabular-nums;">
                            @if (c.MontoMinimo > 0)
                            {
                                <strong style="color:var(--ink);">$@c.MontoMinimo.ToString("N0", ControlClientesRestaurante.Models.Formato.Co) COP</strong>
                            }
                            else
                            {
                                <span style="color:var(--muted);font-style:italic;">Sin mínimo</span>
                            }
                        </td>
                        <td style="text-align:center;min-width:130px;">
                            <div style="font-weight:700;color:var(--ink);font-variant-numeric:tabular-nums;font-size:0.85rem;">
                                @c.UsosActuales / @c.UsosMaximos
                            </div>
                            <div class="cupon-progress-track">
                                @{
                                    double pct = c.UsosMaximos > 0 ? Math.Min(100, ((double)c.UsosActuales / c.UsosMaximos) * 100) : 0;
                                }
                                <div style="background:@(pct >= 100 ? "#EF4444" : "#10B981");height:100%;width:@pct%;border-radius:999px;"></div>
                            </div>
                        </td>
                        <td style="font-variant-numeric:tabular-nums;">
                            @if (c.FechaVencimiento.HasValue)
                            {
                                <span style="color:@(vencido ? "#EF4444" : "var(--ink)");font-weight:@(vencido ? "700" : "600");">
                                    @c.FechaVencimiento.Value.ToString("dd/MM/yyyy")
                                </span>
                                @if (vencido)
                                {
                                    <div style="font-size:0.7rem;color:#EF4444;font-weight:700;">(Expirado)</div>
                                }
                            }
                            else
                            {
                                <span style="color:#10B981;font-size:0.82rem;font-weight:700;">Permanente</span>
                            }
                        </td>
                        <td style="text-align:center;">
                            @if (!c.Activo)
                            {
                                <span class="badge-est badge-cancelado" style="opacity:0.8;">Inactivo</span>
                            }
                            else if (vencido)
                            {
                                <span class="badge-est badge-cancelado">Vencido</span>
                            }
                            else if (agotado)
                            {
                                <span class="badge-est badge-pendiente">Agotado</span>
                            }
                            else
                            {
                                <span class="badge-est badge-completado">Activo</span>
                            }
                        </td>
                        <td style="text-align:right;">
                            <div class="d-inline-flex gap-1 align-items-center justify-content-end">
                                <form asp-action="ToggleEstado" asp-route-id="@c.Id" method="post" style="display:inline;margin:0;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-ghost" title="@(c.Activo ? "Pausar cupón" : "Activar cupón")" style="padding:0.28rem 0.62rem;font-size:0.75rem;">
                                        @(c.Activo ? "Pausar" : "Activar")
                                    </button>
                                </form>

                                <a asp-action="Edit" asp-route-id="@c.Id" class="btn-ghost" style="padding:0.28rem 0.62rem;font-size:0.75rem;">
                                    Editar
                                </a>

                                <form asp-action="Eliminar" asp-route-id="@c.Id" method="post" style="display:inline;margin:0;" onsubmit="return confirm('¿Seguro que deseas eliminar el cupón @c.Codigo?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-danger-pro" title="Eliminar cupón" style="padding:0.28rem 0.52rem;">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<style>
    .cupon-kpi-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1.75rem;
        margin-bottom: 2.25rem;
    }
    .cupon-kpi-card {
        background: var(--surface);
        border: 1.5px solid var(--line, #E3D8C8);
        border-radius: 16px;
        padding: 1.35rem 1.5rem;
        display: flex;
        align-items: center;
        gap: 1.15rem;
        height: 100%;
        box-shadow: var(--shadow);
        transition: transform 0.18s ease, box-shadow 0.18s ease;
    }
    .cupon-kpi-card:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-md);
    }
    .cupon-kpi-icon {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .cupon-kpi-label {
        font-size: 0.72rem;
        font-weight: 700;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        display: block;
    }
    .cupon-kpi-val {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--ink);
        line-height: 1.2;
    }
    .cupon-kpi-sub {
        font-size: 0.74rem;
        color: var(--muted);
    }
    .cupon-code-ticket {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: 'Geist Mono', monospace;
        font-size: 0.9rem;
        font-weight: 800;
        background: rgba(200, 151, 58, 0.14);
        color: var(--gold);
        padding: 0.25rem 0.65rem;
        border-radius: 7px;
        border: 1px dashed rgba(200, 151, 58, 0.55);
        letter-spacing: 0.06em;
    }
    .cupon-progress-track {
        width: 100%;
        background: var(--surface-2);
        border: 1px solid var(--border);
        border-radius: 999px;
        height: 6px;
        margin-top: 5px;
        overflow: hidden;
    }
</style>
