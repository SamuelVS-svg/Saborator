@model List<ControlClientesRestaurante.Models.Reserva>
@{
    ViewData["Title"] = "Gestión de Reservas";
    Layout = "_Layout";
    var avisos = (List<string>)(ViewBag.Avisos ?? new List<string>());
    string filtroSel = ViewBag.FiltroSeleccionado as string ?? "hoy";
    string fechaSel  = ViewBag.FechaSeleccionada as string ?? "";
    string estadoSel = ViewBag.EstadoSeleccionado as string ?? "";
    string buscar    = ViewBag.Buscar as string ?? "";

    int totalHoy         = ViewBag.TotalHoy ?? 0;
    int totalManana      = ViewBag.TotalManana ?? 0;
    int totalConfirmadas = ViewBag.TotalConfirmadas ?? 0;
    int totalGeneral     = ViewBag.TotalGeneral ?? 0;
}

<!-- Encabezado Principal Saborator -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
    <div class="pg-header">
        <div class="pg-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/></svg>
        </div>
        <div>
            <div class="pg-title">Reservas &amp; Gestión de Salón</div>
            <div class="pg-sub">Control de asistencia, recordatorios directos por WhatsApp y asignación de mesas</div>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="ExportarCsv" asp-route-filtro="@filtroSel" asp-route-fecha="@fechaSel" asp-route-estado="@estadoSel" asp-route-buscar="@buscar" 
           class="btn-ghost" style="padding:0.48rem 0.9rem;font-size:0.82rem;gap:0.4rem;display:inline-flex;align-items:center;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            <span>Exportar Reservas (Excel)</span>
        </a>
        <a asp-controller="Reserva" asp-action="Nueva" target="_blank" class="btn-gold" style="padding:0.48rem 1rem;font-size:0.82rem;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            <span>Tomar Reserva Manual</span>
        </a>
    </div>
</div>
<hr class="div-gold" />

<!-- ══ TARJETAS DE KPIS DE RESERVAS ═══════════════════════════════════ -->
<div class="reserva-kpi-grid">
    <a asp-action="Admin" asp-route-filtro="hoy" style="text-decoration:none;display:block;height:100%;">
        <div class="reserva-kpi-card @(filtroSel == "hoy" && string.IsNullOrEmpty(fechaSel) ? "active" : "")" style="border-left: 4px solid var(--gold);">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="reserva-kpi-label">Para Hoy</span>
                <div class="reserva-kpi-icon" style="background: rgba(200,151,58,0.15); color: var(--gold);">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                </div>
            </div>
            <div class="reserva-kpi-val">@totalHoy reservas</div>
            <div class="reserva-kpi-sub">Turnos de almuerzo y cena</div>
        </div>
    </a>

    <a asp-action="Admin" asp-route-filtro="manana" style="text-decoration:none;display:block;height:100%;">
        <div class="reserva-kpi-card @(filtroSel == "manana" ? "active" : "")" style="border-left: 4px solid #3B82F6;">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="reserva-kpi-label">Para Mañana</span>
                <div class="reserva-kpi-icon" style="background: rgba(59,130,246,0.15); color: #3B82F6;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                </div>
            </div>
            <div class="reserva-kpi-val" style="color: #3B82F6;">@totalManana reservas</div>
            <div class="reserva-kpi-sub">Planificación anticipada</div>
        </div>
    </a>

    <a asp-action="Admin" asp-route-filtro="semana" style="text-decoration:none;display:block;height:100%;">
        <div class="reserva-kpi-card @(filtroSel == "semana" ? "active" : "")" style="border-left: 4px solid #10B981;">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="reserva-kpi-label">Próximos 7 Días</span>
                <div class="reserva-kpi-icon" style="background: rgba(16,185,129,0.15); color: #10B981;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                </div>
            </div>
            <div class="reserva-kpi-val" style="color: #10B981;">@totalConfirmadas confirmadas</div>
            <div class="reserva-kpi-sub">Comensales activos</div>
        </div>
    </a>

    <a asp-action="Admin" asp-route-filtro="" style="text-decoration:none;display:block;height:100%;">
        <div class="reserva-kpi-card @(string.IsNullOrEmpty(filtroSel) && string.IsNullOrEmpty(fechaSel) ? "active" : "")" style="border-left: 4px solid #D97706;">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="reserva-kpi-label">Total Registradas</span>
                <div class="reserva-kpi-icon" style="background: rgba(217,119,6,0.15); color: #D97706;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </div>
            </div>
            <div class="reserva-kpi-val" style="color: var(--gold);">@totalGeneral en sistema</div>
            <div class="reserva-kpi-sub">Historial completo</div>
        </div>
    </a>
</div>

@if (avisos.Any())
{
    <div style="background:rgba(200,151,58,0.12);border:1px solid rgba(200,151,58,0.35);border-radius:14px;padding:1.1rem 1.35rem;margin-bottom:2rem;">
        <div style="font-size:0.78rem;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:var(--gold);margin-bottom:0.35rem;display:flex;align-items:center;gap:0.4rem;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
            <span>Avisos de Reservas Recientes</span>
        </div>
        <div style="display:flex;flex-direction:column;gap:0.25rem;font-size:0.84rem;color:var(--text);">
            @foreach (var a in avisos)
            {
                <div>@a</div>
            }
        </div>
    </div>
}

<!-- ══ FILTROS Y BUSCADOR ═══════════════════════════════════════════════ -->
<div class="card-pro" style="padding: 1.5rem 1.75rem; margin-bottom: 2.25rem; background: var(--surface);">
    <form method="get" asp-action="Admin" class="reserva-filter-grid">
        <input type="hidden" name="filtro" value="@(string.IsNullOrEmpty(fechaSel) ? filtroSel : "")" />
        <div>
            <label class="form-label mb-1">Buscar por Código, Comensal o Teléfono</label>
            <input type="text" name="buscar" value="@buscar" class="form-control form-control-sm" placeholder="Ej: RES-2026..., Valentina, 300..." />
        </div>
        <div>
            <label class="form-label mb-1">Fecha Específica</label>
            <input type="date" name="fecha" value="@fechaSel" class="form-control form-control-sm" />
        </div>
        <div>
            <label class="form-label mb-1">Estado</label>
            <select name="estado" class="form-select form-select-sm">
                <option value="">Todos</option>
                <option value="Confirmada" selected="@(estadoSel == "Confirmada")">Confirmada</option>
                <option value="Completada" selected="@(estadoSel == "Completada")">Completada</option>
                <option value="Cancelada" selected="@(estadoSel == "Cancelada")">Cancelada</option>
                <option value="No Asistio" selected="@(estadoSel == "No Asistio")">No Asistió</option>
            </select>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn-brand flex-fill" style="padding:0.48rem 0.95rem;font-size:0.84rem;border-radius:9px;justify-content:center;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <span>Filtrar</span>
            </button>
            <a asp-action="Admin" asp-route-filtro="hoy" class="btn-ghost" style="padding:0.48rem 0.95rem;font-size:0.84rem;border-radius:9px;">
                Hoy
            </a>
        </div>
    </form>
</div>

<!-- ══ LISTADO GENERAL DE RESERVAS ═════════════════════════════════════ -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h2 style="font-family:'Playfair Display',Georgia,serif;font-size:1.2rem;font-weight:700;color:var(--ink);margin:0;">
            Listado de Reservas (@Model.Count)
        </h2>
        <span style="font-size:0.8rem;color:var(--muted);">Salón Principal y Terraza VIP (Mesas 1 a 30)</span>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card-pro text-center py-5" style="color:var(--muted);">
        <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" style="margin-bottom:0.75rem;opacity:0.45;"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        <p class="mb-1 fw-bold" style="color:var(--ink);">No hay reservas registradas para el criterio seleccionado.</p>
        <p class="small mb-0">Puedes cambiar el filtro rápido superior o tomar una nueva reserva manual.</p>
    </div>
}
else
{
    <div class="tbl-wrap">
        <table class="tbl-pro">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Comensal</th>
                    <th>Mesa Asignada</th>
                    <th>Fecha &amp; Hora</th>
                    <th>Personas</th>
                    <th>Petición / Notas</th>
                    <th>Estado</th>
                    <th style="width:240px;text-align:right;">Contacto &amp; Acción</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    string telDigitos = new string(r.Telefono.Where(char.IsDigit).ToArray());
                    if (telDigitos.Length == 10 && telDigitos.StartsWith("3")) telDigitos = "57" + telDigitos;
                    string msgWp = Uri.EscapeDataString($"¡Hola {r.NombreCliente}! Te saludamos de *Saborator Restaurante*. Te recordamos tu reserva de mesa:\n\n🍽️ *Mesa:* #{r.NumeroMesa}\n⏰ *Hora:* {r.Hora}\n👥 *Personas:* {r.NumeroPersonas}\n📍 Cra 4 Sur # 43-12, Barranquilla.\n\n¿Nos confirmas tu asistencia? ¡Te esperamos!");

                    <tr>
                        <td>
                            <span class="reserva-code-pill">@r.Codigo</span>
                        </td>
                        <td>
                            <div style="font-weight:700;color:var(--ink);">@r.NombreCliente</div>
                            <div style="font-size:0.76rem;color:var(--muted);">@r.Telefono</div>
                        </td>
                        <td>
                            <span class="reserva-mesa-badge">
                                Mesa #@r.NumeroMesa
                            </span>
                        </td>
                        <td style="font-variant-numeric:tabular-nums;font-size:0.85rem;">
                            <strong style="color:var(--ink);">@r.Fecha.ToString("dd/MM/yyyy")</strong><br />
                            <span style="color:var(--muted);font-size:0.78rem;">@r.Hora</span>
                        </td>
                        <td style="font-variant-numeric:tabular-nums;font-weight:600;color:var(--text);">
                            @r.NumeroPersonas pers.
                        </td>
                        <td style="max-width:200px;font-size:0.82rem;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;" title="@r.Notas">
                            @(string.IsNullOrEmpty(r.Notas) ? "—" : r.Notas)
                        </td>
                        <td>
                            @if (r.Estado == "Confirmada")
                            { <span class="badge-est badge-completado">Confirmada</span> }
                            else if (r.Estado == "Completada")
                            { <span class="badge-est badge-preparacion">Completada</span> }
                            else if (r.Estado == "No Asistio")
                            { <span class="badge-est badge-pendiente">No Asistió</span> }
                            else
                            { <span class="badge-est badge-cancelado">Cancelada</span> }
                        </td>
                        <td style="text-align:right;">
                            <div class="d-flex justify-content-end align-items-center gap-1">
                                <a href="https://api.whatsapp.com/send?phone=@telDigitos&text=@msgWp" target="_blank"
                                   class="btn-ghost" title="Enviar recordatorio por WhatsApp al comensal" 
                                   style="padding:0.28rem 0.58rem;font-size:0.75rem;background:rgba(16,185,129,0.12);color:#10B981;border:1px solid rgba(16,185,129,0.35);border-radius:7px;display:inline-flex;align-items:center;gap:0.28rem;font-weight:700;">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
                                    <span>WhatsApp</span>
                                </a>

                                @if (r.Estado == "Confirmada")
                                {
                                    <form asp-action="CambiarEstado" method="post" style="margin:0;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@r.Id" />
                                        <input type="hidden" name="nuevoEstado" value="Completada" />
                                        <button type="submit" class="btn-ghost" title="Marcar comensal sentado en la mesa" style="padding:0.28rem 0.58rem;font-size:0.75rem;color:#10B981;border-color:rgba(16,185,129,0.35);font-weight:700;">
                                            <svg class="ico" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-.15em;margin-right:.35em;flex:none"><polyline points="20 6 9 17 4 12"/></svg>Llegó
                                        </button>
                                    </form>

                                    <form asp-action="Cancelar" method="post" style="margin:0;" onsubmit="return confirm('¿Cancelar esta reserva?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@r.Id" />
                                        <button type="submit" class="btn-ghost" title="Cancelar reserva" style="padding:0.28rem 0.55rem;font-size:0.75rem;color:#EF4444;border-color:rgba(239,68,68,0.3);">
                                            <svg class="ico" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-.15em;margin-right:.35em;flex:none"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<style>
    .reserva-kpi-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(235px, 1fr));
        gap: 1.65rem;
        margin-bottom: 2.25rem;
    }
    .reserva-filter-grid {
        display: grid;
        grid-template-columns: 1.8fr 1fr 1fr auto;
        gap: 1.25rem;
        align-items: end;
    }
    @@media (max-width: 992px) {
        .reserva-filter-grid {
            grid-template-columns: 1fr 1fr;
        }
    }
    @@media (max-width: 576px) {
        .reserva-filter-grid {
            grid-template-columns: 1fr;
        }
    }
    .reserva-kpi-card {
        background: var(--surface);
        border: 1.5px solid var(--line, #E3D8C8);
        border-radius: 16px;
        padding: 1.35rem 1.5rem;
        height: 100%;
        box-shadow: var(--shadow);
        transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
    }
    .reserva-kpi-card:hover, .reserva-kpi-card.active {
        transform: translateY(-3px);
        box-shadow: var(--shadow-md);
        border-color: rgba(200, 151, 58, 0.55);
    }
    .reserva-kpi-label {
        font-size: 0.73rem;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        font-weight: 700;
    }
    .reserva-kpi-icon {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .reserva-kpi-val {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 1.45rem;
        font-weight: 800;
        color: var(--ink);
        line-height: 1.2;
        margin-bottom: 0.2rem;
    }
    .reserva-kpi-sub {
        font-size: 0.74rem;
        color: var(--muted);
    }
    .reserva-code-pill {
        font-family: 'Geist Mono', monospace;
        font-weight: 700;
        font-size: 0.82rem;
        color: var(--gold);
        background: rgba(200, 151, 58, 0.12);
        border: 1px solid rgba(200, 151, 58, 0.3);
        padding: 0.22rem 0.55rem;
        border-radius: 6px;
        display: inline-block;
    }
    .reserva-mesa-badge {
        background: var(--surface-2);
        color: var(--ink);
        border: 1px solid rgba(200, 151, 58, 0.35);
        font-weight: 700;
        font-size: 0.78rem;
        padding: 0.25rem 0.65rem;
        border-radius: 7px;
        display: inline-block;
    }
</style>
