@model ControlClientesRestaurante.Models.Reserva
@{
    ViewData["Title"] = $"Boleto de Reserva {Model.Codigo}";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/reserva.css" asp-append-version="true" />

<div class="reserva-page">

    <!-- Navbar Comensal -->
    <header class="cinema-nav">
        <a href="/" class="cinema-brand">
            <div class="cinema-brand-icon">
                <partial name="_LogoBurger" />
            </div>
            <span class="cinema-brand-name">Saborator</span>
        </a>
        <nav class="cinema-links">
            <a href="/" class="cinema-link">Menú Gastronómico</a>
            <a asp-controller="Reserva" asp-action="Nueva" class="cinema-link">Reservar Mesa</a>
            <a asp-controller="Reserva" asp-action="MisReservas" class="cinema-link">Mis Reservas</a>
            <a asp-controller="Home" asp-action="Sistema" class="cinema-link">Sistema (Info)</a>
        </nav>
    </header>

    <div class="confirm-wrap">

        <div class="confirm-seal">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        </div>

        <div class="reserva-ticket-card" style="box-shadow: 0 24px 64px rgba(0,0,0,0.5);">

            <div class="ticket-header">
                <div class="ticket-brand">Saborator</div>
                <div class="ticket-tag">Boleto de Reserva Confirmada</div>
                <div class="ticket-code" style="font-size:1.35rem;padding:0.4rem 1rem;background:rgba(200,151,58,0.15);border:1px solid rgba(200,151,58,0.4);color:#6B1E2E;">
                    @Model.Codigo
                </div>
            </div>

            <div class="ticket-details">
                <div class="t-row">
                    <span class="t-label">Comensal</span>
                    <span class="t-val">@Model.NombreCliente</span>
                </div>
                <div class="t-row">
                    <span class="t-label">Mesa Asignada</span>
                    <span class="t-val highlight">Mesa #@Model.NumeroMesa</span>
                </div>
                <div class="t-row">
                    <span class="t-label">Fecha del Servicio</span>
                    <span class="t-val">@Model.Fecha.ToString("dddd, dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-ES"))</span>
                </div>
                <div class="t-row">
                    <span class="t-label">Turno / Hora</span>
                    <span class="t-val">@Model.Hora</span>
                </div>
                <div class="t-row">
                    <span class="t-label">Comensales</span>
                    <span class="t-val">@Model.NumeroPersonas Personas</span>
                </div>
                <div class="t-row">
                    <span class="t-label">Teléfono</span>
                    <span class="t-val">@Model.Telefono</span>
                </div>
                @if (!string.IsNullOrEmpty(Model.Notas))
                {
                    <div class="t-row" style="flex-direction:column;align-items:flex-start;gap:0.25rem;">
                        <span class="t-label">Petición Especial</span>
                        <span class="t-val" style="font-size:0.85rem;color:#4A3A3E;">@Model.Notas</span>
                    </div>
                }
                <div class="t-row">
                    <span class="t-label">Estado</span>
                    <span class="estado-pill completada">@Model.Estado</span>
                </div>
            </div>

@{
    // Formatear teléfono para enlace directo de WhatsApp Colombia
    string telDigitos = new string(Model.Telefono.Where(char.IsDigit).ToArray());
    if (telDigitos.Length == 10 && telDigitos.StartsWith("3")) telDigitos = "57" + telDigitos;
    string msgWhatsApp = Uri.EscapeDataString($"¡Hola {Model.NombreCliente}! 👋 Tu reserva en *Saborator Restaurante* está confirmada:\n\n🎟️ *Código:* {Model.Codigo}\n🍽️ *Mesa asignada:* #{Model.NumeroMesa}\n📅 *Fecha:* {Model.Fecha:dd/MM/yyyy} a las {Model.Hora}\n👥 *Comensales:* {Model.NumeroPersonas} personas\n📍 *Ubicación:* Cra 4 Sur # 43-12, Barranquilla.\n\n¡Te esperamos para una experiencia gastronómica inolvidable!");
}

            <div style="display:flex;flex-direction:column;gap:0.75rem;margin-top:1.5rem;">
                <!-- Enlace de WhatsApp -->
                <a href="https://api.whatsapp.com/send?phone=@telDigitos&text=@msgWhatsApp" target="_blank"
                   style="width:100%;text-align:center;text-decoration:none;padding:0.75rem;font-size:0.9rem;font-weight:700;display:flex;align-items:center;justify-content:center;gap:0.5rem;background:#25D366;color:#FFF;border-radius:12px;box-shadow:0 4px 15px rgba(37,211,102,0.3);">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
                    <span>Enviar Pase por WhatsApp</span>
                </a>

                @if (!Model.Estado.Contains("Pagada"))
                {
                    <a asp-controller="Pago" asp-action="Checkout" asp-route-tipo="Reserva" asp-route-id="@Model.Id" 
                       class="btn-gold" style="width:100%;text-align:center;text-decoration:none;padding:0.8rem;font-size:0.92rem;font-weight:700;display:flex;align-items:center;justify-content:center;gap:0.5rem;box-shadow:0 6px 20px rgba(200,151,58,0.35);">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                        Pagar Depósito de Garantía Online ($@((Model.NumeroPersonas * 25000m).ToString("N0", ControlClientesRestaurante.Models.Formato.Co)))
                    </a>
                }

                <button type="button" id="btnPdfBoleto" onclick="descargarBoletoPdf()" class="btn-ghost" style="width:100%;text-align:center;padding:0.65rem;display:flex;align-items:center;justify-content:center;gap:0.4rem;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    <span id="btnPdfBoletoTexto">Descargar Boleto en PDF</span>
                </button>

                <div style="display:flex;gap:0.75rem;">
                    <a asp-controller="Reserva" asp-action="MisReservas" class="btn-gold" style="flex:1;text-align:center;text-decoration:none;padding:0.7rem;font-size:0.88rem;">
                        Ver Mis Reservas
                    </a>
                    <a href="/" class="btn-primary" style="flex:1;text-align:center;text-decoration:none;padding:0.7rem;font-size:0.88rem;">
                        Volver a la Carta
                    </a>
                </div>
            </div>

        </div>

    </div>

</div>

<script src="~/lib/html2pdf/html2pdf.bundle.min.js"></script>
<script>
    function descargarBoletoPdf() {
        const btn = document.getElementById('btnPdfBoleto');
        const txt = document.getElementById('btnPdfBoletoTexto');
        const card = document.querySelector('.reserva-ticket-card');

        if (!card || typeof html2pdf === 'undefined') {
            window.print();
            return;
        }

        btn.disabled = true;
        txt.textContent = "Generando PDF...";

        const opt = {
            margin:       [10, 10, 10, 10],
            filename:     'Boleto_Reserva_@(Model.Codigo).pdf',
            image:        { type: 'jpeg', quality: 0.98 },
            html2canvas:  { scale: 2, useCORS: true },
            jsPDF:        { unit: 'mm', format: 'a5', orientation: 'portrait' }
        };

        html2pdf().set(opt).from(card).save()
            .then(() => {
                txt.textContent = "Descargar Boleto en PDF";
                btn.disabled = false;
            })
            .catch(() => {
                txt.textContent = "Descargar Boleto en PDF";
                btn.disabled = false;
                window.print();
            });
    }
</script>
