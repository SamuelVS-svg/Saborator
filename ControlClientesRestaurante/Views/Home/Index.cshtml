    <!-- ══ CARTA / MENÚ GASTRONÓMICO COMPLETO ════════════════════ -->
    <section class="section-pad carta-section-wrap" id="menu">
        <div class="section-inner">
            <div class="section-center" style="margin-bottom:2.5rem;">
                <div class="hero-tag" style="margin-bottom:0.75rem;">
                    Nuestra Selección
                </div>
                <h2 class="section-title">Nuestra Carta Gastronómica</h2>
                <p class="section-sub">Elaborada artesanalmente con productos frescos de temporada</p>
            </div>

            <!-- Filtros por Categoría y Preferencias Dietarias -->
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
                <div class="d-flex flex-wrap gap-2" id="cartaCategoryFilter">
                    <button type="button" class="btn-ghost active" onclick="filtrarCartaCategoria('todas', this)" style="padding:0.4rem 0.85rem;font-size:0.82rem;border-radius:999px;font-weight:700;background:#7A1C28;color:#FFFDF9;">Todas</button>
                    <button type="button" class="btn-ghost" onclick="filtrarCartaCategoria('Hamburguesas & Carnes', this)" style="padding:0.4rem 0.85rem;font-size:0.82rem;border-radius:999px;font-weight:700;">Hamburguesas &amp; Carnes</button>
                    <button type="button" class="btn-ghost" onclick="filtrarCartaCategoria('Salchipapas Gourmet', this)" style="padding:0.4rem 0.85rem;font-size:0.82rem;border-radius:999px;font-weight:700;">Salchipapas Gourmet</button>
                    <button type="button" class="btn-ghost" onclick="filtrarCartaCategoria('Perros & Especiales', this)" style="padding:0.4rem 0.85rem;font-size:0.82rem;border-radius:999px;font-weight:700;">Perros &amp; Especiales</button>
                    <button type="button" class="btn-ghost" onclick="filtrarCartaCategoria('Acompañamientos', this)" style="padding:0.4rem 0.85rem;font-size:0.82rem;border-radius:999px;font-weight:700;">Acompañamientos</button>
                    <button type="button" class="btn-ghost" onclick="filtrarCartaCategoria('Bebidas', this)" style="padding:0.4rem 0.85rem;font-size:0.82rem;border-radius:999px;font-weight:700;">Bebidas</button>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <button type="button" id="btnToggleVeg" onclick="toggleFiltroDieta('veg')" class="btn-ghost" style="padding:0.35rem 0.75rem;font-size:0.78rem;border-radius:999px;font-weight:700;">
                        🌱 Solo Veg
                    </button>
                    <button type="button" id="btnToggleGluten" onclick="toggleFiltroDieta('gluten')" class="btn-ghost" style="padding:0.35rem 0.75rem;font-size:0.78rem;border-radius:999px;font-weight:700;">
                        🌾 Sin TACC
                    </button>
                </div>
            </div>

            <!-- Grid de Platos de la Carta Minimalista -->
            <div class="menu-minimal-grid">
                @foreach (var p in productos)
                {
                    bool esBurger = p.Nombre.ToLower().Contains("hamburguesa");
                    bool esHotDog = p.Nombre.ToLower().Contains("perro");
                    bool esSalchi = p.Nombre.ToLower().Contains("salchipapa");
                    bool esPapas  = p.Nombre.ToLower().Contains("papas");
                    bool esCoca   = p.Nombre.ToLower().Contains("coca");
                    bool esPepsi  = p.Nombre.ToLower().Contains("pepsi");
                    bool esAgua   = p.Nombre.ToLower().Contains("agua");
                    bool esBebida = esCoca || esPepsi || esAgua;

                    string tagBadge = esBurger ? "Firma" : (esHotDog ? "Especial" : (esBebida ? "Bebida" : (esSalchi ? "Gourmet" : (esPapas ? "Crujientes" : "Acompañamiento"))));
                    string tiempo = p.TiempoCoccionMinutos > 0 ? $"{p.TiempoCoccionMinutos} min" : (esBebida ? "Al instante" : (esBurger ? "15 min" : (esHotDog ? "12 min" : "10 min")));

                    string? bgImg = esSalchi ? "/img/salchipapa.jpg"
                        : (esBurger ? "/img/hamburguesa.jpg"
                        : (esHotDog ? "/img/perrocaliente.jpg"
                        : (esPapas ? "/img/papasfrancesa.jpg"
                        : (esCoca ? "/img/cocacola.png?v=3"
                        : (esPepsi ? "/img/pepsi.webp?v=2"
                        : (esAgua ? "/img/agua.webp?v=2" : null))))));
                    string imgSegura = bgImg ?? "/img/hamburguesa.jpg";

                    <article class="dish-card-minimal" tabindex="0" aria-label="@p.Nombre"
                             data-categoria="@p.Categoria" data-veg="@p.EsVegetariano.ToString().ToLower()" data-gluten="@p.EsLibreGluten.ToString().ToLower()">
                        <div class="dish-minimal-media">
                            <span class="dish-minimal-badge">@tagBadge</span>
                            <img src="@imgSegura" alt="@p.Nombre" class="dish-minimal-img" loading="lazy" />
                            <span class="dish-minimal-time">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                @tiempo
                            </span>
                        </div>

                        <div class="dish-minimal-body">
                            <div class="dish-minimal-header">
                                <h3 class="dish-minimal-name">@p.Nombre</h3>
                                <span class="dish-minimal-price">$@p.Precio.ToString("N0")</span>
                            </div>

                            <p class="dish-minimal-desc">
                                @(string.IsNullOrEmpty(p.Descripcion) ? "Receta tradicional con ingredientes seleccionados y cocción artesanal." : p.Descripcion)
                            </p>

                            <!-- Etiquetas Dietarias y Alérgenos -->
                            <div class="d-flex flex-wrap gap-1 align-items-center mb-2" style="font-size:0.72rem;">
                                @if (p.EsVegetariano)
                                {
                                    <span style="background:#ECFDF5;color:#065F46;border:1px solid #A7F3D0;border-radius:4px;padding:1px 5px;font-weight:700;">🌱 Vegetariano</span>
                                }
                                @if (p.EsLibreGluten)
                                {
                                    <span style="background:#EFF6FF;color:#1E40AF;border:1px solid #BFDBFE;border-radius:4px;padding:1px 5px;font-weight:700;">🌾 Sin Gluten</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(p.Alergenos))
                                {
                                    <span style="color:#B45309;font-weight:600;" title="Contiene: @p.Alergenos">⚠️ @p.Alergenos</span>
                                }
                            </div>

                            <div class="dish-minimal-footer">
                                <button type="button" class="btn-dish-add" onclick="cartAgregar(@p.Id, '@p.Nombre.Replace("'", "\\'")', @Convert.ToInt64(p.Precio), '@imgSegura', this)">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                                    <span>Agregar</span>
                                </button>
                                <a asp-controller="Reserva" asp-action="Nueva" class="btn-dish-reserve-icon" title="Reservar mesa en salón" aria-label="Reservar mesa">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
                                </a>
                            </div>
                        </div>
                    </article>
                }
            </div>

            <script>
                let categoriaActiva = 'todas';
                let filtroSoloVeg = false;
                let filtroSoloGluten = false;

                function filtrarCartaCategoria(cat, btn) {
                    categoriaActiva = cat;
                    document.querySelectorAll('#cartaCategoryFilter .btn-ghost').forEach(b => {
                        b.classList.remove('active');
                        b.style.background = '';
                        b.style.color = '';
                    });
                    btn.classList.add('active');
                    btn.style.background = '#7A1C28';
                    btn.style.color = '#FFFDF9';
                    aplicarFiltrosCarta();
                }

                function toggleFiltroDieta(tipo) {
                    if (tipo === 'veg') {
                        filtroSoloVeg = !filtroSoloVeg;
                        const btn = document.getElementById('btnToggleVeg');
                        btn.style.background = filtroSoloVeg ? '#059669' : '';
                        btn.style.color = filtroSoloVeg ? '#FFF' : '';
                    } else if (tipo === 'gluten') {
                        filtroSoloGluten = !filtroSoloGluten;
                        const btn = document.getElementById('btnToggleGluten');
                        btn.style.background = filtroSoloGluten ? '#2563EB' : '';
                        btn.style.color = filtroSoloGluten ? '#FFF' : '';
                    }
                    aplicarFiltrosCarta();
                }

                function aplicarFiltrosCarta() {
                    const cards = document.querySelectorAll('.dish-card-minimal');
                    cards.forEach(card => {
                        const cat = card.getAttribute('data-categoria') || '';
                        const esVeg = card.getAttribute('data-veg') === 'true';
                        const esGluten = card.getAttribute('data-gluten') === 'true';

                        let visible = true;
                        if (categoriaActiva !== 'todas' && !cat.toLowerCase().includes(categoriaActiva.toLowerCase())) {
                            visible = false;
                        }
                        if (filtroSoloVeg && !esVeg) {
                            visible = false;
                        }
                        if (filtroSoloGluten && !esGluten) {
                            visible = false;
                        }
                        card.style.display = visible ? 'flex' : 'none';
                    });
                }
            </script>

            <!-- Banner Exclusivo hacia el Plano de Mesas -->
            <div style="margin-top:3.5rem;background:linear-gradient(135deg, #2A0B13 0%, #150508 100%);color:#FFFDF9;border-radius:20px;padding:3rem 2.5rem;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:2rem;box-shadow:0 16px 40px rgba(0,0,0,0.35);border:1px solid rgba(200,151,58,0.3);">
                <div style="max-width:540px;">
                    <div style="color:var(--gold);font-size:0.75rem;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;margin-bottom:0.5rem;">
                        Experiencia Exclusiva en Sala
                    </div>
                    <h3 style="font-family:var(--font-serif);font-size:2.2rem;font-weight:400;margin:0 0 0.75rem;color:#FFFDF9;">
                        Reserva tu Mesa en Tiempo Real
                    </h3>
                    <p style="color:rgba(255,253,249,0.7);font-size:0.95rem;line-height:1.6;margin:0;">
                        Visualiza el plano de las 30 mesas del restaurante. Escoge tu ubicación predilecta entre Salón Principal, Terraza Panorámica o Salón Cava VIP.
                    </p>
                </div>
                <div>
                    <a asp-controller="Reserva" asp-action="Nueva" class="btn-gold" style="padding:0.85rem 1.85rem;font-size:0.95rem;text-decoration:none;display:inline-flex;align-items:center;gap:0.5rem;">
                        <span>Ver Plano &amp; Reservar</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                    </a>
                </div>
            </div>

        </div>
    </section>

    <!-- ══ FILOSOFÍA DE EXPERIENCIA GASTRONÓMICA ═════════════════ -->
    <section class="section-pad" id="experiencia">
        <div class="section-inner">
            <div class="section-center">
                <h2 class="section-title">El Arte de la Hospitalidad</h2>
                <p class="section-sub">Tres pilares que definen cada visita a Saborator</p>
            </div>
            <div class="features-grid">
                <div class="feat-card">
                    <div class="feat-icon">
                        <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    </div>
                    <h3>Cocina de Precisión</h3>
                    <p>Recetas diseñadas con equilibrio de sabores, carnes de primera calidad y aderezos emulsionados en casa.</p>
                </div>
                <div class="feat-card">
