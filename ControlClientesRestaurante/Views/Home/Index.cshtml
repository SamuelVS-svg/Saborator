                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--gold, #C8973A)" stroke-width="2.5" style="display:inline-block !important;flex-shrink:0;"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
