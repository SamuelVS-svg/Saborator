                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                    </a>

                    <div class="hero-minimal-mode-pill" onclick="abrirModalModalidad()" role="button" tabindex="0" title="Cambiar tipo de entrega">
                        <div class="mode-pill-icon" id="heroBarIcon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18.5" cy="17.5" r="3.5"/><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="15" cy="5" r="1"/><path d="M12 17.5V14l-3-3 4-3 2 3h2"/></svg>
                        </div>
                        <div class="mode-pill-texts">
                            <span class="mode-pill-title" id="heroModalityLabel">Domicilio Express</span>
