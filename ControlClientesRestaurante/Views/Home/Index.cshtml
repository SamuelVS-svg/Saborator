                                            }
                                        </div>
                                        <div style="font-size:0.74rem;color:var(--muted);">@r.FechaCreacion.ToString("dd MMM yyyy")</div>
                                    </div>
                                </div>

                                <div style="display:flex;gap:2px;">
                                    @for (int s = 1; s <= 5; s++)
                                    {
                                        <svg width="15" height="15" viewBox="0 0 24 24" style="@(s <= r.Calificacion ? "fill:#F59E0B;stroke:#D97706;" : "fill:rgba(0,0,0,0.1);stroke:rgba(0,0,0,0.2);")"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                                    }
                                </div>
                            </div>

                            <div style="display:flex;flex-wrap:wrap;gap:0.4rem;margin-bottom:0.75rem;">
                                <span style="font-size:0.7rem;background:var(--surface-2);color:var(--muted);padding:2px 7px;border-radius:6px;font-weight:600;display:inline-flex;align-items:center;gap:3px;">
                                    @if (r.TipoExperiencia == "Domicilio Express")
                                    {
                                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18.5" cy="17.5" r="3.5"/><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="15" cy="5" r="1"/><path d="M12 17.5V14l-3-3 4-3 2 3h2"/></svg>
                                    }
                                    else
                                    {
                                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/></svg>
                                    }
                                    <span>@r.TipoExperiencia</span>
                                </span>
                                @if (!string.IsNullOrEmpty(r.PlatoRecomendado))
                                {
                                    <span style="font-size:0.7rem;background:rgba(200,151,58,0.14);color:var(--gold);border:1px solid rgba(200,151,58,0.3);padding:2px 7px;border-radius:6px;font-weight:600;">
                                        Recomendó: <strong>@r.PlatoRecomendado</strong>
                                    </span>
                                }
                            </div>

                            <p style="font-size:0.88rem;color:var(--text);line-height:1.55;margin:0;font-style:italic;">
                                "@r.Comentario"
                            </p>
                        </div>
                    </div>
                }
            </div>

            <!-- Botón Ver Todas las Reseñas -->
            <div style="text-align:center;">
                <a asp-controller="Resena" asp-action="Index" style="display:inline-flex;align-items:center;gap:0.5rem;padding:0.75rem 1.6rem;background:var(--surface);border:1.5px solid var(--gold);color:var(--ink);border-radius:12px;font-weight:800;font-size:0.9rem;text-decoration:none;transition:all 140ms ease;box-shadow:0 4px 14px rgba(0,0,0,0.08);">
                    <span>Ver Todas las Reseñas (@resenaStats.TotalResenas)</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                </a>
            </div>
        </div>
    </section>

    <!-- Modal para Dejar Reseña en Home -->
    <div class="modal-resena-overlay" id="homeModalResenaOverlay" onclick="clickOverlayResenaHome(event)" role="dialog" aria-modal="true" aria-labelledby="homeModalResenaTitle">
        <div class="modal-resena-box">
            <button type="button" class="btn-close-modal" onclick="cerrarModalResenaHome()" aria-label="Cerrar modal">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
            
            <div class="modal-resena-head">
                <span class="modal-badge-gold">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    Experiencia Gastronómica
                </span>
                <h2 class="modal-resena-title" id="homeModalResenaTitle">Tu Opinión en Saborator</h2>
                <p class="modal-resena-sub">Cuéntanos tu experiencia y ayuda a otros comensales a elegir.</p>
            </div>

            <form id="homeFormNuevaResena" onsubmit="enviarResenaHomeAjax(event)">
                @Html.AntiForgeryToken()
                <div id="homeResenaFeedback" class="resena-feedback-box" style="display:none;"></div>

                <div class="star-picker-wrap">
                    <label class="star-picker-label">Tu Calificación General *</label>
                    <div class="star-picker-icons" id="homeStarPickerIcons">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <button type="button" class="btn-pick-star active" data-star="@i" onclick="seleccionarEstrellaHome(@i)" onmouseenter="hoverEstrellaHome(@i)" onmouseleave="resetEstrellasHome()" aria-label="@i estrellas">
                                <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                            </button>
                        }
                    </div>
                    <span class="star-picker-feedback" id="homeStarPickerTxt">Excelente (5 de 5 estrellas)</span>
                    <input type="hidden" id="homeInputRating" value="5" />
                </div>

                <div class="input-resena-row">
                    <div class="input-resena-col">
                        <label class="input-resena-label">Tu Nombre *</label>
                        <div class="input-icon-wrap">
                            <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                            <input type="text" id="homeResenaNombre" required placeholder="Tu nombre" value="@_usuario" class="input-resena-field has-icon" maxlength="150" />
                        </div>
                    </div>
                    <div class="input-resena-col">
                        <label class="input-resena-label">Correo (Opcional)</label>
                        <div class="input-icon-wrap">
                            <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                            <input type="email" id="homeResenaCorreo" placeholder="correo@ejemplo.com" class="input-resena-field has-icon" maxlength="150" />
                        </div>
                    </div>
                </div>

                <div class="input-resena-row">
                    <div class="input-resena-col">
                        <label class="input-resena-label">Tipo de Experiencia *</label>
                        <div class="input-icon-wrap">
                            <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/></svg>
                            <select id="homeResenaTipoExp" class="input-resena-field has-icon">
                                <option value="En Restaurante">En Restaurante / Mesa</option>
                                <option value="Domicilio Express">Domicilio Express</option>
                                <option value="Para Llevar">Para Llevar / Pick-up</option>
                            </select>
                        </div>
                    </div>
                    <div class="input-resena-col">
                        <label class="input-resena-label">Plato Recomendado (Opcional)</label>
                        <div class="input-icon-wrap">
                            <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>
                            <input type="text" id="homeResenaPlato" placeholder="Ej: Desgranado Especial..." list="homeDatalistPlatos" class="input-resena-field has-icon" maxlength="150" />
                            <datalist id="homeDatalistPlatos">
                                @foreach (var p in productos)
                                {
                                    <option value="@p.Nombre" />
                                }
                            </datalist>
                        </div>
                    </div>
                </div>

                <div class="input-resena-group">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.35rem;">
                        <label class="input-resena-label" style="margin:0;">Tu Reseña &amp; Comentario *</label>
                        <span id="homeCharCounter" style="font-size:0.75rem;color:var(--muted);font-weight:600;">0 / 1000</span>
                    </div>
                    <textarea id="homeResenaComentario" required rows="4" maxlength="1000" 
                              placeholder="Describe el sabor, la temperatura de llegada, la presentación o la atención..." 
                              class="input-resena-field input-textarea" oninput="actualizarContadorHome(this)"></textarea>
                </div>

                <div class="modal-resena-actions">
                    <button type="button" onclick="cerrarModalResenaHome()" class="btn-cancelar-modal">Cancelar</button>
                    <button type="submit" id="homeBtnEnviarResena" class="btn-submit-resena">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                        <span>Publicar Opinión</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- ══ FOOTER GOURMET BORGOÑA & CREMA ═════════════════════════════════ -->
    <div style="text-align:center;padding:1.5rem 0 0;background:var(--brand);border-top:1px solid var(--gold);">
        <button type="button" onclick="replayIntro()" class="replay-intro-btn" title="Reproducir intro cinematográfica" style="margin:0 auto;">
            <svg viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            <span>Ver intro de gala</span>
        </button>
    </div>
    <partial name="_FooterGourmet" />

</div>

<!-- ══ MODAL DE AUTH RÁPIDO PARA EL HOME ══════════════════════ -->
<div class="auth-modal-overlay" id="homeAuthModalOverlay" aria-modal="true" role="dialog">
    <div class="auth-modal-box">
        <button type="button" class="auth-modal-close" onclick="cerrarModalAuthHome()" aria-label="Cerrar">&times;</button>
        <div class="auth-modal-header">
            <div class="auth-modal-logo">Saborator</div>
            <div class="auth-modal-title" id="homeAuthTitle">Acceso Comensal</div>
            <p class="auth-modal-desc" id="homeAuthDesc">Inicia sesión o crea tu cuenta para reservar tu mesa.</p>
        </div>
        <div class="auth-tabs">
            <button type="button" class="auth-tab-btn active" id="homeTabLogin" onclick="cambiarHomeAuthTab('login')">Iniciar Sesión</button>
            <button type="button" class="auth-tab-btn" id="homeTabReg" onclick="cambiarHomeAuthTab('registro')">Crear Cuenta</button>
        </div>
        <div id="homeAuthFeedback" class="auth-feedback"></div>

        <div class="auth-tab-pane active" id="homePaneLogin">
            <form onsubmit="ejecutarLoginHome(event)">
                @Html.AntiForgeryToken()
                <div class="ticket-form-group">
                    <label for="hUsuario">Usuario</label>
                    <input type="text" id="hUsuario" class="ticket-input" required placeholder="Tu usuario" />
                </div>
                <div class="ticket-form-group">
                    <label for="hPass">Contraseña</label>
                    <input type="password" id="hPass" class="ticket-input" required placeholder="••••••••" />
                </div>
                <button type="submit" class="btn-confirm-reserva">Ingresar</button>
            </form>
        </div>

        <div class="auth-tab-pane" id="homePaneReg">
            <form onsubmit="ejecutarRegHome(event)">
                @Html.AntiForgeryToken()
                <div class="ticket-form-group">
                    <label for="hrNom">Nombre Completo *</label>
                    <input type="text" id="hrNom" class="ticket-input" required placeholder="Tu nombre" />
                </div>
                <div style="display:flex;gap:8px;">
                    <div class="ticket-form-group" style="flex:1;">
                        <label for="hrTipoDoc">Tipo Doc. *</label>
                        <select id="hrTipoDoc" class="ticket-input" style="padding:0.6rem 0.5rem;">
                            <option value="CC" selected>CC</option>
                            <option value="CE">CE</option>
                            <option value="PA">Pasaporte</option>
                        </select>
                    </div>
                    <div class="ticket-form-group" style="flex:1.5;">
                        <label for="hrDoc">Documento (Mayor de edad) *</label>
                        <input type="text" id="hrDoc" class="ticket-input" required placeholder="1020304050" />
                    </div>
                </div>
                <div class="ticket-form-group">
                    <label for="hrFechaNac">Fecha de Nacimiento (18+ años) *</label>
                    <input type="date" id="hrFechaNac" class="ticket-input" required max="@DateTime.Today.AddYears(-18).ToString("yyyy-MM-dd")" />
                </div>
                <div class="ticket-form-group">
                    <label for="hrCorreo">Correo Electrónico (para validación) *</label>
                    <input type="email" id="hrCorreo" class="ticket-input" required placeholder="tu-correo@ejemplo.com" />
                </div>
                <div class="ticket-form-group">
                    <label for="hrTel">Teléfono *</label>
                    <input type="tel" id="hrTel" class="ticket-input" required placeholder="300 123 4567" />
                </div>
                <div class="ticket-form-group">
                    <label for="hrUsu">Usuario *</label>
                    <input type="text" id="hrUsu" class="ticket-input" required placeholder="usuario_comensal" />
                </div>
                <div class="ticket-form-group">
                    <label for="hrPass">Contraseña *</label>
                    <input type="password" id="hrPass" class="ticket-input" required placeholder="Mínimo 6 caracteres" />
                </div>
                <div class="ticket-form-group">
                    <label for="hrConf">Confirmar Contraseña *</label>
                    <input type="password" id="hrConf" class="ticket-input" required placeholder="Repite contraseña" />
                </div>
                <button type="submit" class="btn-confirm-reserva">Crear Cuenta</button>
            </form>
        </div>
    </div>
</div>

<script src="~/js/intro.js" asp-append-version="true"></script>
<script>
    function abrirModalAuthHome(tab) {
        document.getElementById('homeAuthModalOverlay').classList.add('show');
        cambiarHomeAuthTab(tab || 'login');
    }
    function cerrarModalAuthHome() {
        document.getElementById('homeAuthModalOverlay').classList.remove('show');
        var fb = document.getElementById('homeAuthFeedback');
        fb.className = 'auth-feedback';
        fb.textContent = '';
    }
    function cambiarHomeAuthTab(tab) {
        var isLogin = tab === 'login';
        document.getElementById('homeTabLogin').classList.toggle('active', isLogin);
        document.getElementById('homeTabReg').classList.toggle('active', !isLogin);
        document.getElementById('homePaneLogin').classList.toggle('active', isLogin);
        document.getElementById('homePaneReg').classList.toggle('active', !isLogin);
    }
    function ejecutarLoginHome(e) {
        e.preventDefault();
        var u = document.getElementById('hUsuario').value.trim();
        var p = document.getElementById('hPass').value;
        var fb = document.getElementById('homeAuthFeedback');
        fetch('/Login/LoginAjax', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ usuario: u, contrasena: p, password: p, contraseña: p, returnUrl: '/Reserva/Nueva' })
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
            if (data.ok) {
                window.location.href = data.redirectUrl || '/Reserva/Nueva';
            } else {
                fb.className = 'auth-feedback error';
                fb.textContent = data.mensaje;
            }
        });
    }
    function ejecutarRegHome(e) {
        e.preventDefault();
        var nom  = document.getElementById('hrNom').value.trim();
        var tDoc = document.getElementById('hrTipoDoc').value;
        var doc  = document.getElementById('hrDoc').value.trim();
        var fn   = document.getElementById('hrFechaNac').value;
        var cor  = document.getElementById('hrCorreo').value.trim();
        var tel  = document.getElementById('hrTel').value.trim();
        var usu  = document.getElementById('hrUsu').value.trim();
        var pas  = document.getElementById('hrPass').value;
        var cnf  = document.getElementById('hrConf').value;
        var fb   = document.getElementById('homeAuthFeedback');
        if (pas !== cnf) {
            fb.className = 'auth-feedback error';
            fb.textContent = 'Las contraseñas no coinciden.';
            return;
        }
        fetch('/Login/RegistroAjax', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ 
                nombreCompleto: nom, 
                tipoDocumento: tDoc,
                documento: doc, 
                fechaNacimiento: fn,
                correo: cor,
                telefono: tel, 
                usuario: usu, 
                contraseña: pas, 
                confirmarContraseña: cnf, 
                returnUrl: '/Reserva/Nueva' 
            })
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
            if (data.ok) {
                window.location.href = data.redirectUrl || '/Login/RegistroExitoso';
            } else {
                fb.className = 'auth-feedback error';
                fb.textContent = data.mensaje;
            }
        });
    }
    document.getElementById('homeAuthModalOverlay').addEventListener('click', function(e) {
        if (e.target === this) cerrarModalAuthHome();
    });

    // ══════════════════════════════════════════════════════════════════
    // ══ MODAL DE RESEÑAS EN EL HOME (AJAX) ═════════════════════════════
    // ══════════════════════════════════════════════════════════════════

    let homeRatingActual = 5;
    const homeDescripcionesEstrellas = {
        1: "Por mejorar (1 de 5 estrellas)",
        2: "Regular (2 de 5 estrellas)",
        3: "Buena (3 de 5 estrellas)",
        4: "Muy buena (4 de 5 estrellas)",
        5: "Excelente (5 de 5 estrellas) — ¡Insuperable!"
    };

    function abrirModalResenaHome() {
        const overlay = document.getElementById('homeModalResenaOverlay');
        if (overlay) {
            overlay.classList.add('open');
            document.body.style.overflow = 'hidden';
            seleccionarEstrellaHome(5);
            const inputNom = document.getElementById('homeResenaNombre');
            if (inputNom && !inputNom.value) inputNom.focus();
        }
    }

    function cerrarModalResenaHome() {
        const overlay = document.getElementById('homeModalResenaOverlay');
        if (overlay) {
            overlay.classList.remove('open');
            document.body.style.overflow = '';
            const fb = document.getElementById('homeResenaFeedback');
            if (fb) {
                fb.style.display = 'none';
                fb.className = 'resena-feedback-box';
            }
        }
    }

    function clickOverlayResenaHome(e) {
        if (e.target === document.getElementById('homeModalResenaOverlay')) {
            cerrarModalResenaHome();
        }
    }

    function seleccionarEstrellaHome(val) {
        homeRatingActual = val;
        const inp = document.getElementById('homeInputRating');
        if (inp) inp.value = val;
        const txt = document.getElementById('homeStarPickerTxt');
        if (txt) txt.textContent = homeDescripcionesEstrellas[val] || `${val} estrellas`;
        actualizarIconosEstrellasHome(val);
    }

    function hoverEstrellaHome(val) {
        actualizarIconosEstrellasHome(val);
        const txt = document.getElementById('homeStarPickerTxt');
        if (txt) txt.textContent = homeDescripcionesEstrellas[val] || `${val} estrellas`;
    }

    function resetEstrellasHome() {
        actualizarIconosEstrellasHome(homeRatingActual);
        const txt = document.getElementById('homeStarPickerTxt');
        if (txt) txt.textContent = homeDescripcionesEstrellas[homeRatingActual] || `${homeRatingActual} estrellas`;
    }

    function actualizarIconosEstrellasHome(val) {
        const icons = document.querySelectorAll('#homeStarPickerIcons .btn-pick-star');
        icons.forEach(btn => {
            const star = parseInt(btn.getAttribute('data-star'));
            if (star <= val) btn.classList.add('active');
            else btn.classList.remove('active');
        });
    }

    function actualizarContadorHome(textarea) {
        const count = textarea.value.length;
        const counter = document.getElementById('homeCharCounter');
        if (counter) counter.textContent = `${count} / 1000`;
    }

    async function enviarResenaHomeAjax(e) {
        e.preventDefault();
        const fb = document.getElementById('homeResenaFeedback');
        const btn = document.getElementById('homeBtnEnviarResena');

        const nombre = document.getElementById('homeResenaNombre').value.trim();
        const correo = document.getElementById('homeResenaCorreo').value.trim();
        const calificacion = parseInt(document.getElementById('homeInputRating').value) || 5;
        const tipoExp = document.getElementById('homeResenaTipoExp').value;
        const plato = document.getElementById('homeResenaPlato').value.trim();
        const comentario = document.getElementById('homeResenaComentario').value.trim();

        if (nombre.length < 2) {
            fb.style.display = 'block';
            fb.className = 'resena-feedback-box error';
            fb.textContent = 'Por favor ingresa tu nombre completo.';
            return;
        }

        if (comentario.length < 5) {
            fb.style.display = 'block';
            fb.className = 'resena-feedback-box error';
            fb.textContent = 'Tu reseña debe tener al menos 5 caracteres.';
            return;
        }

        btn.disabled = true;
        btn.style.opacity = '0.6';

        try {
            const resp = await fetch('/Resena/CrearApi', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    nombreCliente: nombre,
                    correo: correo,
                    calificacion: calificacion,
                    tipoExperiencia: tipoExp,
                    platoRecomendado: plato,
                    comentario: comentario
                })
            });

            const data = await resp.json();

            if (data.ok) {
                fb.style.display = 'block';
                fb.className = 'resena-feedback-box success';
                fb.textContent = data.mensaje;

                const grid = document.getElementById('homeResenasGrid');
                if (grid && data.resena) {
                    let starsHtml = '';
                    for (let s = 1; s <= 5; s++) {
                        starsHtml += `
                            <svg width="15" height="15" viewBox="0 0 24 24" style="${s <= data.resena.calificacion ? 'fill:#F59E0B;stroke:#D97706;' : 'fill:rgba(0,0,0,0.1);stroke:rgba(0,0,0,0.2);'}">
                                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                            </svg>
                        `;
                    }

                    const tagDish = data.resena.platoRecomendado ? `
                        <span style="font-size:0.7rem;background:rgba(200,151,58,0.14);color:var(--gold);border:1px solid rgba(200,151,58,0.3);padding:2px 7px;border-radius:6px;font-weight:600;">
                            Recomendó: <strong>${data.resena.platoRecomendado}</strong>
                        </span>
                    ` : '';

                    const newCard = document.createElement('div');
                    newCard.className = 'resena-card-item';
                    newCard.style.animation = 'fadeInModal 300ms ease-out';

                    const initial = data.resena.nombreCliente ? data.resena.nombreCliente.charAt(0).toUpperCase() : 'C';

                    newCard.innerHTML = `
                        <div>
                            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:0.75rem;">
                                <div style="display:flex;align-items:center;gap:0.75rem;">
                                    <div style="width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg, #6B1E2E, #C8973A);color:#FFFDF9;font-weight:800;font-size:0.95rem;display:flex;align-items:center;justify-content:center;">
                                        ${initial}
                                    </div>
                                    <div>
                                        <div style="font-size:0.92rem;font-weight:700;color:var(--text);display:flex;align-items:center;gap:5px;">
                                            <span>${data.resena.nombreCliente}</span>
                                            <span style="font-size:0.65rem;background:rgba(16,185,129,0.14);color:#10B981;border:1px solid rgba(16,185,129,0.35);border-radius:999px;padding:1px 5px;font-weight:700;display:inline-flex;align-items:center;gap:2px;">
                                                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                                                Verificado
                                            </span>
                                        </div>
                                        <div style="font-size:0.74rem;color:var(--muted);">Justo ahora</div>
                                    </div>
                                </div>
                                <div style="display:flex;gap:2px;">${starsHtml}</div>
                            </div>
                            <div style="display:flex;flex-wrap:wrap;gap:0.4rem;margin-bottom:0.75rem;">
                                <span style="font-size:0.7rem;background:var(--surface-2);color:var(--muted);padding:2px 7px;border-radius:6px;font-weight:600;">
                                    ${data.resena.tipoExperiencia}
                                </span>
                                ${tagDish}
                            </div>
                            <p style="font-size:0.88rem;color:var(--text);line-height:1.55;margin:0;font-style:italic;">
                                "${data.resena.comentario}"
                            </p>
                        </div>
                    `;

                    grid.insertBefore(newCard, grid.firstChild);
                }

                if (data.stats) {
                    const score = document.getElementById('homeScoreDisplay');
                    if (score) score.textContent = data.stats.promedio.toFixed(1);
                    const totalTxt = document.getElementById('homeTotalReviewsDisplay');
                    if (totalTxt) totalTxt.innerHTML = `Basado en <strong>${data.stats.totalResenas}</strong> experiencias verificadas`;
                }

                document.getElementById('homeFormNuevaResena').reset();
                actualizarContadorHome(document.getElementById('homeResenaComentario'));

                setTimeout(() => {
                    cerrarModalResenaHome();
                }, 1400);
            } else {
                fb.style.display = 'block';
                fb.className = 'resena-feedback-box error';
                fb.textContent = data.mensaje || 'Error al enviar reseña.';
            }
        } catch (err) {
            console.error(err);
            fb.style.display = 'block';
            fb.className = 'resena-feedback-box error';
            fb.textContent = 'Error de conexión al enviar la reseña.';
        } finally {
            btn.disabled = false;
            btn.style.opacity = '1';
        }
    }

    // ══════════════════════════════════════════════════════════════════
    // ══ MOTOR DEL CARRITO Y DOMICILIOS ESTILO KFC ═════════════════════
    // ══════════════════════════════════════════════════════════════════

    let cart = [];
    let modalidadEntrega = localStorage.getItem('saborator_tipo_entrega') || 'Domicilio';
    let direccionGuardada = localStorage.getItem('saborator_direccion') || '';
    let costoEnvioGuardado = parseInt(localStorage.getItem('saborator_costo_envio')) || 4000;
    let barrioGuardado = localStorage.getItem('saborator_barrio') || 'Ciudadela 20 de Julio';

    function obtenerImagenPorNombre(nombre) {
        if (!nombre) return '/img/hamburguesa.jpg';
        const n = nombre.toLowerCase().trim();
        if (n.includes('perro') || n.includes('hot dog') || n.includes('hotdog')) return '/img/perrocaliente.jpg';
        if (n.includes('salchipapa')) return '/img/salchipapa.jpg';
        if (n.includes('papa')) return '/img/papasfrancesa.jpg';
        if (n.includes('coca')) return '/img/cocacola.png?v=3';
        if (n.includes('pepsi')) return '/img/pepsi.webp?v=2';
        if (n.includes('agua')) return '/img/agua.webp?v=2';
        if (n.includes('hamburguesa') || n.includes('burger')) return '/img/hamburguesa.jpg';
        return '/img/hamburguesa.jpg';
    }

    function initCartEngine() {
        try {
            cart = JSON.parse(localStorage.getItem('saborator_cart') || '[]');
        } catch(e) {
            cart = [];
        }

        // Auto-reparar imágenes guardadas para que cada producto tenga su foto real
        if (Array.isArray(cart) && cart.length > 0) {
            let modificado = false;
            cart.forEach(item => {
                const fotoReal = obtenerImagenPorNombre(item.nombre);
                if (!item.imgUrl || item.imgUrl === '0' || item.imgUrl === 0 || !item.imgUrl.startsWith('/') || (item.imgUrl.includes('hamburguesa') && fotoReal !== '/img/hamburguesa.jpg')) {
                    item.imgUrl = fotoReal;
                    modificado = true;
                }
            });
            if (modificado) {
                localStorage.setItem('saborator_cart', JSON.stringify(cart));
            }
        }

        actualizarModalidadUI();
        actualizarUI();
    }

    function guardarCart() {
        localStorage.setItem('saborator_cart', JSON.stringify(cart));
        actualizarUI();
    }

    function cartAgregar(id, nombre, precio, imgUrl, btn) {
        // Asegurar imagen específica del producto seleccionado
        let foto = (typeof imgUrl === 'string' && imgUrl.startsWith('/')) 
            ? imgUrl 
            : obtenerImagenPorNombre(nombre);

        const precioNum = (typeof precio === 'number') ? precio : (parseFloat(precio) || 0);

        const item = cart.find(x => x.id === id);
        if (item) {
            item.cantidad += 1;
            item.imgUrl = foto;
        } else {
            cart.push({
                id: id,
                nombre: nombre,
                precio: precioNum,
                imgUrl: foto,
                cantidad: 1
            });
        }
        guardarCart();

        // Feedback táctil visual en el botón
        if (btn) {
            const originalHtml = btn.innerHTML;
            btn.innerHTML = `
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <span>¡Agregado!</span>
            `;
            btn.style.transform = 'scale(1.05)';
            setTimeout(() => {
                btn.innerHTML = originalHtml;
                btn.style.transform = '';
            }, 900);
        }
    }

    function cartCambiarCantidad(id, delta) {
        const item = cart.find(x => x.id === id);
        if (!item) return;
        item.cantidad += delta;
        if (item.cantidad <= 0) {
            cart = cart.filter(x => x.id !== id);
        }
        guardarCart();
    }

    function cartEliminar(id) {
        cart = cart.filter(x => x.id !== id);
        guardarCart();
    }

    function actualizarUI() {
        const totalItems = cart.reduce((acc, x) => acc + x.cantidad, 0);
        const subtotal = cart.reduce((acc, x) => acc + (x.precio * x.cantidad), 0);
        const envio = (modalidadEntrega === 'Domicilio' && totalItems > 0) ? costoEnvioGuardado : 0;
        const totalFinal = subtotal + envio;

        // 1. Badge Navbar
        const navBadge = document.getElementById('navCartCount');
        if (navBadge) {
            navBadge.textContent = totalItems;
            navBadge.style.display = totalItems > 0 ? 'flex' : 'none';
        }

        // 2. Barra Flotante Inferior
        const floatBar = document.getElementById('cartFloatingBar');
        if (floatBar) {
            if (totalItems > 0) {
                floatBar.classList.add('visible');
                document.getElementById('floatItemCount').textContent = totalItems;
                document.getElementById('floatSubtotalVal').textContent = `$${subtotal.toLocaleString('es-CO')} COP`;
                document.getElementById('floatModeVal').textContent = modalidadEntrega === 'Domicilio' 
                    ? `Domicilio ($${costoEnvioGuardado.toLocaleString('es-CO')} - ${barrioGuardado})` 
                    : (modalidadEntrega === 'ParaLlevar' ? 'Retiro en Restaurante' : 'En Mesa');
            } else {
                floatBar.classList.remove('visible');
            }
        }

        // 3. Renderizar items en Drawer
        renderDrawerItems(subtotal, envio, totalFinal);
    }

    function renderDrawerItems(subtotal, envio, totalFinal) {
        const list = document.getElementById('drawerItemsList');
        if (!list) return;

        if (cart.length === 0) {
            list.innerHTML = `
                <div style="text-align:center;padding:3rem 1rem;color:rgba(255,253,249,0.5);">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom:0.75rem;"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                    <p style="font-size:1.1rem;font-weight:600;margin:0 0 0.35rem;color:#FFFDF9;">Tu carrito está vacío</p>
                    <p style="font-size:0.85rem;margin:0;">Explora nuestra carta y añade tus platos favoritos.</p>
                </div>
            `;
        } else {
            let html = '';
            cart.forEach(item => {
                const itemTotal = item.precio * item.cantidad;
                const itemImg = (item.imgUrl && typeof item.imgUrl === 'string' && item.imgUrl.startsWith('/') && !item.imgUrl.includes('0')) 
                    ? item.imgUrl 
                    : obtenerImagenPorNombre(item.nombre);
                html += `
                    <div class="drawer-item">
                        <div class="drawer-item-img" style="background-image:url('${itemImg}');"></div>
                        <div class="drawer-item-details">
                            <div class="drawer-item-top">
                                <span class="drawer-item-name">${item.nombre}</span>
                                <button type="button" class="drawer-item-remove" onclick="cartEliminar(${item.id})" title="Eliminar">&times;</button>
                            </div>
                            <div class="drawer-item-bottom">
                                <div class="cart-stepper">
                                    <button type="button" class="cart-stepper-btn" onclick="cartCambiarCantidad(${item.id}, -1)">&minus;</button>
                                    <span class="cart-stepper-count">${item.cantidad}</span>
                                    <button type="button" class="cart-stepper-btn" onclick="cartCambiarCantidad(${item.id}, 1)">&plus;</button>
                                </div>
                                <span class="drawer-item-price">$${itemTotal.toLocaleString('es-CO')}</span>
                            </div>
                        </div>
                    </div>
                `;
            });
            list.innerHTML = html;
        }

        document.getElementById('drawerSubtotal').textContent = `$${subtotal.toLocaleString('es-CO')} COP`;
        document.getElementById('drawerShipping').textContent = envio > 0 ? `$${envio.toLocaleString('es-CO')} COP (${barrioGuardado})` : 'Gratis ($0)';
        document.getElementById('drawerTotal').textContent = `$${totalFinal.toLocaleString('es-CO')} COP`;

        // Validación Límite Mínimo de Domicilio ($20.000 COP)
        const minAlert = document.getElementById('drawerMinAlert');
        const checkoutBtn = document.getElementById('drawerCheckoutBtn');
        const LIMITE_MINIMO = 20000;

        if (modalidadEntrega === 'Domicilio' && subtotal < LIMITE_MINIMO && cart.length > 0) {
            if (minAlert) {
                minAlert.style.display = 'block';
                const faltante = LIMITE_MINIMO - subtotal;
                document.getElementById('drawerMinFaltante').textContent = `$${faltante.toLocaleString('es-CO')} COP`;
            }
            if (checkoutBtn) {
                checkoutBtn.style.opacity = '0.5';
                checkoutBtn.onclick = function(e) {
                    e.preventDefault();
                    alert(`El pedido mínimo para despacho a domicilio es de $${LIMITE_MINIMO.toLocaleString('es-CO')} COP.\nTe faltan $${(LIMITE_MINIMO - subtotal).toLocaleString('es-CO')} COP para poder enviar a domicilio.`);
                };
            }
        } else {
            if (minAlert) minAlert.style.display = 'none';
            if (checkoutBtn) {
                checkoutBtn.style.opacity = '1';
                checkoutBtn.onclick = null;
            }
        }
    }

    // Drawer Open / Close
    function abrirDrawerCarrito() {
        document.getElementById('cartDrawerOverlay').classList.add('open');
        document.body.style.overflow = 'hidden';
    }
    function cerrarDrawerCarrito() {
        document.getElementById('cartDrawerOverlay').classList.remove('open');
        document.body.style.overflow = '';
    }
    function clickOverlayDrawer(e) {
        if (e.target === document.getElementById('cartDrawerOverlay')) {
            cerrarDrawerCarrito();
        }
    }

    // Modal de Modalidad (KFC)
    function abrirModalModalidad() {
        document.getElementById('modalityModalOverlay').classList.add('open');
        // Marcar opción activa
        document.querySelectorAll('.mod-option-btn').forEach(btn => btn.classList.remove('active'));
        const activeBtn = document.getElementById(`opt${modalidadEntrega}`);
        if (activeBtn) activeBtn.classList.add('active');

        const addrBox = document.getElementById('quickAddressBox');
        if (addrBox) {
            addrBox.style.display = modalidadEntrega === 'Domicilio' ? 'block' : 'none';
            document.getElementById('quickAddressInput').value = direccionGuardada;
            // Sincronizar select si existe
            const sel = document.getElementById('quickBarrioSelect');
            if (sel) {
                for (let i = 0; i < sel.options.length; i++) {
                    if (sel.options[i].value.includes(barrioGuardado)) {
                        sel.selectedIndex = i;
                        break;
                    }
                }
                cambiarBarrioModalKfc();
            }
        }
    }
    function cerrarModalModalidad() {
        document.getElementById('modalityModalOverlay').classList.remove('open');
    }

    function seleccionarModalidad(tipo) {
        modalidadEntrega = tipo;
        localStorage.setItem('saborator_tipo_entrega', tipo);
        
        document.querySelectorAll('.mod-option-btn').forEach(btn => btn.classList.remove('active'));
        const activeBtn = document.getElementById(`opt${tipo}`);
        if (activeBtn) activeBtn.classList.add('active');

        const addrBox = document.getElementById('quickAddressBox');
        if (tipo === 'Domicilio') {
            addrBox.style.display = 'block';
            document.getElementById('quickAddressInput').focus();
        } else {
            addrBox.style.display = 'none';
            actualizarModalidadUI();
            actualizarUI();
            cerrarModalModalidad();
        }
    }

    function cambiarBarrioModalKfc() {
        const sel = document.getElementById('quickBarrioSelect').value;
        const display = document.getElementById('quickModalFeeDisplay');
        const parts = sel.split('|');
        const tarifa = parseInt(parts[0]) || 4000;
        if (display) display.textContent = `$${tarifa.toLocaleString('es-CO')} COP`;
    }

    function guardarDireccionRapida() {
        const dir = document.getElementById('quickAddressInput').value.trim();
        const sel = document.getElementById('quickBarrioSelect').value;
        const parts = sel.split('|');
        const tarifa = parseInt(parts[0]) || 4000;
        const barrio = parts[1] || 'Ciudadela 20 de Julio';

        costoEnvioGuardado = tarifa;
        barrioGuardado = barrio;
        localStorage.setItem('saborator_costo_envio', tarifa);
        localStorage.setItem('saborator_barrio', barrio);

        if (dir) {
            direccionGuardada = dir;
            localStorage.setItem('saborator_direccion', dir);
        }
        actualizarModalidadUI();
        actualizarUI();
        cerrarModalModalidad();
    }

    // Funciones del Cotizador de la Sección Home
    function cambiarZonaDomicilioHome() {
        const sel = document.getElementById('homeZoneSelect').value;
        const parts = sel.split('|');
        const tarifa = parseInt(parts[0]) || 4000;
        const sector = parts[1] || 'Ciudadela 20 de Julio';
        document.getElementById('homeFeeDisplay').textContent = `$${tarifa.toLocaleString('es-CO')} COP`;
        document.getElementById('homeSectorDisplay').textContent = sector;
        const timeTxt = tarifa <= 4000 ? '20 - 30 minutos' : (tarifa <= 6000 ? '30 - 40 minutos' : '40 - 55 minutos');
        document.getElementById('homeTimeDisplay').innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> <span>${timeTxt}</span>`;
    }

    function aplicarTarifaDomicilioHome() {
        const sel = document.getElementById('homeZoneSelect').value;
        const parts = sel.split('|');
        const tarifa = parseInt(parts[0]) || 4000;
        const barrio = parts[1] || 'Ciudadela 20 de Julio';
        const dir = document.getElementById('homeAddressInput').value.trim();

        costoEnvioGuardado = tarifa;
        barrioGuardado = barrio;
        localStorage.setItem('saborator_costo_envio', tarifa);
        localStorage.setItem('saborator_barrio', barrio);
        if (dir) {
            direccionGuardada = dir;
            localStorage.setItem('saborator_direccion', dir);
        }
        modalidadEntrega = 'Domicilio';
        localStorage.setItem('saborator_tipo_entrega', 'Domicilio');

        actualizarModalidadUI();
        actualizarUI();

        const notice = document.getElementById('homeFeeConfirmNotice');
        if (notice) {
            notice.style.display = 'block';
            setTimeout(() => { notice.style.display = 'none'; }, 4000);
        }

        const menuSec = document.getElementById('menu');
        if (menuSec) menuSec.scrollIntoView({ behavior: 'smooth' });
    }

    function actualizarModalidadUI() {
        const navText = document.getElementById('navModalityText');
        const heroType = document.getElementById('heroModalityLabel');
        const heroAddr = document.getElementById('heroAddressLabel');
        const drawerLabel = document.getElementById('drawerModLabel');

        if (modalidadEntrega === 'Domicilio') {
            if (navText) navText.textContent = 'Domicilio';
            if (heroType) heroType.textContent = 'Domicilio Express';
            if (heroAddr) heroAddr.textContent = direccionGuardada ? `${direccionGuardada} (${barrioGuardado})` : 'Ingresa tu dirección de entrega';
            if (drawerLabel) drawerLabel.textContent = `Domicilio (${barrioGuardado})`;
        } else if (modalidadEntrega === 'ParaLlevar') {
            if (navText) navText.textContent = 'Para Llevar';
            if (heroType) heroType.textContent = 'Para Llevar';
            if (heroAddr) heroAddr.textContent = 'Retiro en Sede: Cra 4 Sur # 50D-107';
            if (drawerLabel) drawerLabel.textContent = 'Retiro en Restaurante';
        } else {
            if (navText) navText.textContent = 'En Mesa';
            if (heroType) heroType.textContent = 'Consumo en Mesa';
            if (heroAddr) heroAddr.textContent = 'Plano de 30 mesas exclusivo';
            if (drawerLabel) drawerLabel.textContent = 'Consumo en Salón';
        }
    }

    document.addEventListener('DOMContentLoaded', initCartEngine);
</script>

