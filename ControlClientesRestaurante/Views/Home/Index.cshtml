            <!-- Botón Menú Hamburguesa Móvil -->
            <button type="button" class="lnav-toggle" id="lnavMobileToggle" onclick="document.getElementById('lnavMobileMenu').classList.toggle('open')" aria-label="Abrir menú de opciones">
