                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--gold, #C8973A)" stroke-width="2.3" style="display:inline-block !important;flex-shrink:0;"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>
                        <span>@_usuario</span>
