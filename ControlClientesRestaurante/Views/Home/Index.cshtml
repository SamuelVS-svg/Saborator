                        <span>Reservar Salón</span>
                    </a>
                </div>
            </div>

            <!-- Columna Derecha: Escena visual isométrica minimalista inspirada en el video -->
            <div class="hero-minimal-right">
                <div class="hero-showcase-wrapper">
                    <!-- Plato / Bandeja isométrica de presentación -->
                    <div class="minimal-slate-board">
                        <div class="slate-glow"></div>
                        <img src="/img/hamburguesa.jpg" alt="Hamburguesa de Autor Saborator" class="slate-main-dish" />
                        <div class="slate-reflection"></div>
                    </div>

                    <!-- Tarjeta flotante 1: Producto destacado de autor -->
                    <div class="floating-dish-chip chip-top" onclick="location.href='#menu'">
                        <div class="chip-avatar" style="background-image:url('/img/salchipapa.jpg');"></div>
                        <div class="chip-info">
                            <span class="chip-title">Salchipapa Gourmet</span>
                            <span class="chip-price">$28.000 COP</span>
