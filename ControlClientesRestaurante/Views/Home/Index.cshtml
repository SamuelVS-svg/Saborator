@inject ControlClientesRestaurante.Services.ProductoService _productoSvc
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Saborator — Menú & Experiencia Gourmet";
    Layout = "_Layout";

    var _session = HttpContextAccessor.HttpContext?.Session;
    var _usuario = (User.Identity?.IsAuthenticated == true && !string.IsNullOrWhiteSpace(User.Identity.Name))
        ? User.Identity.Name
        : _session?.GetString("Usuario");
    var _rol     = (User.Identity?.IsAuthenticated == true && !string.IsNullOrWhiteSpace(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value))
        ? User.FindFirst(System.Security.Claims.ClaimTypes.Role)!.Value
        : (_session?.GetString("Rol") ?? "");
    var _autenticado = (User.Identity?.IsAuthenticated == true) || !string.IsNullOrEmpty(_usuario);
    var _esPersonal  = User.IsInRole("Administrador") || User.IsInRole("Cajero") || User.IsInRole("Mesero") || User.IsInRole("Cocinero")
        || _rol == "Administrador" || _rol == "Cajero" || _rol == "Mesero" || _rol == "Cocinero";

    var productos = _productoSvc.ObtenerTodos().Where(p => p.Activo).ToList();
    var resenas = ViewBag.Resenas as List<ControlClientesRestaurante.Models.Resena> ?? new List<ControlClientesRestaurante.Models.Resena>();
    var resenaStats = ViewBag.ResenaStats as ControlClientesRestaurante.Services.ResenaEstadisticasDto ?? new ControlClientesRestaurante.Services.ResenaEstadisticasDto();
}

