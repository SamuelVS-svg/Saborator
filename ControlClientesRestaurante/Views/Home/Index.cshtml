    <!-- ══ HERO DEL MENÚ GASTRONÓMICO (MINIMALISTA INSPIRADO EN EL VIDEO) ═══════════════════════ -->
    <section class="hero hero-minimal" id="inicio">
        <div class="hero-minimal-container">
            <!-- Columna Izquierda: Tipografía limpia, propuesta de valor y acciones rápidas -->
            <div class="hero-minimal-left">
                <div class="hero-tag-minimal">
                    <span class="hero-tag-dot"></span>
                    <span>Alta Cocina Contemporánea &bull; Barranquilla</span>
                </div>

                <h1 class="hero-title-minimal">
                    Disfruta Alta Cocina<br/>
                    <span class="hero-title-accent">Hecha con Pasión.</span>
                </h1>

                <p class="hero-desc-minimal">
                    Ingredientes seleccionados, masa madre artesanal y técnicas culinarias de autor. 
                    Ordena a domicilio express con seguimiento o reserva tu mesa en salón.
                </p>

                <!-- Barra interactiva rápida de pedido / modalidad -->
