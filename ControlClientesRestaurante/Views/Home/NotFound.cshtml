@{
    ViewData["Title"] = "Página no encontrada (404)";
    Layout = "_Layout";
    int code = ViewBag.StatusCode ?? 404;
}

<style>
    .notfound-wrapper {
        min-height: 85vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3rem 1.5rem;
        background: radial-gradient(circle at 50% 30%, rgba(107, 30, 46, 0.45) 0%, rgba(24, 6, 10, 0.98) 75%);
        color: #FFFDF9;
        text-align: center;
        position: relative;
        overflow: hidden;
    }
    .notfound-wrapper::before {
        content: "";
        position: absolute;
        inset: 0;
        background-image: radial-gradient(rgba(200, 151, 58, 0.08) 1px, transparent 1px);
        background-size: 28px 28px;
        pointer-events: none;
    }
    .notfound-card {
        position: relative;
        z-index: 2;
        max-width: 620px;
        background: rgba(30, 10, 16, 0.82);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(200, 151, 58, 0.3);
        border-radius: 20px;
        padding: 3.5rem 2.5rem;
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.65), 0 0 40px rgba(107, 30, 46, 0.35);
        animation: fadeInNotFound 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    @@keyframes fadeInNotFound {
        from { opacity: 0; transform: translateY(20px) scale(0.98); }
        to { opacity: 1; transform: translateY(0) scale(1); }
    }
    .notfound-icon {
        width: 80px;
        height: 80px;
        margin: 0 auto 1.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, rgba(107, 30, 46, 0.6), rgba(200, 151, 58, 0.25));
        border: 1px solid rgba(200, 151, 58, 0.4);
        border-radius: 50%;
        color: #C8973A;
        box-shadow: 0 0 30px rgba(200, 151, 58, 0.25);
    }
    .notfound-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.35rem 1rem;
        border-radius: 999px;
        background: rgba(200, 151, 58, 0.15);
        border: 1px solid rgba(200, 151, 58, 0.35);
        color: #F0E2D2;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        margin-bottom: 1.25rem;
    }
    .notfound-title {
        font-family: 'Instrument Serif', Georgia, serif;
        font-size: clamp(2.4rem, 5vw, 3.4rem);
        font-weight: 400;
        line-height: 1.1;
        margin: 0 0 1rem;
        color: #FFFDF9;
    }
    .notfound-title span {
        color: #C8973A;
        font-style: italic;
    }
    .notfound-desc {
        color: rgba(255, 253, 249, 0.78);
        font-size: 1.05rem;
        line-height: 1.6;
        margin: 0 auto 2.25rem;
        max-width: 480px;
    }
    .notfound-actions {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
    }
    .btn-nf-gold {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.85rem 1.6rem;
        background: linear-gradient(135deg, #C8973A, #A67520);
        color: #18060A;
        font-size: 0.92rem;
        font-weight: 700;
        border-radius: 12px;
        text-decoration: none;
        box-shadow: 0 6px 20px rgba(200, 151, 58, 0.35);
        transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease;
    }
    .btn-nf-gold:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(200, 151, 58, 0.5);
        color: #18060A;
    }
    .btn-nf-outline {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.85rem 1.5rem;
        background: transparent;
        color: #FFFDF9;
        font-size: 0.92rem;
        font-weight: 600;
        border: 1px solid rgba(255, 253, 249, 0.3);
        border-radius: 12px;
        text-decoration: none;
        transition: all 0.2s ease;
    }
    .btn-nf-outline:hover {
        background: rgba(255, 253, 249, 0.08);
        border-color: rgba(200, 151, 58, 0.6);
        color: #C8973A;
    }
</style>

<div class="notfound-wrapper">
    <div class="notfound-card">
        <div class="notfound-icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="8" x2="12" y2="12"/>
                <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
        </div>

        <div class="notfound-badge">Error @code &bull; Servicio no disponible</div>

        <h1 class="notfound-title">Esta mesa <span>no está en sala</span></h1>

        <p class="notfound-desc">
            El plato, la mesa o la sección que estás buscando no existe en nuestra carta o ha sido trasladada a otra ubicación.
        </p>

        <div class="notfound-actions">
            <a href="/" class="btn-nf-gold">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                    <polyline points="9 22 9 12 15 12 15 22"/>
                </svg>
                Regresar al Menú Principal
            </a>
            <a asp-controller="Reserva" asp-action="Nueva" class="btn-nf-outline">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="4" width="18" height="18" rx="2"/>
                    <line x1="16" y1="2" x2="16" y2="6"/>
                    <line x1="8" y1="2" x2="8" y2="6"/>
                    <line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
                Reservar una Mesa
            </a>
        </div>
    </div>
</div>
