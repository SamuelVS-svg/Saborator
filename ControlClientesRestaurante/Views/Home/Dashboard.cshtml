@inject ControlClientesRestaurante.Services.FacturaService _facturaSvc
@inject ControlClientesRestaurante.Services.PedidoService _pedidoSvc
@inject ControlClientesRestaurante.Services.MesaService _mesaSvc
@inject ControlClientesRestaurante.Services.ReservaService _reservaSvc
@inject ControlClientesRestaurante.Services.ProductoService _productoSvc
@inject ControlClientesRestaurante.Services.ResenaService _resenaSvc
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Dashboard V12 — Control & Analítica";
    Layout = "_Layout";

    var session = HttpContextAccessor.HttpContext?.Session;
    var usuario = (User.Identity?.IsAuthenticated == true && !string.IsNullOrWhiteSpace(User.Identity.Name))
        ? User.Identity.Name
        : (session?.GetString("Usuario") ?? "Administrador");
    var rol = (User.Identity?.IsAuthenticated == true && !string.IsNullOrWhiteSpace(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value))
        ? User.FindFirst(System.Security.Claims.ClaimTypes.Role)!.Value
        : (session?.GetString("Rol") ?? "Gerencia");

    // ── Saludo dinámico según la hora del día ──
    var hora = DateTime.Now.Hour;
    var saludo = hora < 12 ? "Buenos días" : (hora < 18 ? "Buenas tardes" : "Buenas noches");

    // ── Cómputo de Datos y Métricas Reales del Restaurante ──
    var facturas = _facturaSvc.ObtenerTodas();
    var pedidos = _pedidoSvc.ObtenerTodos();
    var mesas = _mesaSvc.ObtenerTodas();
    var reservas = _reservaSvc.ObtenerTodas();
    var productos = _productoSvc.ObtenerTodos();

    var facturasHoy = facturas.Where(f => f.FechaCreacion.Date == DateTime.Today).ToList();
    var ventasHoy = facturasHoy.Sum(f => f.Total);

    // Comparación real contra el promedio diario de los 7 días anteriores
    var inicioSemana = DateTime.Today.AddDays(-7);
    var ventasSemana = facturas.Where(f => f.FechaCreacion >= inicioSemana && f.FechaCreacion < DateTime.Today).Sum(f => f.Total);
    var promedioDiario = ventasSemana / 7m;
    bool hayHistorico = promedioDiario > 0;
    var variacionVentas = hayHistorico ? (double)((ventasHoy - promedioDiario) / promedioDiario * 100) : 0;
    var ventasCambio = hayHistorico ? $"{(variacionVentas >= 0 ? "+" : "")}{variacionVentas:0.0}%" : "Sin histórico";
    var ventasSube = variacionVentas >= 0;

    var pedidosActivos = pedidos.Where(p => p.Estado == "Pendiente" || p.Estado == "EnPreparacion" || p.Estado == "En Preparación" || p.Estado == "Abierto").Count();
    var domiciliosEnRuta = pedidos.Count(p => p.Estado == "EnCamino");
    var pedidosCambio = $"{domiciliosEnRuta} en ruta";

    var totalMesas = mesas.Count;
    var mesasOcupadas = mesas.Count(m => m.Estado == "Ocupada");
    var ocupacionPorcentaje = totalMesas > 0 ? (int)Math.Round((double)mesasOcupadas / totalMesas * 100) : 0;

    var reservasHoy = reservas.Where(r => r.Fecha.Date >= DateTime.Today && r.Estado != "Cancelada").OrderBy(r => r.Fecha).Take(6).ToList();
    var reservasActivas = reservas.Where(r => r.Fecha.Date >= DateTime.Today && r.Estado != "Cancelada" && r.Estado != "Completada").ToList();
    var totalReservasNum = reservasActivas.Count;
    var reservasDeHoy = reservasActivas.Count(r => r.Fecha.Date == DateTime.Today);

    var stockBajo = productos.Where(p => p.Activo && p.Stock <= 5).ToList();
    var fechaHoy = DateTime.Now;

    // Métricas reales del bloque principal
    var pedidosHoy = pedidos.Count(p => p.FechaCreacion.Date == DateTime.Today && p.Estado != "Cancelado");
    var entregasHoy = pedidos.Where(p => p.TipoEntrega == "Domicilio" && p.FechaEntrega.HasValue && p.FechaEntrega.Value.Date == DateTime.Today).ToList();
    var minutosEntrega = entregasHoy.Any() ? (int)Math.Round(entregasHoy.Average(p => (p.FechaEntrega!.Value - p.FechaCreacion).TotalMinutes)) : (int?)null;
    var statsResenas = _resenaSvc.ObtenerEstadisticas();

    // ── Calendario real del mes (semana inicia en lunes) con días que tienen reservas ──
    var culturaEs = new System.Globalization.CultureInfo("es-CO");
    var primerDiaMes = new DateTime(fechaHoy.Year, fechaHoy.Month, 1);
    int desfaseLunes = ((int)primerDiaMes.DayOfWeek + 6) % 7;
    int diasMes = DateTime.DaysInMonth(fechaHoy.Year, fechaHoy.Month);
    var diasConReserva = reservas
        .Where(r => r.Estado != "Cancelada" && r.Fecha.Year == fechaHoy.Year && r.Fecha.Month == fechaHoy.Month)
        .Select(r => r.Fecha.Day).ToHashSet();

    // ── Series reales de facturación para la gráfica ──
    List<(string etiqueta, decimal valor)> SerieDias(int dias) =>
        Enumerable.Range(0, dias).Select(i => DateTime.Today.AddDays(-(dias - 1) + i))
            .Select(d => (d.ToString("dd/MM"), facturas.Where(f => f.FechaCreacion.Date == d).Sum(f => f.Total)))
            .ToList();
    var serieHoy = Enumerable.Range(10, 14)
        .Select(h => ($"{h}:00", facturasHoy.Where(f => f.FechaCreacion.Hour == h).Sum(f => f.Total)))
        .ToList();
    var series = new Dictionary<string, List<(string etiqueta, decimal valor)>>
    {
        ["hoy"] = serieHoy, ["7d"] = SerieDias(7), ["30d"] = SerieDias(30)
    };
    string Trazo(List<(string etiqueta, decimal valor)> serie, bool area)
    {
        var max = Math.Max(1m, serie.Max(x => x.valor));
        var pts = serie.Select((x, i) => $"{(serie.Count == 1 ? 0 : i * 600.0 / (serie.Count - 1)):0.#} {(170 - (double)(x.valor / max) * 140):0.#}").ToList();
        var linea = "M " + string.Join(" L ", pts);
        return area ? linea + " L 600 180 L 0 180 Z" : linea;
    }
    var fotoPerfil = (User.Identity?.IsAuthenticated == true && !string.IsNullOrWhiteSpace(User.FindFirst("FotoPerfil")?.Value))
        ? User.FindFirst("FotoPerfil")!.Value
        : session?.GetString("FotoPerfil");
}

<div class="v12-dashboard-wrapper">
    <div class="v12-container">

        <!-- ══ ÁREA CENTRAL ══════════════════════════════════════════════════ -->
        <main class="v12-main">

            <!-- ══ 2. HEADER CON ICONO EJECUTIVO, SALUDO, BUSCADOR Y AVATAR ══ -->
            <header class="v12-header v12-animate-enter v12-stagger-1">
                <div class="d-flex align-items-center gap-3">
                    <div class="pg-icon" style="width: 48px; height: 48px; border-radius: 14px; flex-shrink: 0;">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>
                    </div>
                    <div>
                        <h1 class="v12-greeting-title">
                            <span>@saludo, @usuario</span>
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="var(--gold)" stroke="var(--gold)" stroke-width="1.5" style="flex-shrink:0;"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                        </h1>
                        <p class="v12-greeting-sub">Aquí tienes el balance operativo y métricas en tiempo real de Saborator</p>
                    </div>
                </div>

                <div class="v12-header-center">
                    <div class="glass-card v12-search-box">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                        <input type="text" class="v12-search-input" placeholder="Buscar pedidos, facturas, mesas o clientes..." id="v12QuickSearch" />
                    </div>
                </div>

                <div class="v12-header-actions">
                    <button type="button" class="v12-header-btn" onclick="toggleModoOscuro()" title="Cambiar tema">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
                    </button>
                    <a asp-controller="Reserva" asp-action="Admin" class="v12-header-btn" title="Notificaciones de Reservas">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                    </a>
                    <a asp-controller="Perfil" asp-action="Index" class="glass-card v12-user-badge" style="text-decoration:none;">
                        <div class="v12-avatar" style="overflow:hidden;">
                            @if (!string.IsNullOrEmpty(fotoPerfil))
                            {
                                <img src="@fotoPerfil" alt="@usuario" style="width:100%;height:100%;object-fit:cover;border-radius:50%;display:block;" />
                            }
                            else
                            {
                                @(usuario.Length > 0 ? usuario[0].ToString().ToUpper() : "U")
                            }
                        </div>
                        <div class="v12-user-info">
                            <span class="v12-user-name">@usuario</span>
                            <span class="v12-user-role">@rol</span>
                        </div>
                    </a>
                </div>
            </header>

            <!-- ══ 3. TARJETAS DE MÉTRICAS (STATCARD) ═════════════════════════ -->
            <section class="v12-stats-grid">
                <!-- StatCard 1: Facturación / Ventas -->
                <div class="glass-card glass-card-hover v12-stat-card v12-animate-enter v12-stagger-2">
                    <div class="v12-stat-head">
                        <span class="v12-stat-title">Ventas Hoy</span>
                        <div class="v12-stat-icon-wrap">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                        </div>
                    </div>
                    <div class="v12-stat-value">$@ventasHoy.ToString("N0", ControlClientesRestaurante.Models.Formato.Co)</div>
                    <div class="v12-stat-footer">
                        <span class="v12-trend-pill @(ventasSube ? "up" : "down")">
                            @if (hayHistorico)
                            {
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="@(ventasSube ? "18 15 12 9 6 15" : "6 9 12 15 18 9")"/></svg>
                            }
                            @ventasCambio
                        </span>
                        <span class="v12-trend-label">vs. promedio semanal</span>
                    </div>
                </div>

                <!-- StatCard 2: Comandas Activas -->
                <div class="glass-card glass-card-hover v12-stat-card v12-animate-enter v12-stagger-3">
                    <div class="v12-stat-head">
                        <span class="v12-stat-title">Pedidos en Curso</span>
                        <div class="v12-stat-icon-wrap">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 13.87A4 4 0 0 1 7.41 6a5.11 5.11 0 0 1 1.05-1.54 5 5 0 0 1 7.08 0A5.11 5.11 0 0 1 16.59 6 4 4 0 0 1 18 13.87V21H6Z"/><line x1="6" y1="17" x2="18" y2="17"/></svg>
                        </div>
                    </div>
                    <div class="v12-stat-value">@pedidosActivos</div>
                    <div class="v12-stat-footer">
                        <span class="v12-trend-pill up">
                            @pedidosCambio
                        </span>
                        <span class="v12-trend-label">domicilios con domiciliario</span>
                    </div>
                </div>

                <!-- StatCard 3: Ocupación de Mesas -->
                <div class="glass-card glass-card-hover v12-stat-card v12-animate-enter v12-stagger-4">
                    <div class="v12-stat-head">
                        <span class="v12-stat-title">Ocupación Salón</span>
                        <div class="v12-stat-icon-wrap">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/></svg>
                        </div>
                    </div>
                    <div class="v12-stat-value">@ocupacionPorcentaje%</div>
                    <div class="v12-stat-footer">
                        <span class="v12-trend-pill up">
                            @mesasOcupadas / @totalMesas
                        </span>
                        <span class="v12-trend-label">mesas con comensales</span>
                    </div>
                </div>

                <!-- StatCard 4: Reservas Programadas -->
                <div class="glass-card glass-card-hover v12-stat-card v12-animate-enter v12-stagger-5">
                    <div class="v12-stat-head">
                        <span class="v12-stat-title">Reservas Activas</span>
                        <div class="v12-stat-icon-wrap">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        </div>
                    </div>
                    <div class="v12-stat-value">@totalReservasNum</div>
                    <div class="v12-stat-footer">
                        <span class="v12-trend-pill up">
                            @reservasDeHoy hoy
                        </span>
                        <span class="v12-trend-label">próximas, sin canceladas</span>
                    </div>
                </div>
            </section>

            <!-- ══ CONTENIDO SPLIT: BENTO GRID + PANEL DERECHO ═══════════════ -->
            <div class="v12-content-split">

                <!-- ══ 6. TARJETAS TIPO BENTO ═════════════════════════════════ -->
                <div class="v12-bento-grid">

                    <!-- Bento Hero: Destacada con Color Principal Sólido -->
                    <div class="v12-bento-hero v12-animate-enter v12-stagger-4">
                        <div class="v12-bento-hero-bg">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
                        </div>
                        <div>
                            <div class="v12-bento-hero-tag">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 13.87A4 4 0 0 1 7.41 6a5.11 5.11 0 0 1 1.05-1.54 5 5 0 0 1 7.08 0A5.11 5.11 0 0 1 16.59 6 4 4 0 0 1 18 13.87V21H6Z"/><line x1="6" y1="17" x2="18" y2="17"/></svg>
                                <span>Centro de Operaciones Gastronómico</span>
                            </div>
                            <h2 class="v12-bento-hero-title">Operación de hoy</h2>
                            <p class="v12-bento-hero-desc">
                                @pedidosHoy pedidos registrados hoy, @pedidosActivos en curso y @domiciliosEnRuta domicilios en ruta.
                                @(stockBajo.Any() ? $"{stockBajo.Count} productos con stock crítico." : "Sin alertas de inventario.")
                            </p>
                        </div>

                        <div class="v12-bento-hero-metric">
                            <div class="v12-bento-metric-col">
                                <span class="v12-bento-metric-val">@(minutosEntrega.HasValue ? $"{minutosEntrega} min" : "—")</span>
                                <span class="v12-bento-metric-lbl">Tiempo medio domicilio</span>
                            </div>
                            <div class="v12-bento-metric-col">
                                <span class="v12-bento-metric-val">@entregasHoy.Count</span>
                                <span class="v12-bento-metric-lbl">Domicilios entregados</span>
                            </div>
                            <div class="v12-bento-metric-col">
                                <span class="v12-bento-metric-val">@(statsResenas.TotalResenas > 0 ? $"{statsResenas.Promedio:0.0}" : "—")@if (statsResenas.TotalResenas > 0) {<svg class="ico" width="1em" height="1em" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-.12em;margin-left:.3em"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>}</span>
                                <span class="v12-bento-metric-lbl">Reseñas Clientes</span>
                            </div>
                        </div>

                        <div style="margin-top: 1.4rem;">
                            <a asp-controller="Pedido" asp-action="@(User.IsInRole("Administrador") ? "Cocina" : "Index")" class="v12-bento-hero-btn">
                                @(User.IsInRole("Administrador") ? "Monitorear KDS Cocina" : "Ver pedidos activos")
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                            </a>
                        </div>
                    </div>

                    <!-- ══ 5. CALENDARIO COMPACTO CON DÍAS RESALTADOS ══════════ -->
                    <div class="glass-card glass-card-hover v12-calendar-card v12-animate-enter v12-stagger-5">
                        <div class="v12-cal-header">
                            <span class="v12-cal-month">@fechaHoy.ToString("MMMM yyyy", culturaEs).ToUpper(culturaEs)</span>
                            <a asp-controller="Reserva" asp-action="Admin" class="v12-panel-action">Reservas</a>
                        </div>
                        <div class="v12-cal-grid">
                            <div class="v12-cal-day-head">L</div>
                            <div class="v12-cal-day-head">M</div>
                            <div class="v12-cal-day-head">M</div>
                            <div class="v12-cal-day-head">J</div>
                            <div class="v12-cal-day-head">V</div>
                            <div class="v12-cal-day-head">S</div>
                            <div class="v12-cal-day-head">D</div>

                            @for (int k = 0; k < desfaseLunes; k++)
                            {
                                <div class="v12-cal-day muted"></div>
                            }
                            @for (int d = 1; d <= diasMes; d++)
                            {
                                <div class="v12-cal-day @(d == fechaHoy.Day ? "today" : "") @(diasConReserva.Contains(d) ? "has-event" : "")"
                                     title="@(diasConReserva.Contains(d) ? "Hay reservas este día" : "")">@d</div>
                            }
                        </div>
                    </div>

                    <!-- ══ 4. GRÁFICA DE ACTIVIDAD EN ÁREA/LÍNEA (DEGRADADO BRAND) ══ -->
                    <div class="glass-card glass-card-hover v12-chart-card v12-animate-enter v12-stagger-6">
                        <div class="v12-chart-head">
                            <div>
                                <h3 class="v12-chart-title">Curva de Facturación &amp; Demanda</h3>
                                <span style="font-size:0.75rem; color:var(--muted);">Registro continuo por franja horaria</span>
                            </div>
                            <div class="v12-chart-filters">
                                <button type="button" class="v12-chart-filter-btn active" data-serie="hoy">Hoy</button>
                                <button type="button" class="v12-chart-filter-btn" data-serie="7d">7D</button>
                                <button type="button" class="v12-chart-filter-btn" data-serie="30d">30D</button>
                            </div>
                        </div>
                        <div class="v12-chart-body">
                            <svg class="v12-chart-svg" viewBox="0 0 600 180" preserveAspectRatio="none" role="img" aria-label="Facturación por periodo">
                                <defs>
                                    <linearGradient id="v12AreaGrad" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0%" stop-color="var(--brand)" stop-opacity="0.45" />
                                        <stop offset="60%" stop-color="var(--brand)" stop-opacity="0.12" />
                                        <stop offset="100%" stop-color="var(--brand)" stop-opacity="0.0" />
                                    </linearGradient>
                                </defs>
                                <line x1="0" y1="30" x2="600" y2="30" stroke="var(--line)" stroke-dasharray="4 4" stroke-width="0.8" opacity="0.6"/>
                                <line x1="0" y1="100" x2="600" y2="100" stroke="var(--line)" stroke-dasharray="4 4" stroke-width="0.8" opacity="0.6"/>
                                <line x1="0" y1="170" x2="600" y2="170" stroke="var(--line)" stroke-dasharray="4 4" stroke-width="0.8" opacity="0.6"/>
                                @foreach (var kv in series)
                                {
                                    <g class="v12-serie" data-serie="@kv.Key" style="@(kv.Key == "hoy" ? "" : "display:none")">
                                        <path d="@Trazo(kv.Value, true)" fill="url(#v12AreaGrad)"/>
                                        <path class="v12-chart-line" d="@Trazo(kv.Value, false)" />
                                    </g>
                                }
                            </svg>
                            @foreach (var kv in series)
                            {
                                <div class="v12-serie-resumen" data-serie="@kv.Key" style="font-size:0.75rem;color:var(--muted);margin-top:0.35rem;@(kv.Key == "hoy" ? "" : "display:none")">
                                    @kv.Value.First().etiqueta – @kv.Value.Last().etiqueta · Total $@kv.Value.Sum(x => x.valor).ToString("N0", ControlClientesRestaurante.Models.Formato.Co)
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Bento Subcard: Ocupación de Mesas & Stock -->
                    <div class="glass-card glass-card-hover v12-bento-subcard v12-animate-enter v12-stagger-7">
                        <div>
                            <span class="v12-stat-title">Capacidad del Salón</span>
                            <div style="display:flex; justify-content:space-between; align-items:baseline; margin-top:0.5rem;">
                                <span style="font-size:1.5rem; font-weight:800;">@mesasOcupadas / @totalMesas</span>
                                <span style="font-size:0.8rem; font-weight:700; color:var(--brand);">@ocupacionPorcentaje% Ocupado</span>
                            </div>
                            <div class="v12-progress-bar">
                                <div class="v12-progress-fill" style="width: @ocupacionPorcentaje%;"></div>
                            </div>
                        </div>

                        <div style="border-top:1px solid var(--line); padding-top:0.75rem; margin-top:0.5rem;">
                            <div style="display:flex; justify-content:space-between; align-items:center;">
                                <span style="font-size:0.75rem; color:var(--muted); font-weight:600;">Alertas de Stock</span>
                                <span class="v12-trend-pill @(stockBajo.Any() ? "down" : "up")">
                                    @(stockBajo.Count) @(stockBajo.Count == 1 ? "producto" : "productos")
                                </span>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- ══ 7. PANEL DERECHO CON LISTA DE EVENTOS Y RESERVAS ═══════ -->
                <aside class="v12-right-panel v12-animate-enter v12-stagger-5">
                    <div class="glass-card v12-panel-card">
                        <div class="v12-panel-head">
                            <h3 class="v12-panel-title">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                Turnos &amp; Reservas
                            </h3>
                            <a asp-controller="Reserva" asp-action="Admin" class="v12-panel-action">Ver todas</a>
                        </div>

                        <div class="v12-panel-list">
                            @if (reservasHoy.Any())
                            {
                                foreach (var r in reservasHoy)
                                {
                                    var inicial = !string.IsNullOrEmpty(r.NombreCliente) ? r.NombreCliente[0].ToString().ToUpper() : "C";
                                    <div class="v12-event-item">
                                        <div class="v12-event-avatar">@inicial</div>
                                        <div class="v12-event-info">
                                            <p class="v12-event-title">@r.NombreCliente</p>
                                            <p class="v12-event-sub">Mesa @r.NumeroMesa · @r.NumeroPersonas pers. · @r.Hora</p>
                                        </div>
                                        <span class="v12-event-tag @(r.Estado == "Confirmada" ? "confirmed" : "pending")">
                                            @r.Estado
                                        </span>
                                    </div>
                                }
                            }
                            else
                            {
                                <p style="font-size:0.85rem;color:var(--muted);margin:0.5rem 0;">No hay reservas próximas.</p>
                            }
                        </div>
                    </div>

                    <!-- Acceso Directo de Caja & Facturación Rápida -->
                    <div class="glass-card v12-panel-card">
                        <div class="v12-panel-head">
                            <h3 class="v12-panel-title">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                                Caja Operativa
                            </h3>
                            <a asp-controller="Factura" asp-action="Create" class="v12-panel-action">+ Facturar</a>
                        </div>
                        <p style="font-size:0.8rem; color:var(--muted); margin-bottom:1rem;">
                            Emisión rápida de comprobantes DIAN con liquidación de propina y descuento en una sola transacción atómica.
                        </p>
                        <a asp-controller="Factura" asp-action="Create" class="btn-brand" style="display:flex; justify-content:center; width:100%; text-decoration:none;">
                            Nueva Factura
                        </a>
                    </div>
                </aside>

            </div>

        </main>
    </div>

    <!-- ══ 8. BARRA DE NAVEGACIÓN FLOTANTE TIPO PÍLDORA (DOCK INFERIOR) ════ -->
    <nav class="v12-pill-dock" aria-label="Navegación rápida de accesos">
        <a asp-controller="Home" asp-action="Dashboard" class="v12-dock-item active">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>
            <span>Dashboard</span>
        </a>
        <a asp-controller="Pedido" asp-action="Index" class="v12-dock-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/></svg>
            <span>Pedidos</span>
        </a>
        <a asp-controller="Mesa" asp-action="Index" class="v12-dock-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/></svg>
            <span>Mesas</span>
        </a>
        <a asp-controller="Factura" asp-action="Index" class="v12-dock-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/></svg>
            <span>Facturación</span>
        </a>
        <a asp-controller="Caja" asp-action="Index" class="v12-dock-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <span>Caja</span>
        </a>
        <a asp-controller="Cliente" asp-action="Index" class="v12-dock-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
            <span>Clientes</span>
        </a>
    </nav>
</div>

<script>
    // Buscador interactivo en vivo de Dashboard V12
    var v12Search = document.getElementById('v12QuickSearch');
    if (v12Search) {
        v12Search.addEventListener('input', function() {
            var q = this.value.toLowerCase().trim();
            var items = document.querySelectorAll('.v12-event-item, .v12-stat-card');
            items.forEach(function(el) {
                var txt = el.innerText.toLowerCase();
                el.style.opacity = (!q || txt.includes(q)) ? '1' : '0.25';
            });
        });
    }

    // Filtros interactivos de la gráfica de actividad
    document.querySelectorAll('.v12-chart-filter-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
            document.querySelectorAll('.v12-chart-filter-btn').forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            var serie = this.dataset.serie;
            document.querySelectorAll('.v12-serie, .v12-serie-resumen').forEach(function(el) {
                el.style.display = el.dataset.serie === serie ? '' : 'none';
            });
        });
    });
</script>
