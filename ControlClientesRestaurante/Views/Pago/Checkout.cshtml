@model ControlClientesRestaurante.Controllers.CheckoutRequestViewModel
@{
    ViewData["Title"] = "Pasarela de Pagos Segura";
    Layout = "_Layout";
}

<style>
    .checkout-hero {
        background: var(--bg, #F5EFE6);
        background-image: radial-gradient(circle at 1px 1px, rgba(107, 30, 46, 0.045) 1px, transparent 0);
        background-size: 24px 24px;
        padding: 2.5rem 1rem 3.5rem;
        color: var(--text, #1C1416);
        min-height: 90vh;
    }
    :root[data-theme="dark"] .checkout-hero {
        background: radial-gradient(circle at 50% 20%, rgba(107, 30, 46, 0.45) 0%, rgba(24, 6, 10, 0.98) 75%);
        color: #FFFDF9;
    }
    .checkout-container {
        max-width: 1100px;
        margin: 0 auto;
    }
    .checkout-header {
        text-align: center;
        margin-bottom: 2.5rem;
    }
    .checkout-tag {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.35rem 1rem;
        background: rgba(200, 151, 58, 0.15);
        border: 1px solid rgba(200, 151, 58, 0.35);
        border-radius: 999px;
        color: var(--brand, #6B1E2E);
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: 0.75rem;
    }
    :root[data-theme="dark"] .checkout-tag { color: #F0E2D2; }
    .checkout-title {
        font-family: 'Instrument Serif', Georgia, serif;
        font-size: clamp(2.2rem, 4vw, 3rem);
        font-weight: 400;
        margin: 0 0 0.5rem;
        color: var(--brand, #6B1E2E);
    }
    :root[data-theme="dark"] .checkout-title { color: #FFFDF9; }
    .checkout-title span {
        color: #C8973A;
        font-style: italic;
    }
    .checkout-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 390px;
        gap: 2rem;
        align-items: flex-start;
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
    }
    @@media (max-width: 992px) {
        .checkout-grid {
            grid-template-columns: minmax(0, 1fr);
            gap: 1.25rem;
        }
    }

    /* Tarjeta de Métodos de Pago */
    .payment-card {
        background: var(--surface, #FFFDF9);
        border: 1.5px solid var(--line, #E3D8C8);
        border-radius: 18px;
        padding: 2rem;
        color: var(--text, #1C1416);
        box-shadow: 0 14px 32px -8px rgba(44, 10, 18, 0.06);
        width: 100%;
        max-width: 100%;
        min-width: 0;
        box-sizing: border-box;
        overflow: hidden;
    }
    :root[data-theme="dark"] .payment-card {
        background: rgba(30, 10, 16, 0.85);
        border-color: rgba(200, 151, 58, 0.25);
        color: #FFFDF9;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45);
    }
    .methods-nav {
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 0.65rem;
        margin-bottom: 1.75rem;
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
    }
    @@media (max-width: 900px) {
        .methods-nav {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 0.5rem;
        }
    }
    @@media (max-width: 480px) {
        .methods-nav {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }
    .method-tab {
        background: var(--surface-2, #EFE6D8);
        border: 1.5px solid var(--line-2, #D4C6B2);
        color: var(--text, #1C1416);
        padding: 0.75rem 0.35rem;
        border-radius: 14px;
        font-size: 0.78rem;
        font-weight: 700;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        text-align: center;
        min-height: 82px;
    }
    :root[data-theme="dark"] .method-tab {
        background: rgba(255, 253, 249, 0.05);
        border-color: rgba(255, 253, 249, 0.12);
        color: #FFFDF9;
    }
    .method-tab:hover {
        background: rgba(200, 151, 58, 0.15);
        border-color: #C8973A;
        transform: translateY(-2px);
    }
    .method-tab.active {
        background: linear-gradient(135deg, rgba(200, 151, 58, 0.18), rgba(107, 30, 46, 0.25));
        border-color: #C8973A;
        color: var(--brand, #6B1E2E);
        box-shadow: 0 4px 18px rgba(200, 151, 58, 0.28);
        outline: 2px solid #C8973A;
    }
    :root[data-theme="dark"] .method-tab.active {
        color: #FFFDF9;
        background: linear-gradient(135deg, rgba(200, 151, 58, 0.25), rgba(107, 30, 46, 0.5));
    }
    .method-tab svg,
    .method-tab-logo {
        height: 26px;
        max-width: 48px;
        display: block;
        transition: transform 0.2s ease;
    }
    .method-tab:hover svg,
    .method-tab:hover .method-tab-logo {
        transform: scale(1.08);
    }

    /* Formularios de método */
    .method-pane {
        display: none;
        animation: fadeInPane 0.25s ease forwards;
    }
    .method-pane.active {
        display: block;
    }
    @@keyframes fadeInPane {
        from { opacity: 0; transform: translateY(6px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Visualización interactiva de tarjeta */
    .card-visual {
        background: linear-gradient(135deg, #1C050B 0%, #4A121F 50%, #150307 100%);
        border: 1px solid rgba(200, 151, 58, 0.45);
        border-radius: 14px;
        padding: 1.5rem;
        color: #FFFDF9;
        margin-bottom: 1.75rem;
        position: relative;
        overflow: hidden;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.6), inset 0 1px 1px rgba(255, 255, 255, 0.2);
    }
    .card-visual::after {
        content: "";
        position: absolute;
        top: -50%;
        right: -20%;
        width: 200px;
        height: 200px;
        background: radial-gradient(circle, rgba(200, 151, 58, 0.25) 0%, transparent 70%);
        pointer-events: none;
    }
    .cv-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.75rem;
    }
    .cv-chip {
        width: 38px;
        height: 28px;
        background: linear-gradient(135deg, #FFD700, #DAA520);
        border-radius: 6px;
        border: 1px solid rgba(0,0,0,0.3);
    }
    .cv-brand {
        font-weight: 800;
        font-size: 1.15rem;
        letter-spacing: 0.05em;
        color: #C8973A;
    }
    .cv-number {
        font-family: 'Geist Mono', monospace;
        font-size: 1.25rem;
        letter-spacing: 0.15em;
        margin-bottom: 1.25rem;
        text-shadow: 0 2px 4px rgba(0,0,0,0.6);
    }
    .cv-bottom {
        display: flex;
        justify-content: space-between;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: rgba(255, 253, 249, 0.85);
    }

    .form-group-pago {
        margin-bottom: 1.2rem;
    }
    .form-group-pago label {
        display: block;
        font-size: 0.82rem;
        font-weight: 700;
        color: var(--brand, #6B1E2E);
        margin-bottom: 0.4rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
    :root[data-theme="dark"] .form-group-pago label { color: #F0E2D2; }
    .input-pago {
        width: 100%;
        background: var(--surface-2, #EFE6D8);
        border: 1.5px solid var(--line-2, #D4C6B2);
        color: var(--text, #1C1416);
        border-radius: 10px;
        padding: 0.75rem 1rem;
        font-size: 0.92rem;
        transition: border-color 0.16s ease, box-shadow 0.16s ease;
    }
    :root[data-theme="dark"] .input-pago {
        background: rgba(255, 253, 249, 0.07);
        border-color: rgba(255, 253, 249, 0.2);
        color: #FFFDF9;
    }
    .input-pago:focus {
        outline: none;
        border-color: var(--brand, #6B1E2E);
        background: #FFFDF9;
        box-shadow: 0 0 0 3px rgba(107, 30, 46, 0.18);
    }
    :root[data-theme="dark"] .input-pago:focus {
        border-color: #C8973A;
        background: rgba(255, 253, 249, 0.12);
        box-shadow: 0 0 0 3px rgba(200, 151, 58, 0.25);
    }
    .input-pago option {
        background: var(--surface, #FFFDF9);
        color: var(--text, #1C1416);
    }
    :root[data-theme="dark"] .input-pago option {
        background: #18060A;
        color: #FFFDF9;
    }

    /* Resumen de orden */
    .summary-card {
        background: var(--surface, #FFFDF9);
        border: 1.5px solid var(--line, #E3D8C8);
        border-radius: 18px;
        padding: 1.75rem;
        box-shadow: 0 14px 32px -8px rgba(44, 10, 18, 0.06);
        position: sticky;
        top: 24px;
        color: var(--text, #1C1416);
    }
    :root[data-theme="dark"] .summary-card {
        background: rgba(30, 10, 16, 0.85);
        border-color: rgba(200, 151, 58, 0.25);
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45);
        color: #FFFDF9;
    }
    .summary-title {
        font-family: 'Instrument Serif', Georgia, serif;
        font-size: 1.6rem;
        font-weight: 400;
        margin: 0 0 1rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid var(--line, #E3D8C8);
        color: var(--brand, #6B1E2E);
    }
    :root[data-theme="dark"] .summary-title {
        border-bottom-color: rgba(200, 151, 58, 0.2);
        color: #FFFDF9;
    }
    .summary-item {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: 0.6rem 0;
        font-size: 0.88rem;
        border-bottom: 1px dashed var(--line, #E3D8C8);
    }
    :root[data-theme="dark"] .summary-item {
        border-bottom-color: rgba(255, 253, 249, 0.1);
    }
    .summary-item:last-child {
        border-bottom: none;
    }
    .summary-total {
        margin-top: 1.25rem;
        padding-top: 1rem;
        border-top: 2px solid #C8973A;
        display: flex;
        justify-content: space-between;
        align-items: baseline;
    }
    .summary-total .val {
        font-family: 'Instrument Serif', Georgia, serif;
        font-size: 2rem;
        color: #C8973A;
        font-weight: 700;
    }

    .btn-pagar-now {
        width: 100%;
        background: linear-gradient(135deg, #C8973A, #A67520);
        color: #18060A;
        font-size: 1rem;
        font-weight: 700;
        padding: 0.95rem;
        border: none;
        border-radius: 12px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.65rem;
        box-shadow: 0 8px 25px rgba(200, 151, 58, 0.35);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        margin-top: 1.5rem;
    }
    .btn-pagar-now:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 30px rgba(200, 151, 58, 0.5);
    }
    .security-badge {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        color: var(--muted, #6E5D53);
        font-size: 0.75rem;
        margin-top: 1.25rem;
        text-align: center;
    }
    :root[data-theme="dark"] .security-badge { color: rgba(255, 253, 249, 0.65); }

    .btn-fill-demo {
        background: rgba(200, 151, 58, 0.12);
        border: 1px dashed #C8973A;
        color: var(--brand, #6B1E2E);
        padding: 0.35rem 0.75rem;
        border-radius: 8px;
        font-size: 0.75rem;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        margin-bottom: 1rem;
        transition: all 0.16s ease;
    }
    :root[data-theme="dark"] .btn-fill-demo { color: #F0E2D2; }
    .btn-fill-demo:hover {
        background: rgba(200, 151, 58, 0.25);
    }
    .pago-grid-2 {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
    }
    .pago-grid-3 {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
    }
    .summary-card {
        width: 100%;
        max-width: 100%;
        min-width: 0;
        box-sizing: border-box;
    }
    .input-pago {
        box-sizing: border-box;
        max-width: 100%;
        min-width: 0;
    }
    @@media (max-width: 600px) {
        .checkout-hero {
            padding: 1.25rem 0.85rem 3.5rem;
            overflow-x: hidden;
            box-sizing: border-box;
        }
        .payment-card,
        .summary-card {
            padding: 1.25rem 1rem;
            border-radius: 14px;
            position: static;
        }
        .pago-grid-2,
        .pago-grid-3 {
            grid-template-columns: minmax(0, 1fr);
            gap: 0.75rem;
        }
        .cv-number {
            font-size: 1rem;
            letter-spacing: 0.08em;
        }
    }
</style>

<div class="checkout-hero">
    <div class="checkout-container">

        <div class="checkout-header">
            <div class="checkout-tag">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                Pasarela Cifrada SSL 256-Bit
            </div>
            <h1 class="checkout-title">Completar <span>Pago Seguro</span></h1>
            <p style="color:var(--muted, #6E5D53);font-size:0.95rem;margin:0;">
                Elige tu método de preferencia. Aceptamos Pasarela Wompi Bancolombia, Nequi, PSE, Tarjetas y Cobro en Mesa.
            </p>
        </div>

        <form asp-controller="Pago" asp-action="Procesar" method="post" id="formPasarela" onsubmit="return animarProcesamientoPago(event)">
            @Html.AntiForgeryToken()

            <input type="hidden" name="TipoOrigen" value="@Model.TipoOrigen" />
            <input type="hidden" name="OrigenId" value="@Model.OrigenId" />
            <input type="hidden" name="Monto" value="@Model.Monto" />
            <input type="hidden" name="Concepto" value="@Model.Concepto" />
            <input type="hidden" name="MetodoPago" id="hiddenMetodoPago" value="Wompi" />

            <div class="checkout-grid">

                <!-- Columna Izquierda: Métodos de Pago y Datos -->
                <div class="payment-card">

                    <!-- Navegación de Métodos de Pago con Logos Oficiales -->
                    <div class="methods-nav">
                        <button type="button" class="method-tab active" onclick="seleccionarMetodo('Wompi', this)">
                            <svg viewBox="0 0 52 28" class="method-tab-logo" fill="none">
                                <rect width="52" height="28" rx="6" fill="#120A21"/>
                                <path d="M7 8.5 L12 20 C12.6 21.5 14.4 21.5 15 20 L18.5 12.5 L22 20 C22.6 21.5 24.4 21.5 25 20 L30 8.5" stroke="#00E5A3" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
                                <circle cx="34" cy="9.5" r="2.2" fill="#FF4F81"/>
                                <text x="35.5" y="20.5" font-family="'Geist', 'Segoe UI', Arial, sans-serif" font-weight="900" font-size="8.5" fill="#FFFFFF" letter-spacing="-0.4">wompi</text>
                            </svg>
                            <span>Wompi Oficial</span>
                        </button>
                        <button type="button" class="method-tab" onclick="seleccionarMetodo('Tarjeta', this)">
                            <svg viewBox="0 0 48 28" class="method-tab-logo" fill="none">
                                <rect width="48" height="28" rx="6" fill="#141124"/>
                                <circle cx="16" cy="14" r="7.5" fill="#EB001B"/>
                                <circle cx="26" cy="14" r="7.5" fill="#F79E1B" fill-opacity="0.92"/>
                                <path d="M21 9 A7.5 7.5 0 0 1 21 19 A7.5 7.5 0 0 1 21 9 Z" fill="#FF5F00"/>
                                <path d="M34 10 L36.5 18 H38.5 L41 10 H39.5 L37.5 16 L35.5 10 Z" fill="#1A73E8"/>
                            </svg>
                            <span>Tarjeta</span>
                        </button>
                        <button type="button" class="method-tab" onclick="seleccionarMetodo('Nequi', this)">
                            <svg viewBox="0 0 44 28" class="method-tab-logo" fill="none">
                                <rect width="44" height="28" rx="6" fill="#1A0328"/>
                                <path d="M10 7.5 H14.5 L23.5 18 V7.5 H27.5 V20.5 H23 L14 10 V20.5 H10 V7.5 Z" fill="#FFFFFF"/>
                                <rect x="29" y="8" width="4.5" height="4.5" rx="1" fill="#FF2772"/>
                            </svg>
                            <span>Nequi</span>
                        </button>
                        <button type="button" class="method-tab" onclick="seleccionarMetodo('PSE', this)">
                            <svg viewBox="0 0 50 28" class="method-tab-logo" fill="none">
                                <rect width="50" height="28" rx="6" fill="#0B2341"/>
                                <path d="M8 8 C15 5 21 5 28 8" stroke="#FCD116" stroke-width="2" stroke-linecap="round"/>
                                <path d="M9 10.5 C15 8 21 8 27 10.5" stroke="#003893" stroke-width="1.6" stroke-linecap="round"/>
                                <path d="M10 12.5 C15 10.5 21 10.5 26 12.5" stroke="#CE1126" stroke-width="1.6" stroke-linecap="round"/>
                                <text x="18" y="22" font-family="'Arial Black', sans-serif" font-weight="900" font-size="9" fill="#FFFFFF" text-anchor="middle" letter-spacing="-0.3">pse</text>
                                <line x1="32" y1="6" x2="32" y2="22" stroke="rgba(255,255,255,0.25)" stroke-width="1"/>
                                <path d="M37 9 C41 7 45 7 47 9 L44 14 C42 12 39 12 37 14 Z" fill="#FDDA24"/>
                                <path d="M37 15 C39 13 42 13 44 15 L47 20 C45 22 41 22 37 20 Z" fill="#FFFFFF"/>
                            </svg>
                            <span>Bancolombia / PSE</span>
                        </button>
                        <button type="button" class="method-tab" onclick="seleccionarMetodo('Daviplata', this)">
                            <svg viewBox="0 0 44 28" class="method-tab-logo" fill="none">
                                <rect width="44" height="28" rx="6" fill="#ED1C24"/>
                                <path d="M22 6 L14 13 H17 V21 H27 V13 H30 Z" fill="#FFFFFF"/>
                                <path d="M20 15 H24 V21 H20 Z" fill="#ED1C24"/>
                                <circle cx="22" cy="10" r="1.5" fill="#FFD100"/>
                            </svg>
                            <span>Daviplata</span>
                        </button>
                        <button type="button" class="method-tab" onclick="seleccionarMetodo('Efectivo', this)">
                            <svg viewBox="0 0 44 28" class="method-tab-logo" fill="none">
                                <rect width="44" height="28" rx="6" fill="#201115"/>
                                <rect x="8" y="6" width="28" height="16" rx="3" stroke="#C8973A" stroke-width="1.8" fill="rgba(200,151,58,0.12)"/>
                                <circle cx="22" cy="14" r="3.5" stroke="#C8973A" stroke-width="1.6"/>
                                <path d="M12 10V10.1M32 18V18.1" stroke="#C8973A" stroke-width="2" stroke-linecap="round"/>
                            </svg>
                            <span>En Mesa</span>
                        </button>
                    </div>

                    <!-- Datos Generales del Pagador -->
                    <div class="pago-grid-2">
                        <div class="form-group-pago">
                            <label for="pNombre">Nombre del Pagador *</label>
                            <input type="text" name="NombreCliente" id="pNombre" class="input-pago" 
                                   value="@(Model.NombreCliente ?? "Comensal Saborator")" required placeholder="Tu nombre completo" />
                        </div>
                        <div class="form-group-pago">
                            <label for="pDoc">Documento / C.C. *</label>
                            <input type="text" name="Documento" id="pDoc" class="input-pago" value="1020304050" required placeholder="Ej: 1020304050" />
                        </div>
                    </div>

                    <div class="pago-grid-2">
                        <div class="form-group-pago">
                            <label for="pCorreo">Correo Electrónico *</label>
                            <input type="email" name="Correo" id="pCorreo" class="input-pago" 
                                   value="@(Model.Correo ?? "cliente@saborator.com")" required placeholder="Para tu comprobante digital" />
                        </div>
                        <div class="form-group-pago">
                            <label for="pTel">Teléfono / Celular *</label>
                            <input type="tel" name="Telefono" id="pTel" class="input-pago" 
                                   value="@(Model.Telefono ?? "3201234567")" required placeholder="3201234567" />
                        </div>
                    </div>

                    <!-- 0. PANE WOMPI OFICIAL (BANCOLOMBIA) -->
                    <div class="method-pane active" id="paneWompi">
                        <div style="background:rgba(200,151,58,0.1);border:1.5px solid #C8973A;border-radius:16px;padding:1.25rem;margin-bottom:1.25rem;text-align:center;box-sizing:border-box;max-width:100%;">
                            
                            <!-- Logo oficial de Wompi Bancolombia -->
                            <div style="display:inline-flex;align-items:center;justify-content:center;padding:0.75rem 1.5rem;background:#000;border:1.5px solid rgba(255,255,255,0.15);border-radius:12px;margin-bottom:1.25rem;box-shadow:0 8px 24px rgba(0,0,0,0.5);">
                                <svg viewBox="0 0 100 32" style="width:120px;height:38px;" fill="none">
                                    <path d="M6 8 L14 24 L22 8 L30 24 L38 8" stroke="#00E5A3" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"/>
                                    <circle cx="50" cy="16" r="8" fill="#FFF"/>
                                    <path d="M65 8 L65 24 L75 14 L85 24 L85 8" stroke="#FFF" stroke-width="3.5" stroke-linecap="round"/>
                                </svg>
                            </div>

                            <h3 style="font-size:1.3rem;font-weight:800;margin:0 0 0.4rem;color:var(--brand, #6B1E2E);">Pasarela Oficial Wompi Bancolombia</h3>
                            <p style="font-size:0.9rem;max-width:520px;margin:0 auto 1.25rem;line-height:1.5;color:var(--muted, #6E5D53);">
                                Conéctate con la pasarela oficial para procesar transacciones seguras con Nequi, PSE, Tarjetas y Botón Bancolombia:
                            </p>

