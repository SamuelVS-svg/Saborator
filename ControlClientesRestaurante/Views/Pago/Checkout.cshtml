}))
</script>
<script src="~/js/pages/pago-checkout.js" asp-append-version="true"></script>

@* ══ CHECKOUT WOMPI SIMULADO (solo demostración, sin cobro real) ══════════════ *@

<div class="sw-backdrop" id="swBackdrop" role="dialog" aria-modal="true" aria-labelledby="swTitulo">
    <div class="sw-card">
        <div class="sw-head">
            <div><b id="swTitulo">Wompi</b><small>Checkout de demostración &middot; sin cobro real</small></div>
            <button type="button" class="sw-close" onclick="cerrarSimuladorWompi()" aria-label="Cerrar">&times;</button>
        </div>
        <div class="sw-body">
            <div id="swFormulario">
                <div class="sw-total"><span>Total a pagar</span><span>$@Model.Monto.ToString("N0", ControlClientesRestaurante.Models.Formato.Co) COP</span></div>

                <div class="sw-tabs" role="tablist">
                    <button type="button" class="sw-tab active" data-m="Tarjeta" onclick="swMetodo('Tarjeta')">Tarjeta</button>
                    <button type="button" class="sw-tab" data-m="Nequi" onclick="swMetodo('Nequi')">Nequi</button>
                    <button type="button" class="sw-tab" data-m="PSE" onclick="swMetodo('PSE')">PSE</button>
                </div>

                <div id="swTarjeta">
                    <div class="sw-hint">Datos de prueba: <button type="button" onclick="swLlenar('ok')">tarjeta que aprueba</button> &middot; <button type="button" onclick="swLlenar('no')">tarjeta que rechaza</button></div>
                    <div class="sw-field"><label for="swNumero">Número de tarjeta</label><input id="swNumero" inputmode="numeric" maxlength="19" placeholder="4242 4242 4242 4242" autocomplete="off" /></div>
                    <div class="sw-field"><label for="swNombre">Nombre en la tarjeta</label><input id="swNombre" placeholder="Como aparece en la tarjeta" autocomplete="off" /></div>
                    <div class="sw-row">
                        <div class="sw-field"><label for="swExp">Vencimiento</label><input id="swExp" inputmode="numeric" maxlength="5" placeholder="MM/AA" autocomplete="off" /></div>
                        <div class="sw-field"><label for="swCvc">CVC</label><input id="swCvc" inputmode="numeric" maxlength="4" placeholder="123" autocomplete="off" /></div>
                    </div>
                </div>

                <div id="swNequi" style="display:none;">
                    <div class="sw-hint">Datos de prueba: <button type="button" onclick="swLlenar('ok')">número que aprueba</button> &middot; <button type="button" onclick="swLlenar('no')">número que rechaza</button></div>
                    <div class="sw-field"><label for="swCel">Celular Nequi</label><input id="swCel" inputmode="numeric" maxlength="10" placeholder="3991111111" autocomplete="off" /></div>
                </div>

                <div id="swPSE" style="display:none;">
                    <div class="sw-hint">Elige un banco de prueba para aprobar o rechazar el pago.</div>
                    <div class="sw-field"><label for="swBanco">Banco</label>
                        <select id="swBanco">
                            <option value="ok">Banco que aprueba (prueba)</option>
                            <option value="no">Banco que rechaza (prueba)</option>
                        </select>
                    </div>
                    <div class="sw-field"><label for="swPersona">Tipo de persona</label>
                        <select id="swPersona"><option>Natural</option><option>Jurídica</option></select>
                    </div>
                </div>

                <div class="sw-err" id="swErr"></div>
                <button type="button" class="sw-pay" onclick="swPagar()">Pagar $@Model.Monto.ToString("N0", ControlClientesRestaurante.Models.Formato.Co)</button>
            </div>

            <div id="swProcesando" class="sw-state" style="display:none;">
                <div class="sw-spin"></div>
                <div style="font-weight:800;">Procesando tu pago con Wompi&hellip;</div>
                <div style="font-size:.8rem;color:var(--muted,#6E5D53);margin-top:.3rem;">Simulación: no se realiza ningún cobro.</div>
            </div>

            <div id="swResultado" class="sw-state" style="display:none;">
                <div class="sw-result-ico" id="swIco"></div>
                <div style="font-weight:900;font-size:1.1rem;" id="swMsg"></div>
                <div style="font-size:.8rem;color:var(--muted,#6E5D53);margin:.4rem 0 1rem;" id="swSub"></div>
                <button type="button" class="sw-pay" id="swContinuar">Continuar</button>
            </div>
        </div>
    </div>
</div>

<script src="~/js/pages/pago-simulado.js" asp-append-version="true"></script>
