@using ControlClientesRestaurante.Models
@{
    ViewData["Title"] = "Control de Caja & Arqueo de Turno";
    Layout = "_Layout";
    var turnoActivo = ViewBag.TurnoActivo as TurnoCaja;
    var historial = (ViewBag.Historial as List<TurnoCaja>) ?? new List<TurnoCaja>();
    var usuario = (ViewBag.Usuario as string) ?? "Cajero";
}

<style>
    .caja-metric-box {
        background: var(--surface-2, #EFE6D8);
        padding: 1.25rem;
        border-radius: 14px;
        border: 1px solid var(--line, #E2D7C8);
    }
    .caja-total-banner {
        background: rgba(200, 151, 58, 0.14);
        padding: 1.25rem 1.5rem;
        border-radius: 14px;
        border: 1.5px solid var(--gold, #C8973A);
        grid-column: 1 / -1;
    }
    .caja-modal-box {
        max-width: 480px;
        width: 100%;
        padding: 2rem;
        background: var(--surface, #FFFDF9);
        color: var(--text, #1C1416);
        border: 1px solid var(--line, #E2D7C8);
        border-radius: 20px;
        box-shadow: var(--shadow-lg);
    }
</style>

<!-- Encabezado de Caja -->
<div class="pg-header">
    <div>
        <div class="pg-title">
            <span class="pg-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2"/><path d="M6 12h.01M18 12h.01"/></svg>
            </span>
            Arqueo &amp; Control de Caja
        </div>
        <div class="pg-sub">Apertura con base en efectivo, registro de ingresos por canal y cierre de turno conciliado</div>
    </div>

    <div class="d-flex gap-2 flex-wrap">
        <a asp-controller="Factura" asp-action="Index" class="btn-ghost">
            Ver Historial Facturas
        </a>
        <a asp-controller="Pedido" asp-action="Index" class="btn-brand">
            Pedidos en Curso
        </a>
    </div>
</div>

<hr class="div-gold" />

@if (TempData["Mensaje"] != null)
{
    <div class="alert-pro alert-ok mb-4">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        <span>@TempData["Mensaje"]</span>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert-pro alert-err mb-4">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span>@TempData["Error"]</span>
    </div>
}

<!-- Panel de Estado del Turno -->
@if (turnoActivo != null)
{
    <div class="card-pro mb-4" style="padding: 1.75rem; border-radius: 20px;">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 pb-3 mb-3 border-bottom">
            <div class="d-flex align-items-center gap-3">
                <div style="width: 48px; height: 48px; border-radius: 12px; background: var(--success-bg); color: var(--success); display: flex; align-items: center; justify-content: center;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <h2 style="font-size: 1.25rem; font-weight: 800; margin: 0; color: var(--text);">@turnoActivo.CodigoTurno</h2>
                        <span class="badge-pill bp-ok"><span class="dot"></span>TURNO ABIERTO</span>
                    </div>
                    <div style="font-size: 0.82rem; color: var(--muted); margin-top: 2px;">Cajero: <strong style="color: var(--text);">@turnoActivo.UsuarioCajero</strong> · Apertura: @turnoActivo.FechaApertura.ToString("dd/MM/yyyy hh:mm tt")</div>
                </div>
            </div>

            <button type="button" onclick="document.getElementById('modalCerrarCaja').classList.add('show')" class="btn-brand" style="background: var(--danger); border-color: var(--danger);">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                Realizar Arqueo &amp; Cerrar Turno
            </button>
        </div>

        <!-- Métricas en vivo del turno -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem;">
            <div class="caja-metric-box">
                <div style="font-size: 0.76rem; color: var(--muted); text-transform: uppercase; font-weight: 700;">Base Inicial Efectivo</div>
                <div style="font-size: 1.45rem; font-weight: 800; color: var(--text); margin-top: 0.25rem;">$@turnoActivo.MontoInicial.ToString("N0")</div>
                <div style="font-size: 0.74rem; color: var(--muted);">Fondo fijo entregado</div>
            </div>

            <div class="caja-metric-box">
                <div style="font-size: 0.76rem; color: var(--muted); text-transform: uppercase; font-weight: 700;">Ventas en Efectivo</div>
                <div style="font-size: 1.45rem; font-weight: 800; color: var(--success); margin-top: 0.25rem;">$@turnoActivo.VentasEfectivo.ToString("N0")</div>
                <div style="font-size: 0.74rem; color: var(--muted);">Cobrado en caja / mesa</div>
            </div>

            <div class="caja-metric-box">
                <div style="font-size: 0.76rem; color: var(--muted); text-transform: uppercase; font-weight: 700;">Transferencias Digitales</div>
                <div style="font-size: 1.45rem; font-weight: 800; color: var(--info); margin-top: 0.25rem;">$@turnoActivo.VentasTransferencia.ToString("N0")</div>
                <div style="font-size: 0.74rem; color: var(--muted);">Nequi / Daviplata / PSE</div>
            </div>

            <div class="caja-metric-box">
                <div style="font-size: 0.76rem; color: var(--muted); text-transform: uppercase; font-weight: 700;">Ventas Tarjetas (Datáfono)</div>
                <div style="font-size: 1.45rem; font-weight: 800; color: #8B5CF6; margin-top: 0.25rem;">$@turnoActivo.VentasTarjeta.ToString("N0")</div>
                <div style="font-size: 0.74rem; color: var(--muted);">Crédito / Débito</div>
            </div>

            <div class="caja-total-banner">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
                    <div>
                        <div style="font-size: 0.78rem; color: var(--ink); font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em;">Total Efectivo que debe haber en Caja (Base + Cobros)</div>
                        <div style="font-size: 1.85rem; font-weight: 900; color: var(--text); margin-top: 0.2rem;">$@turnoActivo.TotalEfectivoEsperado.ToString("N0") COP</div>
                    </div>
                    <div style="text-align: right;">
                        <div style="font-size: 0.78rem; color: var(--muted); font-weight: 600;">Facturación Total Turno</div>
                        <div style="font-size: 1.35rem; font-weight: 800; color: var(--gold);">$@turnoActivo.TotalVentasSistema.ToString("N0") COP</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <!-- Caja Cerrada: Formulario de Apertura -->
    <div class="card-pro mb-4 text-center" style="padding: 3rem 2rem; border-radius: 20px; max-width: 620px; margin: 0 auto;">
        <div style="width: 64px; height: 64px; border-radius: 16px; background: var(--brand-soft); color: var(--ink); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.25rem auto;">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </div>
        <h2 style="font-size: 1.45rem; font-weight: 800; margin-bottom: 0.5rem; color: var(--text);">No hay un turno de caja abierto</h2>
        <p style="font-size: 0.88rem; color: var(--muted); margin-bottom: 2rem;">
            Para comenzar a facturar pedidos y registrar cobros en el punto de venta, abre un nuevo turno ingresando la base de efectivo inicial.
        </p>

        <form asp-action="Abrir" method="post" style="text-align: left;">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-lbl">Base Inicial en Efectivo ($ COP) *</label>
                <input type="number" step="1000" min="0" name="montoInicial" value="100000" required class="form-control" style="font-size: 1.1rem; font-weight: 700; padding: 0.65rem 0.85rem;" />
                <span style="font-size: 0.74rem; color: var(--muted);">Ejemplo: $100.000 para dar cambio y devueltas.</span>
            </div>

            <div class="mb-4">
                <label class="form-lbl">Observaciones de Apertura (Opcional)</label>
                <input type="text" name="observaciones" placeholder="Ej: Turno Tarde - Caja Principal" class="form-control" style="padding: 0.65rem 0.85rem;" />
            </div>

            <button type="submit" class="btn-brand" style="width: 100%; justify-content: center; padding: 0.85rem; font-size: 1rem; font-weight: 800; border-radius: 12px;">
                🔓 Abrir Turno de Caja
            </button>
        </form>
    </div>
}

<!-- Historial de Turnos y Cierres Anteriores -->
<div class="card-pro" style="padding: 1.5rem; border-radius: 20px; margin-top: 2rem;">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h3 style="font-size: 1.15rem; font-weight: 800; color: var(--text); margin: 0;">Historial de Turnos y Arqueos Recientes</h3>
        <a asp-action="ExportarHistorialTurnosCsv" class="btn-ghost btn-sm-pro">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            <span>Exportar Arqueos (Excel)</span>
        </a>
    </div>
    
    <div class="tbl-wrap" style="border: none; box-shadow: none;">
        <table class="tbl">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Cajero</th>
                    <th>Apertura</th>
                    <th>Cierre</th>
                    <th>Base Inicial</th>
                    <th>Ventas Totales</th>
                    <th>Esperado</th>
                    <th>Declarado</th>
                    <th>Diferencia</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @if (!historial.Any())
                {
                    <tr>
                        <td colspan="10" class="text-center py-4" style="color: var(--muted);">Aún no hay turnos registrados en el sistema.</td>
                    </tr>
                }
                else
                {
                    @foreach (var t in historial)
                    {
                        <tr>
                            <td><strong style="color: var(--ink); font-family: var(--font-mono);">@t.CodigoTurno</strong></td>
                            <td style="font-weight: 600; color: var(--text);">@t.UsuarioCajero</td>
                            <td style="color: var(--muted); font-size: 0.82rem;">@t.FechaApertura.ToString("dd/MM/yyyy HH:mm")</td>
                            <td style="color: var(--muted); font-size: 0.82rem;">@(t.FechaCierre?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                            <td style="color: var(--text);">$@t.MontoInicial.ToString("N0")</td>
                            <td style="font-weight: 700; color: var(--text);">$@t.TotalVentasSistema.ToString("N0")</td>
                            <td style="color: var(--text);">$@t.TotalEfectivoEsperado.ToString("N0")</td>
                            <td style="font-weight: 600; color: var(--text);">@(t.EfectivoRealDeclarado.HasValue ? $"${t.EfectivoRealDeclarado.Value:N0}" : "—")</td>
                            <td>
                                @if (t.Diferencia.HasValue)
                                {
                                    if (t.Diferencia.Value == 0)
                                    {
                                        <span style="color: var(--success); font-weight: 700;">Exacto ($0)</span>
                                    }
                                    else if (t.Diferencia.Value > 0)
                                    {
                                        <span style="color: var(--info); font-weight: 700;">+$@t.Diferencia.Value.ToString("N0") (Sobrante)</span>
                                    }
                                    else
                                    {
                                        <span style="color: var(--danger); font-weight: 700;">-$@Math.Abs(t.Diferencia.Value).ToString("N0") (Faltante)</span>
                                    }
                                }
                                else
                                {
                                    <span style="color: var(--muted);">—</span>
                                }
                            </td>
                            <td>
                                @if (t.Estado == "Abierto")
                                {
                                    <span class="badge-pill bp-ok"><span class="dot"></span>Abierto</span>
                                }
                                else
                                {
                                    <span class="badge-pill bp-muted"><span class="dot"></span>Cerrado</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Cierre de Turno y Arqueo Físico -->
@if (turnoActivo != null)
{
    <div class="rec-overlay" id="modalCerrarCaja">
        <div class="caja-modal-box">
            <h3 style="font-size: 1.3rem; font-weight: 800; color: var(--text); margin-bottom: 0.35rem;">Arqueo y Cierre de Turno</h3>
            <p style="font-size: 0.82rem; color: var(--muted); margin-bottom: 1.5rem;">
                Cuenta físicamente todos los billetes y monedas que tienes en la gaveta y digita el total real.
            </p>

            <form asp-action="Cerrar" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="turnoId" value="@turnoActivo.Id" />

                <div style="background: rgba(200, 151, 58, 0.14); border: 1px solid rgba(200, 151, 58, 0.35); border-radius: 12px; padding: 1rem; margin-bottom: 1.25rem;">
                    <div style="font-size: 0.75rem; color: var(--ink); font-weight: 700; text-transform: uppercase;">Efectivo Esperado según Sistema:</div>
                    <div style="font-size: 1.5rem; font-weight: 900; color: var(--text);">$@turnoActivo.TotalEfectivoEsperado.ToString("N0") COP</div>
                    <div style="font-size: 0.74rem; color: var(--muted);">Base inicial ($@turnoActivo.MontoInicial.ToString("N0")) + Ventas efectivo ($@turnoActivo.VentasEfectivo.ToString("N0"))</div>
                </div>

                <div class="mb-3">
                    <label class="form-lbl">Efectivo Real en Gaveta ($ COP) *</label>
                    <input type="number" step="1000" min="0" name="efectivoDeclarado" required class="form-control" placeholder="Ej: 350000" style="font-size: 1.1rem; font-weight: 700; padding: 0.65rem 0.85rem;" />
                </div>

                <div class="mb-4">
                    <label class="form-lbl">Nota de Cierre</label>
                    <input type="text" name="observacionesCierre" placeholder="Ej: Turno cuadrado sin novedades" class="form-control" style="padding: 0.65rem 0.85rem;" />
                </div>

                <div class="d-flex gap-2">
                    <button type="button" onclick="document.getElementById('modalCerrarCaja').classList.remove('show')" class="btn-ghost" style="flex: 1; justify-content: center; padding: 0.75rem;">
                        Cancelar
                    </button>
                    <button type="submit" class="btn-brand" style="flex: 2; justify-content: center; padding: 0.75rem; background: var(--danger); border-color: var(--danger); font-weight: 800;">
                        Confirmar Cierre de Caja
                    </button>
                </div>
            </form>
        </div>
    </div>
}
