@model List<ControlClientesRestaurante.Models.Cliente>
@{ ViewData["Title"] = "Clientes"; }

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-0">
    <div class="pg-header">
        <div class="pg-icon">
            <svg viewBox="0 0 24 24" fill="none"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <div>
            <div class="pg-title">Clientes</div>
            <div class="pg-sub">Gestión de clientes del restaurante</div>
        </div>
    </div>
    <a asp-action="Create" class="btn-gold" style="gap:.4rem;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Nuevo cliente
    </a>
</div>
<hr class="div-gold" />

@if (Model == null || !Model.Any())
{
    <div class="card-pro text-center py-5" style="color:var(--c-muted);">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" style="margin-bottom:.75rem;opacity:.3;"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
        <p style="font-weight:600;font-size:1rem;margin-bottom:.25rem;">No hay clientes registrados.</p>
        <p style="font-size:.875rem;">Agrega el primero con <strong>+ Nuevo cliente</strong>.</p>
    </div>
}
else
{
    <div class="tbl-wrap">
        <table id="tablaClientes">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Documento</th>
                    <th>Teléfono</th>
                    <th>Correo</th>
                    <th style="width:100px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td><strong>@c.Nombre</strong></td>
                        <td style="color:var(--c-muted);font-family:monospace;font-size:.82rem;">@c.Documento</td>
                        <td style="color:var(--c-muted);">@c.Telefono</td>
                        <td style="color:var(--c-muted);font-size:.82rem;">@(c.Correo ?? "—")</td>
                        <td>
                            <a asp-action="Edit" asp-route-codigo="@c.Codigo"
                               class="btn-ghost" style="padding:.28rem .65rem;font-size:.76rem;gap:.3rem;">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                Editar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div style="font-size:.73rem;color:var(--c-muted);margin-top:.5rem;text-align:right;">
        <span id="conteo">@Model.Count</span> cliente(s)
    </div>
}

<!-- Modal cliente registrado -->
@if (TempData["ClienteCreado"]?.ToString() == "true")
{
    <div class="modal-overlay show" id="modalCreado">
        <div class="modal-box">
            <div class="modal-icon ok">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <h2 style="font-family:'Playfair Display',serif;font-size:1.2rem;margin-bottom:.35rem;color:var(--c-dark);">
                Cliente registrado
            </h2>
            <p style="color:var(--c-muted);font-size:.875rem;margin-bottom:1.4rem;">
                <strong>@TempData["NombreClienteCreado"]</strong> fue agregado correctamente al sistema.
            </p>
            <button onclick="document.getElementById('modalCreado').classList.remove('show')"
                    class="btn-gold" style="width:100%;justify-content:center;">
                Entendido
            </button>
        </div>
    </div>
}
