                    <div class="no-items" id="noItems">Sin productos seleccionados</div>
                </div>

                <div class="res-total">
                    <span>TOTAL</span>
                    <span id="totalMostrar" class="res-total-val">$0</span>
                </div>

                <button type="submit" class="btn-resumen-submit" id="btnEnviar" disabled>
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 2L11 13"/><path d="M22 2L15 22 11 13 2 9l20-7z"/></svg>
                    <span>Enviar pedido</span>
                </button>

                <a asp-action="MisPedidos" class="btn-resumen-sec">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/></svg>
                    <span>Ver mis pedidos</span>
                </a>
            </div>
        </div>
    </div>

    <div id="hiddenFields"></div>
</form>

@section Scripts {
<script>
var sel = {};
var mesaNum = null;
var btnAnterior = null;

function seleccionarMesa(num) {
    // Deseleccionar anterior
    if (btnAnterior) {
        btnAnterior.classList.remove('seleccionada');
        btnAnterior.classList.add('libre');
    }
    mesaNum = num;
    var btn = document.getElementById('mesa-btn-' + num);
    btn.classList.remove('libre');
    btn.classList.add('seleccionada');
    btnAnterior = btn;

    document.getElementById('mesaSeleccionada').value = num;
    var info = document.getElementById('mesaInfo');
    info.className = 'mesa-badge';
    info.innerHTML = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20 6L9 17l-5-5"/></svg><span>Mesa ' + num + ' seleccionada</span>';
    actualizarBoton();
}

function toggleItem(id, precio, nombre, max) {
    if (sel[id]) {
        delete sel[id];
        document.getElementById('card-' + id).classList.remove('selected');
        document.getElementById('qty-' + id).textContent = '1';
    } else {
        if (max === 0) { alert('Producto sin stock disponible.'); return; }
        sel[id] = { precio, cantidad: 1, max, nombre };
        document.getElementById('card-' + id).classList.add('selected');
    }
    recalc();
}

function cambiarCant(id, delta, max, e) {
    if (e) e.stopPropagation();
    if (!sel[id]) return;
    var n = sel[id].cantidad + delta;
    if (n < 1) n = 1;
    if (n > sel[id].max) n = sel[id].max;
    sel[id].cantidad = n;
    document.getElementById('qty-' + id).textContent = n;
    recalc();
}

function recalc() {
    var ids = Object.keys(sel);
    var html = '';
    var total = 0;

    if (ids.length === 0) {
        document.getElementById('noItems').style.display = 'block';
    } else {
        document.getElementById('noItems').style.display = 'none';
        ids.forEach(function(id) {
            var it = sel[id];
            var sub = it.precio * it.cantidad;
            total += sub;
            html += '<div class="res-row">'
                  + '<span class="res-row-name"><span class="res-qty-pill">' + it.cantidad + 'x</span>' + it.nombre + '</span>'
                  + '<span style="color:#FFFDF9;font-weight:700;">$' + fmt(sub) + '</span></div>';
        });
    }

    document.getElementById('resumenItems').innerHTML =
        '<div class="no-items" id="noItems" style="display:' + (ids.length ? 'none':'block') + '">Sin productos seleccionados</div>' + html;
    document.getElementById('totalMostrar').textContent = '$' + fmt(total);

    var cont = document.getElementById('hiddenFields');
    cont.innerHTML = '';
    ids.forEach(function(id) {
        cont.innerHTML +=
            '<input type="hidden" name="productoIds" value="' + id + '" />'
          + '<input type="hidden" name="cantidades"  value="' + sel[id].cantidad + '" />'
          + '<input type="hidden" name="notasLineas" value="" />';
    });

    actualizarBoton();
}

function actualizarBoton() {
    var btn = document.getElementById('btnEnviar');
    btn.disabled = (Object.keys(sel).length === 0 || mesaNum === null);
}

function fmt(n) { return Math.round(n).toLocaleString('es-CO'); }

// Validar antes de enviar
document.getElementById('formPedido').addEventListener('submit', function(e) {
    if (!mesaNum) {
        e.preventDefault();
        alert('Debes seleccionar una mesa.');
        return;
    }
    if (Object.keys(sel).length === 0) {
        e.preventDefault();
        alert('Agrega al menos un producto.');
    }
});

@if (ViewBag.MesaPreseleccionada != null)
{
    <text>
    document.addEventListener('DOMContentLoaded', function() {
        var preMesa = parseInt('@ViewBag.MesaPreseleccionada', 10);
        if (preMesa) {
            var btn = document.getElementById('mesa-btn-' + preMesa);
            if (btn && btn.classList.contains('libre')) {
                seleccionarMesa(preMesa);
            }
        }
    });
    </text>
}
</script>
}
