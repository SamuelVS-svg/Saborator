@{ ViewData["Title"] = "Tomar pedido"; }
@{
    var mesas = ViewBag.Mesas as List<ControlClientesRestaurante.Models.Mesa> ?? new();
    int libres   = mesas.Count(m => m.Estado == "Libre");
    int ocupadas = mesas.Count(m => m.Estado == "Ocupada");
}

<div class="pg-header">
    <div class="pg-icon">
        <svg viewBox="0 0 24 24" fill="none"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1" ry="1"/><line x1="9" y1="12" x2="15" y2="12"/><line x1="9" y1="16" x2="13" y2="16"/></svg>
    </div>
    <div>
        <div class="pg-title">Tomar pedido</div>
        <div class="pg-sub" style="display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;margin-top:.35rem;">
            <span class="pg-sub-pill"><span class="txt-ok">@libres libres</span></span>
            <span class="pg-sub-pill"><span class="txt-err">@ocupadas ocupadas</span></span>
            <span class="pg-sub-pill">30 mesas</span>
        </div>
    </div>
</div>
<hr class="div-gold" />

<style>
    .pedido-grid { display:grid; grid-template-columns:1fr 370px; gap:1.75rem; align-items:start; }
    @@media(max-width:900px){ .pedido-grid{ grid-template-columns:1fr; } }

    /* Mapa de mesas */
    .mesas-grid {
        display:grid;
        grid-template-columns:repeat(6,1fr);
        gap:.6rem;
        margin-bottom:.85rem;
    }
    @@media(max-width:480px){ .mesas-grid{ grid-template-columns:repeat(5,1fr); } }

    .mesa-btn {
        aspect-ratio:1;
        border-radius:var(--r-control);
        border:1.5px solid transparent;
        display:flex; flex-direction:column;
        align-items:center; justify-content:center;
        font-size:.72rem; font-weight:700;
        cursor:pointer;
        transition:transform 140ms var(--ease), background-color 160ms var(--ease), border-color 160ms var(--ease), box-shadow 180ms var(--ease);
        user-select:none; position:relative;
        line-height:1.2;
        font-variant-numeric: tabular-nums;
    }
    .mesa-btn svg { width:22px; height:22px; margin-bottom:.2rem; flex-shrink:0; }
    .mesa-btn.libre {
        background:var(--color-success-bg); border-color:var(--color-success); color:var(--color-text);
    }
    @@media (hover: hover) and (pointer: fine) {
        .mesa-btn.libre:hover {
            background:var(--color-success-bg-hover);
            transform:translateY(-1px) scale(1.03);
            box-shadow:var(--shadow-sm);
        }
    }
    .mesa-btn.libre:active { transform:scale(0.95); }
    .mesa-btn.ocupada {
        background:var(--surface-2); border-color:var(--line-2); color:var(--muted);
        cursor:not-allowed; opacity:.75;
    }
    .mesa-btn.reservada {
        background:#FFFBEB; border-color:#FDE68A; color:#B45309;
        cursor:not-allowed; opacity:.85;
    }
    .mesa-btn.limpieza {
        background:#F0F9FF; border-color:#BAE6FD; color:#0369A1;
        cursor:not-allowed; opacity:.85;
    }
    [data-theme="dark"] .mesa-btn.reservada {
        background:#3B2A10; border-color:#78350F; color:#FCD34D;
    }
    [data-theme="dark"] .mesa-btn.limpieza {
        background:#0C3247; border-color:#0369A1; color:#7DD3FC;
    }
    .mesa-btn.seleccionada {
        background:var(--color-brand); border-color:var(--on-brand); color:var(--color-on-brand);
        box-shadow:0 0 0 3px var(--brand-soft);
        transform:scale(1.05);
    }

    /* Leyenda */
    .mesa-leyenda { display:flex; gap:.65rem; font-size:.78rem; margin-bottom:1.1rem; flex-wrap:wrap; color:var(--text); }
    .mesa-leyenda > span {
        display:inline-flex; align-items:center; gap:.5rem; font-weight:600;
        background:var(--surface-2); border:1px solid var(--line-2);
        padding:.28rem .85rem; border-radius:9999px; box-shadow:var(--shadow-sm);
    }
    .mesa-leyenda .dot {
        width:10px; height:10px; min-width:10px; min-height:10px;
        border-radius:50%; padding:0 !important; border:none !important;
        display:inline-block; flex-shrink:0;
    }
    .dot-libre    { background:var(--success) !important; box-shadow:0 0 0 2px var(--success-bg); }
    .dot-ocupada  { background:var(--muted) !important; }
    .dot-selected { background:var(--brand) !important; box-shadow:0 0 0 2px var(--brand-soft); }

    /* Menú productos */
    .menu-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(145px,1fr)); gap:.75rem; }
    .menu-card {
        background:var(--surface);
        border:1px solid var(--line);
        border-radius:var(--r-control);
        padding:1rem .85rem;
        cursor:pointer;
        text-align:center;
        transition:border-color 160ms var(--ease), box-shadow 180ms var(--ease), transform 140ms var(--ease), background-color 160ms var(--ease);
        user-select:none;
        box-shadow:var(--shadow-sm), var(--shadow-inner);
    }
    @@media (hover: hover) and (pointer: fine) {
        .menu-card:hover {
            border-color:var(--color-brand);
            transform:translateY(-2px);
            box-shadow:var(--shadow-md), var(--shadow-inner);
        }
    }
    .menu-card:active { transform:scale(0.97); }
    .menu-card.selected {
        border-color:var(--color-brand);
        background:var(--brand-soft);
        box-shadow:0 0 0 2px var(--brand);
    }
    .menu-card .m-ico  { width:44px; height:44px; margin:0 auto .4rem; display:flex; align-items:center; justify-content:center; }
    .menu-card .m-name { font-weight:600; font-size:.82rem; color:var(--color-text); line-height:1.3; }
    .menu-card .m-price{ font-size:.78rem; color:var(--color-brand); font-weight:700; margin-top:.2rem; font-variant-numeric:tabular-nums; }
    .menu-card .m-qty  { display:none; margin-top:.55rem; align-items:center; justify-content:center; gap:.45rem; }
    .menu-card.selected .m-qty { display:flex; }
    .qty-btn {
        width:24px; height:24px; border-radius:50%;
        border:1.5px solid var(--line-2); background:var(--surface);
        color:var(--color-text); font-weight:700; cursor:pointer; font-size:.82rem;
        display:flex; align-items:center; justify-content:center;
        transition:background-color 140ms var(--ease), border-color 140ms var(--ease), color 140ms var(--ease), transform 120ms var(--ease);
    }
    .qty-btn:hover { background:var(--color-brand); border-color:var(--color-brand); color:var(--color-on-brand); }
    .qty-btn:active { transform:scale(0.9); }
    .qty-num { font-weight:700; font-size:.88rem; min-width:18px; text-align:center; font-variant-numeric:tabular-nums; }

    /* Menú con imagen de fondo */
    .menu-card.has-bg {
        background-size: cover !important;
        background-position: center !important;
        background-repeat: no-repeat !important;
        position: relative;
        overflow: hidden;
        color: #FFFDF9;
        border-color: rgba(200, 151, 58, 0.45);
        min-height: 140px;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.2);
    }
    .menu-card.has-bg::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(24, 6, 10, 0.15) 0%, rgba(24, 6, 10, 0.65) 50%, rgba(24, 6, 10, 0.94) 100%);
        transition: background 180ms ease;
        z-index: 1;
        border-radius: inherit;
    }
    .menu-card.has-bg:hover::before {
        background: linear-gradient(180deg, rgba(24, 6, 10, 0.08) 0%, rgba(24, 6, 10, 0.55) 45%, rgba(24, 6, 10, 0.88) 100%);
    }
    .menu-card.has-bg.selected {
        border-color: var(--gold, #C8973A);
        box-shadow: 0 0 0 2.5px var(--gold, #C8973A), 0 8px 22px rgba(107, 30, 46, 0.4);
    }
    .menu-card.has-bg.selected::before {
        background: linear-gradient(180deg, rgba(107, 30, 46, 0.35) 0%, rgba(107, 30, 46, 0.78) 50%, rgba(74, 18, 30, 0.96) 100%);
    }
    .menu-card.has-bg > * {
        position: relative;
        z-index: 2;
    }
    .menu-card.has-bg .m-name {
        color: #FFFDF9 !important;
        text-shadow: 0 1px 4px rgba(0, 0, 0, 0.9);
        font-weight: 700;
    }
    .menu-card.has-bg .m-price {
        color: #F6C878 !important;
        text-shadow: 0 1px 4px rgba(0, 0, 0, 0.9);
        font-weight: 700;
    }
    .menu-card.has-bg .m-ico {
        opacity: 0;
        height: 12px;
        margin: 0;
    }
    .menu-card.has-bg .qty-btn {
        background: rgba(255, 253, 249, 0.95);
        color: var(--brand, #6B1E2E);
        border-color: transparent;
    }
    .menu-card.has-bg .qty-num {
        color: #FFFDF9;
        text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9);
    }

    /* Panel resumen */
    .resumen-panel { position:sticky; top:calc(var(--top-h) + 1.25rem); }
    .resumen-box {
        background:var(--brand);
        border:1px solid rgba(255,253,249,0.18);
        border-radius:var(--r-card);
        padding:1.6rem;
        color:var(--on-brand);
        box-shadow:var(--shadow-lg);
    }
    .resumen-title {
        font-family:var(--font-serif);
        font-style:italic;
        font-size:1.25rem;
        color:#FFFDF9;
        margin-bottom:.75rem;
        display:flex;
        align-items:center;
        justify-content:space-between;
    }
    .res-row {
        display:flex; justify-content:space-between; align-items:center;
        padding:.5rem 0; font-size:.875rem; border-bottom:1px solid rgba(255,253,249,0.12);
        font-variant-numeric:tabular-nums;
    }
    .res-row:last-of-type { border:none; }
    .res-row-name { display:flex; align-items:center; gap:.45rem; color:#FFFDF9; font-weight:500; }
    .res-qty-pill {
        background:rgba(255,253,249,0.22); color:#FFFDF9; font-size:.72rem;
        font-weight:700; padding:.12rem .48rem; border-radius:9999px;
    }
    .res-total {
        display:flex; justify-content:space-between; align-items:baseline;
        font-size:1.15rem; font-weight:700; color:#FFFDF9;
        border-top:1.5px solid var(--gold); margin-top:.85rem; padding-top:.95rem;
        font-variant-numeric:tabular-nums;
    }
    .res-total-val { color:var(--gold); font-size:1.35rem; font-weight:700; }
    .no-items { text-align:center; color:rgba(245,239,230,0.70); font-size:.84rem; padding:1.2rem 0; }
    .mesa-badge {
        display:flex; align-items:center; justify-content:center; gap:.5rem;
        background:rgba(255,253,249,0.22); color:#FFFDF9;
        border:1.5px solid rgba(255,253,249,0.38);
        border-radius:var(--r-control); padding:.45rem .85rem;
        font-size:.84rem; font-weight:700;
        margin-bottom:.85rem; width:100%; text-align:center;
        box-shadow:inset 0 1px 2px rgba(255,253,249,0.12);
    }
    .mesa-none {
        display:flex; align-items:center; justify-content:center; gap:.5rem;
        background:rgba(0,0,0,0.18); color:rgba(245,239,230,0.70);
        border:1px dashed rgba(255,253,249,0.28);
        border-radius:var(--r-control); padding:.45rem .85rem;
        font-size:.82rem; margin-bottom:.85rem; width:100%; text-align:center;
    }
    .btn-resumen-submit {
        background:var(--surface);
        border:1.5px solid var(--surface);
        color:var(--brand);
        font-weight:700;
        font-size:.92rem;
        padding:.72rem 1.25rem;
        border-radius:var(--r-control);
        display:inline-flex;
        align-items:center;
        justify-content:center;
        gap:.5rem;
        width:100%;
        cursor:pointer;
        box-shadow:0 4px 14px rgba(0,0,0,0.25);
        transition:all 160ms var(--ease);
        margin-top:1rem;
    }
    .btn-resumen-submit:hover:not(:disabled) {
        background:var(--gold);
        border-color:var(--gold);
        color:#1C1416;
        transform:translateY(-2px);
        box-shadow:0 6px 18px rgba(0,0,0,0.30);
    }
    .btn-resumen-submit:active:not(:disabled) { transform:scale(0.97); }
    .btn-resumen-submit:disabled {
        background:rgba(255,253,249,0.12);
        border:1px solid rgba(255,253,249,0.18);
        color:rgba(255,253,249,0.40);
        cursor:not-allowed;
        box-shadow:none;
        transform:none;
    }
    .btn-resumen-sec {
        background:transparent;
        border:1px solid rgba(255,253,249,0.25);
        color:#F5EFE6;
        font-weight:500;
        font-size:.85rem;
        padding:.58rem 1.1rem;
        border-radius:var(--r-control);
        display:inline-flex;
        align-items:center;
        justify-content:center;
        gap:.45rem;
        width:100%;
        text-decoration:none;
        transition:all 160ms var(--ease);
        margin-top:.6rem;
    }
    .btn-resumen-sec:hover {
        background:rgba(255,253,249,0.12);
        border-color:rgba(255,253,249,0.45);
        color:#FFFDF9;
    }
</style>

<form asp-action="Menu" method="post" id="formPedido">
    @Html.AntiForgeryToken()
    <!-- Campo hidden que se llena al seleccionar mesa -->
    <input type="hidden" name="mesa" id="mesaSeleccionada" />

    <div class="pedido-grid">
        <div>
            <!-- Mapa de mesas -->
            <div class="card-pro p-4 mb-3">
                <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                    <div style="font-size:.72rem;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;">
                        Selecciona una mesa
                    </div>
                    <a asp-controller="Mesa" asp-action="Index" class="btn btn-sm" style="font-size:.74rem;padding:.22rem .75rem;border-radius:9999px;background:var(--surface-2);color:var(--brand);border:1px solid var(--line-2);font-weight:600;text-decoration:none;display:inline-flex;align-items:center;gap:4px;">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                        <span>Gestionar Estados de Mesas →</span>
                    </a>
                </div>

                <div class="mesa-leyenda">
                    <span><span class="dot dot-libre"></span> Libre</span>
                    <span><span class="dot dot-ocupada"></span> Ocupada</span>
                    <span><span class="dot" style="background:#F59E0B;"></span> Reservada</span>
                    <span><span class="dot" style="background:#0EA5E9;"></span> Limpieza</span>
                    <span><span class="dot dot-selected"></span> Seleccionada</span>
                </div>

                <div class="mesas-grid">
                    @foreach (var m in mesas)
                    {
                        var esLibre = m.Estado == "Libre";
                        var cls = m.Estado switch {
                            "Libre" => "libre",
                            "Ocupada" => "ocupada",
                            "Reservada" => "reservada",
                            "En Limpieza" => "limpieza",
                            _ => "ocupada"
                        };
                        var title = $"Mesa {m.Numero} — {m.Estado}";
                        <button type="button"
                                class="mesa-btn @cls"
                                id="mesa-btn-@m.Numero"
                                onclick="@(esLibre ? $"seleccionarMesa({m.Numero})" : "")"
                                title="@title">
                            <svg viewBox="0 0 512 512" fill="none" stroke="currentColor" stroke-width="28" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M 42 268 V 132 C 42 110 82 110 82 132 V 268" />
                                <rect x="42" y="268" width="94" height="38" rx="4" />
                                <line x1="42" y1="306" x2="42" y2="405" />
                                <line x1="136" y1="306" x2="136" y2="405" />
                                <path d="M 470 268 V 132 C 470 110 430 110 430 132 V 268" />
                                <rect x="376" y="268" width="94" height="38" rx="4" />
                                <line x1="470" y1="306" x2="470" y2="405" />
                                <line x1="376" y1="306" x2="376" y2="405" />
                                <line x1="256" y1="96" x2="256" y2="114" />
                                <path d="M 196 171 C 196 122 316 122 316 171" />
                                <rect x="116" y="171" width="280" height="48" rx="8" />
                                <line x1="187" y1="219" x2="187" y2="405" />
                                <line x1="325" y1="219" x2="325" y2="405" />
                                <line x1="187" y1="340" x2="325" y2="340" />
                            </svg>
                            @m.Numero
                        </button>
                    }
                </div>
            </div>

            <!-- Datos del cliente -->
            <div class="card-pro p-4 mb-3">
                <div style="font-size:.72rem;font-weight:700;color:var(--c-muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:.75rem;">Datos</div>
                <div class="row g-3">
                    <div class="col-12">
                        <label class="lbl">Nombre del cliente <span class="req">*</span></label>
                        <input type="text" name="nombreCliente" class="form-control" placeholder="Ej: Juan Pérez" required />
                    </div>
                    <div class="col-12">
                        <label class="lbl">Notas generales (opcional)</label>
                        <input type="text" name="notas" class="form-control" placeholder="Ej: Sin cebolla, alergia a nueces…" />
                    </div>
                </div>
            </div>

            <!-- Menú -->
            <div class="card-pro p-4">
                <div style="font-size:.72rem;font-weight:700;color:var(--c-muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:.75rem;">Menú</div>
                <div class="menu-grid" id="menuGrid">
                    @{
                        var prods = ViewBag.Productos as List<ControlClientesRestaurante.Models.Producto> ?? new();
                        var imgMap = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
                        {
                            ["Salchipapa"]          = "/img/salchipapa.jpg",
                            ["Hamburguesa"]         = "/img/hamburguesa.jpg",
                            ["Perro Caliente"]      = "/img/perrocaliente.jpg",
                            ["Papas a la Francesa"] = "/img/papasfrancesa.jpg",
                            ["Coca-Cola"]           = "/img/cocacola.png?v=3",
                            ["Pepsi"]               = "/img/pepsi.webp",
                            ["Agua"]                = "/img/agua.webp"
                        };
                        var svgMap = new Dictionary<string, string>
                        {
