@{
    ViewData["Title"] = "Checkout — Domicilio & Pedidos Online";
    var productos = ViewBag.Productos as List<ControlClientesRestaurante.Models.Producto> ?? new();
    var mesas = ViewBag.Mesas as List<ControlClientesRestaurante.Models.Mesa> ?? new();
    string tipoDefecto = ViewBag.TipoEntregaDefecto as string ?? "Domicilio";
    string usuarioActual = ViewBag.UsuarioActual as string ?? "";
    string nombreUsuario = ViewBag.NombreUsuario as string ?? "";
    bool esCajeroOAdmin = ViewBag.EsCajeroOAdmin == true;
    bool esCliente = ViewBag.EsCliente == true;
}

<div class="checkout-wrapper">

    <!-- Encabezado Gastronómico estilo KFC -->
    <div class="checkout-header">
        <div class="checkout-brand-pill">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            Saborator Domicilios &amp; Para Llevar
        </div>
        <h1 class="checkout-title">Finalizar Tu Pedido</h1>
        <p class="checkout-sub">Elige tu modalidad de entrega, ingresa tus datos y disfruta de la mejor alta cocina en tu puerta o en mesa.</p>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="checkout-alert checkout-alert-err">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <span>@TempData["Error"]</span>
        </div>
    }

    <form asp-controller="Pedido" asp-action="ConfirmarCheckout" method="post" id="formCheckout">
        @Html.AntiForgeryToken()

        <div class="checkout-grid">

            <!-- ══ COLUMNA IZQUIERDA: CONFIGURACIÓN Y DATOS ═════════════ -->
            <div class="checkout-main">

                <!-- 1. MODALIDAD DE ENTREGA (ESTILO KFC) -->
                <div class="checkout-card">
                    <div class="card-step-badge">1</div>
                    <div class="card-head">
                        <h3>Modalidad de Entrega</h3>
                        <p>¿Cómo prefieres recibir tu orden hoy?</p>
                    </div>

                    <div class="delivery-tabs">
                        <label class="delivery-tab @(tipoDefecto == "Domicilio" ? "active" : "")" onclick="cambiarTipoEntrega('Domicilio')">
                            <input type="radio" name="tipoEntrega" value="Domicilio" @(tipoDefecto == "Domicilio" ? "checked" : "") style="display:none;" />
                            <div class="tab-icon">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18.5" cy="17.5" r="3.5"/><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="15" cy="5" r="1"/><path d="M12 17.5V14l-3-3 4-3 2 3h2"/></svg>
                            </div>
                            <span class="tab-title">Domicilio</span>
                            <span class="tab-fee">Envío $5.000 COP</span>
                        </label>

                        <label class="delivery-tab @(tipoDefecto == "ParaLlevar" ? "active" : "")" onclick="cambiarTipoEntrega('ParaLlevar')">
                            <input type="radio" name="tipoEntrega" value="ParaLlevar" @(tipoDefecto == "ParaLlevar" ? "checked" : "") style="display:none;" />
                            <div class="tab-icon">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                            </div>
                            <span class="tab-title">Para Llevar</span>
                            <span class="tab-fee">Sin costo (Gratis)</span>
                        </label>

                        @if (!esCliente)
                        {
                        <label class="delivery-tab @(tipoDefecto == "EnMesa" ? "active" : "")" onclick="cambiarTipoEntrega('EnMesa')">
                            <input type="radio" name="tipoEntrega" value="EnMesa" @(tipoDefecto == "EnMesa" ? "checked" : "") style="display:none;" />
                            <div class="tab-icon">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
                            </div>
                            <span class="tab-title">En Salón / Mesa</span>
                            <span class="tab-fee">Comer en sitio</span>
                        </label>
                        }
                    </div>

                    <!-- Campos de Domicilio -->
                    <div id="seccionDomicilio" class="fields-group" style="@(tipoDefecto == "Domicilio" ? "" : "display:none;")">
                        
                        <!-- Banner Sede de Despacho en Barranquilla con enlace a Google Maps -->
                        <div style="background:rgba(200,151,58,0.12);border:1px solid rgba(200,151,58,0.3);border-radius:12px;padding:0.85rem 1rem;margin-bottom:1.25rem;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.75rem;">
                            <div style="display:flex;align-items:center;gap:0.6rem;">
                                <span style="color:#C8973A;display:inline-flex;">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                </span>
                                <div>
                                    <strong style="color:var(--brand);font-size:0.88rem;">Despachamos desde: Cra 4 Sur # 50D-107</strong>
                                    <div style="font-size:0.78rem;color:var(--muted);">Barranquilla, Atlántico (Sede Central Saborator)</div>
                                </div>
                            </div>
                            <div style="display:flex;gap:0.5rem;align-items:center;">
                                <button type="button" onclick="toggleMapaCheckout()" style="background:none;border:none;color:var(--text, #1C1416);font-size:0.78rem;font-weight:700;cursor:pointer;text-decoration:underline;display:inline-flex;align-items:center;gap:4px;">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"/><line x1="8" y1="2" x2="8" y2="18"/><line x1="16" y1="6" x2="16" y2="22"/></svg>
                                    <span id="btnTxtMapaCheckout">Ver Mapa</span>
                                </button>
                                <a href="https://www.google.com/maps/search/?api=1&query=Cra+4+Sur+%2350D-107,+Barranquilla,+Atlantico" target="_blank" rel="noopener noreferrer" style="font-size:0.8rem;color:#C8973A;font-weight:700;text-decoration:none;display:inline-flex;align-items:center;gap:4px;padding:0.3rem 0.65rem;background:var(--surface, #FFFDF9);border:1px solid #C8973A;border-radius:6px;">
                                    <span>Google Maps</span>
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                                </a>
                            </div>
                        </div>

                        <!-- Iframe de Google Maps colapsable en Checkout -->
                        <div id="contenedorMapaCheckout" style="display:none;margin-bottom:1.25rem;border-radius:12px;overflow:hidden;border:1px solid #C8973A;height:220px;box-shadow:0 4px 14px rgba(60,42,32,0.08);">
                            <iframe 
                                src="https://maps.google.com/maps?q=Cra+4+Sur+%2350D-107,+Barranquilla,+Atlantico&t=&z=16&ie=UTF8&iwloc=&output=embed" 
                                width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade">
                            </iframe>
                        </div>

                        <div class="input-row">
                            <div class="input-col" style="flex:1;">
                                <label class="input-label">Sector / Barrio en Barranquilla *</label>
                                <select id="selectBarrioCheckout" onchange="cambiarBarrioCheckout()" class="input-field" style="font-weight:600;">
                                    <optgroup label="Zona Sur Cercana — $4.000 COP">
                                        <option value="4000|Ciudadela 20 de Julio">Ciudadela 20 de Julio ($4.000)</option>
                                        <option value="4000|La Magdalena">La Magdalena ($4.000)</option>
                                        <option value="4000|Las Cayenas">Las Cayenas ($4.000)</option>
                                        <option value="4000|Simón Bolívar">Simón Bolívar ($4.000)</option>
                                        <option value="4000|Santa María">Santa María ($4.000)</option>
                                        <option value="4000|Carrizal">Carrizal ($4.000)</option>
                                        <option value="4000|Buenos Aires">Buenos Aires ($4.000)</option>
                                        <option value="4000|Las Palmas">Las Palmas ($4.000)</option>
                                        <option value="4000|Los Robles">Los Robles ($4.000)</option>
                                    </optgroup>
                                    <optgroup label="Zona Centro / Suroccidente / Soledad — $6.000 COP">
                                        <option value="6000|San Roque">San Roque ($6.000)</option>
                                        <option value="6000|Rebolo">Rebolo ($6.000)</option>
                                        <option value="6000|Chiquinquirá">Chiquinquirá ($6.000)</option>
                                        <option value="6000|San Felipe">San Felipe ($6.000)</option>
                                        <option value="6000|Bostón">Bostón ($6.000)</option>
                                        <option value="6000|Lucero">Lucero ($6.000)</option>
                                        <option value="6000|Los Pinos">Los Pinos ($6.000)</option>
                                        <option value="6000|El Valle">El Valle ($6.000)</option>
                                        <option value="6000|Cevillar">Cevillar ($6.000)</option>
                                        <option value="6000|Soledad Centro">Soledad Centro / Hipódromo ($6.000)</option>
                                    </optgroup>
                                    <optgroup label="Zona Norte / Riomar / Prado — $9.000 COP (Límite 12 km)">
                                        <option value="9000|El Prado">El Prado ($9.000)</option>
                                        <option value="9000|Alto Prado">Alto Prado ($9.000)</option>
                                        <option value="9000|Riomar">Riomar ($9.000)</option>
                                        <option value="9000|Miramar">Miramar ($9.000)</option>
                                        <option value="9000|Buenavista">Buenavista ($9.000)</option>
                                        <option value="9000|Villa Campestre">Villa Campestre ($9.000)</option>
                                        <option value="9000|Villa Santos">Villa Santos ($9.000)</option>
                                        <option value="9000|Paraíso">Paraíso ($9.000)</option>
                                    </optgroup>
                                    @if (esCajeroOAdmin)
                                    {
                                        <option value="custom|Personalizado">Tarifa o Barrio personalizado...</option>
                                    }
                                </select>
                                <input type="hidden" name="barrio" id="inputBarrio" value="Ciudadela 20 de Julio" />
                                <input type="hidden" name="costoEnvio" id="inputCostoEnvio" value="4000" />
                            </div>

                            @if (esCajeroOAdmin)
                            {
                                <div class="input-col" id="colCustomFeeCheckout" style="display:none;flex:1;">
                                    <label class="input-label">Tarifa acordada (COP) *</label>
                                    <input type="number" id="inputCustomFeeCheckout" class="input-field" placeholder="5000" min="0" step="500" value="5000" oninput="cambiarBarrioCheckout()" />
                                </div>
                            }
                        </div>

                        @if (esCajeroOAdmin)
                        {
                            <!-- PANEL DE TARIFA EDITABLE EXCLUSIVO PARA CAJERO / ADMINISTRADOR -->
                            <div style="background:rgba(200,151,58,0.08);border:1.5px solid rgba(200,151,58,0.3);border-radius:12px;padding:0.9rem 1.1rem;margin-bottom:1.25rem;">
                                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.45rem;flex-wrap:wrap;gap:0.5rem;">
                                    <span style="font-size:0.78rem;font-weight:800;color:var(--brand);text-transform:uppercase;letter-spacing:0.5px;display:inline-flex;align-items:center;gap:5px;">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18.5" cy="17.5" r="3.5"/><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="15" cy="5" r="1"/><path d="M12 17.5V14l-3-3 4-3 2 3h2"/></svg>
                                        Control de Tarifa (Autorizado Cajero / Admin)
                                    </span>
                                    <span id="txtTarifaSugeridaBadge" style="font-size:0.75rem;background:#ECFDF5;color:#065F46;border:1px solid #A7F3D0;padding:2px 8px;border-radius:20px;font-weight:700;">
                                        Zona Sur: $4.000 COP
                                    </span>
                                </div>
                                
                                <div style="display:flex;align-items:center;gap:0.6rem;flex-wrap:wrap;">
                                    <div style="display:flex;align-items:center;background:#FFFDF9;border:1.5px solid #E2D7C8;border-radius:8px;padding:0 0.6rem;height:38px;">
                                        <span style="color:#C8973A;font-weight:800;margin-right:4px;">$</span>
                                        <input type="number" id="inputFeeManualCheckout" value="4000" min="0" step="500" 
                                               style="border:none;background:transparent;width:85px;font-weight:700;font-size:0.95rem;color:var(--brand);outline:none;" 
                                               oninput="modificarTarifaManualCheckout(this.value)" />
                                        <span style="font-size:0.75rem;color:#888;font-weight:600;">COP</span>
                                    </div>

                                    <!-- Botones de Ajuste Rápido para el Cajero -->
                                    <div style="display:flex;gap:4px;flex-wrap:wrap;">
                                        <button type="button" class="btn-chip-tarifa" onclick="fijarTarifaManualCheckout(0)">$0 Cortesía</button>
                                        <button type="button" class="btn-chip-tarifa" onclick="fijarTarifaManualCheckout(4000)">$4k Sur</button>
                                        <button type="button" class="btn-chip-tarifa" onclick="fijarTarifaManualCheckout(6000)">$6k Centro</button>
                                        <button type="button" class="btn-chip-tarifa" onclick="fijarTarifaManualCheckout(9000)">$9k Norte</button>
                                    </div>
                                    <span style="font-size:0.73rem;color:#666;font-style:italic;">(Tarifa editable sólo por personal de caja)</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <!-- PANEL DE TARIFA OFICIAL FIJA PARA CLIENTE COMENSAL -->
                            <div style="background:rgba(200,151,58,0.06);border:1px solid rgba(200,151,58,0.25);border-radius:12px;padding:0.85rem 1rem;margin-bottom:1.25rem;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.6rem;">
                                <div style="display:flex;align-items:center;gap:0.5rem;">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C8973A" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                                    <div>
                                        <strong style="color:var(--brand);font-size:0.85rem;display:block;">Tarifa Oficial por Zona</strong>
                                        <span style="font-size:0.76rem;color:var(--muted);">Calculada según el sector de Barranquilla (tarifa auditada y protegida).</span>
                                    </div>
                                </div>
                                <span id="txtTarifaSugeridaBadge" style="font-size:0.85rem;background:#ECFDF5;color:#065F46;border:1px solid #A7F3D0;padding:4px 10px;border-radius:20px;font-weight:700;">
                                    Zona Sur: $4.000 COP
                                </span>
                            </div>
                        }

                        <div class="input-row">
                            <div class="input-col" style="flex:2;">
                                <label class="input-label">Dirección exacta de entrega *</label>
                                <input type="text" name="direccion" id="inputDireccion" class="input-field" placeholder="Ej: Calle 47 # 3 Sur-20, Apto 201" />
                            </div>
                            <div class="input-col" style="flex:1;">
                                <label class="input-label">Detalles de acceso (Torre, Apto, Timbre)</label>
                                <input type="text" name="notas" class="input-field" placeholder="Ej: Torre 2 Apto 401" />
                            </div>
                        </div>
                    </div>

                    <!-- Campos de En Mesa -->
                    <div id="seccionMesa" class="fields-group" style="@(tipoDefecto == "EnMesa" ? "" : "display:none;")">
                        <div class="input-row">
                            <div class="input-col">
                                <label class="input-label">Selecciona tu Mesa *</label>
                                <select name="mesa" id="selectMesa" class="input-field">
                                    @for (int i = 1; i <= 30; i++)
                                    {
                                        var mObj = mesas.FirstOrDefault(m => m.Numero == i);
                                        string estado = mObj?.Estado ?? "Libre";
                                        <option value="Mesa @i">Mesa @i — (@estado)</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. DATOS DE CONTACTO -->
                <div class="checkout-card">
                    <div class="card-step-badge">2</div>
                    <div class="card-head">
                        <h3>Datos del Comensal</h3>
                        <p>Para contactarte con novedades de tu orden y llegada del domiciliario.</p>
                    </div>

                    <div class="input-row">
                        <div class="input-col">
                            <label class="input-label">Nombre completo *</label>
                            <input type="text" name="nombreCliente" id="inputNombre" class="input-field" value="@nombreUsuario" placeholder="Tu nombre" required />
                        </div>
                        <div class="input-col">
                            <label class="input-label">Teléfono celular (WhatsApp) *</label>
                            <input type="tel" name="telefono" id="inputTelefono" class="input-field" placeholder="300 123 4567" required />
                        </div>
                    </div>
                    <div class="input-row">
                        <div class="input-col">
                            <label class="input-label">Correo electrónico (Opcional)</label>
                            <input type="email" name="correo" class="input-field" placeholder="tucorreo@ejemplo.com" />
                        </div>
                    </div>
                </div>

                <!-- 3. MÉTODO DE PAGO ESTILO KFC -->
                <div class="checkout-card">
                    <div class="card-step-badge">3</div>
                    <div class="card-head">
                        <h3>Método de Pago</h3>
                        <p>Elige tu forma de pago favorita.</p>
                    </div>

                    <div class="payment-methods">
                        <label class="payment-box active" onclick="seleccionarPago('Wompi')">
                            <input type="radio" name="metodoPago" value="Wompi" checked style="display:none;" />
                            <div class="pay-icon" style="display:flex;align-items:center;justify-content:center;width:48px;height:48px;background:#000;border-radius:10px;padding:6px;box-shadow:0 2px 8px rgba(0,0,0,0.2);">
                                <svg viewBox="0 0 100 32" style="width:100%;height:100%;" fill="none">
                                    <path d="M6 8 L14 24 L22 8 L30 24 L38 8" stroke="#00E5A3" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
                                    <circle cx="50" cy="16" r="8" fill="#FFF"/>
                                    <path d="M65 8 L65 24 L75 14 L85 24 L85 8" stroke="#FFF" stroke-width="4" stroke-linecap="round"/>
                                </svg>
                            </div>
                            <div class="pay-info">
                                <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                                    <span class="pay-title" style="font-size:1rem;color:var(--text, #1C1416);font-weight:800;">Pasarela Oficial Wompi</span>
                                    <span style="background:rgba(0,229,163,0.18);color:#059669;font-size:0.7rem;font-weight:800;padding:2px 8px;border-radius:10px;border:1px solid #00E5A3;">Única Pasarela Oficial</span>
                                </div>
                                <span class="pay-desc" style="font-size:0.8rem;color:var(--muted, #6E5C50);margin-top:2px;">
                                    Paga al instante con Nequi, PSE, Tarjetas de Crédito/Débito o Botón Bancolombia.
                                </span>
                                <div style="display:flex;align-items:center;gap:8px;margin-top:6px;">
                                    <!-- Nequi badge -->
                                    <span style="display:inline-flex;align-items:center;gap:4px;background:#200020;color:#FFF;padding:2px 6px;border-radius:5px;font-size:0.7rem;font-weight:700;">
                                        <svg viewBox="0 0 24 24" style="width:12px;height:12px;"><rect width="24" height="24" fill="#200020"/><path d="M6 18V6h3.2l5.6 7.8V6H18v12h-3.2L9.2 10.2V18H6z" fill="#FF2772"/><circle cx="17.5" cy="6.5" r="1.5" fill="#FF2772"/></svg>
                                        Nequi
                                    </span>
                                    <!-- PSE badge -->
                                    <span style="display:inline-flex;align-items:center;gap:4px;background:#003366;color:#FFCC00;padding:2px 6px;border-radius:5px;font-size:0.7rem;font-weight:700;">
                                        PSE
                                    </span>
                                    <!-- Tarjetas badge -->
                                    <span style="display:inline-flex;align-items:center;gap:4px;background:#18060A;color:#FFF;padding:2px 6px;border-radius:5px;font-size:0.7rem;font-weight:700;">
                                        Visa / Mastercard
                                    </span>
                                    <span style="display:inline-flex;align-items:center;gap:4px;background:#FDDA24;color:#000;padding:2px 6px;border-radius:5px;font-size:0.7rem;font-weight:800;">
                                        Bancolombia
                                    </span>
                                </div>
                            </div>
                        </label>

                        <label class="payment-box" onclick="seleccionarPago('Efectivo')">
                            <input type="radio" name="metodoPago" value="Efectivo" style="display:none;" />
                            <div class="pay-icon" style="display:flex;align-items:center;justify-content:center;width:48px;height:48px;background:rgba(42,115,72,0.15);border-radius:10px;border:1px solid #4CAF50;">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2A7348" stroke-width="2.2"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="3"/><line x1="6" y1="12" x2="6.01" y2="12"/><line x1="18" y1="12" x2="18.01" y2="12"/></svg>
                            </div>
                            <div class="pay-info">
                                <span class="pay-title" style="font-weight:700;color:var(--text, #1C1416);">Efectivo Contraentrega</span>
                                <span class="pay-desc" style="font-size:0.8rem;color:var(--muted, #6E5C50);">Pagas en mano al repartidor o al personal del restaurante al recibir tu orden.</span>
                            </div>
                        </label>
                    </div>

                    <div id="cajaCambioEfectivo" class="input-row" style="margin-top:1rem;display:none;">
                        <div class="input-col">
                            <label class="input-label">¿Con cuánto vas a pagar? (Para llevarte cambio exacto)</label>
                            <input type="number" name="pagaCon" class="input-field" placeholder="Ej: 50000" />
                        </div>
                    </div>
                </div>

            </div>

            <!-- ══ COLUMNA DERECHA: RESUMEN DE LA ORDEN ═════════════════ -->
            <div class="checkout-sidebar">
                <div class="summary-card">
                    <h3 class="summary-title">Resumen de tu Orden</h3>

                    <!-- Contenedor dinámico de items sincronizados con localStorage -->
                    <div id="checkoutItemsList" class="summary-items">
                        <!-- Rellenado por JS desde carrito -->
