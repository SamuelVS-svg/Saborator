@model List<ControlClientesRestaurante.Models.Pedido>
@{ ViewData["Title"] = "Pedidos activos"; }

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-0">
    <div class="pg-header">
        <div class="pg-icon">
            <svg viewBox="0 0 24 24" fill="none"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1" ry="1"/><polyline points="9 11 11 13 15 9"/></svg>
        </div>
        <div>
            <div class="pg-title">Pedidos activos</div>
            <div class="pg-sub" style="display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;margin-top:.35rem;">
                <span>Pedidos pendientes, en preparación o listos para cobrar</span>
                <span class="pg-sub-pill"><span class="txt-ok">@ViewBag.MesasLibres libres</span></span>
                <span class="pg-sub-pill"><span class="txt-err">@ViewBag.MesasOcupadas ocupadas</span></span>
            </div>
        </div>
    </div>
</div>
<hr class="div-gold" />

@if (!Model.Any())
{
    <div class="card-pro text-center py-5" style="color:var(--c-muted);">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" style="margin-bottom:.75rem;opacity:.3;"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1" ry="1"/></svg>
        <p style="font-weight:600;font-size:1rem;margin-bottom:.25rem;">No hay pedidos activos en este momento.</p>
    </div>
}
else
{
    <div class="tbl-wrap">
        <table>
            <thead>
                <tr>
                    <th>N° Pedido</th>
                    <th>Mesa</th>
                    <th>Cliente</th>
                    <th>Mesero</th>
                    <th>Total</th>
                    <th>Estado</th>
                    <th>Hora</th>
                    <th style="width:180px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td><strong style="font-family:monospace;font-size:.82rem;">@p.Numero</strong></td>
                        <td><strong>@p.Mesa</strong></td>
                        <td style="color:var(--c-muted);font-size:.82rem;">@(p.NombreCliente ?? "—")</td>
                        <td style="color:var(--c-muted);font-size:.82rem;">@p.UsuarioMesero</td>
                        <td><strong>$@p.Total.ToString("N0", ControlClientesRestaurante.Models.Formato.Co)</strong></td>
                        <td>
                            <span class="estado-pill estado-@p.Estado.ToLower()">
                                @p.Estado
                            </span>
                        </td>
                        <td style="color:var(--c-muted);font-size:.8rem;">@p.FechaCreacion.ToString("HH:mm")</td>
                        <td>
                            <div class="d-flex gap-1 flex-wrap">
                                <a asp-action="Detalle" asp-route-id="@p.Id" class="btn-ghost" style="padding:.25rem .6rem;font-size:.74rem;gap:.25rem;">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                    Ver
                                </a>

                                @if (p.Estado == "Listo")
                                {
                                    <a asp-controller="Factura" asp-action="FacturarPedido" asp-route-id="@p.Id"
                                       class="btn-gold" style="padding:.25rem .6rem;font-size:.74rem;gap:.25rem;">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                                        Cobrar
                                    </a>
                                }

                                @if (p.Estado == "Pendiente")
                                {
                                    <form asp-action="CambiarEstado" method="post" style="margin:0;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id"     value="@p.Id" />
                                        <input type="hidden" name="estado" value="EnPreparacion" />
                                        <button type="submit" class="btn-chip btn-chip-brand">
                                            En preparación
                                        </button>
                                    </form>
                                }

                                @if (p.Estado == "EnPreparacion")
                                {
                                    <form asp-action="CambiarEstado" method="post" style="margin:0;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id"     value="@p.Id" />
                                        <input type="hidden" name="estado" value="Listo" />
                                        <button type="submit" class="btn-chip btn-chip-ok">
                                            Marcar listo
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div style="font-size:.73rem;color:var(--c-muted);margin-top:.5rem;text-align:right;">
        @Model.Count pedido(s) activo(s)
    </div>
}
