<script>
    let categoriaActivaReceta = 'TODAS';

    function seleccionarCategoriaReceta(btn, cat) {
        categoriaActivaReceta = cat;
        document.querySelectorAll('#recetarioCategoryFilters .receta-cat-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        filtrarRecetario();
    }

    function filtrarRecetario() {
        const q = (document.getElementById('recetarioSearch')?.value || '').trim().toLowerCase();
        const items = document.querySelectorAll('.receta-card-item');
        items.forEach(el => {
            const cat = el.getAttribute('data-cat') || '';
            const text = el.getAttribute('data-search') || '';
            const matchCat = (categoriaActivaReceta === 'TODAS') || (cat === categoriaActivaReceta);
            const matchText = !q || text.includes(q);
            el.style.display = (matchCat && matchText) ? '' : 'none';
        });
    }
</script>
