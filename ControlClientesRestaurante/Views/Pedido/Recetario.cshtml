@model List<ControlClientesRestaurante.Models.Producto>
@{
    ViewData["Title"] = "Fichas Técnicas y Recetario";
    var categorias = Model != null
        ? Model.Select(p => string.IsNullOrWhiteSpace(p.Categoria) ? "General" : p.Categoria).Distinct().OrderBy(c => c).ToList()
        : new List<string>();
}

<!-- Encabezado Principal Saborator -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
    <div class="pg-header">
        <div class="pg-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
        </div>
        <div>
            <div class="pg-title">Recetario &amp; Fichas Técnicas de Carta</div>
            <div class="pg-sub">Estandarización gastronómica, tiempos de cocción, alérgenos y protocolo oficial de cocina</div>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Producto" asp-action="Index" class="btn-ghost">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2v0a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/></svg>
            <span>Gestionar Carta</span>
        </a>
        <a asp-action="Cocina" class="btn-gold">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 13.87A4 4 0 0 1 7.41 6a5.11 5.11 0 0 1 1.05-1.54 5 5 0 0 1 7.08 0A5.11 5.11 0 0 1 16.59 6 4 4 0 0 1 18 13.87V21H6Z"/><line x1="6" y1="17" x2="18" y2="17"/></svg>
            <span>Ir a Pantalla KDS Cocina</span>
        </a>
    </div>
</div>
<hr class="div-gold" />

<!-- Protocolo de Cocina Banner -->
<div class="recetario-protocol-banner mb-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="recetario-protocol-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 3z"/></svg>
            </div>
            <div>
                <h5 class="recetario-protocol-title mb-1">Protocolo de Cocción y Calidad Saborator</h5>
                <p class="recetario-protocol-desc mb-0">
                    • Tiempo objetivo por comanda caliente: <strong>12 a 15 minutos</strong>.<br />
                    • Cada proteína debe salir sellada al momento. Respetar estrictamente el orden FIFO de la pantalla KDS y verificar alérgenos reportados en las notas.
                </p>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="recetario-badge-gold">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <span>@(Model?.Count ?? 0) Fichas Activas</span>
            </span>
        </div>
    </div>
</div>

<!-- Barra de Búsqueda y Filtros por Categoría -->
<div class="card-pro" style="padding: 1.25rem 1.5rem; margin-bottom: 2rem;">
    <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.25rem;">
        <div style="flex: 1 1 280px; max-width: 420px; position: relative;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--muted); pointer-events: none;"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" id="recetarioSearch" class="form-control form-control-sm" style="padding-left: 2.2rem;" placeholder="Buscar plato, ingrediente o categoría..." oninput="filtrarRecetario()" />
        </div>
        <div style="flex: 2 1 360px;">
            <div class="d-flex flex-wrap gap-2 justify-content-lg-end" id="recetarioCategoryFilters">
                <button type="button" class="receta-cat-btn active" data-cat="TODAS" onclick="seleccionarCategoriaReceta(this, 'TODAS')">
                    Todas (@(Model?.Count ?? 0))
                </button>
                @foreach (var cat in categorias)
                {
                    var countCat = Model!.Count(p => (string.IsNullOrWhiteSpace(p.Categoria) ? "General" : p.Categoria) == cat);
                    <button type="button" class="receta-cat-btn" data-cat="@cat" onclick="seleccionarCategoriaReceta(this, '@cat')">
                        @cat (@countCat)
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<!-- Grid de Fichas Técnicas -->
<div class="recetario-grid" id="recetarioGrid">
    @if (Model != null && Model.Any())
    {
        @foreach (var prod in Model)
        {
            string catReal = !string.IsNullOrWhiteSpace(prod.Categoria) ? prod.Categoria : "Platos Fuertes";
            bool esBurger = prod.Nombre.Contains("Hamburguesa", StringComparison.OrdinalIgnoreCase) || prod.Nombre.Contains("Burger", StringComparison.OrdinalIgnoreCase) || catReal.Contains("Hamburguesa", StringComparison.OrdinalIgnoreCase);
            bool esHotDog = prod.Nombre.Contains("Perro", StringComparison.OrdinalIgnoreCase) || catReal.Contains("Perro", StringComparison.OrdinalIgnoreCase);
            bool esSalchi = prod.Nombre.Contains("Salchipapa", StringComparison.OrdinalIgnoreCase) || catReal.Contains("Salchipapa", StringComparison.OrdinalIgnoreCase);
            bool esPapas  = prod.Nombre.Contains("Papa", StringComparison.OrdinalIgnoreCase);
            bool esPostre = catReal.Contains("Postre", StringComparison.OrdinalIgnoreCase) || prod.Nombre.Contains("Volcán", StringComparison.OrdinalIgnoreCase) || prod.Nombre.Contains("Tiramisú", StringComparison.OrdinalIgnoreCase) || prod.Nombre.Contains("Cheesecake", StringComparison.OrdinalIgnoreCase) || prod.Nombre.Contains("Brownie", StringComparison.OrdinalIgnoreCase);
            bool esBebida = catReal.Contains("Bebida", StringComparison.OrdinalIgnoreCase) || catReal.Contains("Cóctel", StringComparison.OrdinalIgnoreCase) || catReal.Contains("Vino", StringComparison.OrdinalIgnoreCase) || prod.Nombre.Contains("Coca", StringComparison.OrdinalIgnoreCase) || prod.Nombre.Contains("Pepsi", StringComparison.OrdinalIgnoreCase) || prod.Nombre.Contains("Agua", StringComparison.OrdinalIgnoreCase) || prod.Nombre.Contains("Limonada", StringComparison.OrdinalIgnoreCase) || prod.Nombre.Contains("Soda", StringComparison.OrdinalIgnoreCase) || prod.Nombre.Contains("Sangría", StringComparison.OrdinalIgnoreCase);
            bool esEntrada = catReal.Contains("Entrada", StringComparison.OrdinalIgnoreCase) || prod.Nombre.Contains("Carpaccio", StringComparison.OrdinalIgnoreCase) || prod.Nombre.Contains("Ceviche", StringComparison.OrdinalIgnoreCase) || prod.Nombre.Contains("Tartar", StringComparison.OrdinalIgnoreCase) || prod.Nombre.Contains("Croqueta", StringComparison.OrdinalIgnoreCase) || prod.Nombre.Contains("Pulpo", StringComparison.OrdinalIgnoreCase);
            bool esPastaArroz = catReal.Contains("Pasta", StringComparison.OrdinalIgnoreCase) || catReal.Contains("Arroz", StringComparison.OrdinalIgnoreCase) || catReal.Contains("Risotto", StringComparison.OrdinalIgnoreCase) || prod.Nombre.Contains("Risotto", StringComparison.OrdinalIgnoreCase) || prod.Nombre.Contains("Fettuccine", StringComparison.OrdinalIgnoreCase) || prod.Nombre.Contains("Ravioli", StringComparison.OrdinalIgnoreCase) || prod.Nombre.Contains("Paella", StringComparison.OrdinalIgnoreCase) || prod.Nombre.Contains("Arroz", StringComparison.OrdinalIgnoreCase);

            string bgImg = esSalchi ? "/img/salchipapa.jpg"
                : (esBurger ? "/img/hamburguesa.jpg"
                : (esHotDog ? "/img/perrocaliente.jpg"
                : (esPapas ? "/img/papasfrancesa.jpg"
                : (prod.Nombre.Contains("Coca", StringComparison.OrdinalIgnoreCase) ? "/img/cocacola.png?v=3"
                : (prod.Nombre.Contains("Pepsi", StringComparison.OrdinalIgnoreCase) ? "/img/pepsi.webp?v=2"
                : (prod.Nombre.Contains("Agua", StringComparison.OrdinalIgnoreCase) ? "/img/agua.webp?v=2" : ""))))));

            int tiempoMin = prod.TiempoCoccionMinutos > 0 ? prod.TiempoCoccionMinutos : (esBebida ? 3 : (esPostre ? 6 : (esEntrada ? 10 : 15)));

            <div class="receta-card-item"
                 data-cat="@catReal"
                 data-search="@($"{prod.Nombre} {prod.Descripcion} {catReal} {prod.Alergenos} {prod.Ingredientes}".ToLowerInvariant())">
                <div class="receta-card h-100">
                    <!-- Imagen + Badges superiores -->
                    <div class="receta-card-media">
                        @if (!string.IsNullOrEmpty(bgImg))
                        {
                            <img src="@bgImg" alt="" aria-hidden="true" class="receta-card-img-ambient" loading="lazy" />
                            <img src="@bgImg" alt="@prod.Nombre" class="receta-card-img" loading="lazy" onerror="this.style.display='none';this.previousElementSibling.style.display='none';this.nextElementSibling.style.display='flex';" />
                            <div class="receta-card-placeholder" style="display:none;">
                                <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2v0a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/></svg>
                            </div>
                        }
                        else
                        {
                            <div class="receta-card-placeholder">
                                <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2v0a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/></svg>
                            </div>
                        }
                        <div class="receta-card-overlay"></div>

                        <span class="receta-pill-cat">@catReal</span>
                        <span class="receta-pill-time" title="Tiempo estándar de preparación">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                            @tiempoMin min
                        </span>
                    </div>

                    <!-- Cuerpo de la ficha -->
                    <div class="receta-card-body">
                        <div class="d-flex align-items-start justify-content-between gap-2 mb-2">
                            <h4 class="receta-card-title mb-0">@prod.Nombre</h4>
                            <span class="receta-card-price">$@prod.Precio.ToString("N0")</span>
                        </div>

                        <p class="receta-card-desc">
                            @(string.IsNullOrWhiteSpace(prod.Descripcion) ? "Preparación gastronómica estandarizada bajo receta oficial de la casa." : prod.Descripcion)
                        </p>

                        <!-- Metadatos rápidos (Stock, Alérgenos y Etiquetas Dietarias) -->
                        <div class="receta-meta-row">
                            <span class="receta-meta-tag">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
                                Stock: <strong>@prod.Stock</strong>
                            </span>
                            @if (!string.IsNullOrWhiteSpace(prod.Alergenos))
                            {
                                <span class="receta-meta-tag alergeno" title="Alérgenos declarados">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                                    @prod.Alergenos
                                </span>
                            }
                            @if (prod.EsVegetariano)
                            {
                                <span class="receta-meta-tag destacado">🌱 Vegetariano</span>
                            }
                            @if (prod.EsLibreGluten)
                            {
                                <span class="receta-meta-tag destacado">🌾 Libre de Gluten</span>
                            }
                        </div>

                        <!-- Especificación de Preparación -->
                        <div class="receta-spec-box mt-auto">
                            <div class="receta-spec-title">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/></svg>
                                <span>Protocolo de Estación</span>
                            </div>
                            <ul class="receta-spec-list">
                                @if (!string.IsNullOrWhiteSpace(prod.Ingredientes))
                                {
                                    <li><strong>Mise en Place / Ingredientes:</strong> @prod.Ingredientes</li>
                                }
                                @if (esBurger)
                                {
                                    <li><strong>Pan Brioche:</strong> Sellado en plancha con mantequilla clarificada a 180°C.</li>
                                    <li><strong>Proteína:</strong> Madurada 180g sellada a término 3/4 (4 min por cara).</li>
                                    <li><strong>Acabado:</strong> Queso fundido en campana, vegetales frescos y salsa de autor.</li>
                                }
                                else if (esSalchi)
                                {
                                    <li><strong>Base:</strong> Papa seleccionada frita a 175°C hasta dorado uniforme y crocante.</li>
                                    <li><strong>Proteínas:</strong> Embutidos artesanales salteados en plancha caliente.</li>
                                    <li><strong>Emplatado:</strong> Gratinado de quesos, tocineta crocante y salsas de la casa.</li>
                                }
                                else if (esHotDog)
                                {
                                    <li><strong>Pan &amp; Salchicha:</strong> Pan artesanal al vapor con salchicha suiza dorada en parrilla.</li>
                                    <li><strong>Toppings:</strong> Queso fundido, tocineta ahumada, ripio crocante y salsas.</li>
                                }
                                else if (esPapas)
                                {
                                    <li><strong>Fritura:</strong> Aceite limpio a 175°C durante 4–5 minutos hasta textura crujiente.</li>
                                    <li><strong>Sazón:</strong> Sal marina fina, paprika ahumada y hierbas al salir de freidora.</li>
                                }
                                else if (esEntrada)
                                {
                                    <li><strong>Mise en place:</strong> Corte de precisión al momento y control de temperatura de servicio.</li>
                                    <li><strong>Emplatado:</strong> Vajilla fría o precalentada según ficha, aderezo al pase y microgreens.</li>
                                }
                                else if (esPastaArroz)
                                {
                                    <li><strong>Cocción:</strong> Punto <em>al dente</em> controlado, mantecado con fondo reducido y grasa noble.</li>
                                    <li><strong>Pase:</strong> Emplatado en plato hondo precalentado, terminado con parmesano madurado.</li>
                                }
                                else if (esPostre)
                                {
                                    <li><strong>Pastelería:</strong> Emplatado de precisión con contraste térmico (helado artesanal al momento).</li>
                                    <li><strong>Decoración:</strong> Coulis, crocantes y espolvoreado final justo antes de salir a mesa.</li>
                                }
                                else if (esBebida)
                                {
                                    <li><strong>Bar &amp; Cristalería:</strong> Servir entre 4°C y 6°C en cristalería climatizada con hielo cristalino.</li>
                                    <li><strong>Garnish:</strong> Deshidratados cítricos o hierbas aromáticas frescas al momento del despacho.</li>
                                }
                                else
                                {
                                    <li><strong>Estación de Fuego:</strong> Sellado en parrilla/plancha a alta temperatura respetando el término solicitado.</li>
                                    <li><strong>Reposo &amp; Pase:</strong> Reposo de 2 min antes del corte, guarnición caliente y reducción brillante al pase.</li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="card-pro text-center py-5" style="color: var(--muted);">
                <p class="mb-0 fw-semibold">No hay recetas cargadas en la carta actualmente.</p>
            </div>
        </div>
    }
</div>

<style>
    .recetario-protocol-banner {
        background: linear-gradient(135deg, rgba(200, 151, 58, 0.14) 0%, var(--surface) 100%);
        border: 1px solid rgba(200, 151, 58, 0.35);
        border-radius: 14px;
        padding: 1.15rem 1.35rem;
        box-shadow: var(--shadow-sm);
    }
    .recetario-protocol-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: rgba(200, 151, 58, 0.18);
        border: 1px solid rgba(200, 151, 58, 0.35);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--gold);
        flex-shrink: 0;
    }
    .recetario-protocol-title {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--ink);
    }
    .recetario-protocol-desc {
        font-size: 0.83rem;
        color: var(--muted);
        line-height: 1.5;
    }
    .recetario-badge-gold {
        background: rgba(200, 151, 58, 0.16);
        color: var(--ink);
        border: 1px solid rgba(200, 151, 58, 0.45);
        padding: 0.45rem 0.85rem;
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .recetario-badge-gold svg {
        color: var(--gold);
    }

    /* Botones de filtro de categoría */
    .receta-cat-btn {
        background: var(--surface-2);
        color: var(--text);
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 0.35rem 0.85rem;
        font-size: 0.78rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.18s ease;
    }
    .receta-cat-btn:hover {
        border-color: var(--gold);
        color: var(--ink);
    }
    .receta-cat-btn.active {
        background: linear-gradient(135deg, var(--gold) 0%, #a67623 100%);
        color: #18060A !important;
        border-color: var(--gold);
        font-weight: 700;
        box-shadow: 0 3px 10px rgba(200, 151, 58, 0.28);
    }

    /* Cuadrícula de Fichas Técnicas con espaciado generoso */
    .recetario-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(315px, 1fr));
        gap: 2rem;
        margin-top: 0.5rem;
        margin-bottom: 3rem;
        align-items: stretch;
    }
    @@media (max-width: 640px) {
        .recetario-grid {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }
    }

    /* Tarjeta de Ficha Técnica */
    .receta-card {
        background: var(--surface);
        border: 1.5px solid var(--line, #E3D8C8);
        border-radius: 18px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        box-shadow: var(--shadow);
        transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
    }
    .receta-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-md);
        border-color: rgba(200, 151, 58, 0.55);
    }
    .receta-card-media {
        position: relative;
        height: 195px;
        background: radial-gradient(circle at center, #261218 0%, #12070A 100%);
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .receta-card-img-ambient {
        display: none;
    }
    .receta-card-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        position: relative;
        z-index: 1;
        transition: transform 0.35s ease;
    }
    /* En PC: mostrar la imagen completa sin recortar ni ensanchar */
    @@media (min-width: 768px) {
        .receta-card-media {
            height: 245px;
            padding: 0.65rem;
        }
        .receta-card-img-ambient {
            display: block;
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            filter: blur(18px) brightness(0.38) saturate(1.2);
            transform: scale(1.15);
            z-index: 0;
            pointer-events: none;
        }
        .receta-card-img {
            width: auto;
            max-width: 100%;
            height: 100%;
            object-fit: contain;
            border-radius: 12px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
        }
    }
    .receta-card:hover .receta-card-img {
        transform: scale(1.04);
    }
    .receta-card-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--gold);
        background: radial-gradient(circle at center, rgba(200, 151, 58, 0.18), #14080C 75%);
    }
    .receta-card-overlay {
        position: absolute;
        inset: auto 0 0 0;
        height: 65px;
        background: linear-gradient(to top, rgba(18, 13, 15, 0.85), transparent);
        pointer-events: none;
        z-index: 2;
    }
    .receta-pill-cat {
        position: absolute;
        top: 12px;
        left: 12px;
        z-index: 3;
        background: rgba(24, 6, 10, 0.86);
        backdrop-filter: blur(6px);
        border: 1px solid rgba(200, 151, 58, 0.55);
        color: #E2B659;
        padding: 0.28rem 0.72rem;
        border-radius: 999px;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
    .receta-pill-time {
        position: absolute;
        top: 12px;
        right: 12px;
        z-index: 3;
        background: rgba(24, 6, 10, 0.86);
        backdrop-filter: blur(6px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: #FFFDF9;
        padding: 0.26rem 0.65rem;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }
    .receta-card-body {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        flex: 1;
    }
    .receta-card-title {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 1.12rem;
        font-weight: 700;
        color: var(--ink);
        line-height: 1.25;
    }
    .receta-card-price {
        font-family: 'Geist Mono', monospace;
        font-size: 0.95rem;
        font-weight: 800;
        color: var(--gold);
