@model List<ControlClientesRestaurante.Models.Pedido>
@{
    ViewData["Title"] = "Panel de Domicilios & Envíos";
    bool esAdminOCajero = ViewBag.EsAdminOCajero == true;
    var domiciliarios = ViewBag.Domiciliarios as List<string> ?? new();
    int pendientes = Model.Count(p => p.Estado == "Pendiente");
    int enCocina = Model.Count(p => p.Estado == "EnPreparacion");
    int listos = Model.Count(p => p.Estado == "Listo");
    int enCamino = Model.Count(p => p.Estado == "EnCamino");
    int entregados = Model.Count(p => p.Estado == "Entregado");
}

<div class="pg-header">
    <div class="pg-icon">
        <svg viewBox="0 0 24 24" fill="none"><circle cx="18.5" cy="17.5" r="3.5"/><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="15" cy="5" r="1"/><path d="M12 17.5V14l-3-3 4-3 2 3h2"/></svg>
    </div>
    <div>
        <div class="pg-title">Despacho de Domicilios &amp; Para Llevar</div>
        <div class="pg-sub" style="display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;margin-top:.35rem;">
            <span class="pg-sub-pill"><span class="txt-err">@pendientes por aceptar</span></span>
            <span class="pg-sub-pill" style="color:#B45309;"><span style="color:#F59E0B;">●</span> @enCocina en cocina</span>
            <span class="pg-sub-pill" style="color:#7C3AED;"><span style="color:#8B5CF6;">●</span> @listos listos</span>
            <span class="pg-sub-pill" style="color:#0369A1;"><span style="color:#0EA5E9;">●</span> @enCamino en camino</span>
            <span class="pg-sub-pill"><span class="txt-ok">@entregados entregados</span></span>
        </div>
    </div>
</div>
<hr class="div-gold" />

@if (TempData["Mensaje"] != null)
{
    <div class="alerta alerta-ok" style="margin-bottom:1.25rem;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
        <span>@TempData["Mensaje"]</span>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alerta alerta-err" style="margin-bottom:1.25rem;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span>@TempData["Error"]</span>
    </div>
}

@if (Model == null || Model.Count == 0)
{
    <div class="tbl-empty" style="padding:3rem 1.5rem;text-align:center;">
        <p style="font-size:1.1rem;font-weight:600;margin:0 0 0.5rem;">No hay pedidos de domicilio o para llevar registrados.</p>
        <p style="color:var(--muted);font-size:0.9rem;margin:0;">Los nuevos pedidos de la tienda online aparecerán aquí en tiempo real.</p>
    </div>
}
else
{
    <div class="domicilios-cards-grid">
        @foreach (var p in Model)
        {
            string estadoClase = p.Estado switch
            {
                "Pendiente" => "st-pendiente",
                "EnPreparacion" => "st-cocina",
                "Listo" => "st-listo",
                "EnCamino" => "st-camino",
                "Entregado" => "st-entregado",
                "Facturado" => "st-facturado",
                "Cancelado" => "st-cancelado",
                _ => ""
            };

            string estadoTexto = p.Estado switch
            {
                "Pendiente" => "Por Aceptar",
                "EnPreparacion" => "En Cocina",
                "Listo" => p.TipoEntrega == "Domicilio" ? "Listo para salir" : "Listo para recoger",
                "EnCamino" => "En Camino",
                "Entregado" => "Entregado",
                "Facturado" => "Facturado",
                "Cancelado" => "Cancelado",
                _ => p.Estado
            };

            <div class="dom-card @estadoClase">
                <div class="dom-card-header">
                    <div class="dom-id-wrap">
                        <span class="dom-code">@p.Numero</span>
                        <span class="dom-type-pill @(p.TipoEntrega == "Domicilio" ? "pill-dom" : "pill-llevar")">
                            @if (p.TipoEntrega == "Domicilio") {
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:3px;vertical-align:-1px;"><circle cx="18.5" cy="17.5" r="3.5"/><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="15" cy="5" r="1"/><path d="M12 17.5V14l-3-3 4-3 2 3h2"/></svg>
                                <text>Domicilio</text>
                            } else {
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:3px;vertical-align:-1px;"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                                <text>Para Llevar</text>
                            }
                        </span>
                    </div>
                    <span class="badge-estado @estadoClase">@estadoTexto</span>
                </div>

                <div class="dom-card-body">
                    <!-- Cliente & Contacto -->
                    <div class="dom-info-row">
                        <strong>@p.NombreCliente</strong>
                        <a href="tel:@p.Telefono" class="dom-phone-link">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                            @p.Telefono
                        </a>
                    </div>

                    @if (p.TipoEntrega == "Domicilio")
                    {
                        <div class="dom-address-box">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                            <div style="flex:1;">
                                <div class="dom-address">@p.Direccion</div>
                                @if (!string.IsNullOrEmpty(p.Barrio))
                                {
                                    <div class="dom-barrio">Barrio: @p.Barrio</div>
                                }
                            </div>
                            <a href="https://www.google.com/maps/dir/?api=1&origin=Cra+4+Sur+%2350D-107,+Barranquilla,+Atlantico&destination=@Uri.EscapeDataString($"{p.Direccion}, {p.Barrio}, Barranquilla")" 
                               target="_blank" rel="noopener noreferrer" 
                               title="Abrir ruta GPS en Google Maps" 
                               style="padding:0.35rem 0.6rem;background:var(--surface);border:1px solid var(--brand);border-radius:6px;font-size:0.75rem;font-weight:700;color:var(--brand);text-decoration:none;display:inline-flex;align-items:center;gap:3px;white-space:nowrap;">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                <span>Ruta Maps</span>
                            </a>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(p.Notas))
                    {
                        <div class="dom-notes-box">
                            <strong>Nota:</strong> @p.Notas
                        </div>
                    }

                    <!-- Lista de platos -->
                    <div class="dom-dishes-box">
                        @foreach (var l in p.Lineas)
                        {
                            <div class="dom-dish-row">
                                <span><strong>@(l.Cantidad)x</strong> @l.NombreProducto</span>
                                <span>$@((l.PrecioUnitario * l.Cantidad).ToString("N0", ControlClientesRestaurante.Models.Formato.Co))</span>
                            </div>
                        }
                    </div>

                    <!-- Fila de Costo de Envío y Ajuste Rápido para Cajero -->
                    @if (p.TipoEntrega == "Domicilio" && esAdminOCajero && p.Estado != "Facturado" && p.Estado != "Cancelado")
                    {
                        <div class="dom-fee-control-box" id="boxTarifa_@p.Id">
                            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.35rem;">
                                <span style="font-size:0.75rem;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:0.4px;">
                                    Tarifa Envío:
                                </span>
                                <strong id="lblFee_@p.Id" style="color:var(--brand);font-size:0.88rem;">$@p.CostoEnvio.ToString("N0", ControlClientesRestaurante.Models.Formato.Co) COP</strong>
                            </div>

                            <div style="display:flex;align-items:center;gap:0.4rem;flex-wrap:wrap;">
                                <input type="number" id="inpFee_@p.Id" value="@((int)p.CostoEnvio)" min="0" step="500" aria-label="Tarifa de envío del pedido @p.Numero"
                                       class="dom-fee-input" />
                                
                                <button type="button" onclick="guardarTarifaDomicilio(@p.Id)" title="Guardar valor personalizado" class="dom-fee-save">
                                    Guardar
                                </button>

                                <div style="display:inline-flex;gap:3px;">
                                    <button type="button" class="btn-micro-chip" title="Cortesía" onclick="aplicarTarifaRapida(@p.Id, 0)">$0</button>
                                    <button type="button" class="btn-micro-chip" title="Sur ($4k)" onclick="aplicarTarifaRapida(@p.Id, 4000)">$4k</button>
                                    <button type="button" class="btn-micro-chip" title="Centro ($6k)" onclick="aplicarTarifaRapida(@p.Id, 6000)">$6k</button>
                                    <button type="button" class="btn-micro-chip" title="Norte ($9k)" onclick="aplicarTarifaRapida(@p.Id, 9000)">$9k</button>
                                </div>
                            </div>
                        </div>
                    }
                    else if (p.TipoEntrega == "Domicilio")
                    {
                        <div class="dom-dish-row" style="margin-bottom:0.5rem;">
                            <span>Tarifa de envío</span>
                            <span>$@p.CostoEnvio.ToString("N0", ControlClientesRestaurante.Models.Formato.Co)</span>
                        </div>
                    }

                    @if (p.TipoEntrega == "Domicilio")
                    {
                        <div class="dom-rider-row">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18.5" cy="17.5" r="3.5"/><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="15" cy="5" r="1"/><path d="M12 17.5V14l-3-3 4-3 2 3h2"/></svg>
                            @if (esAdminOCajero && (p.Estado == "Pendiente" || p.Estado == "EnPreparacion" || p.Estado == "Listo"))
                            {
                                <form asp-action="AsignarRepartidor" method="post" class="dom-rider-form">
                                    <input type="hidden" name="id" value="@p.Id" />
                                    <select name="repartidor" class="dom-rider-select" aria-label="Domiciliario del pedido @p.Numero" onchange="this.form.submit()">
                                        <option value="">Sin domiciliario</option>
                                        @foreach (var d in domiciliarios)
                                        {
                                            <option value="@d" selected="@(string.Equals(d, p.Repartidor, StringComparison.OrdinalIgnoreCase))">@d</option>
                                        }
                                    </select>
                                </form>
                            }
                            else
                            {
                                <span>Domiciliario: <strong>@(p.Repartidor ?? "sin asignar")</strong></span>
                            }
                        </div>
                    }

                    <div class="dom-total-row">
                        <span>Pago: <strong>@p.MetodoPago @(p.PagaCon.HasValue ? $"(Paga con ${(p.PagaCon.Value).ToString("N0", ControlClientesRestaurante.Models.Formato.Co)})" : "")</strong></span>
                        <span class="dom-total-val" id="lblTotal_@p.Id">$@p.Total.ToString("N0", ControlClientesRestaurante.Models.Formato.Co) COP</span>
                    </div>
                </div>

                <!-- Botones de Acción de Estado -->
                <div class="dom-card-actions">
                    @if (p.Estado == "Pendiente")
                    {
                        <form asp-action="ActualizarEstadoDomicilio" method="post" style="flex:1;">
                            <input type="hidden" name="id" value="@p.Id" />
                            <input type="hidden" name="nuevoEstado" value="EnPreparacion" />
                            <button type="submit" class="btn-action btn-cocina">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 13.87A4 4 0 0 1 7.41 6a5.11 5.11 0 0 1 1.05-1.54 5 5 0 0 1 7.08 0A5.11 5.11 0 0 1 16.59 6 4 4 0 0 1 18 13.87V21H6Z"/><line x1="6" y1="17" x2="18" y2="17"/></svg>
                                <span>Aceptar &amp; Cocinar</span>
                            </button>
                        </form>
                    }
                    else if (p.Estado == "EnPreparacion")
                    {
                        <div class="dom-wait">En cocina — la cocina lo marcará como listo</div>
                    }
                    else if (p.Estado == "Listo" && p.TipoEntrega == "Domicilio")
                    {
                        <div class="dom-wait">@(string.IsNullOrEmpty(p.Repartidor) ? "Esperando que un domiciliario lo recoja" : $"Esperando a {p.Repartidor}")</div>
                    }
                    else if (p.Estado == "Listo")
                    {
                        <form asp-action="ActualizarEstadoDomicilio" method="post" style="flex:1;">
                            <input type="hidden" name="id" value="@p.Id" />
                            <input type="hidden" name="nuevoEstado" value="Entregado" />
                            <button type="submit" class="btn-action btn-entregar">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                                <span>Entregado al cliente</span>
                            </button>
                        </form>
                    }
                    else if (p.Estado == "EnCamino")
                    {
                        if (esAdminOCajero)
                        {
                            <form asp-action="ConfirmarEntrega" method="post" style="flex:1;">
                                <input type="hidden" name="id" value="@p.Id" />
                                <input type="hidden" name="volverA" value="Domicilios" />
                                <button type="submit" class="btn-action btn-entregar">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                                    <span>Marcar Entregado</span>
                                </button>
                            </form>
                        }
                        else
                        {
                            <div class="dom-wait">En camino con @p.Repartidor</div>
                        }
                    }
                    else if (p.Estado == "Entregado" && esAdminOCajero)
                    {
                        <a asp-controller="Factura" asp-action="FacturarPedido" asp-route-id="@p.Id" class="btn-action btn-facturar" title="Emitir Factura y Cobrar">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                            <span>Cobrar Factura</span>
                        </a>
                    }
                    else
                    {
                        <div class="dom-wait">@estadoTexto</div>
                    }

                    <a asp-action="Seguimiento" asp-route-id="@p.Numero" target="_blank" class="btn-ver-tracker" title="Ver Tracker en vivo">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    </a>
                </div>
            </div>
        }
    </div>
}

<style>
    .domicilios-cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr));
        gap: 1.5rem;
        margin-top: 1rem;
    }
    .dom-card {
        background: var(--surface, #FFFDF9);
        border: 1px solid var(--line, #E2D7C8);
        border-radius: 16px;
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        transition: transform 140ms ease, box-shadow 140ms ease;
    }
    .dom-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.06);
    }
    .dom-card.st-pendiente { border-left: 5px solid #EF4444; }
    .dom-card.st-cocina    { border-left: 5px solid #F59E0B; }
    .dom-card.st-camino    { border-left: 5px solid #0EA5E9; }
    .dom-card.st-listo     { border-left: 5px solid #8B5CF6; }
    .dom-card.st-entregado { border-left: 5px solid #10B981; }
    .dom-card.st-facturado,
    .dom-card.st-cancelado { border-left: 5px solid var(--line); opacity: 0.75; }

    .dom-card-header {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.85rem;
        border-bottom: 1px solid var(--line, #E2D7C8);
        padding-bottom: 0.75rem;
    }
    .dom-id-wrap { display: flex; align-items: center; gap: 0.5rem; }
    .dom-code { font-weight: 800; font-size: 1.05rem; color: var(--brand, #6B1E2E); white-space: nowrap; }
    .dom-type-pill {
        white-space: nowrap;
        font-size: 0.72rem;
        font-weight: 700;
        padding: 0.2rem 0.55rem;
        border-radius: 999px;
    }
    .pill-dom { background: rgba(107, 30, 46, 0.1); color: var(--brand, #6B1E2E); }
    .pill-llevar { background: rgba(200, 151, 58, 0.15); color: #B45309; }

    .badge-estado {
        white-space: nowrap;
        font-size: 0.74rem;
        font-weight: 700;
        padding: 0.25rem 0.65rem;
        border-radius: 999px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }
    .badge-estado.st-pendiente { background: #FEE2E2; color: #991B1B; }
    .badge-estado.st-cocina    { background: #FEF3C7; color: #92400E; }
    .badge-estado.st-camino    { background: #E0F2FE; color: #075985; }
    .badge-estado.st-listo     { background: #EDE9FE; color: #5B21B6; }
    .badge-estado.st-entregado { background: #D1FAE5; color: #065F46; }
    .badge-estado.st-facturado { background: var(--surface-2); color: var(--muted); }
    .badge-estado.st-cancelado { background: #F3F4F6; color: #6B7280; text-decoration: line-through; }

    .dom-info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.92rem;
        margin-bottom: 0.5rem;
    }
    .dom-phone-link {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        color: var(--brand, #6B1E2E);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.85rem;
    }
    .dom-address-box {
        display: flex;
        align-items: flex-start;
        gap: 0.45rem;
        background: var(--surface-2);
        padding: 0.55rem 0.75rem;
        border-radius: 8px;
        margin-bottom: 0.65rem;
        font-size: 0.84rem;
        color: var(--text);
    }
    .dom-address-box svg { color: var(--brand, #6B1E2E); margin-top: 2px; flex-shrink: 0; }
    .dom-address { font-weight: 600; }
    .dom-barrio { font-size: 0.75rem; color: var(--muted, #6E5C50); }

    .dom-notes-box {
        font-size: 0.8rem;
        color: var(--text);
        background: rgba(253, 230, 138, 0.15);
        border: 1px dashed #FDE68A;
        padding: 0.4rem 0.65rem;
        border-radius: 6px;
        margin-bottom: 0.65rem;
    }

    .dom-dishes-box {
        border-top: 1px dashed var(--line, #E2D7C8);
        border-bottom: 1px dashed var(--line, #E2D7C8);
        padding: 0.65rem 0;
        margin-bottom: 0.75rem;
        max-height: 120px;
        overflow-y: auto;
    }
    .dom-dish-row {
        color: var(--text);
        display: flex;
        justify-content: space-between;
        font-size: 0.84rem;
        padding: 0.2rem 0;
    }

    .dom-total-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.88rem;
        margin-bottom: 1rem;
    }
    .dom-total-val {
        font-size: 1.1rem;
        font-weight: 800;
        color: var(--brand, #6B1E2E);
    }

    .dom-card-actions {
        display: flex;
        gap: 0.5rem;
        align-items: center;
    }
    .btn-action {
        width: 100%;
        padding: 0.65rem 0.85rem;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 700;
        cursor: pointer;
        border: none;
        transition: transform 120ms ease;
    }
    .btn-action:hover { transform: translateY(-1px); }
    .btn-cocina   { background: #F59E0B; color: #FFF; }
    .btn-camino   { background: #0EA5E9; color: #FFF; }
    .btn-entregar { background: #10B981; color: #FFF; }

    .btn-ver-tracker {
        padding: 0.65rem;
        border: 1px solid var(--line, #E2D7C8);
        border-radius: 8px;
        color: var(--muted, #6E5C50);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 120ms ease;
    }
    .btn-ver-tracker:hover {
        background: var(--surface-2);
        color: var(--brand);
    }

    .dom-fee-control-box {
        background: rgba(200, 151, 58, 0.08);
        border: 1px solid rgba(200, 151, 58, 0.3);
        border-radius: 8px;
        padding: 0.5rem 0.65rem;
        margin-bottom: 0.75rem;
    }
    .dom-fee-input {
        width: 80px;
        padding: 3px 6px;
        font-size: 0.8rem;
        border: 1px solid var(--line);
        border-radius: 6px;
        font-weight: 700;
        color: var(--brand);
        background: var(--surface);
        outline: none;
    }
    .dom-fee-input:focus { border-color: var(--brand); }
    .dom-fee-save {
        background: var(--brand);
        color: #FFF;
        border: none;
        border-radius: 6px;
