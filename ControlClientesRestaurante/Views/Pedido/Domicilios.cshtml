<div id="afTokenDomicilios" hidden>@Html.AntiForgeryToken()</div>
<script>
    async function guardarTarifaDomicilio(pedidoId) {
        const inp = document.getElementById(`inpFee_${pedidoId}`);
        if (!inp) return;
        const tarifa = Math.max(0, parseInt(inp.value) || 0);
        const token = document.querySelector('#afTokenDomicilios input[name="__RequestVerificationToken"]')?.value || '';

        try {
            const resp = await fetch('/Pedido/AsignarValorDomicilioApi', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify({ id: pedidoId, nuevoCostoEnvio: tarifa })
            });
            const data = await resp.json();
            if (data.ok) {
                const lblFee = document.getElementById(`lblFee_${pedidoId}`);
                if (lblFee) lblFee.textContent = `$${Number(data.costoEnvio).toLocaleString('es-CO')} COP`;

                const lblTotal = document.getElementById(`lblTotal_${pedidoId}`);
                if (lblTotal) lblTotal.textContent = `$${Number(data.total).toLocaleString('es-CO')} COP`;

                inp.style.borderColor = '#10B981';
                setTimeout(() => { inp.style.borderColor = ''; }, 1000);
            } else {
                alert(data.mensaje || 'Error al actualizar tarifa');
            }
        } catch (e) {
            console.error(e);
            alert('Error al comunicarse con el servidor');
        }
    }

    function aplicarTarifaRapida(pedidoId, tarifa) {
        const inp = document.getElementById(`inpFee_${pedidoId}`);
        if (inp) inp.value = tarifa;
        guardarTarifaDomicilio(pedidoId);
    }
</script>
