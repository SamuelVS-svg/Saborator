    .card-section-title {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--brand, #6B4226);
        margin: 0 0 1.25rem;
        border-bottom: 1px solid var(--line, #E8DFD0);
        padding-bottom: 0.65rem;
