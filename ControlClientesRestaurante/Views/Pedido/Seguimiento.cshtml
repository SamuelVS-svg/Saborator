    .order-item-name { font-weight: 600; color: var(--text, #1E120C); }
    .order-item-note { font-size: 0.75rem; color: var(--muted, #6E5C50); }
    .order-item-price { font-weight: 700; color: var(--text, #1E120C); }

    .tracker-cost-breakdown {
        border-top: 1px solid var(--line, #E8DFD0);
