@model ControlClientesRestaurante.Models.Pedido
@{
    ViewData["Title"] = $"Seguimiento de Pedido — {Model.Numero}";

    string estado = Model.Estado;
    bool esDomicilio = Model.TipoEntrega == "Domicilio";
    bool datosPrivados = ViewBag.DatosPrivados == true;

    // Mapeo de paso según estado:
    // 1 = Pendiente (Recibido)
    // 2 = EnPreparacion (y "Listo" de un domicilio que aún espera domiciliario)
    // 3 = EnCamino (domicilio) / Listo para recoger (para llevar o mesa)
    // 4 = Entregado / Facturado
    int stepActual = estado switch
    {
        "Pendiente" => 1,
        "EnPreparacion" => 2,
        "Listo" => esDomicilio ? 2 : 3,
        "EnCamino" => 3,
        "Entregado" or "Facturado" => 4,
        _ => 1
    };
    bool esCancelado = estado == "Cancelado";

    string textoEstado = estado switch
    {
        "EnPreparacion" => "Nuestros chefs están cocinando tu orden al momento",
        "Listo" => esDomicilio ? "Tu pedido está listo y saldrá en breve con nuestro domiciliario" : "¡Tu pedido está listo para recoger!",
        "EnCamino" => string.IsNullOrEmpty(Model.Repartidor) ? "Tu pedido va en camino a tu dirección" : $"{Model.Repartidor} va en camino con tu pedido",
        "Entregado" or "Facturado" => "Tu pedido ha sido entregado ¡Buen provecho!",
        _ => "Hemos recibido tu pedido y lo estamos confirmando"
    };

    // Enmascarar datos personales a quien solo conoce el número de pedido
    string Enmascarar(string? valor, int visibles) =>
        string.IsNullOrEmpty(valor) ? "" : (valor.Length <= visibles ? new string('•', valor.Length) : new string('•', valor.Length - visibles) + valor[^visibles..]);
}

<div class="tracker-wrapper">

    <!-- Encabezado con Código y Tiempo Estimado -->
    <div class="tracker-header">
        <div class="tracker-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            Rastreador en Tiempo Real
        </div>
        <h1 class="tracker-title">Estado de tu Orden</h1>
        <p class="tracker-code">Código de Pedido: <strong>@Model.Numero</strong></p>
    </div>

    @if (esCancelado)
    {
        <div class="tracker-cancel-box">
            <h3>Pedido Cancelado</h3>
            <p>Este pedido ha sido cancelado. Si tienes dudas, por favor contáctanos.</p>
        </div>
    }
    else
    {
        <!-- ══ STEPPER INTERACTIVO ESTILO KFC ═════════════════════════ -->
        <div class="kfc-stepper-card">
            <div class="stepper-time-pill">
                <span id="labelEstadoTexto">@textoEstado</span>
            </div>

            <div class="stepper-track">
                <!-- Barra de progreso de fondo -->
                <div class="stepper-progress-fill" id="progressFill" style="width: @((stepActual - 1) * 33.33)%;"></div>

                <!-- Paso 1 -->
                <div class="stepper-node @(stepActual >= 1 ? "active" : "") @(stepActual == 1 ? "current" : "")">
                    <div class="node-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                    </div>
                    <span class="node-label">Recibido</span>
                    <span class="node-sub">@Model.FechaCreacion.ToString("hh:mm tt")</span>
                </div>

                <!-- Paso 2 -->
                <div class="stepper-node @(stepActual >= 2 ? "active" : "") @(stepActual == 2 ? "current" : "")">
                    <div class="node-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 13.87A4 4 0 0 1 7.41 6a5.11 5.11 0 0 1 1.05-1.54 5 5 0 0 1 7.08 0A5.11 5.11 0 0 1 16.59 6 4 4 0 0 1 18 13.87V21H6Z"/><line x1="6" y1="17" x2="18" y2="17"/></svg>
                    </div>
                    <span class="node-label">En Cocina</span>
                    <span class="node-sub">Preparando</span>
                </div>

                <!-- Paso 3 -->
                <div class="stepper-node @(stepActual >= 3 ? "active" : "") @(stepActual == 3 ? "current" : "")">
                    <div class="node-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="18.5" cy="17.5" r="3.5"/><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="15" cy="5" r="1"/><path d="M12 17.5V14l-3-3 4-3 2 3h2"/></svg>
                    </div>
                    <span class="node-label">@(esDomicilio ? "En Camino" : "Listo")</span>
                    <span class="node-sub">@(esDomicilio ? (Model.Repartidor ?? "Domiciliario") : "Para recoger")</span>
                </div>

                <!-- Paso 4 -->
                <div class="stepper-node @(stepActual >= 4 ? "active" : "") @(stepActual == 4 ? "current" : "")">
                    <div class="node-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    </div>
                    <span class="node-label">Entregado</span>
                    <span class="node-sub">¡Completado!</span>
                </div>
            </div>
        </div>
    }

    <!-- ══ DETALLES DE LA ORDEN ═════════════════════════════════════ -->
    <div class="tracker-details-grid">

        <!-- Columna Izquierda: Información de Entrega y Cliente -->
        <div class="tracker-card">
            <h3 class="card-section-title">Detalles de Entrega</h3>

            <div class="detail-row">
                <span class="detail-label">Modalidad:</span>
                <span class="detail-value highlight">
                    @if (Model.TipoEntrega == "Domicilio") { <text>Domicilio Express</text> }
                    else if (Model.TipoEntrega == "ParaLlevar") { <text>Retiro en Restaurante</text> }
                    else { <text>En Mesa (@Model.Mesa)</text> }
                </span>
            </div>

            @if (esDomicilio && !datosPrivados)
            {
                <div class="detail-row">
                    <span class="detail-label">Barrio:</span>
                    <span class="detail-value">@(Model.Barrio ?? "—")</span>
                </div>
            }
            else if (esDomicilio)
            {
                <div class="detail-row">
                    <span class="detail-label">Dirección:</span>
                    <span class="detail-value">@Model.Direccion @(!string.IsNullOrEmpty(Model.Barrio) ? $"— {Model.Barrio}" : "")</span>
                </div>

                <!-- Tarjeta de Ruta Google Maps desde la Sede -->
                <div class="tracker-dispatch-box" style="background:var(--surface-2, #FAF6F0);border:1.5px solid var(--line, #E2D7C8);border-radius:12px;padding:1rem;margin:1rem 0;">
                    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.6rem;flex-wrap:wrap;gap:0.5rem;">
                        <span style="font-size:0.78rem;font-weight:800;color:var(--brand);text-transform:uppercase;display:inline-flex;align-items:center;gap:6px;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18.5" cy="17.5" r="3.5"/><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="15" cy="5" r="1"/><path d="M12 17.5V14l-3-3 4-3 2 3h2"/></svg>
                            Ruta de Despacho Saborator
                        </span>
                        <a href="https://www.google.com/maps/dir/?api=1&origin=Cra+4+Sur+%2350D-107,+Barranquilla,+Atlantico&destination=@Uri.EscapeDataString($"{Model.Direccion}, {Model.Barrio}, Barranquilla")" 
                           target="_blank" rel="noopener noreferrer" 
                           class="dispatch-map-link"
                           style="font-size:0.8rem;color:#C8973A;font-weight:700;text-decoration:none;display:inline-flex;align-items:center;gap:4px;padding:0.25rem 0.6rem;background:var(--surface, #FFFDF9);border:1px solid #C8973A;border-radius:6px;">
                            <span>Abrir Ruta en Google Maps ↗</span>
                        </a>
                    </div>
                    <div class="dispatch-info-text" style="font-size:0.8rem;color:var(--muted, #555);margin-bottom:0.65rem;">
                        <strong>Salida:</strong> Cra 4 Sur # 50D-107, Barranquilla (Sede Central)<br/>
                        <strong>Llegada:</strong> @Model.Direccion @(!string.IsNullOrEmpty(Model.Barrio) ? $"({Model.Barrio})" : "")
                    </div>
                    <div style="height:160px;border-radius:8px;overflow:hidden;border:1px solid var(--line, #E2D7C8);">
                        <iframe 
                            src="https://maps.google.com/maps?q=Cra+4+Sur+%2350D-107,+Barranquilla,+Atlantico&t=&z=15&ie=UTF8&iwloc=&output=embed" 
                            width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade">
                        </iframe>
                    </div>
                </div>
            }

            <div class="detail-row">
                <span class="detail-label">Cliente:</span>
                <span class="detail-value">@(datosPrivados ? Model.NombreCliente : Model.NombreCliente?.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault())</span>
            </div>

            <div class="detail-row">
                <span class="detail-label">Teléfono:</span>
                <span class="detail-value">@(datosPrivados ? Model.Telefono : Enmascarar(Model.Telefono, 3))</span>
            </div>

            <div class="detail-row">
                <span class="detail-label">Método de Pago:</span>
                <span class="detail-value">@Model.MetodoPago @(Model.PagaCon.HasValue ? $"(Paga con ${Model.PagaCon.Value:N0})" : "")</span>
            </div>

            @if (datosPrivados && !string.IsNullOrEmpty(Model.Notas))
            {
                <div class="detail-row">
                    <span class="detail-label">Notas de Acceso:</span>
                    <span class="detail-value" style="font-style:italic;">@Model.Notas</span>
                </div>
            }

            <!-- Contacto WhatsApp -->
            <div style="margin-top:1.5rem;padding-top:1.25rem;border-top:1px solid var(--line,#E2D7C8);">
                <a href="https://wa.me/573225254289?text=Hola%20Saborator,%20quisiera%20consultar%20sobre%20mi%20pedido%20@Model.Numero" target="_blank" class="btn-whatsapp">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
                    <span>¿Dudas con tu orden? Escríbenos por WhatsApp</span>
                </a>
            </div>
        </div>

        <!-- Columna Derecha: Productos Pedidos y Total -->
        <div class="tracker-card">
            <h3 class="card-section-title">Productos en tu Orden</h3>

            <div class="order-items-list">
                @foreach (var l in Model.Lineas)
                {
                    <div class="order-item-row">
                        <div class="order-item-main">
                            <span class="order-item-qty">@(l.Cantidad)x</span>
                            <div>
                                <div class="order-item-name">@l.NombreProducto</div>
                                @if (!string.IsNullOrEmpty(l.Notas))
                                {
                                    <div class="order-item-note">Nota: @l.Notas</div>
                                }
                            </div>
                        </div>
                        <span class="order-item-price">$@((l.PrecioUnitario * l.Cantidad).ToString("N0"))</span>
                    </div>
                }
            </div>

            <div class="tracker-cost-breakdown">
                @if (Model.Descuento > 0)
                {
                    <div class="cost-row" style="color:#16A34A;font-weight:700;">
                        <span>Descuento Promocional @(!string.IsNullOrEmpty(Model.CodigoCupon) ? $"({Model.CodigoCupon})" : "")</span>
                        <span>-$@Model.Descuento.ToString("N0") COP</span>
                    </div>
                }
                @if (Model.CostoEnvio > 0)
                {
                    <div class="cost-row">
                        <span>Costo de Envío</span>
                        <span>$@Model.CostoEnvio.ToString("N0") COP</span>
                    </div>
                }
                <div class="cost-row total">
                    <span>Total Pagado / A Pagar</span>
                    <span>$@Model.Total.ToString("N0") COP</span>
                </div>
            </div>

            @if (Model.Estado != "Facturado" && Model.Estado != "Cancelado")
            {
                var wompiKeySeg = (string)(ViewBag.WompiPublicKey ?? "pub_prod_3LfjIbKhTNWppn3OIYoG3aVNYUzmWUnw");
                var wompiMontoCentavosSeg = (long)(Model.Total * 100);
                var wompiRefSeg = Model.Numero;

                <div style="margin-top:1.25rem;background:rgba(200,151,58,0.08);border:1.5px solid #C8973A;border-radius:12px;padding:1rem;text-align:center;">
                    <div style="font-size:0.85rem;color:var(--brand);font-weight:700;margin-bottom:0.5rem;display:flex;align-items:center;justify-content:center;gap:6px;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                        <span>Pagar Pedido con Wompi</span>
                    </div>
                    <p style="font-size:0.78rem;color:var(--muted);margin:0 0 0.8rem;">Acepta Tarjeta, Nequi, PSE y Botón Bancolombia en línea.</p>
                    <button type="button" onclick="pagarWompiSeguimiento()" style="width:100%;padding:0.75rem;background:linear-gradient(135deg, #FFD700, #C8973A);border:none;border-radius:8px;font-weight:800;color:#18060A;cursor:pointer;font-size:0.95rem;box-shadow:0 4px 12px rgba(200,151,58,0.3);">
                        Pagar $@Model.Total.ToString("N0") con Wompi
                    </button>
                </div>

                <script type="text/javascript" src="https://checkout.wompi.co/widget.js"></script>
                <script>
                    function pagarWompiSeguimiento() {
                        try {
                            if (typeof WidgetCheckout === 'undefined') {
                                alert('El servicio de Wompi está cargando. Intenta de nuevo en unos segundos.');
                                return;
                            }
                            var checkout = new WidgetCheckout({
                                currency: 'COP',
                                amountInCents: @wompiMontoCentavosSeg,
                                reference: '@wompiRefSeg',
                                publicKey: '@wompiKeySeg',
                                redirectUrl: window.location.origin + '/Pago/RetornoWompi'
                            });
                            checkout.open(function (result) {
                                var transaction = result.transaction;
                                if (transaction && transaction.status === 'APPROVED') {
                                    window.location.reload();
                                }
                            });
                        } catch (e) {
                            console.error('Error Wompi:', e);
                        }
                    }
                </script>
            }

            @if (stepActual >= 3)
            {
                <div style="margin-top:1.25rem;background:linear-gradient(135deg, rgba(200,151,58,0.12), rgba(107,30,46,0.08));border:1px solid rgba(200,151,58,0.35);border-radius:14px;padding:1.15rem;text-align:center;">
                    <div style="font-weight:700;color:var(--brand);font-size:0.95rem;margin-bottom:0.25rem;display:flex;align-items:center;justify-content:center;gap:6px;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                        <span>¿Qué tal estuvo tu experiencia?</span>
                    </div>
                    <p style="font-size:0.8rem;color:var(--muted);margin:0 0 0.85rem;">Tu opinión ayuda a nuestra cocina y a otros comensales.</p>
                    <a asp-controller="Resena" asp-action="Index" style="display:inline-flex;align-items:center;gap:0.4rem;padding:0.5rem 1rem;background:var(--brand);color:#FFFDF9;border-radius:8px;font-size:0.82rem;font-weight:700;text-decoration:none;transition:transform 140ms ease;">
                        <span>Dejar Reseña en Saborator</span>
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                    </a>
                </div>
            }

            <div style="margin-top:1.5rem;text-align:center;">
                <a href="/#menu" class="btn-back-menu">
                    ← Seguir Explorando la Carta
                </a>
            </div>
        </div>

    </div>

</div>

<!-- Estilos del Tracker -->
<style>
    .tracker-wrapper {
        max-width: 980px;
        margin: 0 auto;
        padding: 2.5rem 1.25rem 5rem;
    }
    .tracker-header {
        text-align: center;
        margin-bottom: 2.5rem;
    }
    .tracker-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: rgba(200, 151, 58, 0.12);
        color: var(--gold, #C8973A);
        border: 1px solid rgba(200, 151, 58, 0.35);
        padding: 0.3rem 0.85rem;
        border-radius: 999px;
        font-size: 0.76rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-bottom: 0.75rem;
    }
    .tracker-title {
        font-family: var(--font-serif, 'Instrument Serif', serif);
        font-size: 2.75rem;
        font-weight: 400;
        color: var(--brand, #6B1E2E);
        margin: 0 0 0.5rem;
        line-height: 1.15;
    }
    .tracker-code {
        font-size: 1.05rem;
        color: var(--muted, #6E5C50);
        margin: 0;
    }
    .tracker-code strong {
        color: var(--brand, #6B1E2E);
        letter-spacing: 0.05em;
    }

    /* Stepper Card KFC */
    .kfc-stepper-card {
        background: #18060A;
        border: 1px solid rgba(200, 151, 58, 0.35);
        border-radius: 20px;
        padding: 2.25rem 2rem 2.75rem;
        margin-bottom: 2.5rem;
        color: #FFFDF9;
        box-shadow: 0 16px 40px rgba(0,0,0,0.35);
    }
    .stepper-time-pill {
        text-align: center;
        margin-bottom: 2.5rem;
        font-size: 1.1rem;
        font-weight: 600;
        color: #FFFDF9;
    }
    .stepper-track {
        position: relative;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        max-width: 720px;
        margin: 0 auto;
    }
    .stepper-track::before {
        content: '';
        position: absolute;
        top: 24px;
        left: 30px;
        right: 30px;
        height: 4px;
        background: rgba(255, 253, 249, 0.15);
        z-index: 1;
    }
    .stepper-progress-fill {
        position: absolute;
        top: 24px;
        left: 30px;
        height: 4px;
        background: linear-gradient(90deg, var(--gold, #C8973A) 0%, #F5CE7C 100%);
        z-index: 2;
        transition: width 400ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .stepper-node {
        position: relative;
        z-index: 3;
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 90px;
        text-align: center;
    }
    .node-icon {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: #2A0B13;
        border: 2px solid rgba(255, 253, 249, 0.2);
        color: rgba(255, 253, 249, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 0.65rem;
        transition: all 250ms ease;
    }
    .stepper-node.active .node-icon {
        background: var(--gold, #C8973A);
        border-color: #FFFDF9;
        color: #18060A;
        box-shadow: 0 0 16px rgba(200, 151, 58, 0.5);
    }
    .stepper-node.current .node-icon {
        animation: pulseCurrent 1.6s infinite ease-in-out;
    }
    @@keyframes pulseCurrent {
        0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(200, 151, 58, 0.7); }
        70% { transform: scale(1.08); box-shadow: 0 0 0 12px rgba(200, 151, 58, 0); }
        100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(200, 151, 58, 0); }
    }
    .node-label {
        font-size: 0.88rem;
        font-weight: 700;
        color: rgba(255, 253, 249, 0.6);
        margin-bottom: 0.15rem;
    }
    .stepper-node.active .node-label { color: #FFFDF9; }
    .node-sub {
        font-size: 0.72rem;
        color: rgba(255, 253, 249, 0.45);
    }

    /* Details Grid */
    .tracker-details-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
    }
    @@media (max-width: 768px) {
        .tracker-details-grid { grid-template-columns: 1fr; }
    }
    .tracker-card {
        background: var(--surface, #FFFDF9);
        border: 1px solid var(--line, #E2D7C8);
        border-radius: 16px;
        padding: 1.75rem;
        box-shadow: 0 4px 20px rgba(0,0,0,0.03);
    }
    .card-section-title {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--brand, #6B1E2E);
        margin: 0 0 1.25rem;
        border-bottom: 1px solid var(--line, #E2D7C8);
        padding-bottom: 0.65rem;
    }
    .detail-row {
        display: flex;
        justify-content: space-between;
        padding: 0.55rem 0;
        font-size: 0.9rem;
        border-bottom: 1px dashed rgba(0,0,0,0.06);
    }
    .detail-label { color: var(--muted, #6E5C50); font-weight: 600; }
    .detail-value { color: var(--text, #18060A); font-weight: 700; text-align: right; }
    .detail-value.highlight { color: var(--gold, #C8973A); font-weight: 800; }

    /* Items */
    .order-items-list {
        max-height: 250px;
        overflow-y: auto;
        margin-bottom: 1.25rem;
    }
    .order-item-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.65rem 0;
        border-bottom: 1px solid var(--line, #E2D7C8);
        font-size: 0.9rem;
    }
    .order-item-main { display: flex; align-items: flex-start; gap: 0.65rem; }
    .order-item-qty {
        font-weight: 800;
        color: var(--gold, #C8973A);
        font-size: 0.85rem;
    }
    .order-item-name { font-weight: 600; color: var(--text, #18060A); }
