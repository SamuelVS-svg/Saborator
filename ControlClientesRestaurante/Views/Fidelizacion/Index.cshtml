@model ControlClientesRestaurante.Services.ResumenFidelizacion
@using ControlClientesRestaurante.Models
@using ControlClientesRestaurante.Services
@{
    ViewData["Title"] = "Fidelización de Clientes";
    string? segmento = ViewBag.Segmento;
    string? nivel = ViewBag.Nivel;

    var lista = Model.Clientes.AsEnumerable();
    if (!string.IsNullOrEmpty(segmento)) lista = lista.Where(c => c.Segmento == segmento);
    if (!string.IsNullOrEmpty(nivel)) lista = lista.Where(c => c.Nivel == nivel);
    var filas = lista
        .OrderBy(c => c.Segmento == "En riesgo" ? 0 : c.Segmento == "Perdido" ? 1 : c.Segmento == "Activo" ? 2 : 3)
        .ThenByDescending(c => c.TotalGastado)
        .ToList();

    string Cop(decimal v) => "$" + v.ToString("N0", Formato.Co);
    string ColorSegmento(string s) => s switch { "Activo" => "#10B981", "En riesgo" => "#F59E0B", "Perdido" => "#EF4444", _ => "#94A3B8" };
    string ColorNivel(string n) => n switch { "Platino" => "#8B5CF6", "Oro" => "#C8973A", "Plata" => "#94A3B8", _ => "#B45309" };
    string Primero(string nombre) => nombre.Split(' ')[0];

    string MensajeReconquista(ClienteFidelizacion c) =>
        $"Hola {Primero(c.Nombre)}, te extrañamos en Saborator. Tenemos un detalle para ti en tu próxima visita. ¡Te esperamos!";
    string MensajeVip(ClienteFidelizacion c) =>
        $"Hola {Primero(c.Nombre)}, gracias por ser cliente {c.Nivel} de Saborator. Tienes una recompensa esperándote en tu próxima visita.";

    var tarjetas = new[] {
        (Nombre: "Activo", Valor: Model.Activos, Color: "#10B981", Sub: $"Vinieron en los últimos {Model.DiasRiesgo} días"),
        (Nombre: "En riesgo", Valor: Model.EnRiesgo, Color: "#F59E0B", Sub: $"Entre {Model.DiasRiesgo} y {Model.DiasPerdido} días sin venir"),
        (Nombre: "Perdido", Valor: Model.Perdidos, Color: "#EF4444", Sub: $"Más de {Model.DiasPerdido} días sin venir"),
        (Nombre: "Sin compras", Valor: Model.SinCompras, Color: "#94A3B8", Sub: "Registrados que aún no han consumido")
    };
}

<div class="pg-header mb-3">
    <div class="pg-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
    </div>
    <div>
        <div class="pg-title">Fidelización de Clientes</div>
        <div class="pg-sub">Quién dejó de venir, desde cuándo, y a quién premiar por su constancia</div>
    </div>
</div>
<hr class="div-gold" />

<div class="row g-3 mb-4">
    @foreach (var t in tarjetas)
    {
        <div class="col-6 col-lg-3">
            <a asp-action="Index" asp-route-segmento="@t.Nombre" asp-route-diasRiesgo="@Model.DiasRiesgo" asp-route-diasPerdido="@Model.DiasPerdido"
               class="card-pro d-block text-decoration-none" style="border-left:4px solid @t.Color;@(segmento == t.Nombre ? "outline:2px solid " + t.Color + ";" : "")">
                <div style="font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;opacity:.7;">@t.Nombre</div>
                <div style="font-size:1.9rem;font-weight:800;color:@t.Color;line-height:1.2;">@t.Valor</div>
                <div style="font-size:0.75rem;opacity:.7;">@t.Sub</div>
            </a>
        </div>
    }
</div>

<form method="get" class="card-pro mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-6 col-md-3">
            <label class="form-label">Estado</label>
            <select name="segmento" class="form-select">
                <option value="">Todos</option>
                @foreach (var s in new[] { "Activo", "En riesgo", "Perdido", "Sin compras" })
                {
                    <option value="@s" selected="@(segmento == s)">@s</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label">Nivel</label>
            <select name="nivel" class="form-select">
                <option value="">Todos</option>
                @foreach (var n in new[] { "Platino", "Oro", "Plata", "Bronce" })
                {
                    <option value="@n" selected="@(nivel == n)">@n</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label">En riesgo desde (días)</label>
            <input type="number" name="diasRiesgo" min="1" value="@Model.DiasRiesgo" class="form-control" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label">Perdido desde (días)</label>
            <input type="number" name="diasPerdido" min="2" value="@Model.DiasPerdido" class="form-control" />
        </div>
        <div class="col-12 col-md-2 d-flex gap-2">
            <button type="submit" class="btn-gold" style="padding:0.5rem 1rem;">Aplicar</button>
            <a asp-action="Index" class="btn-ghost">Limpiar</a>
        </div>
    </div>
    <div class="mt-2" style="font-size:0.78rem;opacity:.7;">
        Niveles por visitas: Bronce (1–2) · Plata (3–5) · Oro (6–11) · Platino (12+). Hoy hay <strong>@Model.Vip</strong> clientes Oro/Platino.
    </div>
</form>

<div class="tbl-wrap">
    <table class="tbl-pro">
        <thead>
            <tr>
                <th>Cliente</th>
                <th>Estado</th>
                <th>Nivel</th>
                <th style="text-align:center;">Visitas</th>
                <th>Última visita</th>
                <th style="text-align:right;">Total gastado</th>
                <th style="text-align:right;">Ticket prom.</th>
                <th>Contactar / Recompensar</th>
            </tr>
        </thead>
        <tbody>
        @if (!filas.Any())
        {
            <tr><td colspan="8" style="text-align:center;padding:2rem;">No hay clientes con ese filtro.</td></tr>
        }
        @foreach (var c in filas)
        {
            bool reconquista = c.Segmento == "En riesgo" || c.Segmento == "Perdido";
            bool vip = c.Nivel == "Oro" || c.Nivel == "Platino";
            string msg = reconquista ? MensajeReconquista(c) : MensajeVip(c);
            <tr>
                <td>
                    <div style="font-weight:700;">@c.Nombre</div>
                    <div style="font-size:0.75rem;opacity:.7;">@c.Telefono</div>
                </td>
                <td>
                    <span style="color:@ColorSegmento(c.Segmento);font-weight:700;">● @c.Segmento</span>
                    @if (c.MasTardeDeLoHabitual)
                    {
                        <div style="font-size:0.72rem;color:#F59E0B;">Tarda más de lo habitual</div>
                    }
                </td>
                <td><span style="color:@ColorNivel(c.Nivel);font-weight:800;">@(c.Visitas > 0 ? c.Nivel : "—")</span></td>
                <td style="text-align:center;">@c.Visitas</td>
                <td>
                    @if (c.UltimaVisita.HasValue)
                    {
                        <div>@c.UltimaVisita.Value.ToString("dd/MM/yyyy")</div>
                        <div style="font-size:0.75rem;opacity:.7;">hace @c.DiasSinVenir días@(c.FrecuenciaDias.HasValue ? " · suele venir cada " + c.FrecuenciaDias.Value.ToString("0.#") + " d" : "")</div>
                    }
                    else
                    {
                        <span style="opacity:.6;">—</span>
                    }
                </td>
                <td style="text-align:right;">@Cop(c.TotalGastado)</td>
                <td style="text-align:right;">@Cop(c.TicketPromedio)</td>
                <td>
                    <div class="d-flex flex-wrap gap-1">
                        @if (c.TelefonoWhatsApp != null && c.Visitas > 0 && (reconquista || vip))
                        {
                            <a class="btn-ghost" style="padding:0.25rem 0.6rem;font-size:0.75rem;" target="_blank" rel="noopener"
                               href="https://wa.me/@c.TelefonoWhatsApp?text=@Uri.EscapeDataString(msg)">WhatsApp</a>
                        }
                        @if (!string.IsNullOrWhiteSpace(c.Correo) && c.Visitas > 0 && (reconquista || vip))
                        {
                            <a class="btn-ghost" style="padding:0.25rem 0.6rem;font-size:0.75rem;"
                               href="mailto:@c.Correo?subject=@Uri.EscapeDataString("Un detalle de Saborator para ti")&body=@Uri.EscapeDataString(msg)">Correo</a>
                        }
                        @if (reconquista)
                        {
                            <a class="btn-gold" style="padding:0.25rem 0.6rem;font-size:0.75rem;" asp-controller="Cupon" asp-action="Create"
                               asp-route-codigo="@("VUELVE" + c.ClienteId)" asp-route-descripcion="@("Te extrañamos, " + Primero(c.Nombre) + ": descuento de reconquista")" asp-route-valor="15">Cupón reconquista</a>
                        }
                        else if (vip)
                        {
                            <a class="btn-gold" style="padding:0.25rem 0.6rem;font-size:0.75rem;" asp-controller="Cupon" asp-action="Create"
                               asp-route-codigo="@("VIP" + c.ClienteId)" asp-route-descripcion="@("Recompensa " + c.Nivel + " para " + Primero(c.Nombre))" asp-route-valor="@(c.Nivel == "Platino" ? 20 : 15)">Cupón recompensa</a>
                        }
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
<p class="mt-3" style="font-size:0.78rem;opacity:.7;">
    Se calcula con las facturas emitidas (las anuladas no cuentan). Solo cuentan como visitas las facturas asociadas a un cliente registrado.
</p>
