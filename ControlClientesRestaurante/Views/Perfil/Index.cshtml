                    <!-- Tema 4: Bistro Botánico & Oliva Esmeralda -->
                    <div class="theme-card @(temaActual == "esmeralda" ? "active" : "")" onclick="aplicarTema('esmeralda', this)">
                        <div>
                            <div class="theme-card-swatches">
                                <div class="theme-swatch" style="background:#204E38;" title="Verde Bosque"></div>
                                <div class="theme-swatch" style="background:#F2F6F3;" title="Menta Suave"></div>
                                <div class="theme-swatch" style="background:#9BB68A;" title="Oliva Fresco"></div>
                            </div>
                            <div class="theme-card-title">Bistro Esmeralda</div>
                            <p class="theme-card-desc">Verde Bosque & Menta Oliva. Frescura botánica inspirada en huertos de autor.</p>
                        </div>
                        <div>
                            @if (temaActual == "esmeralda")
                            {
                                <span class="theme-active-pill"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg> Activo</span>
                            }
