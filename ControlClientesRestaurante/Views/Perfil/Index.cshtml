                                <div class="theme-swatch" style="background:#FAF6ED;" title="Champaña Cava"></div>
                                <div class="theme-swatch" style="background:#D4AF37;" title="Destello Dorado"></div>
                            </div>
                            <div class="theme-card-title">Oro Imperial</div>
                            <p class="theme-card-desc">Cava Champagne & Lino Dorado. Distinción inspirada en etiquetas de reserva.</p>
                        </div>
                        <div>
                            @if (temaActual == "dorado")
                            {
                                <span class="theme-active-pill"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg> Activo</span>
                            }
