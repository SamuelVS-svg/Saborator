                        <label style="display:block;font-size:0.78rem;font-weight:700;color:var(--text,#3C2A20);text-transform:uppercase;margin-bottom:0.35rem;">Nombre Completo *</label>
                        <input type="text" name="nombre" value="@cliente.Nombre" class="input-field" style="width:100%;padding:0.75rem 1rem;border:1.5px solid var(--line,#E2D7C8);border-radius:10px;font-size:0.92rem;background:var(--surface,#FFFDF9);color:var(--text,#1C1416);" required />
                    </div>

                    <div style="margin-bottom:1rem;">
                        <label style="display:block;font-size:0.78rem;font-weight:700;color:var(--text,#3C2A20);text-transform:uppercase;margin-bottom:0.35rem;">Documento de Identidad</label>
                        <input type="text" value="@cliente.Documento" class="input-field" style="width:100%;padding:0.75rem 1rem;border:1.5px solid var(--line,#E2D7C8);border-radius:10px;font-size:0.92rem;background:var(--surface-2,#F9FAFB);color:var(--muted,#6B7280);" disabled />
                        <span style="font-size:0.72rem;color:var(--faint,#9CA3AF);">El documento no es modificable por seguridad fiscal.</span>
                    </div>

                    <div style="margin-bottom:1rem;">
                        <label style="display:block;font-size:0.78rem;font-weight:700;color:var(--text,#3C2A20);text-transform:uppercase;margin-bottom:0.35rem;">Teléfono Celular (WhatsApp) *</label>
                        <input type="tel" name="telefono" value="@cliente.Telefono" class="input-field" style="width:100%;padding:0.75rem 1rem;border:1.5px solid var(--line,#E2D7C8);border-radius:10px;font-size:0.92rem;background:var(--surface,#FFFDF9);color:var(--text,#1C1416);" required />
                    </div>

                    <div style="margin-bottom:1.5rem;">
                        <label style="display:block;font-size:0.78rem;font-weight:700;color:var(--text,#3C2A20);text-transform:uppercase;margin-bottom:0.35rem;">Correo Electrónico</label>
                        <input type="email" name="correo" value="@cliente.Correo" class="input-field" style="width:100%;padding:0.75rem 1rem;border:1.5px solid var(--line,#E2D7C8);border-radius:10px;font-size:0.92rem;background:var(--surface,#FFFDF9);color:var(--text,#1C1416);" placeholder="correo@ejemplo.com" />
                    </div>

                    <button type="submit" style="background:var(--brand,#6B1E2E);color:var(--on-brand,#FFFDF9);border:none;padding:0.75rem 1.5rem;border-radius:10px;font-weight:800;font-size:0.85rem;cursor:pointer;width:100%;box-shadow:0 3px 10px rgba(107,30,46,0.2);">
                        Guardar Cambios
                    </button>
                </form>
            }
            else
            {
                <div style="font-size:0.88rem;color:var(--text,#4B5563);line-height:1.6;">
                    <div style="margin-bottom:0.85rem;">
                        <strong style="color:var(--text,#111827);display:block;font-size:0.75rem;text-transform:uppercase;letter-spacing:0.04em;">Nombre de Usuario</strong>
                        <span style="font-size:1rem;color:var(--brand,#18060A);font-weight:700;">@usuario?.NombreUsuario</span>
                    </div>
                    <div style="margin-bottom:0.85rem;">
                        <strong style="color:var(--text,#111827);display:block;font-size:0.75rem;text-transform:uppercase;letter-spacing:0.04em;">Rol Operativo</strong>
                        <span style="font-size:0.95rem;color:var(--success,#065F46);font-weight:700;">Personal de Restaurante: @rol</span>
                    </div>
                    <div style="margin-bottom:0.85rem;">
                        <strong style="color:var(--text,#111827);display:block;font-size:0.75rem;text-transform:uppercase;letter-spacing:0.04em;">Estado de la Cuenta</strong>
                        <span style="font-size:0.85rem;background:var(--success-bg,#ECFDF5);color:var(--success,#065F46);padding:2px 8px;border-radius:999px;font-weight:700;">Activa &amp; Operativa</span>
                    </div>
                    <div style="background:var(--surface-2,#FAF6F0);border:1px dashed var(--line,#E2D7C8);padding:0.85rem;border-radius:10px;font-size:0.78rem;color:var(--muted,#6B7280);margin-top:1.5rem;">
                        <svg class="ico" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="vertical-align:-.15em;margin-right:.35em;flex:none"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>Tu cuenta forma parte del equipo operativo de Saborator. Si necesitas modificar tus credenciales operativas o rol, contacta a Gerencia.
                    </div>
                </div>
            }
        </div>

        <!-- ── COLUMNA DERECHA: CAMBIO VOLUNTARIO DE CONTRASEÑA ── -->
        <div style="background:var(--surface,#FFFDF9);border:1px solid var(--line,#E2D7C8);border-radius:20px;padding:1.75rem;box-shadow:0 4px 16px var(--color-shadow, rgba(0,0,0,0.02));">
            <div style="display:flex;align-items:center;gap:10px;margin-bottom:1.25rem;border-bottom:1px solid var(--line,#E2D7C8);padding-bottom:0.85rem;">
                <div style="width:36px;height:36px;border-radius:10px;background:var(--brand-soft, rgba(107,30,46,0.1));color:var(--brand,#6B1E2E);display:flex;align-items:center;justify-content:center;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </div>
                <div>
                    <h3 style="margin:0;font-size:1.1rem;font-weight:800;color:var(--brand,#6B1E2E);">Seguridad &amp; Clave</h3>
                    <p style="margin:0;font-size:0.78rem;color:var(--muted,#6B7280);">Actualiza tu contraseña de acceso</p>
                </div>
            </div>

            <form asp-action="CambiarContraseña" method="post" id="formCambiarClave">
                @Html.AntiForgeryToken()

                <div style="margin-bottom:1rem;">
                    <label style="display:block;font-size:0.78rem;font-weight:700;color:var(--text,#3C2A20);text-transform:uppercase;margin-bottom:0.35rem;">Contraseña Actual *</label>
                    <input type="password" name="contrasenaActual" class="input-field" style="width:100%;padding:0.75rem 1rem;border:1.5px solid var(--line,#E2D7C8);border-radius:10px;font-size:0.92rem;background:var(--surface,#FFFDF9);color:var(--text,#1C1416);" placeholder="Tu clave actual" required />
                </div>

                <div style="margin-bottom:1rem;">
                    <label style="display:block;font-size:0.78rem;font-weight:700;color:var(--text,#3C2A20);text-transform:uppercase;margin-bottom:0.35rem;">Nueva Contraseña *</label>
                    <input type="password" name="nuevaContrasena" id="inputNuevaClave" class="input-field" style="width:100%;padding:0.75rem 1rem;border:1.5px solid var(--line,#E2D7C8);border-radius:10px;font-size:0.92rem;background:var(--surface,#FFFDF9);color:var(--text,#1C1416);" placeholder="Mínimo 6 caracteres" minlength="6" oninput="verificarFortalezaClave(this.value)" required />
                    
                    <!-- Medidor visual de fortaleza -->
                    <div style="margin-top:6px;display:flex;align-items:center;gap:6px;">
                        <div style="flex:1;height:4px;background:#E5E7EB;border-radius:2px;overflow:hidden;">
                            <div id="barraFortaleza" style="height:100%;width:0%;background:#EF4444;transition:all 200ms ease;"></div>
                        </div>
                        <span id="txtFortaleza" style="font-size:0.72rem;font-weight:700;color:#9CA3AF;">Seguridad</span>
                    </div>
                </div>

                <div style="margin-bottom:1.5rem;">
                    <label style="display:block;font-size:0.78rem;font-weight:700;color:var(--text,#3C2A20);text-transform:uppercase;margin-bottom:0.35rem;">Confirmar Nueva Contraseña *</label>
                    <input type="password" name="confirmarContrasena" class="input-field" style="width:100%;padding:0.75rem 1rem;border:1.5px solid var(--line,#E2D7C8);border-radius:10px;font-size:0.92rem;background:var(--surface,#FFFDF9);color:var(--text,#1C1416);" placeholder="Repite la nueva contraseña" minlength="6" required />
                </div>

                <button type="submit" style="background:var(--gold,#C8973A);color:#18060A;border:none;padding:0.75rem 1.5rem;border-radius:10px;font-weight:800;font-size:0.85rem;cursor:pointer;width:100%;box-shadow:0 3px 10px rgba(200,151,58,0.25);transition:transform 120ms ease;">
                    Actualizar Contraseña
                </button>
            </form>
        </div>

    </div>

</div>

@Html.AntiForgeryToken()

<script>
    // ── PREVISUALIZAR IMAGEN SUBIDA ──────────────────────────────────────────
    function previsualizarFoto(input) {
        if (!input.files || !input.files[0]) return;
        var file = input.files[0];

        // Validar tamaño máx 5MB
        if (file.size > 5 * 1024 * 1024) {
            alert("La imagen seleccionada supera los 5MB permitidos.");
            input.value = "";
            return;
        }

        // Limpiar selección de presets para favorecer el archivo subido
        document.getElementById('inputAvatarPreset').value = '';
        document.querySelectorAll('.avatar-preset-btn').forEach(function(b) { b.classList.remove('active'); });

        var reader = new FileReader();
        reader.onload = function(e) {
            var imgPreview = document.getElementById('previewAvatarImg');
            var fallback = document.getElementById('previewAvatarFallback');
            if (imgPreview) {
                imgPreview.src = e.target.result;
                imgPreview.style.display = 'block';
            }
            if (fallback) {
                fallback.style.display = 'none';
            }
            var lbl = document.getElementById('lblDropzoneTitulo');
            if (lbl) {
                lbl.textContent = 'Foto lista para guardar: ' + file.name;
            }
        };
        reader.readAsDataURL(file);
    }

    // ── DRAG & DROP EN ZONA DE SUBIDA ────────────────────────────────────────
    (function initDragAndDrop() {
        var dz = document.getElementById('dropzoneAvatar');
        var fileInput = document.getElementById('inputFotoArchivo');
        if (!dz || !fileInput) return;

        ['dragenter', 'dragover'].forEach(function(eventName) {
            dz.addEventListener(eventName, function(e) {
                e.preventDefault();
                e.stopPropagation();
                dz.classList.add('dragover');
            }, false);
        });

        ['dragleave', 'drop'].forEach(function(eventName) {
            dz.addEventListener(eventName, function(e) {
                e.preventDefault();
                e.stopPropagation();
                dz.classList.remove('dragover');
            }, false);
        });

        dz.addEventListener('drop', function(e) {
            var dt = e.dataTransfer;
            var files = dt.files;
            if (files && files.length > 0) {
                fileInput.files = files;
                previsualizarFoto(fileInput);
            }
        }, false);
    })();

    // ── SELECCIONAR AVATAR PREDISEÑADO ───────────────────────────────────────
    function seleccionarPreset(rutaPreset, btnElement) {
        document.getElementById('inputAvatarPreset').value = rutaPreset;
        // Limpiar archivo seleccionado
        var fileInp = document.getElementById('inputFotoArchivo');
        if (fileInp) fileInp.value = '';

        // Actualizar estados visuales de los botones
        document.querySelectorAll('.avatar-preset-btn').forEach(function(b) {
            b.classList.remove('active');
        });
        if (btnElement) {
            btnElement.classList.add('active');
        }

        // Previsualizar en la zona
        var imgPreview = document.getElementById('previewAvatarImg');
        var fallback = document.getElementById('previewAvatarFallback');
        if (imgPreview) {
            imgPreview.src = rutaPreset;
            imgPreview.style.display = 'block';
        }
        if (fallback) {
            fallback.style.display = 'none';
        }
        var lbl = document.getElementById('lblDropzoneTitulo');
        if (lbl) {
            lbl.textContent = 'Avatar seleccionado listo para guardar';
        }
    }

    // ── APLICAR TEMA CON TRANSICIÓN LIVE & GUARDADO ASYNC ─────────────────────
    function aplicarTema(tema, cardElement) {
        // 1. Aplicar inmediatamente al DOM para experiencia instantánea
        if (tema === 'clasico') {
            document.documentElement.removeAttribute('data-theme');
        } else {
            document.documentElement.setAttribute('data-theme', tema);
        }
        try {
            localStorage.setItem('saborator_theme', tema);
        } catch(e) {}

        // 2. Actualizar estilos de las tarjetas
        document.querySelectorAll('.theme-card').forEach(function(c) {
            c.classList.remove('active');
            var pill = c.querySelector('.theme-active-pill');
            if (pill) pill.remove();
        });

        if (cardElement) {
            cardElement.classList.add('active');
            var wrapper = cardElement.children[1];
            if (wrapper) {
                wrapper.innerHTML = '<span class="theme-active-pill"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg> Activo</span>';
            }
        }

        // 3. Actualizar badge de tema en cabecera
        var badge = document.getElementById('badgeTemaActual');
        if (badge) {
            badge.innerHTML = '<span style="width:7px;height:7px;border-radius:50%;background:var(--gold,#D4C2A5);"></span> Tema: <strong style="text-transform:capitalize;">' + tema + '</strong>';
        }

        // 4. Guardar asíncronamente en backend para persistencia de la cuenta
        var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        var formData = new FormData();
        formData.append('tema', tema);
        formData.append('__RequestVerificationToken', token);

        fetch('/Perfil/ActualizarTema', {
            method: 'POST',
            body: formData,
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
            var statusToast = document.getElementById('toastTemaStatus');
            if (statusToast) {
                statusToast.textContent = 'Guardado en tu cuenta';
                statusToast.style.opacity = '1';
                setTimeout(function() {
                    statusToast.style.opacity = '0';
                }, 2200);
            }
            if (typeof showToast === 'function') {
                showToast('ok', 'Tema "' + tema.toUpperCase() + '" aplicado a tu perfil.');
            }
        })
        .catch(function(err) {
            console.error('Error guardando tema:', err);
        });
    }

    // ── MEDIDOR DE FORTALEZA DE CLAVE ────────────────────────────────────────
    function verificarFortalezaClave(val) {
        const barra = document.getElementById('barraFortaleza');
        const txt = document.getElementById('txtFortaleza');
        if (!barra || !txt) return;

        let score = 0;
        if (val.length >= 6) score += 25;
        if (val.length >= 10) score += 25;
        if (/[A-Z]/.test(val)) score += 25;
        if (/[0-9!@@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]/.test(val)) score += 25;

        barra.style.width = score + '%';
        if (score <= 25) {
            barra.style.background = '#EF4444';
            txt.textContent = 'Débil';
            txt.style.color = '#EF4444';
        } else if (score <= 50) {
            barra.style.background = '#F59E0B';
            txt.textContent = 'Moderada';
            txt.style.color = '#F59E0B';
        } else if (score <= 75) {
            barra.style.background = '#3B82F6';
            txt.textContent = 'Buena';
            txt.style.color = '#3B82F6';
        } else {
            barra.style.background = '#10B981';
            txt.textContent = 'Muy Segura';
            txt.style.color = '#10B981';
        }
    }
</script>
