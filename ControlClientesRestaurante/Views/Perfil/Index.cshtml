                        </div>
                        <div>
                            @if (temaActual == "clasico")
                            {
                                <span class="theme-active-pill"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg> Activo</span>
                            }
                        </div>
                    </div>

                    <!-- Tema 2: Noche Gourmet (Dark Mode) -->
                    <div class="theme-card @(temaActual == "dark" || temaActual == "noche" ? "active" : "")" onclick="aplicarTema('dark', this)">
                        <div>
                            <div class="theme-card-swatches">
                                <div class="theme-swatch" style="background:#120D0F;" title="Negro Obsidian"></div>
                                <div class="theme-swatch" style="background:#B2475C;" title="Borgoña Carmesí"></div>
                                <div class="theme-swatch" style="background:#E5C687;" title="Oro Noche"></div>
                            </div>
                            <div class="theme-card-title">Noche Gourmet</div>
                            <p class="theme-card-desc">Obsidian & Borgoña Noir. Modo oscuro de lujo para veladas y descanso visual.</p>
                        </div>
                        <div>
                            @if (temaActual == "dark" || temaActual == "noche")
                            {
                                <span class="theme-active-pill"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg> Activo</span>
                            }
