                    </div>

                    <!-- Tema 5: Atardecer & Brasa Viva -->
                    <div class="theme-card @(temaActual == "sunset" ? "active" : "")" onclick="aplicarTema('sunset', this)">
                        <div>
                            <div class="theme-card-swatches">
                                <div class="theme-swatch" style="background:#872B15;" title="Terracota Brasa"></div>
                                <div class="theme-swatch" style="background:#F9F3EE;" title="Arcilla Cálida"></div>
                                <div class="theme-swatch" style="background:#E08E45;" title="Ámbar Fuego"></div>
