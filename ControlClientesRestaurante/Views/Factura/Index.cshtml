@model List<ControlClientesRestaurante.Models.Factura>
@{
    ViewData["Title"] = "Historial de Ventas & Facturación";
    decimal totalFacturado  = ViewBag.TotalFacturado  ?? 0m;
    decimal totalIva        = ViewBag.TotalIva        ?? 0m;
    decimal totalPropinas   = ViewBag.TotalPropinas   ?? 0m;
    decimal totalDomicilios = ViewBag.TotalDomicilios ?? 0m;
    decimal ticketPromedio  = ViewBag.TicketPromedio  ?? 0m;
    int totalFacturas       = ViewBag.TotalFacturas   ?? 0;

    string desde = ViewBag.Desde as string ?? "";
    string hasta = ViewBag.Hasta as string ?? "";
    string buscar = ViewBag.Buscar as string ?? "";
    string cajeroSeleccionado = ViewBag.CajeroSeleccionado as string ?? "";
    var listaCajeros = (ViewBag.ListaCajeros as List<string>) ?? new List<string>();
}

<!-- Encabezado Principal -->
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
    <div class="pg-header">
        <div class="pg-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="3" x2="9" y2="21"/></svg>
        </div>
        <div>
            <div class="pg-title">Historial de Ventas &amp; Facturación</div>
            <div class="pg-sub">Consulta de comprobantes contables, métricas financieras y exportación ejecutiva</div>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <a asp-action="ExportarCsv" asp-route-desde="@desde" asp-route-hasta="@hasta" asp-route-buscar="@buscar" asp-route-cajero="@cajeroSeleccionado" 
           class="btn-ghost" title="Exportar reporte consolidado a Excel / CSV" style="padding:0.48rem 0.9rem;font-size:0.82rem;gap:0.4rem;display:inline-flex;align-items:center;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            <span>Exportar Ventas (Excel)</span>
        </a>
        <a asp-action="ExportarDetalladoCsv" asp-route-desde="@desde" asp-route-hasta="@hasta" asp-route-buscar="@buscar" asp-route-cajero="@cajeroSeleccionado" 
           class="btn-ghost" title="Exportar desglose por plato vendido a Excel" style="padding:0.48rem 0.9rem;font-size:0.82rem;gap:0.4rem;display:inline-flex;align-items:center;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            <span>Detalle Platos (Excel)</span>
        </a>
        <a asp-action="Create" class="btn-gold" style="padding:0.48rem 1rem;font-size:0.82rem;gap:0.4rem;display:inline-flex;align-items:center;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            <span>Nueva Factura</span>
        </a>
    </div>
</div>
<hr class="div-gold" />

<!-- ══ TARJETAS DE KPIS FINANCIEROS ═══════════════════════════════════ -->
<div class="ventas-kpi-grid">
    <div class="ventas-kpi-card" style="border-left: 4px solid var(--gold);">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <span class="ventas-kpi-label">Total Facturado</span>
            <div class="ventas-kpi-icon" style="background: rgba(200,151,58,0.15); color: var(--gold);">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
        </div>
        <div class="ventas-kpi-val">$@totalFacturado.ToString("N0") <small style="font-size:0.75rem;font-weight:600;color:var(--muted);">COP</small></div>
        <div class="ventas-kpi-sub">En <strong>@totalFacturas</strong> comprobante(s)</div>
    </div>

    <div class="ventas-kpi-card" style="border-left: 4px solid #10B981;">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <span class="ventas-kpi-label">Ticket Promedio</span>
            <div class="ventas-kpi-icon" style="background: rgba(16,185,129,0.15); color: #10B981;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
            </div>
        </div>
        <div class="ventas-kpi-val" style="color: #10B981;">$@ticketPromedio.ToString("N0") <small style="font-size:0.75rem;font-weight:600;color:var(--muted);">COP</small></div>
        <div class="ventas-kpi-sub">Valor medio por factura emitida</div>
    </div>

    <div class="ventas-kpi-card" style="border-left: 4px solid #D97706;">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <span class="ventas-kpi-label">IVA Recaudado</span>
            <div class="ventas-kpi-icon" style="background: rgba(217,119,6,0.15); color: #D97706;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            </div>
        </div>
        <div class="ventas-kpi-val" style="color: var(--gold);">$@totalIva.ToString("N0") <small style="font-size:0.75rem;font-weight:600;color:var(--muted);">COP</small></div>
        <div class="ventas-kpi-sub">Impuesto al consumo discriminado</div>
    </div>

    <div class="ventas-kpi-card" style="border-left: 4px solid #3B82F6;">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <span class="ventas-kpi-label">Propinas &amp; Domicilios</span>
            <div class="ventas-kpi-icon" style="background: rgba(59,130,246,0.15); color: #3B82F6;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            </div>
        </div>
        <div class="ventas-kpi-val" style="color: #3B82F6;">$@((totalPropinas + totalDomicilios).ToString("N0")) <small style="font-size:0.75rem;font-weight:600;color:var(--muted);">COP</small></div>
        <div class="ventas-kpi-sub">$@totalPropinas.ToString("N0") prop. / $@totalDomicilios.ToString("N0") dom.</div>
    </div>
</div>

<!-- ══ FILTROS DE RANGO Y BÚSQUEDA ═══════════════════════════════════ -->
<div class="card-pro" style="padding: 1.5rem 1.75rem; margin-bottom: 2.25rem; background: var(--surface);">
    <form method="get" asp-action="Index" id="filtroForm" class="ventas-filter-grid">
        <div>
            <label class="form-label mb-1">Buscar por N°, Cliente o Cédula</label>
            <input type="text" name="buscar" value="@buscar" class="form-control form-control-sm" placeholder="Ej: FAC-0001, Carlos, 1042..." />
        </div>
        <div>
            <label class="form-label mb-1">Desde</label>
            <input type="date" name="desde" id="inputDesde" value="@desde" class="form-control form-control-sm" />
        </div>
        <div>
            <label class="form-label mb-1">Hasta</label>
            <input type="date" name="hasta" id="inputHasta" value="@hasta" class="form-control form-control-sm" />
        </div>
        <div>
            <label class="form-label mb-1">Cajero</label>
            <select name="cajero" class="form-select form-select-sm">
                <option value="">Todos los cajeros</option>
                @foreach (var c in listaCajeros)
                {
                    <option value="@c" selected="@(c == cajeroSeleccionado)">@c</option>
                }
            </select>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn-brand flex-fill" style="padding:0.48rem 0.95rem;font-size:0.84rem;border-radius:9px;justify-content:center;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <span>Filtrar</span>
            </button>
            <a asp-action="Index" class="btn-ghost" style="padding:0.48rem 0.95rem;font-size:0.84rem;border-radius:9px;">
                Limpiar
            </a>
        </div>
    </form>

    <!-- Botones de Acceso Rápido de Fecha -->
    <div class="d-flex flex-wrap align-items-center gap-2 mt-3 pt-3" style="border-top: 1px solid var(--line);">
        <span style="font-size:0.75rem;color:var(--muted);font-weight:700;text-transform:uppercase;letter-spacing:0.05em;margin-right:0.25rem;">Rango rápido:</span>
        <button type="button" class="btn-ghost" onclick="setRango('hoy')" style="padding:0.25rem 0.7rem;font-size:0.75rem;">Hoy</button>
        <button type="button" class="btn-ghost" onclick="setRango('semana')" style="padding:0.25rem 0.7rem;font-size:0.75rem;">Últimos 7 días</button>
        <button type="button" class="btn-ghost" onclick="setRango('mes')" style="padding:0.25rem 0.7rem;font-size:0.75rem;">Este mes</button>
    </div>
</div>

@if (Model == null || !Model.Any())
{
    <div class="card-pro text-center py-5" style="color:var(--muted);">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" style="margin-bottom:.75rem;opacity:.4;"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="3" x2="9" y2="21"/></svg>
        <p style="font-weight:700;font-size:1rem;color:var(--ink);margin-bottom:.25rem;">No se encontraron facturas para los filtros seleccionados.</p>
        <p style="font-size:.875rem;margin-bottom:0;">Intenta ampliar el rango de fechas o limpiar los filtros.</p>
    </div>
}
else
{
    <div class="tbl-wrap">
        <table id="tablaFacturas" class="tbl-pro">
            <thead>
                <tr>
                    <th>N° Factura</th>
                    <th>Fecha &amp; Hora</th>
                    <th>Cliente</th>
                    <th>Subtotal</th>
                    <th>IVA</th>
                    <th>Propina</th>
                    <th>Total</th>
                    <th>Estado</th>
                    <th>Cajero</th>
                    <th style="width:125px;text-align:right;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in Model)
                {
                    decimal ivaFactura = f.Subtotal * f.ImpuestoPorcentaje / 100m;
                    <tr>
                        <td>
                            <span class="factura-num-pill">@f.Numero</span>
                        </td>
                        <td style="color:var(--muted);font-size:.82rem;font-variant-numeric:tabular-nums;">
                            <strong style="color:var(--text);">@f.FechaCreacion.ToString("dd/MM/yyyy")</strong>
                            <span class="ms-1">@f.FechaCreacion.ToString("HH:mm")</span>
                        </td>
                        <td>
                            @if (f.Cliente != null)
                            {
                                <div style="font-weight:700;color:var(--ink);">@f.Cliente.Nombre</div>
                                <div style="font-size:0.75rem;color:var(--muted);">Doc: @(f.Cliente.Documento ?? "N/A")</div>
                            }
                            else if (!string.IsNullOrEmpty(f.NombreClienteLibre))
                            {
                                <div style="font-weight:700;color:var(--ink);">@f.NombreClienteLibre</div>
                                <div style="font-size:0.75rem;color:var(--muted);">Cliente libre</div>
                            }
                            else
                            {
                                <span style="color:var(--muted);">Consumidor final</span>
                            }
                        </td>
                        <td style="font-size:0.85rem;font-variant-numeric:tabular-nums;color:var(--text);">$@f.Subtotal.ToString("N0")</td>
                        <td style="font-size:0.85rem;font-variant-numeric:tabular-nums;color:var(--muted);">$@ivaFactura.ToString("N0")</td>
                        <td style="font-size:0.85rem;font-variant-numeric:tabular-nums;color:var(--muted);">$@f.Propina.ToString("N0")</td>
                        <td style="font-variant-numeric:tabular-nums;">
                            <strong style="font-size:0.94rem;color:var(--gold);">$@f.Total.ToString("N0")</strong>
                        </td>
                        <td>
                            @if (f.Estado == "Emitida")
                            { <span class="badge-emit">Emitida</span> }
                            else
                            { <span class="badge-anul">Anulada</span> }
                        </td>
                        <td style="color:var(--text);font-size:.82rem;font-weight:600;">@f.UsuarioCajero</td>
                        <td style="text-align:right;">
                            <a asp-action="Detalle" asp-route-id="@f.Id" class="btn-ghost"
                               style="padding:.3rem .7rem;font-size:.76rem;gap:.3rem;display:inline-flex;align-items:center;">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                Ver / PDF
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3 px-1" style="font-size:.8rem;color:var(--muted);">
        <div>Mostrando <strong style="color:var(--ink);">@Model.Count</strong> factura(s)</div>
        <div>Total consolidado en vista: <strong style="color:var(--gold);font-size:0.92rem;">$@totalFacturado.ToString("N0") COP</strong></div>
    </div>
}

<style>
    .ventas-kpi-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(235px, 1fr));
        gap: 1.65rem;
        margin-bottom: 2.25rem;
    }
    .ventas-filter-grid {
        display: grid;
        grid-template-columns: 1.6fr 1fr 1fr 1fr auto;
        gap: 1.25rem;
        align-items: end;
    }
    @@media (max-width: 1100px) {
        .ventas-filter-grid {
            grid-template-columns: 1fr 1fr;
        }
    }
    @@media (max-width: 576px) {
        .ventas-filter-grid {
            grid-template-columns: 1fr;
        }
    }
    .ventas-kpi-card {
        background: var(--surface);
        border: 1.5px solid var(--line, #E3D8C8);
        border-radius: 16px;
        padding: 1.35rem 1.5rem;
        height: 100%;
        box-shadow: var(--shadow);
        transition: transform 0.18s ease, box-shadow 0.18s ease;
    }
    .ventas-kpi-card:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-md);
    }
    .ventas-kpi-label {
        font-size: 0.73rem;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        font-weight: 700;
    }
    .ventas-kpi-icon {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .ventas-kpi-val {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 1.4rem;
        font-weight: 800;
        color: var(--ink);
        line-height: 1.2;
        margin-bottom: 0.2rem;
        font-variant-numeric: tabular-nums;
    }
    .ventas-kpi-sub {
        font-size: 0.74rem;
        color: var(--muted);
    }
    .factura-num-pill {
        font-family: 'Geist Mono', monospace;
        font-weight: 700;
        font-size: 0.82rem;
        color: var(--gold);
        background: rgba(200, 151, 58, 0.12);
        border: 1px solid rgba(200, 151, 58, 0.3);
        padding: 0.22rem 0.55rem;
        border-radius: 6px;
        display: inline-block;
    }
</style>

<script>
    function setRango(tipo) {
        const hoy = new Date();
        const formatDate = (d) => d.toISOString().split('T')[0];
        const inputDesde = document.getElementById('inputDesde');
        const inputHasta = document.getElementById('inputHasta');

        inputHasta.value = formatDate(hoy);

        if (tipo === 'hoy') {
            inputDesde.value = formatDate(hoy);
        } else if (tipo === 'semana') {
            const semanaAtras = new Date();
            semanaAtras.setDate(hoy.getDate() - 7);
            inputDesde.value = formatDate(semanaAtras);
        } else if (tipo === 'mes') {
            const inicioMes = new Date(hoy.getFullYear(), hoy.getMonth(), 1);
            inputDesde.value = formatDate(inicioMes);
        }
        document.getElementById('filtroForm').submit();
    }
</script>
